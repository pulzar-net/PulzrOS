# ── build output ──────────────────────────────────────────────────────────
# Downloaded ImageBuilders, packaged .ipk files, rendered rootfs overlays.
# Large, and entirely reproducible from the sources in this repo.
.build/

# Finished images.
out/

# The console's build output, which build.sh writes straight into the
# parkeze-console package payload. Generated on every build — never commit it,
# or a stale copy ships instead of the source in console/.
feed/parkeze-console/files/www/

# Operator authorized_keys, assembled by build.sh from keys/*.pub. Generated
# on every build from the sources in keys/ — committing it would let a stale
# copy ship after somebody's key is removed. Same for the fleet-keys bundle
# build.sh writes alongside them.
boards/common/files/etc/dropbear/authorized_keys
boards/common/files/root/.ssh/authorized_keys
boards/common/files/usr/share/parkeze/fleet-keys
# The SSH CA's public line, copied in by build.sh from keys/ca/.
boards/common/files/usr/share/parkeze/ssh/

# The fleet recovery PUBLIC key, copied in by build.sh. Public, but it belongs
# to a deployment rather than to this repo — an image built from a checkout
# should use whichever key that deployment uses, not one frozen in git.
boards/common/files/etc/parkeze/recovery.pub
recovery_ed25519.pub

# The firmware signing PUBLIC key, same reasoning: build.sh copies it in, and
# which key an image trusts is a property of the deployment that built it.
boards/common/files/etc/parkeze/firmware.pub
firmware_ed25519.pub

console/node_modules/
console/dist/
# TypeScript's incremental build cache: machine-local and regenerated on
# every typecheck.
console/tsconfig.tsbuildinfo

# A local ucode build for scripts/check-ucode.sh — see the README.
ucode/

# ── secrets ───────────────────────────────────────────────────────────────
# Never commit a gateway credential or the fleet recovery PRIVATE key. That
# key is the anchor for every adopted gateway; see docs/auth.md for what its
# disclosure would cost.
.env
.env.local
*.pem
*_ed25519
# Public halves are not secret, and keys/*.pub is meant to be committed.
!*_ed25519.pub
# Except this one. It belongs to a deployment rather than to this repo — an
# image built from a checkout should use whichever key that deployment uses,
# not one frozen in git. The rule above would otherwise re-include it and
# undo the explicit ignore further up, which is exactly what it was doing.
recovery_ed25519.pub
firmware_ed25519.pub

# ── editors and OS ────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
*.bak
*.backup
.DS_Store
._*
Thumbs.db

# ── logs ──────────────────────────────────────────────────────────────────
*.log
logs/
*.tmp

# Per-unit flash dumps (factory calibration, MACs) taken by a harvest.
# Only useful to the unit they came from.
devices/
