# ── build output ──────────────────────────────────────────────────────────
# Downloaded ImageBuilders, packaged .ipk files, rendered rootfs overlays.
# Large, and entirely reproducible from the sources in this repo.
.build/

# Finished images.
out/

# The console's build output, which build.sh writes straight into the
# parkeze-console package payload. Generated on every build — never commit it,
# or a stale copy ships instead of the source in console/.
feed/parkeze-console/files/www/

# The fleet recovery PUBLIC key, copied in by build.sh. Public, but it belongs
# to a deployment rather than to this repo — an image built from a checkout
# should use whichever key that deployment uses, not one frozen in git.
boards/common/files/etc/parkeze/recovery.pub
recovery_ed25519.pub

console/node_modules/
console/dist/

# A local ucode build for scripts/check-ucode.sh — see the README.
ucode/

# ── secrets ───────────────────────────────────────────────────────────────
# Never commit a gateway credential or the fleet recovery PRIVATE key. That
# key is the anchor for every adopted gateway; see docs/auth.md for what its
# disclosure would cost.
.env
.env.local
*.pem
*_ed25519
!*_ed25519.pub

# ── editors and OS ────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
*.bak
*.backup
.DS_Store
._*
Thumbs.db

# ── logs ──────────────────────────────────────────────────────────────────
*.log
logs/
*.tmp
