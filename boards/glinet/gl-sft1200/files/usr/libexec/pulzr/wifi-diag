#!/bin/sh
#
# What the siwifi driver knew of a client link that pulzr-wifi-uplink found
# dead while associated, printed for it to log before it restarts the radio.
#
#   wifi-diag <station device>
#
# The station as cfg80211 sees it, then the driver's: the AP's TX queues (a
# queue left stopped shows in its status letters: C stop channel, F full, P
# and V power save, S CSA), the hardware queues' credits, and its TX and RX
# counters. Until one of these was caught, a link that stayed associated
# with no traffic for four minutes left nothing to say why.

dev="$1"
case "${dev}" in ''|*[!A-Za-z0-9_.-]*) exit 0 ;; esac
phy="$(cat "/sys/class/net/${dev}/phy80211/name" 2>/dev/null)"

iw dev "${dev}" station dump 2>/dev/null \
    | grep -E "^Station|inactive time|tx (packets|retries|failed)|tx bitrate|signal:"

d="/sys/kernel/debug/ieee80211/${phy}/siwifi"
[ -n "${phy}" ] && [ -d "${d}" ] || exit 0

# The header, the station line and one row per TID
grep -E "^\*\* STA|^tid\||^ *[0-9]+\| *[0-9]+\|" "${d}/txq" 2>/dev/null
awk '/informations/ { q = $1 } /credits :/ { c = c " " q "=" $3 } END { if (c != "") print "credits" c }' \
    "${d}/hwq" 2>/dev/null
grep -E "mpdu tx (retry|failed|flush)|single tx retry|tx drop full|tx pkt|rx mpdu missed|rx pkt|RX bcn" \
    "${d}/trx_stats" 2>/dev/null
