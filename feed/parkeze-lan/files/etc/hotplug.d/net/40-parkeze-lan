#!/bin/sh
#
# A port that comes back on its own, a USB adapter replugged, rejoins the
# bridge without the devlan interface going down, so no ifup follows it.
# netifd adds it to the bridge after this event, hence the pause.
[ "${ACTION}" = "add" ] || exit 0
. /etc/parkeze/board.conf
case " ${PARKEZE_LAN_PORTS} " in *" ${INTERFACE} "*) ;; *) exit 0 ;; esac
( sleep 3; /usr/sbin/parkeze-lan isolate ) &
