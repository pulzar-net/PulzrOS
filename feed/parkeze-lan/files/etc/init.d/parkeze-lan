#!/bin/sh /etc/rc.common
#
# The devlan zone's own nftables table and each client's policy rules: see
# /usr/sbin/parkeze-lan. After the firewall and the network, since the policy
# rules are fw4's and the isolation flags need the bridge.

START=21

start() { /usr/sbin/parkeze-lan apply; }
reload() { /usr/sbin/parkeze-lan apply; }
