#!/bin/sh /etc/rc.common
#
# pulzr-edge-ip: the requests a LAN device's codec asks for (pulzr-protocol
# "IP requests"). Respawned, because a broker that goes away must not leave a
# device's commands unanswered until a reboot.
#
# Its config is generated at every start: the gateway's own part
# (edge-config), and [ip] lan, every address the LAN bridge holds with its
# prefix (the LAN and any subnet added for a device with a static address,
# pulzr-lan's devlan_extra). A request goes only to a device on one of them,
# so a subnet added or removed restarts this.
#
# START=97, after the management agent (96), which wants the same credentials.

START=97
STOP=10

USE_PROCD=1

CONFIG=/var/run/pulzr-edge/ip.toml

. /usr/libexec/pulzr/edge-config

lan_subnets() {
	ip -4 -o addr show dev br-devlan 2>/dev/null | awk '{ for (i = 1; i < NF; i++) if ($i == "inet") print $(i + 1) }'
}

write_config() {
	local top list="" a
	top="$(edge_common)" || return 1
	for a in $(lan_subnets); do
		case "${a}" in *[!0-9./]*) continue ;; esac
		list="${list}${list:+, }\"${a}\""
	done
	[ -n "${list}" ] || return 1
	umask 077
	printf '%s\n[ip]\nlan = [%s]\n' "${top}" "${list}" > "${CONFIG}"
}

start_service() {
	# Not started without a LAN to serve or credentials to publish with.
	write_config || return 0

	procd_open_instance
	procd_set_param command /usr/sbin/pulzr-edge-ip ip "${CONFIG}"
	procd_set_param respawn 60 5 0
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_config_trigger "config.change" "pulzr" /etc/init.d/pulzr-edge-ip restart
	procd_add_interface_trigger "interface.*" devlan /etc/init.d/pulzr-edge-ip restart
	procd_add_interface_trigger "interface.*" devlan_extra /etc/init.d/pulzr-edge-ip restart
}
