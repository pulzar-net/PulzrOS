#!/bin/sh
#
# Open the console to the network the ethernet port is plugged into, for a
# while.
#
#   parkeze-local-access open [minutes]   open, or extend, and print a sign-in link
#   parkeze-local-access close
#   parkeze-local-access status
#
# ── WHY ────────────────────────────────────────────────────────────────────
#
# The port's uplink is in the wan zone, which drops everything except the two
# console carve-outs: 169.254.0.0/16 and the fixed console subnet. That is right
# for a gateway on a customer network. It is wrong for one on our own bench,
# where the laptop is on the same LAN as the gateway's DHCP lease and the only
# other ways in are a cable swap or a round trip through parkeze.net.
#
# Adoption also turns local sign-in off and deletes the first-boot password, so
# opening the firewall alone would reach a login page nobody can pass. The
# window therefore comes with its own way in: a one-time link, printed here.
#
# ── WHO MAY OPEN IT ────────────────────────────────────────────────────────
#
# Only a root shell — the serial console, or SSH from somewhere already allowed.
# There is deliberately no API for it. Whoever can run this can already read
# the session directory and every credential on the box, so the window grants
# nothing they did not have; an endpoint that opened it would be a new door.
#
# ── WHY IT CANNOT OUTLIVE A REBOOT ─────────────────────────────────────────
#
# Everything lives in /var/run. The firewall include that 20-parkeze-network
# declares points at a file in here, and fw4 ignores an include whose file does
# not exist — so a reboot, a crash or a forgotten window all end the same way:
# closed. Nothing is written to flash.
#
# Sessions opened through the window end with it, even ones signed in seconds
# before it closed. See readSession in the console's auth.uc.

DIR=/var/run/parkeze/local-access
STATE="${DIR}/state.json"
RULES="${DIR}/rules.nft"
TICKET="${DIR}/ticket"
TAG="parkeze-local-access"

DEFAULT_MINUTES=60
# A day, the same ceiling as the setup AP's window. A bench session that
# outlasts it can run this again.
MAX_MINUTES=1440

log() { logger -t local-access -p daemon.notice "$*"; }
die() { echo "$*" >&2; exit 1; }

expires_at() { jsonfilter -i "${STATE}" -e '@.expires' 2>/dev/null; }

is_open() {
    local expires; expires="$(expires_at)"
    [ -n "${expires}" ] && [ "${expires}" -gt "$(date +%s)" ]
}

firewall_reload() {
    /etc/init.d/firewall reload >/dev/null 2>&1
}

rule_loaded() {
    nft list chain inet fw4 input_wan 2>/dev/null | grep -q "${TAG}"
}

# The subnet the port's DHCP lease is on, as a CIDR. Empty without a lease.
lease_subnet() {
    local status addr mask
    status="$(ubus call network.interface.wan status 2>/dev/null)" || return 1
    addr="$(echo "${status}" | jsonfilter -e '@["ipv4-address"][0].address' 2>/dev/null)"
    mask="$(echo "${status}" | jsonfilter -e '@["ipv4-address"][0].mask' 2>/dev/null)"
    [ -n "${addr}" ] && [ -n "${mask}" ] || return 1
    ipcalc.sh "${addr}/${mask}" | sed -n 's/^NETWORK=//p' | tr -d '\n'
    printf '/%s\n' "${mask}"
}

lease_address() {
    ubus call network.interface.wan status 2>/dev/null \
        | jsonfilter -e '@["ipv4-address"][0].address' 2>/dev/null
}

open_window() {
    local minutes="${1:-${DEFAULT_MINUTES}}"
    case "${minutes}" in ''|*[!0-9]*) die "Minutes must be a whole number." ;; esac
    [ "${minutes}" -ge 1 ] && [ "${minutes}" -le "${MAX_MINUTES}" ] \
        || die "Minutes must be between 1 and ${MAX_MINUTES}."

    [ "$(uci -q get firewall.local_access)" = "include" ] \
        || die "This image has no firewall include for LAN access. Reflash with a newer build."

    local subnet address
    subnet="$(lease_subnet)"
    address="$(lease_address)"
    [ -n "${subnet}" ] && [ -n "${address}" ] \
        || die "The ethernet port has no DHCP lease, so there is no LAN to open to."

    # Checked before it goes anywhere near nft. A malformed line in an include
    # does not fail on its own — it stops fw4 loading the entire ruleset.
    echo "${subnet}" | grep -qE '^([0-9]{1,3}\.){3}[0-9]{1,3}/[0-9]{1,2}$' \
        || die "Could not work out the LAN subnet (got '${subnet}')."

    mkdir -p "${DIR}"
    chmod 0700 "${DIR}"

    # Kept across an extension, new for a fresh window. Sessions record the id
    # of the window they came through, so closing one ends its sessions for
    # good rather than until the next window opens.
    local id
    if is_open; then
        id="$(jsonfilter -i "${STATE}" -e '@.id' 2>/dev/null)"
    fi
    [ -n "${id}" ] || id="$(openssl rand -hex 8)"

    local expires=$(( $(date +%s) + minutes * 60 ))
    printf '{"id":"%s","expires":%d,"subnet":"%s"}\n' \
        "${id}" "${expires}" "${subnet}" > "${STATE}"

    # SSH as well as the console and its WiFi sign-in port, the same ports the
    # permanent carve-outs open. Deploying a console build to a bench gateway
    # is an scp.
    printf 'ip saddr %s tcp dport { 22, 80, 443, 8443 } accept comment "%s"\n' \
        "${subnet}" "${TAG}" > "${RULES}"

    firewall_reload
    if ! rule_loaded; then
        rm -f "${RULES}" "${STATE}" "${TICKET}"
        firewall_reload
        die "The firewall would not take the rule. LAN access is closed."
    fi

    # One link, good once. Running this again replaces an unused one.
    local ticket
    ticket="$(openssl rand -hex 32)"
    ( umask 077; printf '%s' "${ticket}" | sha256sum | cut -d' ' -f1 > "${TICKET}" )

    /etc/init.d/parkeze-local-access restart >/dev/null 2>&1

    log "opened to ${subnet} for ${minutes} min"
    echo "LAN access open to ${subnet} until $(date -d "@${expires}" '+%H:%M') (${minutes} min)."
    echo "https://${address}/#ticket=${ticket}"
    echo "The link works once. Run this again for another, or to extend."
}

close_window() {
    local was_open=0
    [ -e "${RULES}" ] && was_open=1
    rm -f "${RULES}" "${STATE}" "${TICKET}"
    [ "${was_open}" = "1" ] && firewall_reload
    [ "${was_open}" = "1" ] && log "closed"
    echo "LAN access closed."
    # Last, because when the timer is what called this, stopping the service
    # ends this process.
    /etc/init.d/parkeze-local-access stop >/dev/null 2>&1
}

status() {
    if is_open; then
        printf '{"open":true,"expires":%d,"subnet":"%s"}\n' \
            "$(expires_at)" "$(jsonfilter -i "${STATE}" -e '@.subnet')"
    else
        echo '{"open":false}'
    fi
}

# Run by /etc/init.d/parkeze-local-access. Re-reads the expiry every pass, so
# opening again extends the window without restarting anything.
expire() {
    while is_open; do
        local left=$(( $(expires_at) - $(date +%s) ))
        [ "${left}" -gt 60 ] && left=60
        sleep "${left}"
    done
    close_window >/dev/null
}

case "$1" in
    open)   open_window "$2" ;;
    close)  close_window ;;
    status) status ;;
    expire) expire ;;
    *)      echo "usage: $0 open [minutes] | close | status" >&2; exit 1 ;;
esac
