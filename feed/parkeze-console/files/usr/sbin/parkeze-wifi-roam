#!/bin/sh
#
# Once a minute, ask whether the WiFi uplink should move to another
# remembered network. The decision is roam() in the console's access.uc —
# kept there because joining is there, and a roam is a join.

while :; do
    sleep 60
    ucode /usr/share/parkeze/console/wifi-roam.uc >/dev/null 2>&1
done
