#!/bin/sh
#
# Put a sha512crypt hash into root's /etc/shadow entry.
#
# Factored out of the console so that the one piece of code that edits
# /etc/shadow is in one place and can be read on its own. It takes a hash, not
# a password: the caller has already derived it, and a cleartext password
# passed as argv would be visible in the process table to every user on the
# box for as long as this runs.
#
# Usage: parkeze-set-root-password '$6$rounds=...$...$...'

hash="$1"

# Refuse anything that is not a sha512crypt string. An empty or malformed
# value written into that field does not fail — it produces an account with no
# password, which dropbear will happily let in with RootPasswordAuth on. That
# is exactly the state this script exists to get out of, so it must never be
# the state this script creates.
case "${hash}" in
    '$6$'*'$'*) : ;;
    *) echo "refusing to write a non-sha512crypt value to root's shadow entry" >&2
       exit 1 ;;
esac

[ -f /etc/shadow ] || exit 1

# A temp file plus mv, so a power cut mid-write cannot leave a truncated
# /etc/shadow — which would lock every account out permanently.
tmp="$(mktemp /tmp/.shadow.XXXXXX)" || exit 1
chmod 0600 "${tmp}"

# '|' as the delimiter: a sha512crypt hash uses only [A-Za-z0-9./$], so it
# cannot contain one and cannot break out of the expression.
sed "s|^root:[^:]*:|root:${hash}:|" /etc/shadow > "${tmp}" || { rm -f "${tmp}"; exit 1; }

# Prove the edit did what it was supposed to before replacing the real file.
grep -q "^root:\\\$6\\\$" "${tmp}" || { rm -f "${tmp}"; exit 1; }

cat "${tmp}" > /etc/shadow
rm -f "${tmp}"
chmod 0600 /etc/shadow
exit 0
