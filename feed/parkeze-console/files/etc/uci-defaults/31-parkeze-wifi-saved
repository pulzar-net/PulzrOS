#!/bin/sh
#
# Remember the WiFi network a gateway had already joined before networks
# were remembered at all, so it is in the saved list after the upgrade rather
# than missing until somebody rejoins it. Also folds in the pinned
# certificate the first enterprise-WiFi build kept in parkeze.wifi.
#
# Idempotent: uci-defaults run again after every sysupgrade.

# See 30-parkeze-console: at image assembly this would run on the build host.
[ -n "${IPKG_INSTROOT}" ] && exit 0

ssid="$(uci -q get wireless.parkeze_sta.ssid)"
if [ -n "${ssid}" ]; then
    known=0
    for s in $(uci -q show parkeze | sed -n 's/^parkeze\.\([^.=]*\)=wifi_network$/\1/p'); do
        [ "$(uci -q get "parkeze.${s}.ssid")" = "${ssid}" ] && known=1
    done
    if [ "${known}" = 0 ]; then
        name="$(uci add parkeze wifi_network)"
        uci set "parkeze.${name}.ssid=${ssid}"
        case "$(uci -q get wireless.parkeze_sta.encryption)" in
            wpa*)
                uci set "parkeze.${name}.security=eap"
                for opt in eap_type auth identity anonymous_identity password; do
                    v="$(uci -q get "wireless.parkeze_sta.${opt}")"
                    [ -n "${v}" ] && uci set "parkeze.${name}.${opt}=${v}"
                done
                ca="$(uci -q get wireless.parkeze_sta.ca_cert)"
                hash="${ca#hash://server/sha256/}"
                [ "${hash}" != "${ca}" ] && uci set "parkeze.${name}.cert_hash=${hash}"
                subject="$(uci -q get parkeze.wifi.cert_subject)"
                [ -n "${subject}" ] && uci set "parkeze.${name}.cert_subject=${subject}"
                ;;
            none|'')
                uci set "parkeze.${name}.security=open"
                ;;
            *)
                uci set "parkeze.${name}.security=psk"
                key="$(uci -q get wireless.parkeze_sta.key)"
                [ -n "${key}" ] && uci set "parkeze.${name}.key=${key}"
                ;;
        esac
        uci set "parkeze.${name}.last_joined=$(date +%s)"
    fi
fi
uci -q delete parkeze.wifi
uci commit parkeze
exit 0
