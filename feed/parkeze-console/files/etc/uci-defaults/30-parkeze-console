#!/bin/sh
#
# First-boot console setup: a TLS certificate, and an initial local password
# that is unique to this unit.

# ── Do not run during image assembly ────────────────────────────────────────
#
# OpenWrt's prepare_rootfs executes every /etc/uci-defaults script while the
# image is being built, with IPKG_INSTROOT pointing at the staging rootfs. Any
# absolute path in here therefore hits the *build host*, not the gateway.
#
# For this package that is not merely wrong, it is dangerous: identity comes
# from /proc/cpuinfo, and the console's first-boot credentials and TLS key are
# generated here. Run at build time, every gateway flashed from one image would
# share one password and one private key, and would believe it was the CI
# runner.
#
# So: defer to first boot, which is the only place any of this makes sense.
[ -n "${IPKG_INSTROOT}" ] && exit 0

. /etc/parkeze/board.conf

STATE=/etc/parkeze/console
mkdir -p "${STATE}"
chmod 0700 "${STATE}"

# ── uhttpd ──────────────────────────────────────────────────────────────────
#
# Configured here rather than by shipping /etc/config/uhttpd, which belongs to
# the uhttpd package — two packages claiming one path is a file clash that
# fails the image build outright.
#
# The stock `main` instance is replaced wholesale rather than added to: it
# serves /www with the LuCI CGI handler on plain HTTP, and leaving it alongside
# ours would mean two ways in with two different auth stories.
uci -q delete uhttpd.main
uci -q batch <<EOF
set uhttpd.main=uhttpd

# Bound on every address, and kept safe by the firewall rather than by the
# bind address.
#
# The single ethernet port carries the uplink and the console addresses at
# once, so there is no address to bind to that means "local only" — the
# distinction lives in the source of the packet, not the destination, and only
# the firewall can see that. /etc/uci-defaults/20-parkeze-network drops
# everything from that port except 169.254.0.0/16 and the console subnet.
#
# Plain :80 listens too, so that a laptop typing the hostname lands on the
# redirect below instead of a refused connection. It only ever answers the
# redirect; redirect_https is set further down.
add_list uhttpd.main.listen_http='0.0.0.0:80'
add_list uhttpd.main.listen_https='0.0.0.0:443'

set uhttpd.main.home='/www/parkeze'
set uhttpd.main.cgi_prefix=''

# One list entry of the form <url-prefix>=<handler>, which is how uhttpd's
# ucode plugin is configured — the same shape LuCI uses for its own handler:
#
#   list ucode_prefix "/cgi-bin/luci=/usr/lib/ucode/luci/uhttpd.uc"
#
# Not two options. `ucode_handler` is not an option at all, and a bare
# `ucode_prefix` with no `=handler` is not a mapping — uhttpd's own comment
# says "Ucode support is disabled when no handler mappings are specified", so
# the API silently never existed. Every /api request fell through to
# error_page and was answered with the SPA's index.html, which looks like the
# console working right up until you read the body.
add_list uhttpd.main.ucode_prefix='/api=/usr/share/parkeze/console/api/index.uc'

# Same mechanism, for /assets: uhttpd itself has no gzip support at all, and
# build.sh ships a .gz next to every JS/CSS chunk for this to serve instead of
# the plain file when the browser will take it. See assets.uc's own header
# comment for why this could not just be folded into a static-file option —
# claiming the prefix here means uhttpd's own file serving never sees it
# again, so the handler has to answer the plain-file and missing-file cases
# too, not only the compressed one.
add_list uhttpd.main.ucode_prefix='/assets=/usr/share/parkeze/console/assets.uc'

set uhttpd.main.cert='${STATE}/cert.pem'
set uhttpd.main.key='${STATE}/key.pem'

# Everything that is not a real file is the SPA's entry point, so a deep link
# like /network survives a page reload instead of 404ing.
set uhttpd.main.error_page='/index.html'

set uhttpd.main.redirect_https='1'
set uhttpd.main.rfc1918_filter='0'
set uhttpd.main.max_requests='16'
set uhttpd.main.max_connections='64'
set uhttpd.main.script_timeout='600'
set uhttpd.main.network_timeout='30'
set uhttpd.main.http_keepalive='20'
set uhttpd.main.tcp_keepalive='1'

# No directory listings, ever. The console's asset directory is not a thing to
# browse.
set uhttpd.main.no_dirlists='1'
set uhttpd.main.no_symlinks='1'
EOF
uci commit uhttpd

# ── TLS ─────────────────────────────────────────────────────────────────────
# Self-signed and generated on the device, so no two gateways share a key.
# A browser will warn, which is correct and unavoidable for a device on a
# private address — the alternative is shipping a real certificate and its
# private key in a public firmware image, which is worse in every way.
#
# The parkeze.net proxy terminates its own TLS and does not rely on this being
# trusted; this exists so that a laptop plugged directly into the LAN port is
# not sending a password in the clear.
if [ ! -f "${STATE}/cert.pem" ]; then
    hostname="$(uci -q get parkeze.identity.hostname || echo parkeze)"
    px5g selfsigned -der \
        -days 3650 -newkey rsa:2048 \
        -certout "${STATE}/cert.pem" -keyout "${STATE}/key.pem" \
        -subj "/C=US/ST=NY/O=Parkeze/CN=${hostname}.local" 2>/dev/null \
    || openssl req -x509 -newkey rsa:2048 -nodes -days 3650 \
        -keyout "${STATE}/key.pem" -out "${STATE}/cert.pem" \
        -subj "/C=US/ST=NY/O=Parkeze/CN=${hostname}.local" 2>/dev/null
    chmod 0600 "${STATE}/key.pem"
fi

# ── mDNS ────────────────────────────────────────────────────────────────────
#
# What makes `https://parkeze-<serial>.local` work from a laptop with a cable
# and nothing else. Without this the link-local address is technically
# reachable but nobody can be expected to know what it is.
#
# Restricted to the link-local interface. The same port also faces whatever
# site network the gateway is plugged into, and answering multicast discovery
# there would put the gateway in the service browser of every machine on it —
# an inventory of our hardware handed to a network we do not control, for no
# benefit, since management from parkeze.net arrives over the tunnel.
uci -q batch <<EOF
delete umdns.@umdns[0]
add umdns umdns
set umdns.@umdns[-1].jail='1'
add_list umdns.@umdns[-1].network='linklocal'
EOF
uci commit umdns

# ── Initial credential ──────────────────────────────────────────────────────
# A per-unit random password, not a fleet-wide default.
#
# The previous ParkezeOS shipped parkeze/parkeze on every image, which means
# one published README is root on the entire fleet. A random password printed
# where the installer can find it costs one label and closes that entirely.
#
# It is written in the clear to a root-only file *as well as* being hashed,
# because the installer has to be able to read it off the device on first
# setup. The console deletes the cleartext copy the moment the password is
# changed, and refuses to consider the gateway set up until that happens.
if [ ! -f "${STATE}/password" ]; then
    initial="$(tr -dc 'A-HJ-NP-Za-km-z2-9' < /dev/urandom | head -c 14)"
    echo 'parkeze' > "${STATE}/username"
    echo "${initial}" > "${STATE}/initial-password"
    chmod 0600 "${STATE}/initial-password"

    # openssl passwd, NOT busybox mkpasswd.
    #
    # The busybox in OpenWrt 24.10 has neither the mkpasswd nor the cryptpw
    # applet compiled in. The previous call here produced nothing at all, on
    # every gateway ever built: ${STATE}/password was written zero bytes, the
    # console refused every sign-in because the stored hash was empty, and
    # root's /etc/shadow entry was never populated either — which left
    # passwordless root over SSH, because dropbear ships with
    # RootPasswordAuth on and an empty hash is not "no login", it is "login
    # with no password".
    #
    # -stdin keeps the password out of the process table. The 'rounds=' prefix
    # inside the salt is honoured by openssl and travels in the output string,
    # so the hash records the cost it was made with.
    salt="$(tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 16)"
    hash="$(printf '%s\n' "${initial}" \
            | openssl passwd -6 -salt "rounds=100000\$${salt}" -stdin 2>/dev/null)"

    # Checked, loudly. The previous version wrote the empty result out and
    # carried on as though it had worked, which is why this went unnoticed
    # through every build so far.
    case "${hash}" in
        '$6$'*'$'*)
            printf '%s' "${hash}" > "${STATE}/password"
            chmod 0600 "${STATE}/password"
            touch "${STATE}/password-is-initial"

            # Root's shell login gets the same credential — SSH is a real door
            # into this gateway, it is where the claim code is shown, and the
            # password for it is the one on the label.
            /usr/libexec/parkeze-set-root-password "${hash}" \
                || logger -t parkeze -p daemon.err \
                   "could not set root's password; root login may be open"
            ;;
        *)
            logger -t parkeze -p daemon.err \
                "FAILED to hash the initial console password: openssl passwd -6 returned nothing. Local sign-in will not work."
            # Lock root outright rather than leave it open. A gateway nobody
            # can log into is recoverable with a card reader; a gateway anybody
            # can log into is not recoverable at all.
            sed -i 's|^root:[^:]*:|root:!:|' /etc/shadow 2>/dev/null
            ;;
    esac

    # Not written into a banner file here: parkeze-motd reads
    # initial-password directly and prints it on every login until it is
    # changed, at which point it disappears on its own. Baking it into
    # /etc/banner meant a gateway advertised a credential it no longer had.
fi

exit 0
