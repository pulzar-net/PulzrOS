#!/bin/sh /etc/rc.common
#
# The resource history behind the console's System page. See parkeze-stats.

START=99
STOP=10
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /usr/sbin/parkeze-stats collect
    procd_set_param respawn 3600 5 0
    procd_close_instance
}
