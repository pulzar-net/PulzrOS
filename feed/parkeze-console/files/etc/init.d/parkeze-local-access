#!/bin/sh /etc/rc.common
#
# The timer that closes a LAN access window. See /usr/sbin/parkeze-local-access.
#
# Nothing to do at boot: the window lives in /var/run, so a fresh boot has none.
# Respawned, because a timer that dies leaves the window open until the next
# reboot — and that is the one failure this must not have.

START=99
STOP=10
USE_PROCD=1

start_service() {
    [ -s /var/run/parkeze/local-access/state.json ] || return 0

    procd_open_instance
    procd_set_param command /usr/sbin/parkeze-local-access expire
    procd_set_param respawn 3600 5 0
    procd_close_instance
}
