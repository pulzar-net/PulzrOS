# The Parkeze console, and nothing else.
#
# This replaces the stock uhttpd config wholesale rather than adding to it. The
# stock one serves /www with the LuCI CGI handler and listens on plain HTTP;
# neither is wanted here, and leaving them configured alongside would mean two
# ways in with two different auth stories.

config uhttpd main
	# LAN only. The console is never exposed to either uplink — reaching it
	# from outside happens through the parkeze.net proxy or over the tailnet,
	# both of which arrive via the loopback/tailscale addresses below rather
	# than by opening a port to the world.
	list listen_http   '127.0.0.1:80'
	list listen_https  '0.0.0.0:443'

	option home         '/www/parkeze'
	option cgi_prefix   ''
	option ucode_prefix '/api'
	option ucode_handler '/usr/share/parkeze/console/api/index.uc'

	option cert         '/etc/parkeze/console/cert.pem'
	option key          '/etc/parkeze/console/key.pem'

	# Everything that is not a real file is the SPA's entry point, so a deep
	# link like /network survives a page reload instead of 404ing.
	option error_page   '/index.html'

	option redirect_https 1
	option rfc1918_filter 0
	option max_requests   16
	option max_connections 64
	option script_timeout  60
	option network_timeout 30
	option http_keepalive  20
	option tcp_keepalive   1

	# No directory listings, ever. The console's asset directory is not a
	# thing to browse.
	option no_dirlists  1
	option no_symlinks  1
