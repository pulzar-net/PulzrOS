#!/bin/sh
#
# Follow whichever backhaul the tunnel is allowed to use.
#
# Re-homing the tunnel is one route replace in table 97 — wg0 itself, its
# keys and its peer are untouched — so `apply` alone is enough on every
# ifup/ifdown of either interface, and is what makes a failover take seconds
# rather than however long it takes something else to notice the handshake
# went stale.
#
# Wired ifup gets a full service restart instead, because it is also the
# moment enrolment finally has a link home: a gateway that missed its tunnel
# config the first time round retries there. That path already requires
# somebody to run a cable, so paying for a restart on it is free.

. /etc/parkeze/board.conf

[ "${PARKEZE_WIREGUARD_ENABLED:-1}" = "1" ] || exit 0

WIRED="${PARKEZE_WAN_ETH_IFACE:-wan}"
CELL="${PARKEZE_WAN_CELL_IFACE:-wwan}"
WIFI="${PARKEZE_WAN_WIFI_IFACE:-wwifi}"

if [ "${INTERFACE}" = "${WIRED}" ]; then
    case "${ACTION}" in
        ifup)   /etc/init.d/parkeze-wireguard restart ;;
        ifdown) /usr/sbin/parkeze-wireguard-route apply ;;
    esac
elif [ "${INTERFACE}" = "${WIFI}" ]; then
    # Same as wired: WiFi is an egress the tunnel may use, so coming up on it
    # is worth a restart to re-resolve the hub's endpoint on the new path.
    case "${ACTION}" in
        ifup)   /etc/init.d/parkeze-wireguard restart ;;
        ifdown) /usr/sbin/parkeze-wireguard-route apply ;;
    esac
elif [ "${INTERFACE}" = "${CELL}" ] || [ "${INTERFACE}" = usbwan ]; then
    # usbwan is a HiLink dongle or a phone: cellular, though it looks wired.
    case "${ACTION}" in
        ifup|ifdown) /usr/sbin/parkeze-wireguard-route apply ;;
    esac
fi
