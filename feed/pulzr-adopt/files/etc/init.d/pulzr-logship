#!/bin/sh /etc/rc.common
#
# Send the system log to Pulzr Cloud (pulzr-logship), once adopted. The
# mirror of pulzr-report: that one says what this gateway is every six hours,
# this one says what it is doing as it does it.

START=98
STOP=10
USE_PROCD=1

start_service() {
    [ "$(uci -q get pulzr.adoption.state)" = "adopted" ] || return 0
    [ "$(uci -q get pulzr.logship.enabled)" = "0" ] && return 0

    procd_open_instance logship
    procd_set_param command /usr/sbin/pulzr-logship
    procd_set_param respawn 300 10 0
    procd_close_instance
}

service_triggers() {
    procd_add_config_trigger "config.change" "pulzr" /etc/init.d/pulzr-logship restart
}
