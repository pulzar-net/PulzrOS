#!/bin/sh
#
# A cellular adapter that is a USB Ethernet device, as the usbwan uplink.
#
#   parkeze-usb-cellular scan                  bind usbwan to one, if present
#   parkeze-usb-cellular status [--present]    JSON; --present prints nothing
#                                              and exits 1 when there is none
#
# ── WHAT THIS IS FOR ───────────────────────────────────────────────────────
#
# A HiLink dongle (a Huawei E3372h, most ZTE sticks) runs the modem, a NAT and
# a DHCP server of its own, and shows the gateway a USB Ethernet port. A phone
# sharing its data over USB is the same from here. ModemManager has nothing to
# talk to and no SIM to read; the gateway's half is a DHCP client, which is all
# usbwan is.
#
# The device is whatever the kernel named it when it was plugged in, eth1 or
# usb0, so the interface ships without one and this fills it in, the way
# parkeze-modem-detect does for wwan.
#
# usbwan is billed, and /usr/share/parkeze/cellular.sh is where every script
# that keeps traffic off the SIM learns so. Nothing about the device says it:
# it is a DHCP lease on an Ethernet port, which is also what the wired uplink
# is.
#
# ── WHAT COUNTS ────────────────────────────────────────────────────────────
#
# A device bound to cdc_ether, cdc_ncm, rndis_host or ipheth, except:
#
#   a port the board names        PARKEZE_PORT_IFACE, PARKEZE_LAN_PORTS, or
#                                 anything already in a bridge. A Pi's USB LAN
#                                 adapter is often plain CDC Ethernet.
#   a control port beside it      option, qmi_wwan, cdc_mbim, huawei_cdc_ncm
#                                 and the rest on the same USB device: a modem
#                                 ModemManager drives as wwan. Raising its
#                                 network port here as well would race
#                                 ModemManager for the same bearer.
#
# What is left and gets this wrong is a plain USB Ethernet adapter that speaks
# CDC, plugged in as something other than a LAN port. It is counted billed,
# which is the wrong way round to be safe in.
#
# ── WHICH KIND ─────────────────────────────────────────────────────────────
#
#   hilink   the kernel flagged it a WWAN function (DEVTYPE=wwan), or it is
#            Huawei's or ZTE's
#   tether   anything else: ipheth is only ever an iPhone, and RNDIS or NCM
#            from another vendor is a phone in practice
#
# Only the console uses the answer, as a label. Both are billed alike.

. /etc/parkeze/board.conf

IFACE=usbwan

log() { logger -t usb-cellular -p daemon.info "$*"; }

# "<driver> <usb device dir>" when the device is one, else exit 1.
candidate() {
    local dev="$1" driver usb d port
    [ -e "/sys/class/net/${dev}/device/driver" ] || return 1
    driver="$(basename "$(readlink "/sys/class/net/${dev}/device/driver")")"
    case "${driver}" in
        cdc_ether|cdc_ncm|rndis_host|ipheth) ;;
        *) return 1 ;;
    esac
    for port in ${PARKEZE_PORT_IFACE} ${PARKEZE_LAN_PORTS}; do
        [ "${port}" = "${dev}" ] && return 1
    done
    [ -e "/sys/class/net/${dev}/master" ] && return 1
    usb="$(readlink -f "/sys/class/net/${dev}/device/..")"
    for d in "${usb}"/*:*/driver; do
        [ -e "${d}" ] || continue
        case "$(basename "$(readlink "${d}")")" in
            option|qcserial|sierra|cdc_acm|qmi_wwan|cdc_mbim|huawei_cdc_ncm|cdc_wdm) return 1 ;;
        esac
    done
    echo "${driver} ${usb}"
}

# What the USB device calls itself, cut down to what is safe inside a JSON
# string and short enough for a console fact.
usb_string() {
    tr -cd 'A-Za-z0-9 ._()/+-' < "$1" 2>/dev/null | tr -s ' ' | cut -c1-48
}

kind_of() {
    local dev="$1" driver="$2" usb="$3"
    [ "${driver}" = ipheth ] && { echo tether; return; }
    grep -qx 'DEVTYPE=wwan' "/sys/class/net/${dev}/uevent" 2>/dev/null && { echo hilink; return; }
    case "$(cat "${usb}/idVendor" 2>/dev/null)" in
        12d1|19d2) echo hilink ;;
        *)         echo tether ;;
    esac
}

scan() {
    local path dev found=""
    for path in /sys/class/net/*; do
        dev="${path##*/}"
        candidate "${dev}" >/dev/null && { found="${dev}"; break; }
    done
    # Nothing plugged in. usbwan keeps the device it had and stays down, and
    # netifd raises it again by itself if the same name comes back.
    [ -n "${found}" ] || return 0
    [ "$(uci -q get network.${IFACE}.device)" = "${found}" ] && return 0
    uci -q set network.${IFACE}.device="${found}"
    uci commit network
    log "usbwan bound to ${found}"
    /sbin/ifup "${IFACE}" >/dev/null 2>&1
}

status() {
    local dev spec driver usb model
    dev="$(uci -q get network.${IFACE}.device)"
    if [ -z "${dev}" ] || ! spec="$(candidate "${dev}")"; then
        [ "$1" = --present ] && return 1
        printf '{"present":false}\n'
        return 0
    fi
    driver="${spec%% *}"; usb="${spec#* }"
    model="$(usb_string "${usb}/manufacturer") $(usb_string "${usb}/product")"
    model="$(echo "${model}" | sed 's/^ *//; s/ *$//')"
    # imei and iccid empty, not left out: these are the fields
    # parkeze-modem-detect reports for a modem, and its readers default
    # nothing. A HiLink dongle answers neither question over this link.
    printf '{"present":true,"kind":"%s","device":"%s","driver":"%s","model":"%s","usb":"%s:%s","imei":"","iccid":"","gpsCapable":false}\n' \
        "$(kind_of "${dev}" "${driver}" "${usb}")" "${dev}" "${driver}" "${model}" \
        "$(cat "${usb}/idVendor" 2>/dev/null)" "$(cat "${usb}/idProduct" 2>/dev/null)"
}

case "${1:-status}" in
    scan)   scan ;;
    status) status "$2" ;;
    *) echo "usage: parkeze-usb-cellular {scan|status [--present]}" >&2; exit 2 ;;
esac
