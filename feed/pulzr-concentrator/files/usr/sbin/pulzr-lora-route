#!/bin/sh
#
# Decide whether LoRaWAN uplinks are allowed onto the metered link.
#
#   pulzr-lora-route apply    enforce the current setting
#   pulzr-lora-route flush    remove the rule and table
#   pulzr-lora-route status   report the setting and where uplinks go
#
# ── WHY THIS IS A SEPARATE DECISION ────────────────────────────────────────
#
# Management traffic and LoRaWAN traffic have different answers to "is
# cellular acceptable".
#
# Management has to reach a gateway whatever happens — an unreachable gateway
# cannot be fixed remotely, so it is worth the data every time, and cellular
# is its failover unconditionally.
#
# Uplinks are the opposite shape. A busy site can produce them continuously,
# the volume is set by how many devices are in range rather than by anything
# we control, and a wired outage nobody notices for a week is a bill nobody
# budgeted for. Whether that is acceptable depends on the site, so it is a
# setting rather than a policy: `pulzr.lorawan.allow_cellular`.
#
# ── WHAT "NOT ALLOWED" COSTS TODAY ─────────────────────────────────────────
#
# It depends on whether buffering is on — see pulzr-lora-buffer.
#
# With it, uplinks queue on the gateway and go out when wired returns, which
# makes this setting a trade: later data, no bill.
#
# Without it they are dropped, because the forwarder publishes to a broker it
# cannot reach and nothing here stores them. Buffering is on by default
# wherever there is an SD card; cellular stays allowed by default, so a
# gateway only stops sending uplinks over the SIM when somebody chooses that.
#
# ── HOW ────────────────────────────────────────────────────────────────────
#
# The same shape as pulzr-wireguard-route, for the same reasons: mark the
# traffic, send the mark to a table of our own, and put an unreachable rule
# under it so a marked packet is dropped rather than falling through to the
# main table when ours is empty. A gap between wired going down and cellular
# registering must not leak uplinks onto the SIM.
#
# Marked by destination port rather than by process. The forwarder runs as
# root, so there is no uid to match that would not also match everything else
# the gateway does — but 8883 is the broker and nothing else on this box
# speaks it. Reports and claims go to 443 and are untouched.

. /lib/functions.sh
. /lib/functions/network.sh
. /etc/pulzr/board.conf
# wired_gateway: the first usable wired uplink, of however many pulzr-ports
# made.
. /usr/share/pulzr/wired.sh

MARK="${PULZR_LORA_MARK:-0x9800}"
MASK="0xff00"
TABLE="${PULZR_LORA_TABLE:-98}"
WIFI_IFACE="${PULZR_WAN_WIFI_IFACE:-wwifi}"

log() { logger -t lora-route -p daemon.info "$*"; }

# The port whose traffic actually leaves this gateway, read from the config
# that was rendered rather than assumed — a deployment that moves its broker
# should not have to remember this file exists.
#
# Which config depends on whether uplinks are buffered. With buffering on the
# forwarder talks to 127.0.0.1:1883 and it is the *bridge* that goes out, so
# reading the forwarder's config would confine loopback traffic and leave the
# connection that actually costs money unmarked — the confinement would look
# installed and do nothing.
broker_port() {
    local conf port
    if [ -f /var/run/pulzr/lora/mosquitto.conf ]; then
        port="$(sed -n 's/^address .*:\([0-9]\+\)$/\1/p' \
                /var/run/pulzr/lora/mosquitto.conf | head -n1)"
        [ -n "${port}" ] && { echo "${port}"; return; }
    fi
    for conf in /tmp/run/pulzr/lora/slot*/mqtt-forwarder.toml; do
        [ -f "${conf}" ] || continue
        port="$(sed -n 's/^server=".*:\([0-9]\+\)"/\1/p' "${conf}" | head -n1)"
        [ -n "${port}" ] && { echo "${port}"; return; }
    done
    echo 8883
}

# 1 unless somebody has said otherwise. Per gateway, because whether a metered
# uplink is acceptable is a property of the site rather than of the board.
allow_cellular() {
    local set; set="$(uci -q get pulzr.lorawan.allow_cellular)"
    [ -n "${set}" ] || set="${PULZR_LORA_ALLOW_CELLULAR:-1}"
    [ "${set}" = "1" ]
}

iface_gateway() {
    local gw dev
    network_get_gateway gw "$1" || return 1
    network_get_device dev "$1" || return 1
    [ -n "${gw}" ] && [ -n "${dev}" ] || return 1
    echo "${gw} ${dev}"
}

# The WiFi's lease, only once pulzr-wifi-uplink has seen it reach the
# internet: a guest network has a gateway before anybody has signed in, and
# uplinks confined there went into its sign-in page. It re-runs `apply` when
# its answer changes.
wifi_gateway() {
    /usr/sbin/pulzr-wifi-uplink usable 2>/dev/null || return 1
    iface_gateway "${WIFI_IFACE}"
}

flush() {
    while ip rule del fwmark "${MARK}/${MASK}" table "${TABLE}" 2>/dev/null; do :; done
    while ip rule del fwmark "${MARK}/${MASK}" unreachable 2>/dev/null; do :; done
    ip route flush table "${TABLE}" 2>/dev/null
    nft delete table inet pulzr-lora 2>/dev/null
}

case "${1:-status}" in

apply)
    if allow_cellular; then
        # Nothing to confine. Uplinks take whatever route the gateway has,
        # which is the behaviour every gateway has had until now.
        flush
        log "uplinks may use any backhaul"
        exit 0
    fi

    port="$(broker_port)"

    # Mark first, so that even if the routing below cannot be built the
    # packets are marked and the unreachable rule catches them. Built fresh
    # rather than added to: a stale rule from an earlier port would otherwise
    # keep marking traffic nobody meant to confine.
    nft delete table inet pulzr-lora 2>/dev/null
    if ! nft -f - <<EOF 2>/dev/null
table inet pulzr-lora {
    chain output {
        type route hook output priority mangle; policy accept;
        tcp dport ${port} meta mark set ${MARK}
    }
}
EOF
    then
        log "ERROR: could not mark uplink traffic; leaving it unconfined"
        exit 1
    fi

    # The unreachable rule goes in first and at a higher priority number, so
    # it sits *below* the table lookup. Order matters: installed the other way
    # round it would swallow everything.
    ip rule del fwmark "${MARK}/${MASK}" unreachable 2>/dev/null
    ip rule add fwmark "${MARK}/${MASK}" unreachable priority 32101 2>/dev/null
    ip rule del fwmark "${MARK}/${MASK}" table "${TABLE}" 2>/dev/null
    ip rule add fwmark "${MARK}/${MASK}" table "${TABLE}" priority 32100 2>/dev/null

    # "Not cellular" means any link that is not billed: wired, then WiFi.
    # This used to mean wired only, so a gateway whose uplink was somebody's
    # WiFi dropped every uplink with this setting off — the setting exists to
    # avoid a data bill, and WiFi has none.
    #
    # Named by interface, never "any DHCP uplink that is not wwan": usbwan,
    # a HiLink dongle or a tethered phone, is an Ethernet device with a lease
    # exactly as wan is, and it is billed.
    ip route flush table "${TABLE}" 2>/dev/null
    if set -- $(wired_gateway); [ -n "${1:-}" ]; then
        ip route replace default via "$1" dev "$2" table "${TABLE}"
        log "uplinks confined to wired (${2}), port ${port}"
    elif set -- $(wifi_gateway); [ -n "${1:-}" ]; then
        ip route replace default via "$1" dev "$2" table "${TABLE}"
        log "uplinks confined to WiFi (${2}), port ${port}"
    else
        # Neither is up. The table stays empty and the unreachable rule below
        # it drops uplinks, which is the whole point of the setting: they wait
        # for a free link rather than being billed to the SIM.
        log "uplinks confined to wired or WiFi, both down — they will not be sent"
    fi
    ;;

flush)
    flush
    log "confinement removed"
    ;;

status)
    allowed=false; allow_cellular && allowed=true
    wired=false; wifi=false
    wired_gateway >/dev/null 2>&1 && wired=true
    wifi_gateway >/dev/null 2>&1 && wifi=true
    # Sending right now means: allowed anywhere, or confined with a free
    # link up.
    sending=false
    if [ "${allowed}" = "true" ] || [ "${wired}" = "true" ] || [ "${wifi}" = "true" ]; then
        sending=true
    fi
    printf '{"allowCellular":%s,"wiredUp":%s,"wifiUp":%s,"sending":%s,"brokerPort":%s}\n' \
        "${allowed}" "${wired}" "${wifi}" "${sending}" "$(broker_port)"
    ;;

*)
    echo "usage: pulzr-lora-route {apply|flush|status}" >&2
    exit 2
    ;;
esac

exit 0
