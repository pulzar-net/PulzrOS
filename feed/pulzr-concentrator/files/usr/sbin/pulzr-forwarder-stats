#!/bin/sh
#
# LoRa counters, as JSON.
#
#   pulzr-forwarder-stats            print JSON
#   pulzr-forwarder-stats --record   also update the uplink total the LED
#                                      daemon differences
#   pulzr-forwarder-stats --slot N   print JSON for one slot's pair only
#
# Read from the log, where both ChirpStack processes report:
#
#   concentratord, every 30s:
#     Publishing stats event, rx_received: 12, rx_received_ok: 11, tx_received: 0, tx_emitted: 0
#   concentratord, per frame:
#     Frame received, uplink_id: ..., freq: ...
#   mqtt-forwarder, per uplink it publishes:
#     Sending uplink event, uplink_id: ..., topic: us915_0/gateway/.../event/up
#
# The concentratord counts cover the last stats interval. Received and
# forwarded are reported separately on purpose. They answer different questions
# and have entirely different fixes:
#
#   received 0                the radio is hearing nothing — antenna, channel
#                             plan, or a concentrator that never initialised.
#   received > 0, forwarded 0 it hears fine and cannot deliver — backhaul, or
#                             MQTT credentials.
#
# A single "packets" counter conflates those, and they get diagnosed as each
# other.

STATE_DIR=/var/run/pulzr/lora
COUNTER="${STATE_DIR}/uplinks"

# `logread -l` bounds the read: on a gateway that has been up for a month the
# log is large, and the console calls this on every page load.
log="$(logread -l 400 2>/dev/null)"

# One slot's counters. Both processes log under the same names whichever slot
# they serve, so on a two-concentrator gateway the unfiltered read takes
# whichever pair logged last. procd knows each instance's pid; the log tags
# every line with it.
if [ "$1" = "--slot" ]; then
    case "$2" in ''|*[!0-9]*) echo "usage: $0 --slot N" >&2; exit 2 ;; esac
    instances="$(ubus call service list '{"name":"pulzr-packet-forwarder"}' 2>/dev/null)"
    pid_of() {
        echo "${instances}" | jsonfilter -e "@['pulzr-packet-forwarder'].instances['$1'].pid" 2>/dev/null
    }
    cpid="$(pid_of "concentratord$2")"
    fpid="$(pid_of "forwarder$2")"
    # A wider window than the default: two slots share it, and the filter
    # throws most of it away.
    log="$(logread -l 1200 2>/dev/null | grep -aE "\[(${cpid:-x}|${fpid:-x})\]:")"
fi

stats="$(echo "${log}" | grep -a 'Publishing stats event' | tail -n1)"
field() { echo "${stats}" | sed -n "s/.* $1: *\([0-9]*\).*/\1/p"; }
received="$(field rx_received)"
received_ok="$(field rx_received_ok)"
emitted="$(field tx_emitted)"

crc_ok=0
[ "${received:-0}" -gt 0 ] && crc_ok=$(( ${received_ok:-0} * 100 / received ))

# Forwarded over the same window: uplinks the forwarder published after the
# stats line before this one.
forwarded="$(echo "${log}" | awk '
    /Publishing stats event/ { prev = count; count = 0; next }
    /Sending uplink event/   { count++ }
    END { print prev + 0 }')"

# A running total, for the LED daemon. The interval counts reset every 30s, so
# each stats line is added once, keyed on its log timestamp.
mkdir -p "${STATE_DIR}"
if [ "$1" = "--record" ] && [ -n "${stats}" ]; then
    stamp="$(echo "${stats}" | awk '{print $1, $2, $3, $4, $5}')"
    last="$(cat "${STATE_DIR}/stats-stamp" 2>/dev/null)"
    if [ "${stamp}" != "${last}" ]; then
        total=$(( $(cat "${COUNTER}" 2>/dev/null || echo 0) + ${received:-0} ))
        echo "${total}" > "${COUNTER}"
        echo "${stamp}" > "${STATE_DIR}/stats-stamp"
    fi
fi

# "Nothing for two hours" is actionable, "1183" is not.
last_seen="$(echo "${log}" | grep -a 'Frame received' | tail -n1 | awk '{print $1, $2, $3, $4, $5}')"

printf '{"rx_received":%s,"rx_forwarded":%s,"tx_emitted":%s,"crc_ok_percent":%s,"total_received":%s,"last_uplink":"%s"}\n' \
    "${received:-0}" "${forwarded:-0}" "${emitted:-0}" "${crc_ok}" \
    "$(cat "${COUNTER}" 2>/dev/null || echo 0)" "${last_seen}"
