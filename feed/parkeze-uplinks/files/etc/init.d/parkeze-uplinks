#!/bin/sh /etc/rc.common
#
# The uplink tracker: see /usr/sbin/parkeze-uplinks. Its first act is to set
# the metrics, which a sysupgrade's uci-defaults put back to the stock 10 and
# 20 before this runs.

START=95
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /usr/sbin/parkeze-uplinks run
    procd_set_param respawn 60 10 0
    procd_close_instance
}

reload_service() {
    /usr/sbin/parkeze-uplinks apply
}
