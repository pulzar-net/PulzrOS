#!/bin/sh
#
# The uplink order and tracking, left as they are on a re-run: a sysupgrade
# keeps the order somebody chose at the gateway.

# OpenWrt's prepare_rootfs runs every uci-defaults script during image
# assembly, with IPKG_INSTROOT set. The build host's network is not this
# gateway's.
[ -n "${IPKG_INSTROOT}" ] && exit 0

if [ -z "$(uci -q get parkeze.uplinks)" ]; then
    uci -q batch <<EOT
set parkeze.uplinks=uplinks
add_list parkeze.uplinks.track='wan'
add_list parkeze.uplinks.track_ip='1.1.1.1'
add_list parkeze.uplinks.track_ip='8.8.8.8'
set parkeze.uplinks.interval='10'
set parkeze.uplinks.down='3'
set parkeze.uplinks.up='3'
EOT
    uci commit parkeze
fi

/etc/init.d/parkeze-uplinks enable
exit 0
