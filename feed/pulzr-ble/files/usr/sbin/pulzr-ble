#!/bin/sh
#
# Bluetooth on this gateway, as pulzr-edge-ble.
#
#   pulzr-ble state    on, off, or absent -- one word, for the facts report
#   pulzr-ble attach   power the chip and attach it as hci0; nothing if it is there
#   pulzr-ble run      attach, write the config and exec pulzr-edge-ble (procd runs this)
#
# pulzr-edge-ble owns the whole controller over the HCI user channel: it scans
# passively and sends each beacon whose MAC starts with one of pulzr.ble.oui
# as its own device, ble:<EUI-64>, in Pulzr protocol v1 (at most one up per
# beacon per pulzr.ble.interval), and answers GATT and advertising intents.
# Pulzr Net decodes the advertising data with the device type's codec, so a
# new beacon model is a codec there and never a firmware change here.
#
# Only beacons with one of the prefixes are sent: a car park is full of phones
# and watches, and none of them is ours to upload.

. /etc/pulzr/board.conf

log() { logger -t pulzr-ble -p daemon.info "$*"; }

enabled() { [ "$(uci -q get pulzr.ble.enabled)" = 1 ]; }

# A radio this build can drive: the board's own, or a dongle btusb attached.
radio() {
    [ -n "${PULZR_BT}" ] && return 0
    ls /sys/class/bluetooth/hci* >/dev/null 2>&1
}

state() {
    if ! radio; then echo absent
    elif enabled; then echo on
    else echo off
    fi
}

# The chip's enable line, high. Through sysfs because it is on the firmware's
# GPIO expander, whose number depends on the order the chips registered in.
power() {
    [ -n "${PULZR_BT_POWER}" ] || return 0
    local label="${PULZR_BT_POWER%:*}" line="${PULZR_BT_POWER##*:}" chip gpio
    for chip in /sys/class/gpio/gpiochip*; do
        [ "$(cat "${chip}/label" 2>/dev/null)" = "${label}" ] || continue
        gpio=$(( $(cat "${chip}/base") + line ))
        [ -d "/sys/class/gpio/gpio${gpio}" ] || echo "${gpio}" > /sys/class/gpio/export
        echo out > "/sys/class/gpio/gpio${gpio}/direction"
        # Low first: a chip left powered by a previous attempt answers at the
        # baud rate that attempt set, and hciattach starts at 115200.
        echo 0 > "/sys/class/gpio/gpio${gpio}/value"; sleep 1
        echo 1 > "/sys/class/gpio/gpio${gpio}/value"; sleep 1
        return 0
    done
    log "no gpiochip labelled ${label}; the chip may be held in reset"
    return 0
}

# A UART chip (a Pi's) is attached from userspace: OpenWrt's hci_uart has H4
# but not Broadcom's protocol, so the kernel cannot bring it up on its own. A
# dongle needs nothing; btusb attached it.
attach() {
    if [ ! -e /sys/class/bluetooth/hci0 ] && [ "${PULZR_BT}" = uart ]; then
        [ -e "${PULZR_BT_UART}" ] || {
            # The wiring is applied at boot; turned on since, it waits for one.
            log "${PULZR_BT_UART} is not a tty yet; Bluetooth needs a reboot"
            return 1
        }
        power
        # -t: a chip that does not answer must not hold this forever.
        hciattach -t 15 "${PULZR_BT_UART}" "${PULZR_BT_CHIP}" "${PULZR_BT_BAUD}" noflow \
            >/dev/null 2>&1 || { log "hciattach failed on ${PULZR_BT_UART}"; return 1; }
    fi
    [ -e /sys/class/bluetooth/hci0 ] || { log "no Bluetooth controller"; return 1; }
}

# The config is generated at every start, from the gateway's broker login and
# pulzr.ble (/usr/libexec/pulzr/edge-config, in pulzr-probe).
run() {
    local cfg=/var/run/pulzr-edge/ble.toml top
    enabled || exit 0
    . /usr/libexec/pulzr/edge-config
    top="$(edge_common)" || { log "not adopted yet"; exit 1; }
    attach || exit 1
    # The user channel needs hci0 down; hciattach leaves it up. Without
    # hciconfig (no bluez-utils), pulzr-edge-ble waits for the kernel's own
    # power-off after setup.
    command -v hciconfig >/dev/null && hciconfig hci0 down
    (umask 077; { printf '%s\n\n' "${top}"; edge_ble; } > "${cfg}")
    exec /usr/sbin/pulzr-edge-ble ble "${cfg}"
}

case "$1" in
    state)  state ;;
    attach) attach ;;
    run)    run ;;
    *)      echo "usage: pulzr-ble state|attach|run" >&2; exit 2 ;;
esac
