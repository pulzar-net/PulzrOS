#!/bin/sh /etc/rc.common
#
# Bluetooth, as pulzr-edge-ble. Not started at all while Bluetooth is off,
# which it is on every gateway until somebody turns it on, or before the
# gateway has broker credentials to publish with. Respawned: a controller or
# a broker connection that drops comes back on its own (pulzr-edge-ble also
# buffers to disk meanwhile).
#
# START=97, after the MQTT agent (96): same credentials, same reason to wait.

START=97
STOP=10

USE_PROCD=1

start_service() {
    [ "$(uci -q get pulzr.ble.enabled)" = 1 ] || return 0
    [ "$(uci -q get pulzr.adoption.state)" = "adopted" ] || return 0
    [ -n "$(uci -q get pulzr.mqtt.host)" ] && \
        [ -n "$(uci -q get pulzr.mqtt.username)" ] || return 0

    procd_open_instance
    procd_set_param command /usr/sbin/pulzr-ble run
    procd_set_param respawn 60 10 0
    procd_set_param stderr 1
    procd_close_instance
}
