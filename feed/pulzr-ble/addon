# What makes this package an add-on (docs/addons.md). One capability, with
# its own pulzr-edge binary (pulzr-edge-ble). ADDON_FEATURE: the console's
# Bluetooth page and /api/bluetooth, there while this is installed.
ADDON_TITLE="Bluetooth"
ADDON_CAPS="ble"
ADDON_FEATURE="bluetooth"
ADDON_BOARDS="*"
ADDON_UPSTREAM="pulzr-edge"
