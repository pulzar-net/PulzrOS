#!/usr/bin/ucode
// The gateway's resolver, which is also its LAN's: dnsmasq.
//
//   pulzr-dns status                         JSON: upstream, hosts, rebind
//   pulzr-dns upstream auto | <ip>...        the uplink's servers, or these
//   pulzr-dns host <name> <ip>               a name the LAN resolves
//   pulzr-dns unhost <name>
//   pulzr-dns rebind on|off [<domain>...]    and the domains allowed to
//                                              answer with a private address
//   pulzr-dns ddns <name> <zone> <uplink>    keep <name> on this site's
//   pulzr-dns ddns off                       address, on Cloudflare
//   pulzr-dns ddns-token                     the API token, on stdin
//
// ── WHAT A NAME MAY NOT BE ─────────────────────────────────────────────────
//
// Nothing under a Pulzr domain. A LAN client whose policy is parkeze may
// reach exactly the addresses dnsmasq has answered for Pulzr's names
// (pulzr_dst, 25-pulzr-lan), so a local name for net.parkeze.com would
// be a way to give that client any address on the internet. Nor a
// reservation's name, which pulzr-lan already serves for that client.
//
// ── UPSTREAM SERVERS ───────────────────────────────────────────────────────
//
// Auto is whatever each uplink's lease or bearer handed out, which is what
// dnsmasq reads from resolv.conf.auto. Servers named here replace those on
// every uplink (noresolv), as GL.iNet's manual DNS does. A list where no
// server answers for Pulzr's MQTT host is refused: the gateway resolves
// through dnsmasq too, and a resolver that answers nothing is a gateway
// Pulzr Cloud cannot reach until somebody drives out to it.
//
// Servers dnsmasq is told for one domain (`/domain/ip`) are left alone; only
// plain addresses are this page's.
//
// ── REBIND PROTECTION ──────────────────────────────────────────────────────
//
// On by default, as OpenWrt ships it: an answer from upstream with a private
// address is dropped, which stops a web page in a LAN client's browser from
// naming the client's own network. A site with an internal DNS zone needs
// that zone listed, or turns it off.
//
// ── DYNAMIC DNS ────────────────────────────────────────────────────────────
//
// The customer's own name, in their own Cloudflare zone, kept on the address
// the site's internet has: for ports exposed on the uplinks (pulzr-lan),
// reached through the site router's forward. Pulzr hosts no name and holds no
// account for it; the token is theirs, scoped to their zone.
//
// ddns-scripts does the work (service `pulzr` in UCI ddns). The address is
// asked of the web, because behind a site router the uplink's own address is
// a private one, and both that question and the update leave on the uplink
// named here (bind_network): never cellular, where the answer would be the
// carrier's address, and never the tunnel.
//
// The token goes in on stdin, so it is never on a command line, and
// /etc/config/ddns is root's alone. `status` says whether one is set and nothing more: it is
// what the MQTT agent's `dns` op sends Pulzr Cloud.
//
// Everything else is in UCI dhcp, and `status` is what the MQTT agent's `dns`
// op sends Pulzr Cloud, so a server set at the gateway is one Pulzr Cloud sees.

let fs = require('fs');
let uci = require('uci');

const RESOLV = '/tmp/resolv.conf.d/resolv.conf.auto';
const BOARD = '/etc/pulzr/board.conf';
const MAX_SERVERS = 3;
const MAX_HOSTS = 64;
const MAX_DOMAINS = 16;
const IPV4 = /^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$/;
// One label, checked a label at a time with the length apart: a {0,61}
// inside a repeated group is a large automaton for musl's TRE to build on
// every call, for a rule this states plainly.
const LABEL = /^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?$/;
const DDNS = 'pulzr';
const DDNS_CONFIG = '/etc/config/ddns';
const DDNS_RUN = '/var/run/ddns/';
const DDNS_LOG = '/var/log/ddns/';
// A Cloudflare API token: 40 characters today, of these.
const TOKEN = /^[A-Za-z0-9_-]{20,128}$/;

let cursor = uci.cursor();

let die = (msg, code) => {
    warn(msg, '\n');
    exit(code ?? 1);
};

let log = (msg) => system(['logger', '-t', 'dns', '-p', 'daemon.notice', msg]);

let ipv4 = (ip) => {
    let m = match(ip ?? '', IPV4);
    if (!m) return false;
    for (let i = 1; i <= 4; i++) if (int(m[i]) > 255) return false;
    return true;
};

let hostname = (name) => {
    if (type(name) != 'string' || length(name) < 1 || length(name) > 253) return false;
    for (let label in split(name, '.'))
        if (length(label) > 63 || !match(label, LABEL)) return false;
    return true;
};

let list = (v) => type(v) == 'array' ? v : (v != null ? [v] : []);

// dnsmasq's one section, by name: it is anonymous in the stock config.
let section = () => {
    let name = null;
    cursor.foreach('dhcp', 'dnsmasq', (s) => { name ??= s['.name']; });
    return name ?? die('no dnsmasq section in /etc/config/dhcp');
};

let board = (key) => {
    let m = match(fs.readfile(BOARD) ?? '', regexp('(^|\n)' + key + '="?([^"\n]*)"?'));
    return m ? m[2] : null;
};

let hostOf = (url) => {
    let h = replace(url ?? '', /^[a-z]+:\/\//, '');
    return split(split(h, '/')[0], ':')[0];
};

// The registrable domain of each Pulzr endpoint, as 25-pulzr-lan works
// it out for the pulzr_dst set.
let pulzrDomains = () => uniq(filter(map([hostOf(board('PULZR_NET_URL')), board('PULZR_MQTT_HOST')], (h) => {
    let parts = split(lc(h ?? ''), '.');
    return length(parts) >= 2 ? join('.', slice(parts, -2)) : null;
}), (d) => d));

let pulzrName = (name) => {
    name = lc(name);
    for (let d in pulzrDomains())
        if (name == d || substr(name, -length(d) - 1) == '.' + d) return d;
    return null;
};

let fromUplinks = () => {
    let out = [];
    for (let line in split(fs.readfile(RESOLV) ?? '', '\n')) {
        let m = match(line, /^nameserver[ \t]+([^ \t]+)/);
        if (m && !(m[1] in out)) push(out, m[1]);
    }
    return out;
};

let reload = () => system('/etc/init.d/dnsmasq reload >/dev/null 2>&1', 30000);

// A section name is letters, digits and underscores, and a name has no
// underscore, so this is one-to-one: a-b and a.b stay two names.
let hostSection = (name) => 'dns_' + replace(replace(lc(name), /-/g, '_h'), /\./g, '_d');

// The uplinks a name may follow: wired (wan, wan_<device>, pulzr-ports)
// and WiFi. Not cellular.
let ddnsUplinks = () => {
    let out = [];
    cursor.foreach('network', 'interface', (i) => {
        let n = i['.name'];
        if ((n == 'wan' || index(n, 'wan_') == 0 || n == 'wwifi' || n == 'wwifi2') && i.disabled != '1') push(out, n);
    });
    return sort(out);
};

let ddnsStatus = () => {
    let s = cursor.get_all('ddns', DDNS);
    if (!s) return { enabled: false, uplinks: ddnsUplinks() };
    let address = trim(fs.readfile(DDNS_RUN + DDNS + '.ip') ?? '') || null;
    // ddns-scripts keeps the uptime of the last update, not the time.
    let since = int(trim(fs.readfile(DDNS_RUN + DDNS + '.update') ?? '0'));
    let uptime = int(split(fs.readfile('/proc/uptime') ?? '0', ' ')[0]);
    let updated = since > 0 && uptime >= since ? time() - (uptime - since) : null;
    // The last thing ddns-scripts gave up on, while nothing has been
    // registered: once an address is, an old error is history.
    let error = null;
    if (!address)
        for (let line in split(fs.readfile(DDNS_LOG + DDNS + '.log') ?? '', '\n')) {
            let m = match(line, /ERROR *: *(.*)$/);
            if (m) error = trim(m[1]);
        }
    let at = index(s.domain ?? '', '@');
    return {
        enabled: s.enabled == '1',
        name: s.lookup_host ?? null,
        zone: at >= 0 ? substr(s.domain, at + 1) : null,
        uplink: s.bind_network ?? null,
        tokenSet: length(s.password ?? '') > 0,
        address, updated, error,
        uplinks: ddnsUplinks(),
    };
};

let ddnsCommit = () => {
    cursor.commit('ddns');
    system(['chmod', '600', DDNS_CONFIG]);
    system('/etc/init.d/ddns enable >/dev/null 2>&1; /etc/init.d/ddns restart >/dev/null 2>&1', 30000);
};

let status = () => {
    let s = section();
    let servers = filter(list(cursor.get('dhcp', s, 'server')), ipv4);
    let custom = cursor.get('dhcp', s, 'noresolv') == '1' && length(servers) > 0;
    let hosts = [];
    cursor.foreach('dhcp', 'domain', (d) => {
        if (index(d['.name'], 'dns_') == 0 && d.name && d.ip)
            push(hosts, { name: d.name, ip: d.ip });
    });
    return {
        upstream: {
            mode: custom ? 'custom' : 'auto',
            servers: custom ? servers : fromUplinks(),
        },
        hosts: sort(hosts, (a, b) => a.name < b.name ? -1 : 1),
        rebind: {
            protection: cursor.get('dhcp', s, 'rebind_protection') != '0',
            allowed: list(cursor.get('dhcp', s, 'rebind_domain')),
        },
        ddns: ddnsStatus(),
    };
};

let commands = {
    status: () => printf('%J\n', status()),

    upstream: (...servers) => {
        let s = section();
        let keep = filter(list(cursor.get('dhcp', s, 'server')), (v) => !ipv4(v));
        if (length(servers) == 1 && servers[0] == 'auto') {
            length(keep) ? cursor.set('dhcp', s, 'server', keep) : cursor.delete('dhcp', s, 'server');
            cursor.delete('dhcp', s, 'noresolv');
        } else {
            (length(servers) >= 1 && length(servers) <= MAX_SERVERS)
                || die(sprintf('one to %d servers, or auto', MAX_SERVERS), 2);
            for (let ip in servers) ipv4(ip) || die(sprintf('%s is not an IPv4 address', ip), 2);
            length(uniq(servers)) == length(servers) || die('a server is named twice', 2);
            let probe = board('PULZR_MQTT_HOST') ?? 'mqtt.parkeze.com';
            let answered = false;
            for (let ip in servers)
                if (!answered && system(sprintf("nslookup '%s' '%s' >/dev/null 2>&1", probe, ip), 10000) == 0)
                    answered = true;
            answered || die(sprintf('no answer from %s for %s', join(' or ', servers), probe), 3);
            cursor.set('dhcp', s, 'server', [...servers, ...keep]);
            cursor.set('dhcp', s, 'noresolv', '1');
        }
        cursor.commit('dhcp');
        reload();
        log('upstream ' + join(' ', servers));
        printf('%J\n', status().upstream);
    },

    host: (name, ip) => {
        hostname(name) || die('a name is letters, digits, hyphens and dots', 2);
        ipv4(ip) || die(sprintf('%s is not an IPv4 address', ip ?? ''), 2);
        let theirs = pulzrName(name);
        theirs && die(sprintf('names under %s are Pulzr\'s', theirs), 2);
        let reserved = false;
        cursor.foreach('dhcp', 'host', (h) => {
            if (lc(h.name ?? '') == lc(name)) reserved = true;
        });
        reserved && die(sprintf('%s is a reservation\'s name', name), 3);
        let id = hostSection(name), count = 0;
        cursor.foreach('dhcp', 'domain', (d) => {
            if (index(d['.name'], 'dns_') == 0 && d['.name'] != id) count++;
        });
        count < MAX_HOSTS || die(sprintf('at most %d names', MAX_HOSTS), 3);
        cursor.set('dhcp', id, 'domain');
        cursor.set('dhcp', id, 'name', name);
        cursor.set('dhcp', id, 'ip', ip);
        cursor.commit('dhcp');
        reload();
        log(sprintf('host %s %s', name, ip));
        printf('%J\n', { name, ip });
    },

    unhost: (name) => {
        hostname(name) || die('a name is letters, digits, hyphens and dots', 2);
        let id = hostSection(name);
        cursor.get('dhcp', id) == 'domain' || die(sprintf('no name %s', name), 3);
        cursor.delete('dhcp', id);
        cursor.commit('dhcp');
        reload();
        log(sprintf('host %s removed', name));
        printf('%J\n', { name, ip: null });
    },

    rebind: (on, ...domains) => {
        (on == 'on' || on == 'off') || die('on or off', 2);
        length(domains) <= MAX_DOMAINS || die(sprintf('at most %d domains', MAX_DOMAINS), 2);
        for (let d in domains) hostname(d) || die(sprintf('%s is not a domain', d), 2);
        let s = section();
        cursor.set('dhcp', s, 'rebind_protection', on == 'on' ? '1' : '0');
        length(domains) ? cursor.set('dhcp', s, 'rebind_domain', uniq(domains))
                        : cursor.delete('dhcp', s, 'rebind_domain');
        cursor.commit('dhcp');
        reload();
        log(sprintf('rebind protection %s%s', on, length(domains) ? ', allowing ' + join(' ', domains) : ''));
        printf('%J\n', status().rebind);
    },
};

commands.ddns = (name, zone, uplink) => {
    fs.access(DDNS_CONFIG) || die('ddns-scripts is not on this gateway');
    if (name == 'off') {
        cursor.get('ddns', DDNS) || die('no dynamic DNS is set', 3);
        cursor.set('ddns', DDNS, 'enabled', '0');
        ddnsCommit();
        log('ddns off');
        return printf('%J\n', ddnsStatus());
    }
    name = lc(name ?? ''); zone = lc(zone ?? '');
    hostname(name) || die('a name is letters, digits, hyphens and dots', 2);
    (hostname(zone) && index(zone, '.') > 0) || die('a zone is a domain, like example.com', 2);
    (name == zone || substr(name, -length(zone) - 1) == '.' + zone) || die(sprintf('%s is not in %s', name, zone), 2);
    let theirs = pulzrName(zone);
    theirs && die(sprintf('names under %s are Pulzr\'s', theirs), 2);
    (uplink in ddnsUplinks()) || die('the uplink is a wired one or the WiFi', 2);
    length(cursor.get('ddns', DDNS, 'password') ?? '') || die('set the API token first', 3);

    // Cloudflare's script takes host@zone, and @zone for the zone's own name.
    let host = name == zone ? '' : substr(name, 0, length(name) - length(zone) - 1);
    let set = {
        enabled: '1', service_name: 'cloudflare.com-v4', lookup_host: name, domain: host + '@' + zone,
        username: 'Bearer', use_ipv6: '0', force_ipversion: '1', interface: uplink, bind_network: uplink,
        // Cloudflare's own echo, the provider the customer already chose. It
        // lists the address after the host, which holds no IPv4 address.
        ip_source: 'web', ip_url: 'https://www.cloudflare.com/cdn-cgi/trace',
        use_https: '1', cacert: '/etc/ssl/certs', check_interval: '5', check_unit: 'minutes',
        force_interval: '24', force_unit: 'hours', retry_interval: '60', retry_unit: 'seconds',
    };
    cursor.get('ddns', DDNS) || cursor.set('ddns', DDNS, 'service');
    for (let k in keys(set)) cursor.set('ddns', DDNS, k, set[k]);
    // curl, for --interface: the update and the address question both leave
    // on the uplink named, and Cloudflare's script needs curl anyway.
    cursor.get('ddns', 'global') && cursor.set('ddns', 'global', 'use_curl', '1');
    ddnsCommit();
    log(sprintf('ddns %s on %s', name, uplink));
    printf('%J\n', ddnsStatus());
};

// On stdin, so a token is never in a process listing.
commands['ddns-token'] = () => {
    fs.access(DDNS_CONFIG) || die('ddns-scripts is not on this gateway');
    let token = trim(fs.stdin.read('all') ?? '');
    match(token, TOKEN) || die('that is not a Cloudflare API token', 2);
    if (!cursor.get('ddns', DDNS)) {
        cursor.set('ddns', DDNS, 'service');
        cursor.set('ddns', DDNS, 'enabled', '0');
    }
    cursor.set('ddns', DDNS, 'password', token);
    ddnsCommit();
    log('ddns token set');
    printf('%J\n', { tokenSet: true });
};

let cmd = commands[ARGV[0] ?? 'status'];
cmd ?? die('usage: pulzr-dns {status|upstream|host|unhost|rebind|ddns|ddns-token}', 2);
call(cmd, null, null, ...slice(ARGV, 1));
// A change Pulzr Cloud would otherwise have to ask for (pulzr-mqtt-agent
// --push). A refused change died above and sends nothing.
if ((ARGV[0] ?? 'status') != 'status')
    system('( /usr/sbin/pulzr-mqtt-agent --push dns >/dev/null 2>&1 & ) 2>/dev/null');
