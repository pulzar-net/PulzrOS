# <package arch> <Depends, comma-separated or ->
#
# The MIPS binaries are dynamically linked against musl, libgcc and libstdc++.
# The aarch64 ones are static. The three Pi architectures are the same binary:
# apk matches the architecture name exactly, so each needs its own package.
# libgcc and libstdcpp without their ABI suffixes: apk resolves those through
# what libgcc1 and libstdcpp6 provide, and the release's index.json, which
# check-deps.sh reads, lists them only by that name.
mipsel_24kc          libgcc,libstdcpp
aarch64_cortex-a53   -
aarch64_cortex-a72   -
aarch64_cortex-a76   -
