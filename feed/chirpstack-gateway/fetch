#!/usr/bin/env bash
#
# Put ChirpStack's gateway binaries for one architecture into a package root.
#
#   fetch <package-arch> <dest-root> <cache-dir>
#
# Built from source, never taken from anyone's image: build/build.sh compiles
# ChirpStack Concentratord and the MQTT Forwarder from their pinned release
# sources (build/versions), against the SX1302 HAL in pulzar-net/sx1302_hal --
# ChirpStack's fork with the MT7628's half-duplex SPI as a build option -- as
# static musl binaries, so the package depends on nothing.
#
# A build is identified by build/key. CI's "LoRa stack" job builds every
# target once per key and hands them to the feed build in
# CHIRPSTACK_BUILT_DIR; without that (a local build) this builds the one it
# needs, which takes Docker, rustup and cross.

set -euo pipefail

ARCH="${1:?arch}" DEST="${2:?dest}" CACHE="${3:?cache}"
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

case "${ARCH}" in
  aarch64_*)   TARGET=aarch64-unknown-linux-musl ;;
  mipsel_24kc) TARGET=mipsel-unknown-linux-musl ;;
  mips_24kc)   TARGET=mips-unknown-linux-musl ;;
  *) echo "no ChirpStack build for ${ARCH}" >&2; exit 1 ;;
esac

built="${CHIRPSTACK_BUILT_DIR:-${CACHE}/chirpstack-$("${HERE}/build/key")}"
if [ ! -x "${built}/chirpstack-mqtt-forwarder-${TARGET}" ]; then
  "${HERE}/build/build.sh" "${TARGET}" "${built}"
fi

mkdir -p "${DEST}/usr/bin"
for bin in chirpstack-concentratord-sx1302 chirpstack-concentratord-sx1301 chirpstack-mqtt-forwarder; do
  [ -f "${built}/${bin}-${TARGET}" ] || continue
  install -m 0755 "${built}/${bin}-${TARGET}" "${DEST}/usr/bin/${bin}"
done
[ -x "${DEST}/usr/bin/chirpstack-concentratord-sx1302" ] \
  || { echo "no concentratord for ${TARGET} in ${built}" >&2; exit 1; }
