# The image concentratord is cross-built in: cross-rs's for the target, with
# the HALs built into its sysroot where concentratord's libloragw crates look
# for them. From chirpstack-concentratord's own cross/Dockerfile.* (MIT), with
# every source pinned by sha256 and the SX1302 HAL from pulzar-net/sx1302_hal
# (SPI_HALF_DUPLEX=1 for the MT7628, whose SPI cannot read while it writes).
ARG BASE
FROM ${BASE}

ARG MUSL_PREFIX
ARG HAL_ARCH
ARG SPI_HALF_DUPLEX=0
ARG SX1302_HAL_REPO
ARG SX1302_HAL_VERSION
ARG SX1302_HAL_SHA256
ARG SX1301_HAL_VERSION
ARG SX1301_HAL_SHA256

RUN apt-get update && \
    apt-get --assume-yes install protobuf-compiler libprotobuf-dev curl && \
    rm -rf /var/lib/apt/lists/*

# get <url> <sha256> <dir>: a tarball, checked, unpacked into dir.
RUN printf '%s\n' '#!/bin/sh' 'set -eu' \
      'curl -fsSL --retry 3 -o /tmp/src.tgz "$1"' \
      'echo "$2  /tmp/src.tgz" | sha256sum -c -' \
      'mkdir -p "$3" && tar -xzf /tmp/src.tgz -C "$3" --strip-components=1 && rm /tmp/src.tgz' \
      > /usr/local/bin/get && chmod +x /usr/local/bin/get

RUN get "https://codeload.github.com/brocaar/lora_gateway/tar.gz/${SX1301_HAL_VERSION}" \
        "${SX1301_HAL_SHA256}" /hal/lora_gateway && \
    cd /hal/lora_gateway && \
    sed -i "s/CFLAGS :=.*/CFLAGS := -O2 -Wall -Wextra -std=c99 -Iinc -I. -fPIC/g" libloragw/Makefile && \
    ARCH=${HAL_ARCH} CROSS_COMPILE=${MUSL_PREFIX}- make && \
    ln -s /hal/lora_gateway/libloragw/inc /usr/local/${MUSL_PREFIX}/include/libloragw-sx1301 && \
    ln -s /hal/lora_gateway/libloragw/libloragw.a /usr/local/${MUSL_PREFIX}/lib/libloragw-sx1301.a

RUN get "https://codeload.github.com/${SX1302_HAL_REPO}/tar.gz/${SX1302_HAL_VERSION}" \
        "${SX1302_HAL_SHA256}" /hal/sx1302_hal && \
    cd /hal/sx1302_hal && \
    sed -i "s/CFLAGS :=.*/CFLAGS := -O2 -Wall -Wextra -std=c99 -Iinc -I. -I..\/libtools\/inc -fPIC/g" libloragw/Makefile && \
    sed -i "s/CFLAGS :=.*/CFLAGS := -O2 -Wall -Wextra -std=c99 -Iinc -I. -fPIC/g" libtools/Makefile && \
    ARCH=${HAL_ARCH} CROSS_COMPILE=${MUSL_PREFIX}- make libloragw SPI_HALF_DUPLEX=${SPI_HALF_DUPLEX} && \
    ln -s /hal/sx1302_hal/libloragw/inc /usr/local/${MUSL_PREFIX}/include/libloragw-sx1302 && \
    ln -s /hal/sx1302_hal/libloragw/libloragw.a /usr/local/${MUSL_PREFIX}/lib/libloragw-sx1302.a && \
    cp /hal/sx1302_hal/libtools/inc/* /usr/local/${MUSL_PREFIX}/include && \
    cp /hal/sx1302_hal/libtools/*.a /usr/local/${MUSL_PREFIX}/lib

# libstdc++ where concentratord's .cargo/config.toml links it from, statically.
RUN mkdir -p /usr/local/${MUSL_PREFIX}-target/lib && \
    cp /usr/local/${MUSL_PREFIX}/lib/libstdc++* /usr/local/${MUSL_PREFIX}-target/lib
