#!/bin/sh /etc/rc.common
#
# The setup AP watchdog.
#
# Started late: it asks whether the backhaul is up, and doing that before the
# network has settled just means the first check reports a fault that is
# really "not up yet". The first poll is one interval in for that reason.

START=99
STOP=05
USE_PROCD=1

boot() {
    # Whatever was up before the reboot. Its window and its markers were in
    # /var/run and are gone, so an AP left in the config would otherwise stand
    # with nothing to take it down, and a station held for it would stay off.
    # Compat: the wireless section ids parkeze_sta and parkeze_ap are kept from ParkezeOS; a gateway
    # upgraded or rolled back keeps its saved WiFi only if both images agree on them.
    if [ -n "$(uci -q get wireless.parkeze_ap)" ] || [ -e /etc/pulzr/ap/sta-held ]; then
        /usr/sbin/pulzr-ap down >/dev/null 2>&1
    fi

    # On a gateway that has never been adopted, raise the AP straight away
    # rather than waiting out the fallback timer. There is nothing to protect
    # yet and somebody is very likely standing there with a phone, trying to
    # claim it — see docs/src/content/docs/provisioning.md.
    if [ "$(uci -q get pulzr.adoption.state)" != "adopted" ] \
       && [ "$(uci -q get pulzr.ap.enabled)" != "0" ] \
       && [ "$(uci -q get pulzr.ap.onboarding)" != "0" ]; then
        /usr/sbin/pulzr-ap up 0 >/dev/null 2>&1
    fi
    start
}

start_service() {
    procd_open_instance ap
    procd_set_param command /usr/sbin/pulzr-ap-watchdog
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param respawn 60 10 0
    procd_close_instance
}

stop_service() {
    /usr/sbin/pulzr-ap down >/dev/null 2>&1
}

service_triggers() {
    procd_add_config_trigger "config.change" "pulzr" /etc/init.d/pulzr-ap restart
}
