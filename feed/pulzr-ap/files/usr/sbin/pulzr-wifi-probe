#!/bin/sh
#
# Ask a WPA2-Enterprise network which certificate its RADIUS server presents,
# without sending it a password.
#
#   pulzr-wifi-probe      reads /tmp/pulzr-wifi-probe.req, runs the probe,
#                           writes /tmp/pulzr-wifi-probe.json
#
# ── WHY A GATEWAY HAS TO BE SHOWN THE CERTIFICATE ──────────────────────────
#
# On eduroam and every network like it, the password is the user's own
# account password, and it goes to whatever RADIUS server answers. A phone
# asks "trust this certificate?" the first time because the alternative is
# handing that password to anybody running an access point with the same
# name. A gateway that joined without checking would do exactly that, every
# time it reconnected, unattended, for years.
#
# So the console shows the technician the certificate first, and the join
# pins it (ca_cert="hash://server/sha256/..."): from then on the gateway talks
# only to that server.
#
# ── HOW ────────────────────────────────────────────────────────────────────
#
# wpa_supplicant has a mode for exactly this. With ca_cert="probe://" it runs
# EAP far enough to receive the server's certificate chain, reports each
# certificate, and fails the handshake — before phase 2, so no password is
# ever sent. The reports go to syslog (wpad runs wpa_supplicant with -s) as
#
#   CTRL-EVENT-EAP-PEER-CERT depth=0 subject='/CN=radius.example.edu' hash=<sha256>
#
# and this reads them back. The station section is borrowed for the probe and
# the previous wireless configuration put back afterwards, so a gateway
# already on a working WiFi uplink returns to it.
#
# Run in the background by the console: bringing the station up and waiting
# for RADIUS takes longer than a request should be held, and on a single-radio
# board the reload drops the setup AP the caller may be connected through.

REQ=/tmp/pulzr-wifi-probe.req
OUT=/tmp/pulzr-wifi-probe.json
SNAP=/tmp/pulzr-wifi-probe.wireless
LOCK=/var/run/pulzr-wifi-probe.pid
WAIT=30

. /usr/share/libubox/jshn.sh

emit() {
    json_init
    json_add_string state "$1"
    json_add_string ssid "${ssid}"
    [ -n "$2" ] && json_add_string error "$2"
    json_add_array chain
    old_ifs="${IFS}"
    # A subject can contain '*'; the unquoted expansion below must not glob.
    set -f
    IFS='
'
    for line in ${chain}; do
        IFS="${old_ifs}"
        depth="${line%%|*}"; rest="${line#*|}"
        hash="${rest%%|*}"; subject="${rest#*|}"
        json_add_object ""
        json_add_int depth "${depth}"
        json_add_string subject "${subject}"
        json_add_string hash "${hash}"
        json_close_object
        IFS='
'
    done
    IFS="${old_ifs}"
    set +f
    json_close_array
    json_dump > "${OUT}.tmp" && mv "${OUT}.tmp" "${OUT}"
}

restore() {
    if [ -s "${SNAP}" ]; then
        uci -q import wireless < "${SNAP}"
        rm -f "${SNAP}"
    fi
    if [ "${made_network}" = 1 ]; then
        uci -q delete network.wwifi
        uci -q commit network
        ubus call network reload >/dev/null 2>&1
    fi
    wifi reload >/dev/null 2>&1
    rm -f "${LOCK}"
}

if [ -f "${LOCK}" ] && kill -0 "$(cat "${LOCK}")" 2>/dev/null; then
    exit 0
fi
echo $$ > "${LOCK}"

ssid="$(jsonfilter -i "${REQ}" -e '@.ssid' 2>/dev/null)"
method="$(jsonfilter -i "${REQ}" -e '@.method' 2>/dev/null)"
outer="$(jsonfilter -i "${REQ}" -e '@.identity' 2>/dev/null)"
rm -f "${REQ}"
chain=""

case "${method}" in peap|ttls) ;; *) method=peap ;; esac
if [ -z "${ssid}" ] || [ -z "${outer}" ]; then
    emit failed 'Give the network name and a username.'
    rm -f "${LOCK}"
    exit 1
fi

radio="$(uci -q show wireless | sed -n 's/^wireless\.\([^.]*\)=wifi-device$/\1/p' | head -n1)"
if [ -z "${radio}" ]; then
    emit failed 'This board has no WiFi radio.'
    rm -f "${LOCK}"
    exit 1
fi

emit probing
uci -q export wireless > "${SNAP}"

# A station needs an interface to belong to before netifd will start it. The
# probe never gets as far as an address, so a bare DHCP interface outside any
# firewall zone is enough, and it is removed again afterwards.
made_network=0
if [ -z "$(uci -q get network.wwifi)" ]; then
    made_network=1
    uci -q set network.wwifi=interface
    uci -q set network.wwifi.proto=dhcp
    uci -q commit network
    ubus call network reload >/dev/null 2>&1
fi

uci -q batch <<EOF
set wireless.pulzr_sta=wifi-iface
set wireless.pulzr_sta.device=${radio}
set wireless.pulzr_sta.mode=sta
set wireless.pulzr_sta.network=wwifi
set wireless.pulzr_sta.disabled=0
set wireless.${radio}.disabled=0
delete wireless.pulzr_sta.key
EOF
# Values with spaces or quotes in them go through uci set one by one, not the
# batch above, which would split them.
uci -q set wireless.pulzr_sta.ssid="${ssid}"
uci -q set wireless.pulzr_sta.encryption=wpa2
uci -q set wireless.pulzr_sta.eap_type="${method}"
uci -q set wireless.pulzr_sta.identity="${outer}"
uci -q set wireless.pulzr_sta.password=probe
uci -q set wireless.pulzr_sta.ca_cert='probe://'
uci -q commit wireless

nonce="$$-$(date +%s)"
logger -t pulzr-wifi-probe "start ${nonce}"
wifi reload >/dev/null 2>&1

# The chain arrives together, depth highest first, then the handshake fails
# and wpa_supplicant tries again a few seconds later and reports it again.
# Done once depth 0 has been seen and one more second has passed for the
# rest of the chain to land.
seen_leaf=0
i=0
while [ "${i}" -lt "${WAIT}" ]; do
    sleep 1
    i=$((i + 1))
    lines="$(logread | sed -n "/start ${nonce}/,\$p" \
        | sed -n "s/.*CTRL-EVENT-EAP-PEER-CERT depth=\([0-9]*\) subject='\(.*\)' hash=\([0-9a-f]\{64\}\).*/\1|\3|\2/p" \
        | sort -t'|' -k1,1n -u)"
    if [ -n "${lines}" ]; then
        chain="${lines}"
        case "${chain}" in 0\|*) seen_leaf=$((seen_leaf + 1)) ;; esac
        [ "${seen_leaf}" -ge 2 ] && break
    fi
done

if [ -n "${chain}" ]; then
    emit 'done'
else
    emit failed "No certificate from ${ssid}. Check the name and that the gateway is in range."
fi
restore
# The console's failure reader (lib/wififail.uc) skips everything between
# start and end: these handshakes fail on purpose.
logger -t pulzr-wifi-probe "end ${nonce}"
exit 0
