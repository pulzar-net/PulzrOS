#!/bin/sh /etc/rc.common
#
# The management channel. Respawned, because a broker that goes away must not
# take the gateway's manageability with it permanently — and on a cellular
# gateway this is often the cheapest way in.
#
# START=96, after pulzr-claim (95), which is what obtains the credentials
# this needs. A gateway that has just been adopted should not have to wait for
# a reboot before it can be managed: pulzr-adopt restarts this the moment the
# credentials land.

START=96
STOP=10

USE_PROCD=1

start_service() {
    # Not started at all until there is something to listen with.
    #
    # This used to start unconditionally and lean on procd's respawn to notice
    # when credentials arrived: the agent exited saying so, and was relaunched
    # five seconds later, forever. On an unadopted gateway that was one log
    # line every five seconds — 359 of the 553 lines logread held on a
    # RAK7289CV2 half an hour after boot, with the boot log already pushed out.
    # A gateway waiting days at a site for somebody to adopt it had a log made
    # of nothing else.
    [ "$(uci -q get pulzr.adoption.state)" = "adopted" ] || return 0
    [ -n "$(uci -q get pulzr.mqtt.host)" ] && \
        [ -n "$(uci -q get pulzr.mqtt.username)" ] || return 0

    procd_open_instance
    procd_set_param command /usr/sbin/pulzr-mqtt-agent
    procd_set_param respawn 30 5 0
    procd_set_param stderr 1
    procd_close_instance
}

service_triggers() {
    # Credentials can change after adoption, and a re-adoption replaces them.
    procd_add_config_trigger "config.change" "pulzr" /etc/init.d/pulzr-mqtt-agent restart
}
