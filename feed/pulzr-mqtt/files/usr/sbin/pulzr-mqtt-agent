#!/bin/sh
#
# Manage this gateway over MQTT, so that reading its state does not mean
# loading its web console.
#
#   pulzr-mqtt-agent                  listen for requests until killed
#   pulzr-mqtt-agent --once           answer nothing; print what `status` would say
#   pulzr-mqtt-agent --publish-state  publish the retained state again and exit
#   pulzr-mqtt-agent --push lan|uplinks|dns
#                                     publish what changed without being asked
#
# ── WHY ────────────────────────────────────────────────────────────────────
#
# The console is a React app: a document, a stylesheet, and a JS bundle that
# is a quarter of a megabyte before its route chunks. Opening it to read one
# number costs that every time, and on a metered SIM behind a 250ms link it is
# both slow and billed. Most of what anybody opens it for is a handful of
# facts the gateway already knows and could simply have said.
#
# So: one request, one JSON answer, on a connection the gateway is holding
# anyway. A few hundred bytes instead of a few hundred kilobytes.
#
# ── THE TOPICS ─────────────────────────────────────────────────────────────
#
#   parkeze/gateway/<eui>/mgmt/request    Pulzar Cloud asks; we subscribe
#   parkeze/gateway/<eui>/mgmt/response   we answer; Pulzar Cloud subscribes
#   parkeze/gateway/<eui>/mgmt/state      retained, published once at start
#
# Deliberately outside the region prefix. `us915_0/gateway/<eui>/...` belongs
# to ChirpStack and the packet forwarder holds a subscription across it;
# putting management traffic in there would mean two things reading one
# namespace and a downlink topic that sometimes is not one.
#
# The grant is asymmetric, and mqtt-authorizer enforces it: this gateway may
# subscribe to its own request topic and publish to its own response and state
# topics. It may not publish requests, and it may not read another gateway's
# anything.
#
# ── WHAT IT WILL DO, AND WHAT IT WILL NEVER DO ─────────────────────────────
#
# Every operation is named in the case below and every one of them runs a
# fixed command. There is deliberately no "run this" — a remote channel that
# executes what it is handed is a root shell with no audit trail and no way to
# reason about what a compromised broker could do. Adding an operation here is
# a firmware change, which is the point: the set of things that can be done to
# a gateway remotely should be reviewable in one place.
#
# Arguments are validated before use and never interpolated into a command
# line. The LAN operations hand theirs to pulzr-lan as separate arguments,
# and it refuses anything that is not a MAC, an address on its LAN, a port or
# a number of seconds.
#
# ── COST ───────────────────────────────────────────────────────────────────
#
# This holds a second TLS session to the broker, alongside the packet
# forwarder's. That is not free on a SIM, so the keepalive is long: the agent
# has nothing to say most of the time and an idle minute costs nothing worth
# saving. Responses are capped, because "tail the log" over cellular is how a
# convenience becomes a bill.

. /etc/pulzr/board.conf

# Compat: the topic root is a wire contract with the broker's ACLs and the cloud's
# subscriptions, and keeps its ParkezeOS spelling.
TOPIC_ROOT="parkeze/gateway"
STATE_DIR=/var/run/pulzr/mqtt
# 60s, not 300s. Every ping is billed and this channel is idle almost always,
# which argued for a long interval — but the interval is also how long the
# gateway stays unmanageable after its backhaul changes underneath it, and
# that is the moment you most want to reach it.
#
# Measured by pulling the ethernet on a RAK on a bench. The packet forwarder,
# which keeps a 30s keepalive, was back on the SIM in twelve seconds. This
# agent held a dead TCP session until the broker reaped it and did not
# reconnect for six minutes.
#
# A ping is a two-byte packet. At 60s that is roughly 1440 a day, which
# against a 1NCE plan is noise, and it buys back five minutes of blindness
# every time a gateway fails over.
KEEPALIVE="${PULZR_MQTT_KEEPALIVE:-60}"
# A response is meant to be a handful of facts. Anything larger is either a
# mistake or a log somebody should be pulling over the tunnel instead.
MAX_RESPONSE=8192

log() { logger -t mqtt-agent -p daemon.info "$*"; }

eui()      { uci -q get pulzr.identity.gateway_eui; }
host()     { uci -q get pulzr.mqtt.host; }
username() { uci -q get pulzr.mqtt.username; }
password() { uci -q get pulzr.mqtt.password; }

# `mosquitto_pub -m` would put the payload on a command line, where a quote in
# it is a syntax error and a backtick is worse. -f reads a file, which has no
# such problem and no length limit either.
publish() {
    local topic="$1" file="$2" retain="$3"
    mosquitto_pub -h "$(host)" -p 8883 --capath /etc/ssl/certs \
        -u "$(username)" -P "$(password)" \
        -t "${topic}" -f "${file}" -q 1 ${retain:+-r} >/dev/null 2>&1
}

# ── the operations ──────────────────────────────────────────────────────────
#
# Each prints JSON on stdout. Anything that is not valid JSON is wrapped by
# the caller, so a script that fails prints an error rather than corrupting
# the response.

op_status() {
    printf '{"eui":"%s","version":"%s","build":"%s","uptime":%s,"adopted":"%s"}' \
        "$(eui)" "${PULZR_VERSION:-unknown}" "${PULZR_BUILD:-unknown}" \
        "$(cut -d. -f1 /proc/uptime 2>/dev/null || echo 0)" \
        "$(uci -q get pulzr.adoption.state || echo unknown)"
}

op_lorawan() {
    printf '{"status":"%s","slots":%s,"present":%s,"channels":%s,"region":"%s","forwarder":"%s"}' \
        "$(uci -q get pulzr.concentrator.status || echo unknown)" \
        "$(uci -q get pulzr.concentrator.slots || echo 0)" \
        "$(uci -q get pulzr.concentrator.present || echo 0)" \
        "$(uci -q get pulzr.concentrator.channels || echo 0)" \
        "$(uci -q get pulzr.lorawan.region || echo unknown)" \
        "$(/etc/init.d/pulzr-packet-forwarder running >/dev/null 2>&1 && echo running || echo stopped)"
}

op_backhaul()  { /usr/sbin/pulzr-lora-route status 2>/dev/null || echo '{}'; }
op_storage()   { printf '{"present":"%s","device":"%s","freeMb":"%s","writable":"%s"}' \
                     "$(uci -q get pulzr.storage.present || echo 0)" \
                     "$(uci -q get pulzr.storage.device)" \
                     "$(uci -q get pulzr.storage.free_mb || echo 0)" \
                     "$(uci -q get pulzr.storage.writable || echo 0)"; }
op_firmware()  { /usr/sbin/pulzr-firmware status 2>/dev/null || echo '{}'; }
op_cellular()  { /usr/sbin/pulzr-modem-detect --status 2>/dev/null || echo '{}'; }
op_gps()       { /usr/sbin/pulzr-gps status 2>/dev/null || echo '{}'; }
op_lan()       { /usr/sbin/pulzr-lan status 2>/dev/null || echo '{}'; }
op_dns()       { /usr/sbin/pulzr-dns status 2>/dev/null || echo '{}'; }
op_uplinks()   { /usr/sbin/pulzr-uplinks status 2>/dev/null || echo '{}'; }
op_ports()     { /usr/sbin/pulzr-ports status 2>/dev/null || echo '{}'; }
op_speedtest() { /usr/sbin/pulzr-speedtest brief 2>/dev/null || echo '{"error":"this gateway does not run speed tests"}'; }
op_addons()    { /usr/sbin/pulzr-addon status --brief 2>/dev/null || echo '{"error":"this gateway has no add-ons"}'; }
# Pulzar changed a device driver this gateway runs, or one of its devices:
# pull them now rather than before the next command (pulzr-drivers).
op_drivers() {
    [ -x /usr/sbin/pulzr-drivers ] || { echo '{"error":"this gateway runs no drivers"}'; return 0; }
    /usr/sbin/pulzr-drivers sync 2>/dev/null
}
# What pulzr-probe last found, not a new scan: hotplug keeps the file current,
# and a scan may probe a port, which is not what a read should do.
op_radios()    { cat /var/run/pulzr-probe/radios.json 2>/dev/null || echo '{"detected":[]}'; }

# A field of the request being answered, for the operations that take more
# than one argument.
field() { jsonfilter -i "${STATE_DIR}/request.json" -e "@.$1" 2>/dev/null; }

# The Thread border router (pulzr-thread add-on), read only: the platform
# sets Thread up through the console API over gateway-link, as a person's
# session, because a dataset carries the network key and this channel's
# far side is a broker that is not the place for one.
op_thread() {
    [ -x /usr/sbin/pulzr-thread ] || { echo null; return 0; }
    /usr/sbin/pulzr-thread status --brief 2>/dev/null || echo null
}

# pulzr-radios prints the radios as JSON, or an error on stderr, which
# becomes the error object, as lan's does.
radio() {
    [ -x /usr/sbin/pulzr-radios ] || { echo '{"error":"this gateway cannot detect radios"}'; return 1; }
    local out
    if out="$(/usr/sbin/pulzr-radios "$@" 2>&1)"; then
        echo "${out}"
    else
        printf '{"error":"%s"}' "$(echo "${out}" | tail -n1 | tr -d '"\\')"
        return 1
    fi
}

# A LAN change: pulzr-lan prints the result as JSON, or an error on stderr,
# which becomes the error object.
lan() {
    [ -x /usr/sbin/pulzr-lan ] || { echo '{"error":"this gateway has no LAN ports"}'; return 1; }
    local out
    if out="$(/usr/sbin/pulzr-lan "$@" 2>&1)"; then
        echo "${out}"
    else
        printf '{"error":"%s"}' "$(echo "${out}" | head -n1 | tr -d '"\\')"
        return 1
    fi
}
# The daemon's last record, not a read of the bus: the port has one owner, and
# a request from here must not become a second master on it.
op_rak_power() { /usr/sbin/pulzr-rak-power status 2>/dev/null || echo '{"error":"this gateway has no RAK power board"}'; }

# ── dispatch ────────────────────────────────────────────────────────────────

# Runs one operation and prints its JSON result, or an error object. Nothing
# from the request reaches a command line: `op` selects a branch, it is never
# executed.
# Run one operation with a ceiling on how long it may take.
#
# There is no `timeout` applet in this build — pulzr-gps-detect learned the
# same thing and grew its own bounded_read for it.
#
# Without a ceiling, one slow probe takes the whole management channel with
# it. The read loop is sequential, so a call that never returns means every
# later request goes unanswered forever. Measured on a RAK: op_cellular's
# mmcli call hung, and from that moment the agent answered nothing — not even
# a plain status — while the gateway itself stayed perfectly healthy and kept
# forwarding. The channel you would reach for to find out why is the one that
# is gone.
#
# A timeout returns a JSON error rather than nothing, so that `all` — which
# composes seven of these into one document — stays valid JSON when one probe
# is wedged, instead of collapsing into "the gateway produced an unreadable
# answer" and telling you nothing about which part failed.
bounded() {
    local seconds="$1"; shift
    # Its own file: the catch-up push runs ops beside the request loop, and
    # both are this shell's $$.
    local out; out="$(mktemp "${STATE_DIR}/op.XXXXXX")" || out="${STATE_DIR}/op.$$"
    ( "$@" > "${out}" 2>/dev/null ) &
    local pid=$! waited=0 killed=0
    while kill -0 "${pid}" 2>/dev/null; do
        if [ "${waited}" -ge "${seconds}" ]; then
            kill -TERM "${pid}" 2>/dev/null
            sleep 1
            kill -KILL "${pid}" 2>/dev/null
            killed=1
            break
        fi
        sleep 1
        waited=$((waited + 1))
    done
    wait "${pid}" 2>/dev/null
    if [ "${killed}" = 1 ] || [ ! -s "${out}" ]; then
        rm -f "${out}"
        printf '{"error":"%s timed out"}' "$1"
        return 0
    fi
    cat "${out}"
    rm -f "${out}"
}

dispatch() {
    local op="$1" arg="$2" out

    case "${op}" in
        status)    out="$(bounded 10 op_status)" ;;
        lorawan)   out="$(bounded 15 op_lorawan)" ;;
        backhaul)  out="$(bounded 15 op_backhaul)" ;;
        storage)   out="$(bounded 15 op_storage)" ;;
        firmware)  out="$(bounded 15 op_firmware)" ;;
        # 20s: this one shells out to mmcli, which is the call that hung.
        cellular)  out="$(bounded 20 op_cellular)" ;;
        gps)       out="$(bounded 20 op_gps)" ;;
        # Leases, reservations, policies and each client's traffic per uplink,
        # and the forwards open now and recently. Not part of `all`: it grows
        # with the number of devices, and one busy LAN would take `all` past
        # MAX_RESPONSE.
        lan)       out="$(bounded 15 op_lan)" ;;
        # What the site set at the gateway, read back the way lan is: the
        # resolver's upstream servers, local names and rebind protection, and
        # the uplink order with each uplink's tracked state. Read-only; the
        # settings are the site's.
        dns)       out="$(bounded 10 op_dns)" ;;
        uplinks)   out="$(bounded 10 op_uplinks)" ;;
        # What each port is for and its VLANs (pulzr-ports), read back the
        # same way: set at the gateway, reported here.
        ports)     out="$(bounded 10 op_ports)" ;;
        # The last thirty speed tests, short: the whole history does not fit
        # MAX_RESPONSE, and the latest of each is on every report anyway.
        speedtest) out="$(bounded 10 op_speedtest)" ;;
        rak-power) out="$(bounded 10 op_rak_power)" ;;
        # What is wanted, refused and installed, as the report carries it. A
        # read only: an install takes minutes and this loop answers one
        # request at a time, so installs and removals go through the console
        # API over gateway-link, where a person's session names who asked.
        addons)    out="$(bounded 10 op_addons)" ;;
        drivers)   out="$(bounded 45 op_drivers)" ;;
        radios)    out="$(bounded 5 op_radios)" ;;

        # A person's decisions about a radio, from the gateway page: Identify
        # probes a serial adapter nobody could name, and "This is a Modbus
        # adapter" hands one to the Modbus module and stops it ever being
        # probed. pulzr-radios checks the id again; the answer is the radios.
        radio-identify)
            out="$(bounded 70 radio identify "$(field radio)")" || { echo "${out}"; return 1; } ;;
        radio-assign)
            out="$(bounded 15 radio assign "$(field radio)" "$(field use)")" || { echo "${out}"; return 1; } ;;

        thread)    out="$(bounded 15 op_thread)" ;;

        # Everything at once, for the case this exists to serve: somebody
        # wanting to know how a gateway is without opening anything.
        all)
            out="$(printf '{"system":%s,"lorawan":%s,"backhaul":%s,"storage":%s,"firmware":%s,"cellular":%s,"addons":%s,"radios":%s,"thread":%s}' \
                   "$(bounded 10 op_status)" "$(bounded 15 op_lorawan)" \
                   "$(bounded 15 op_backhaul)" "$(bounded 15 op_storage)" \
                   "$(bounded 15 op_firmware)" "$(bounded 20 op_cellular)" \
                   "$(bounded 10 op_addons)" "$(bounded 5 op_radios)" "$(bounded 15 op_thread)")" ;;

        restart-forwarder)
            /etc/init.d/pulzr-packet-forwarder restart >/dev/null 2>&1
            out='{"restarted":true}' ;;

        detect-concentrator)
            /usr/sbin/pulzr-concentrator-detect >/dev/null 2>&1
            out="$(op_lorawan)" ;;

        detect-gps)
            /usr/sbin/pulzr-gps-detect >/dev/null 2>&1
            out="$(op_gps)" ;;

        # The only operation that takes an argument, and it is a boolean.
        # Validated to exactly 0 or 1 before it goes anywhere near uci.
        set-lora-cellular)
            case "${arg}" in
                true|1)  value=1 ;;
                false|0) value=0 ;;
                *) echo '{"error":"allow must be true or false"}'; return 1 ;;
            esac
            uci -q set pulzr.lorawan.allow_cellular="${value}"
            uci commit pulzr
            /usr/sbin/pulzr-lora-route apply >/dev/null 2>&1
            out="$(op_backhaul)" ;;

        # The one forward a gateway makes: from the management tunnel to one
        # LAN client's TCP port, until it expires or is closed. The answer
        # names the tunnel port it is reached on. See pulzr-lan.
        lan-forward)
            out="$(lan forward "$(field ip)" "$(field port)" "$(field seconds)" "${id}")" || { echo "${out}"; return 1; } ;;
        lan-unforward)
            out="$(lan unforward "$(field port)" "${id}")" || { echo "${out}"; return 1; } ;;
        lan-policy)
            out="$(lan policy "$(field mac)" "$(field policy)")" || { echo "${out}"; return 1; } ;;
        # A reservation, or with no ip, the end of one.
        lan-reserve)
            name="$(field name)"
            if [ -z "$(field ip)" ]; then
                out="$(lan unreserve "$(field mac)")"
            elif [ -n "${name}" ]; then
                out="$(lan reserve "$(field mac)" "$(field ip)" "${name}")"
            else
                out="$(lan reserve "$(field mac)" "$(field ip)")"
            fi || { echo "${out}"; return 1; } ;;
        # Another subnet on the LAN bridge, or with remove true, the end of one.
        # `for` a device's address: the gateway picks its own in that subnet.
        lan-address)
            if [ -n "$(field for)" ]; then
                out="$(lan address for "$(field for)")"
            elif [ "$(field remove)" = "true" ]; then
                out="$(lan address remove "$(field address)")"
            else
                out="$(lan address add "$(field address)")"
            fi || { echo "${out}"; return 1; } ;;

        # Last, and deliberately plain. A reboot takes the gateway away for a
        # couple of minutes; it is here because the alternative is a truck.
        reboot)
            log "reboot requested over MQTT"
            ( sleep 2; reboot ) >/dev/null 2>&1 &
            out='{"rebooting":true}' ;;

        *)
            echo "{\"error\":\"no such operation\"}"
            return 1 ;;
    esac

    # A script that printed nothing, or printed something that is not JSON,
    # must not become a malformed response — the envelope has to stay
    # parseable whatever happened inside it.
    #
    # And it must not be reported as a success. The platform decides whether a
    # command worked from `ok`, so an unreadable answer returning 0 would be
    # handed back to a caller as though the gateway had agreed to something.
    [ -n "${out}" ] || out='{}'
    if ! echo "${out}" | jsonfilter -e '@' >/dev/null 2>&1; then
        echo '{"error":"the gateway produced an unreadable answer"}'
        return 1
    fi
    echo "${out}"
}

# ── pushed, not asked for ───────────────────────────────────────────────────
#
# Pulzar Cloud used to ask every gateway with a LAN for its LAN, uplinks and
# DNS every five minutes (net-api lan-paths), which on a SIM is a request and
# an answer for nothing most of the time. They are pushed instead, when they
# change:
#
#   lan       after a DHCP lease is added, changes or expires
#             (hotplug.d/dhcp/60-pulzr-lan-push in pulzr-lan)
#   uplinks   after pulzr-uplinks changes the order or the tracking
#   dns       after pulzr-dns changes the resolver
#   (all three after pulzr-apply puts a configuration back, and each time
#    this agent connects, since a change made while it was away was sent
#    nowhere)
#
# Each is the same document the op answers with, so a missed one heals at the
# next. On the response topic, unsolicited, with id "push": it is the one this
# gateway may publish on besides its retained state, and anything that asks
# requests drops an answer whose id it did not send. Tunnel and broker byte
# counts are not pushed: the WireGuard hub and the broker already hold them.
push() {
    local kind="$1" result="$2" file="${STATE_DIR}/push.$1.$$"
    [ -s "${STATE_DIR}/backoff" ] && return 0
    [ "${#result}" -le "${MAX_RESPONSE}" ] || { log "push ${kind}: too large to send"; return 1; }
    printf '{"id":"push","ok":true,"push":"%s","at":%s,"result":%s}' "${kind}" "$(date +%s)" "${result}" > "${file}"
    publish "${TOPIC_ROOT}/$(eui)/mgmt/response" "${file}"
    rm -f "${file}"
}

# The catch-up after a connect: whichever of the three this gateway has, as
# one message a line through one mosquitto_pub, so one TLS session, not three.
push_all() {
    local file="${STATE_DIR}/push.all.$$" kind out at
    : > "${file}"
    at="$(date +%s)"
    for kind in lan uplinks dns; do
        [ -x "/usr/sbin/pulzr-${kind}" ] || continue
        out="$(bounded 15 "op_${kind}" | tr -d '\n')"
        [ "${#out}" -le "${MAX_RESPONSE}" ] || { log "push ${kind}: too large to send"; continue; }
        printf '{"id":"push","ok":true,"push":"%s","at":%s,"result":%s}\n' "${kind}" "${at}" "${out}" >> "${file}"
    done
    [ -s "${file}" ] && mosquitto_pub -h "$(host)" -p 8883 --capath /etc/ssl/certs \
        -u "$(username)" -P "$(password)" \
        -t "${TOPIC_ROOT}/$(eui)/mgmt/response" -l -q 1 < "${file}" >/dev/null 2>&1
    rm -f "${file}"
}

# ── the loop ────────────────────────────────────────────────────────────────

if [ "$1" = "--once" ]; then
    dispatch all ""
    exit 0
fi

[ -n "$(eui)" ] && [ -n "$(host)" ] && [ -n "$(username)" ] || {
    log "not adopted, or no broker credentials — nothing to listen on"
    exit 1
}

mkdir -p "${STATE_DIR}"

# A radio plugged in or pulled out (pulzr-radios): the retained state again,
# so whoever reads it later sees what is plugged in now. Not while the broker
# is refusing this gateway, for the reason the start-up publish below gives.
if [ "$1" = "--publish-state" ]; then
    [ -s "${STATE_DIR}/backoff" ] && exit 0
    dispatch all "" > "${STATE_DIR}/state.json.$$"
    publish "${TOPIC_ROOT}/$(eui)/mgmt/state" "${STATE_DIR}/state.json.$$" retain
    rm -f "${STATE_DIR}/state.json.$$"
    exit 0
fi

if [ "$1" = "--push" ]; then
    case "$2" in
        lan)     [ -x /usr/sbin/pulzr-lan ] || exit 0; push lan "$(bounded 15 op_lan)" ;;
        uplinks) [ -x /usr/sbin/pulzr-uplinks ] || exit 0; push uplinks "$(bounded 10 op_uplinks)" ;;
        dns)     [ -x /usr/sbin/pulzr-dns ] || exit 0; push dns "$(bounded 10 op_dns)" ;;
        *) echo "usage: pulzr-mqtt-agent --push lan|uplinks|dns" >&2; exit 2 ;;
    esac
    exit $?
fi

REQUEST="${TOPIC_ROOT}/$(eui)/mgmt/request"
RESPONSE="${TOPIC_ROOT}/$(eui)/mgmt/response"

# ── backing off when the broker will not have us ────────────────────────────
#
# procd respawns this every five seconds. That is right for a broker that has
# gone away for a moment and wrong for one that is refusing us: a gateway
# whose ACL does not grant the management topics — the state every gateway is
# in until the authorizer is deployed — would otherwise open a TLS connection,
# collect a full status, publish a retained message and be denied, twenty
# times a minute, for as long as it is powered on. On a metered SIM that is a
# data plan spent on being told no.
#
# So a subscription that dies almost immediately is treated as a refusal and
# slept off, doubling up to five minutes. One that lasts is a real session,
# and the count resets. procd still supervises; this only decides how quickly
# it is allowed to try again.
BACKOFF_FILE="${STATE_DIR}/backoff"
FAST_FAILURE=10
BACKOFF_MAX=300

backoff_seconds() {
    local n; n="$(cat "${BACKOFF_FILE}" 2>/dev/null)"
    case "${n}" in ''|*[!0-9]*) n=0 ;; esac
    n=$((n + 1)); [ "${n}" -gt 6 ] && n=6
    echo "${n}" > "${BACKOFF_FILE}"
    local s=15; local i=1
    while [ "${i}" -lt "${n}" ]; do
        s=$((s * 2)); [ "${s}" -ge "${BACKOFF_MAX}" ] && { s="${BACKOFF_MAX}"; break; }
        i=$((i + 1))
    done
    echo "${s}"
}

# Retained, so a platform that subscribes later gets the gateway's state
# without having to ask. Published once at startup rather than on a timer:
# the forwarder already sends stats every thirty seconds, and a second
# periodic publisher on the same SIM is chatter nobody asked for.
#
# Skipped entirely while backing off. The state has not changed since the last
# attempt fifteen seconds ago, and collecting it costs a run of every status
# command on the gateway.
if [ ! -s "${BACKOFF_FILE}" ]; then
    dispatch all "" > "${STATE_DIR}/state.json"
    publish "${TOPIC_ROOT}/$(eui)/mgmt/state" "${STATE_DIR}/state.json" retain
fi

log "listening on ${REQUEST}"
STARTED="$(date +%s)"


# One JSON document per message, one message per line.
#
# No -N. It does not mean what its name suggests and what this comment used
# to claim: `mosquitto_sub --help` says "do not add an end of line character
# when printing the payload". With it, nothing this subscription received ever
# ended in a newline, so `read` below blocked forever and the agent processed
# exactly zero commands — while connecting, subscribing and acknowledging
# every one of them, so it looked healthy from the broker and from the fleet
# view alike.
#
# Measured: EMQX reported send_msg=1 inflight=0 for the agent's client — the
# request delivered and acked — with recv_msg=0 and not one dispatch line in
# the gateway's log.
#
# The topic prefix it was supposed to be suppressing is only printed when -v
# is passed, which it is not.
mosquitto_sub -h "$(host)" -p 8883 --capath /etc/ssl/certs \
    -u "$(username)" -P "$(password)" \
    -t "${REQUEST}" -q 1 -k "${KEEPALIVE}" 2>/dev/null |
while IFS= read -r line; do
    [ -n "${line}" ] || continue

    printf '%s' "${line}" > "${STATE_DIR}/request.json"
    id="$(jsonfilter -i "${STATE_DIR}/request.json" -e '@.id' 2>/dev/null)"
    op="$(jsonfilter -i "${STATE_DIR}/request.json" -e '@.op' 2>/dev/null)"
    arg="$(jsonfilter -i "${STATE_DIR}/request.json" -e '@.allow' 2>/dev/null)"

    # An id that is not ours to choose still ends up in a document we
    # generate, so it is reduced to something that cannot break it.
    id="$(printf '%s' "${id}" | tr -cd 'A-Za-z0-9._-' | cut -c1-64)"
    [ -n "${id}" ] || id="unknown"

    if result="$(dispatch "${op}" "${arg}")"; then ok=true; else ok=false; fi

    # Capped. A response is a handful of facts; anything larger is a mistake
    # this should not put on a metered link.
    if [ "${#result}" -gt "${MAX_RESPONSE}" ]; then
        result='{"error":"the answer was too large to send"}'
        ok=false
    fi

    printf '{"id":"%s","ok":%s,"result":%s}' "${id}" "${ok}" "${result}" \
        > "${STATE_DIR}/response.json"
    publish "${RESPONSE}" "${STATE_DIR}/response.json"
    log "${op:-?} -> ${ok}"
done &
SUBSCRIPTION=$!

# The catch-up push (push_all), once the subscription has outlived the time in
# which a refusal ends it: a broker that will not have this gateway is not
# sent three documents per attempt.
( sleep "${FAST_FAILURE}"; kill -0 "${SUBSCRIPTION}" 2>/dev/null && push_all ) &

# Backgrounded and waited on, with the pipeline killed on the way out.
#
# procd stops this by signalling its one pid, the shell. Run in the foreground,
# the pipeline survived that: ash does not run a trap while it waits on a
# foreground pipeline, and nothing else signals mosquitto_sub or the read loop.
# Every restart left the previous subscription connected, so a gateway that
# had been restarted once answered every management request twice. `wait` is
# interruptible, so the trap runs, and both halves are this shell's children.
trap 'kill $(pgrep -P $$) 2>/dev/null; exit 0' TERM INT
wait "${SUBSCRIPTION}"

# How long it lasted is the only signal available for why it ended:
# mosquitto_sub's stderr is discarded (it would otherwise log a line per
# reconnect) and it exits 0 on a clean denial just as it does on a broker
# restart.
LASTED=$(( $(date +%s) - STARTED ))
if [ "${LASTED}" -lt "${FAST_FAILURE}" ]; then
    WAIT="$(backoff_seconds)"
    log "subscription refused after ${LASTED}s — retrying in ${WAIT}s"
    sleep "${WAIT}"
else
    rm -f "${BACKOFF_FILE}"
    log "subscription ended after ${LASTED}s"
fi
