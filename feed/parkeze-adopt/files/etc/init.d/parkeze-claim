#!/bin/sh /etc/rc.common
#
# Poll parkeze.net for "has somebody claimed this gateway yet".
#
# Runs only while unadopted, and stops itself the moment adoption completes.
#
# ── THE BACKOFF, AND WHY IT IS SHAPED LIKE THIS ────────────────────────────
#
# An installer powers a gateway on, scans the code, and expects the thing to
# come up while they are still standing there. So the first few minutes are
# polled hard — every 5 seconds — because that is the window where a human is
# waiting and latency is the whole experience.
#
# After that nobody is watching. A gateway that sat in a warehouse for three
# weeks before anybody scanned it must not have spent those three weeks
# hitting our API every five seconds, and on a cellular unit it must not have
# spent them burning the SIM's allowance either. So the interval opens out to
# an hour and stays there.
#
#   0–2 min      every 5s     somebody is standing in front of it
#   2–15 min     every 30s    they wandered off to get a ladder
#   15–60 min    every 5 min
#   after that   every hour   it is in a box somewhere

START=95
STOP=10
USE_PROCD=1

start_service() {
    [ "$(uci -q get parkeze.adoption.state)" = "adopted" ] && return 0

    procd_open_instance claim
    procd_set_param command /usr/sbin/parkeze-claim-loop
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param respawn 60 10 0
    procd_close_instance
}

service_triggers() {
    # Poll immediately when an uplink appears rather than waiting out the
    # current backoff: a gateway that has just been plugged into ethernet
    # should not sit for an hour before noticing it can reach us.
    procd_add_reload_interface_trigger wan
    procd_add_reload_interface_trigger wwan
    procd_add_reload_interface_trigger usbwan
    procd_add_config_trigger "config.change" "parkeze" /etc/init.d/parkeze-claim restart
}
