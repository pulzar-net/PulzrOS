#!/bin/sh
#
# The loop behind /etc/init.d/parkeze-report. Split out for the same reason
# parkeze-claim-loop is: the interval is the interesting part and it should be
# readable without reading procd.

log() { logger -t report -p daemon.info "$*"; }

# Once on start, then every six hours.
#
# Six rather than six minutes because none of this changes often. A gateway's
# model never changes, its console port never changes, and its backhaul changes
# when somebody runs a cable — which is a site visit, not a thing that happens
# between polls. The report exists so the console is not a form somebody typed
# into a year ago, not so it is live telemetry.
#
# It also has to be cheap on a SIM. A cellular-only gateway is billed for every
# one of these, and at six hours it is four small POSTs a day.
INTERVAL=21600

# Not immediately: adoption restarts this service, and the management tunnel is
# enrolling in the same moment. Reporting a tunnel that has not handshaken yet
# as the first thing parkeze.net ever hears is a worse answer than waiting half
# a minute for the real one.
sleep 30

# After parkeze.net says the claim is revoked: asked once more this much later
# before anything is done about it. See parkeze-claim's header.
CONFIRM=60

last=0
while :; do
    if [ "$(uci -q get parkeze.adoption.state)" != "adopted" ]; then
        log "not adopted; reporting stops"
        /etc/init.d/parkeze-report stop >/dev/null 2>&1 &
        exit 0
    fi

    now="$(date +%s)"

    # The claim was revoked and a new one waits to be adopted. Polled here
    # rather than by parkeze-claim's own service, which runs only while
    # unadopted: this gateway is still adopted, still forwarding and still on
    # its tunnel. The old claim is still reported with every six hours, in
    # case parkeze.net accepts it again.
    if parkeze-claim reclaiming >/dev/null 2>&1; then
        if [ "$((now - last))" -ge "${INTERVAL}" ]; then
            last="${now}"
            parkeze-claim report >/dev/null 2>&1 || true
        fi
        parkeze-claim poll >/dev/null 2>&1 || true
        sleep "$(parkeze-claim backoff 2>/dev/null || echo 3600)"
        continue
    fi

    last="${now}"
    parkeze-claim report >/dev/null 2>&1
    if [ "$?" = 3 ]; then
        sleep "${CONFIRM}"
        continue
    fi
    sleep "${INTERVAL}"
done
