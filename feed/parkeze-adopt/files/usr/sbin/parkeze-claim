#!/bin/sh
#
# One-touch provisioning: the device half.
#
#   parkeze-claim status        what state this gateway is in, as JSON
#   parkeze-claim qr [--ascii]  the QR payload, or a terminal QR
#   parkeze-claim register      tell parkeze.net this gateway is waiting
#   parkeze-claim poll          has somebody claimed us? if so, adopt
#   parkeze-claim reset         throw away the claim identity and start over
#   parkeze-claim apply <blob>  complete an adoption offline, from a signed
#                               bundle the operator carried back
#   parkeze-claim report        tell parkeze.net what this gateway is
#   parkeze-claim reclaiming    exit 0 while a new claim waits to replace a
#                               revoked one
#   parkeze-claim backoff       seconds until the waiting claim is polled again
#   parkeze-claim note-revoked  count an answer saying the claim is revoked
#
# ── HOW IT WORKS ───────────────────────────────────────────────────────────
#
# The goal is that installing a gateway is: power it on, scan the code, pick
# the site. No typing, no credentials on the device, no serial cable.
#
#   1. At first boot the gateway mints a claim identity:
#
#        claim_id      public. Goes in the QR. Names this pending claim.
#        claim_secret  private. NEVER leaves the device and is never in the
#                      QR — it is what proves, later, that the thing asking
#                      for the adoption bundle is the gateway somebody
#                      actually scanned and not a bystander who photographed
#                      the screen.
#        commitment    sha256(claim_secret), which is what parkeze.net stores.
#
#   2. If the gateway has internet it registers the claim, and the QR is a
#      short URL: parkeze.net already knows the EUI, the board and the
#      commitment.
#
#      If it does not, the QR carries those inline instead. Slightly longer,
#      still one scan, and it means a gateway in a basement can be claimed
#      from a phone that has signal.
#
#   3. The installer scans, signs in to parkeze.net, and picks an
#      organisation. That marks the claim adopted.
#
#   4. The gateway polls and finds it has been claimed, pulls its bundle —
#      MQTT credentials and the fleet recovery anchor — finishes adoption on
#      its own, and enrols its WireGuard key for the management tunnel.
#      Nobody goes back to the device.
#
# ── WHY THE SECRET MATTERS ─────────────────────────────────────────────────
#
# Without it, the QR alone would be enough to fetch the bundle, and a QR is
# visible to anyone who walks past a rack. With it, seeing the code lets you
# *claim* the gateway into your organisation (which requires a Parkeze login
# and is audited) but not *become* it.
#
# ── WHEN THE CLAIM IS REVOKED ──────────────────────────────────────────────
#
# parkeze.net revokes every claim a gateway was adopted with when it is
# released or adopted again by code. A transfer no longer does: the claim is
# the gateway's identity, and the previous owner has no root to have read the
# secret with. From then on /report and /wireguard/enroll answer
# 404 "No such gateway." and /claim/poll 404 "No such claim.", and nothing the
# old secret can prove will be accepted again.
#
# The gateway does not stop working when that happens. Its LoRa identity and
# its tunnel survive it, so it keeps them, stays adopted, and mints a
# second claim beside the first (next/) for the new owner to adopt. That claim
# is shown wherever the first one was — the console, the terminal UI, the login
# banner, the status LED — and polled on a backoff counted from when it was
# minted, so a reboot does not restart the fast polling. When it is adopted it
# replaces the old one and the bundle it brings is installed as at first
# adoption.
#
# One answer is not enough to start that: a deploy that was rolling, or a
# database that was briefly somewhere else, would otherwise put a claim code
# on every gateway that reported during it. Two, a minute apart, as
# `parkeze-adopt --check` asks. And only the exact answer: the API's generic
# 404 for an unknown route says "Not found", which is a proxy or a deploy, not
# a revocation. One waiting claim at a time; it is registered once, and again
# only if parkeze.net says it has never heard of it.

set -e
# set -e aborts on a failed command substitution in an assignment, and both
# `uci -q get` and jsonfilter exit 1 for a key that simply is not there — the
# normal case for an optional value. Every such read below ends in `|| true`.
# Without it, `report` died on its first run at an unset optional value and
# still looked successful from parkeze.net's side.

# Both overridable so scripts/test-claim.sh can run this against a sandbox.
. "${PARKEZE_BOARD_CONF:-/etc/parkeze/board.conf}"

STATE="${PARKEZE_CLAIM_DIR:-/etc/parkeze/claim}"
# The claim waiting to replace a revoked one. Inside STATE so keep.d carries it
# across an upgrade with the rest.
NEXT="${STATE}/next"
NET_URL="${PARKEZE_NET_URL:-https://app.pulzr.net}"

# How far apart the two revoked answers must be. See the header.
REVOKED_CONFIRM=60

log() { logger -t claim -p daemon.info "$*"; }
die() { echo "$*" >&2; exit 1; }

# ── identity ────────────────────────────────────────────────────────────────

# A claim in DIR: the gateway's own (STATE) or the one replacing it (NEXT).
mint() {
    local dir="${1:-${STATE}}"
    mkdir -p "${dir}"
    chmod 0700 "${dir}"

    # Crockford-ish base32 over random bytes, grouped for reading aloud. The
    # alphabet excludes I, L, O and U — the first three because they are
    # indistinguishable from 1 and 0 in most fonts, and U because it turns up
    # in words nobody wants printed on a device.
    local raw
    raw="$(head -c 16 /dev/urandom | hexdump -ve '1/1 "%02x"')"
    local id=""
    local i=0
    while [ "${i}" -lt 12 ]; do
        local byte alphabet
        byte="$(printf '%d' "0x${raw:$((i * 2)):2}")"
        alphabet="0123456789ABCDEFGHJKMNPQRSTVWXYZ"
        id="${id}$(echo "${alphabet}" | cut -c$((byte % 32 + 1)))"
        i=$((i + 1))
    done
    # 4-4-4, the way a licence key is read out over a phone.
    id="$(echo "${id}" | sed 's/\(....\)\(....\)\(....\)/\1-\2-\3/')"

    head -c 32 /dev/urandom | hexdump -ve '1/1 "%02x"' > "${dir}/secret"
    chmod 0600 "${dir}/secret"
    echo "${id}" > "${dir}/id"
    rm -f "${dir}/registered"
    [ "${dir}" != "${STATE}" ] || echo "pending" > "${STATE}/state"

    log "minted claim ${id}"
}

ensure_identity() {
    [ -s "${STATE}/id" ] && [ -s "${STATE}/secret" ] && return 0
    mint
}

id_in()         { cat "$1/id" 2>/dev/null || true; }
secret_in()     { cat "$1/secret" 2>/dev/null || true; }
commitment_in() { sha256sum "$1/secret" 2>/dev/null | cut -d' ' -f1; }
claim_id()   { id_in "${STATE}"; }
commitment() { commitment_in "${STATE}"; }
registered() { [ -f "${STATE}/registered" ]; }

adopted()    { [ "$(uci -q get parkeze.adoption.state || true)" = "adopted" ]; }
reclaiming() { adopted && [ -s "${NEXT}/id" ] && [ -s "${NEXT}/secret" ]; }

# The claim a person should be shown: the one waiting to replace a revoked
# claim if there is one, this gateway's own otherwise.
shown() {
    if reclaiming; then echo "${NEXT}"; else echo "${STATE}"; fi
}

# ── the QR payload ──────────────────────────────────────────────────────────

payload() {
    ensure_identity
    local dir id eui
    dir="$(shown)"
    id="$(id_in "${dir}")"
    eui="$(uci -q get parkeze.identity.gateway_eui)" || true

    if [ -f "${dir}/registered" ]; then
        # parkeze.net already knows everything about this claim. Short is
        # better: a smaller QR scans from further away and in worse light,
        # which matters when the code is on a screen inside a cabinet.
        echo "${NET_URL}/adopt#${id}"
    else
        # Never reached the internet. Carry what parkeze.net needs to create
        # the pending claim from the scan alone. The commitment is truncated
        # to 24 hex characters — 96 bits, far beyond what a collision attack
        # on a single short-lived claim could use, and it keeps the QR in a
        # version that still scans comfortably.
        printf '%s/adopt#o1.%s.%s.%s.%s\n' \
            "${NET_URL}" "${id}" "${eui}" "$(commitment_in "${dir}" | cut -c1-24)" "${BOARD_ID}"
    fi
}

qr() {
    local data
    data="$(payload)"

    case "${1:-}" in
        --ascii|--utf8)
            command -v qrencode >/dev/null 2>&1 || die "qrencode is not installed"
            # ANSI over UTF8: half-block rendering is compact enough to fit an
            # 80x24 terminal, which a serial console usually is.
            qrencode -t ANSIUTF8 -m 1 -- "${data}"
            echo
            echo "  ${data}"
            ;;
        --svg)
            command -v qrencode >/dev/null 2>&1 || die "qrencode is not installed"
            # For the web console. SVG rather than PNG so it stays crisp on a
            # phone and can be handed back inside a JSON response as text —
            # no binary endpoint, no second request.
            qrencode -t SVG -m 1 -o - -- "${data}"
            ;;
        *)
            echo "${data}"
            ;;
    esac
}

# ── talking to parkeze.net ──────────────────────────────────────────────────

# Whether the last attempt to reach parkeze.net worked.
#
# WHY NOT parkeze-backhaul-check
#
# That script answers "can this gateway be MANAGED", and it answers it
# correctly: it asks whether the WireGuard tunnel has a recent handshake,
# because the tunnel is what we manage over. Before adoption there is no
# tunnel — no key has been enrolled yet — so the answer is false, and on a board with no modem the
# cellular fallback is false too. Every unadopted gateway therefore read as
# offline, including one that had just registered its claim over the very link
# being reported as down. The claim screen showed "No internet" to an installer
# standing in front of a working gateway.
#
# The honest answer for this state is not a probe at all. This script talks to
# parkeze.net every few seconds while it waits to be claimed, and each of those
# attempts is a definitive statement about reachability that has already been
# paid for. So it is recorded rather than re-measured, which also keeps the
# budget rule intact: no extra bytes on a metered SIM to learn something we
# just found out for free.

REACHED="${STATE}/reached"

# Two hours. The poll interval opens out to an hour once nobody is watching, so
# a shorter window would report a gateway offline merely for being patient. It
# bounds how stale the answer can be after somebody pulls the cable: false for
# up to two hours rather than false forever, which is the trade the previous
# behaviour got backwards.
REACHED_MAX_AGE=7200

mark_reached() {
    mkdir -p "${STATE}"
    date +%s > "${REACHED}" 2>/dev/null || true
}

mark_unreached() {
    rm -f "${REACHED}"
}

reached_recently() {
    local when now
    when="$(cat "${REACHED}" 2>/dev/null)" || return 1
    case "${when}" in ''|*[!0-9]*) return 1 ;; esac
    now="$(date +%s)"
    [ "$((now - when))" -lt "${REACHED_MAX_AGE}" ]
}

# What parkeze.net answers when the claim in a request no longer proves this
# gateway: released, adopted again by code, or decommissioned. Matched on the sentence as
# well as the status, because a 404 alone is also what a proxy in front of a
# half-deployed API says ("Not found").
revoked_answer() {
    [ "$1" = "404" ] || return 1
    [ "$(printf '%s' "$2" | jsonfilter -e '@.error' 2>/dev/null || true)" = "$3" ]
}

# POST a JSON body. Prints the response body, then the status on a line of its
# own; non-zero only when there was no answer at all.
call() {
    curl -sS --max-time 20 -w '\n%{http_code}' -X POST "${NET_URL}$1" \
        -H 'Content-Type: application/json' -d "$2" 2>&1
}

register_dir() {
    local dir="$1"

    # A cellular-only gateway's SIM is worth carrying here, not just on the
    # first six-hourly report(): an operator adopting off the announced list
    # is looking at a gateway they have never touched, over a backhaul that
    # is itself the SIM, and the adopt should not have to wait on a later
    # report to know which one it was.
    local iccid
    iccid="$(parkeze-modem-detect --status 2>/dev/null | jsonfilter -e '@.iccid' 2>/dev/null)" || true

    local raw status response
    raw="$(call /api/v1/gateway-ops/claim/register \
        "$(printf '{"claimId":"%s","commitment":"%s","eui":"%s","serial":"%s","board":"%s","version":"%s","simIccid":"%s"}' \
              "$(id_in "${dir}")" "$(commitment_in "${dir}")" \
              "$(uci -q get parkeze.identity.gateway_eui || true)" \
              "$(uci -q get parkeze.identity.serial || true)" \
              "${BOARD_ID}" "${PARKEZE_VERSION}" "${iccid:-}")")" || {
        # Not an error worth shouting about: an un-provisioned gateway with no
        # uplink is the normal state five minutes into an install. The QR
        # falls back to the offline form and everything still works.
        log "could not register claim (offline?): ${raw}"
        mark_unreached
        return 1
    }
    mark_reached
    status="$(echo "${raw}" | tail -n1)"
    response="$(echo "${raw}" | sed '$d')"

    case "${status}" in
        2??)
            touch "${dir}/registered"
            log "claim $(id_in "${dir}") registered with parkeze.net"
            return 0
            ;;
        409)
            # This id or this secret was revoked, or the id belongs to somebody
            # else. Neither will ever register, and asking again is how a
            # gateway released with its old claim used to sit refused forever.
            # A new one replaces it; the code on screen changes with it.
            log "claim $(id_in "${dir}") refused ($(printf '%s' "${response}" | jsonfilter -e '@.error' 2>/dev/null || true)); minting another"
            mint "${dir}"
            [ "${dir}" = "${STATE}" ] || date +%s > "${dir}/since"
            return 1
            ;;
    esac
    log "could not register claim (${status}): ${response}"
    return 1
}

register() {
    ensure_identity
    if reclaiming; then
        [ -f "${NEXT}/registered" ] && { log "already registered"; return 0; }
        register_dir "${NEXT}"
        return $?
    fi
    adopted && { log "adopted; nothing to register"; return 0; }
    registered && { log "already registered"; return 0; }
    register_dir "${STATE}"
}

poll_dir() {
    local dir="$1"
    [ -f "${dir}/registered" ] || register_dir "${dir}" || return 1

    # Status captured rather than thrown away by -f, because 404 means
    # something specific here and is worth acting on. Body and status are
    # separated by a newline that curl appends last.
    local raw status response
    raw="$(call /api/v1/gateway-ops/claim/poll \
        "$(printf '{"claimId":"%s","secret":"%s"}' "$(id_in "${dir}")" "$(secret_in "${dir}")")")" || {
        log "poll failed: ${raw}"
        mark_unreached
        return 1
    }
    mark_reached
    status="$(echo "${raw}" | tail -n1)"
    response="$(echo "${raw}" | sed '$d')"

    if [ "${status}" = "404" ]; then
        # parkeze.net does not know this claim. The local `registered` file is
        # a cache of a fact that lives on the server, and the server has just
        # said otherwise — so the cache is wrong, not the server.
        #
        # This is what happens when a gateway is removed from the fleet while
        # it is still running and unadopted: the claim row goes with it, and
        # without this the device would poll a claim nobody has forever,
        # never re-register, and stay invisible until it was reflashed.
        #
        # Dropping the marker makes the next tick register again, under the
        # same claim id — so the code already on the screen and the QR beside
        # it keep working. If the claim was revoked rather than forgotten,
        # registering it is refused, and register_dir mints a new one.
        rm -f "${dir}/registered"
        log "parkeze.net does not know claim $(id_in "${dir}"); will register again"
        return 1
    fi

    local state
    state="$(echo "${response}" | jsonfilter -e '@.state' 2>/dev/null)" || true

    if [ "${status}" = "409" ] && [ "${state}" = "collected" ] && [ "${dir}" = "${NEXT}" ]; then
        # Adopted, and its bundle collected more than ten minutes ago by a
        # poll whose answer never got here. The broker password in it is gone
        # with it; the claim is still the one parkeze.net accepts, so it
        # replaces the revoked one regardless, and reports resume.
        logger -t claim -p daemon.err "claim $(id_in "${NEXT}") was collected without its bundle arriving; the broker password must be reissued"
        promote
        return 0
    fi

    if [ "${status}" -ge 400 ] 2>/dev/null; then
        log "poll failed (${status}): ${response}"
        return 1
    fi

    case "${state}" in
        adopted)
            log "claimed — completing adoption"
            echo "${response}" > "${STATE}/bundle.json"
            chmod 0600 "${STATE}/bundle.json"
            if [ "${dir}" = "${NEXT}" ]; then
                # Before the bundle, not after: installing it restarts the
                # tunnel, and the enrolment that follows proves itself with
                # whichever claim is in STATE.
                promote
                parkeze-adopt --from-bundle "${STATE}/bundle.json"
                rm -f "${STATE}/bundle.json"
                # A transfer moves the tunnel to the new owner's hub at the
                # gateway's next enrolment, and nothing else would enrol: the
                # tunnel config it has is still valid where it points. This
                # keeps the current tunnel until the answer arrives.
                parkeze-wireguard-enroll --background || true
                return 0
            fi
            parkeze-adopt --from-bundle "${STATE}/bundle.json"
            rm -f "${STATE}/bundle.json"
            echo "adopted" > "${STATE}/state"
            ;;
        pending)
            # Normal. Somebody has not scanned it yet.
            ;;
        *)
            log "unexpected claim state '${state}'"
            return 1
            ;;
    esac
    return 0
}

poll() {
    ensure_identity
    if adopted; then
        reclaiming || return 0
        poll_dir "${NEXT}"
        return $?
    fi
    poll_dir "${STATE}"
}

# ── a revoked claim ─────────────────────────────────────────────────────────

# The waiting claim takes the revoked one's place. Two renames, because the id
# and the secret are two files: the window between them is a rename, and a
# gateway caught in it has a claim parkeze.net refuses — which is the state
# this whole path recovers from.
promote() {
    cp "${NEXT}/secret" "${STATE}/secret.new"
    chmod 0600 "${STATE}/secret.new"
    cp "${NEXT}/id" "${STATE}/id.new"
    mv "${STATE}/secret.new" "${STATE}/secret"
    mv "${STATE}/id.new" "${STATE}/id"
    touch "${STATE}/registered"
    echo "adopted" > "${STATE}/state"
    rm -rf "${NEXT}" "${STATE}/revoked"
    log "claim $(claim_id) adopted; it replaces the revoked claim"
}

# One answer that the claim is revoked. The first is remembered; the second,
# at least REVOKED_CONFIRM later, starts a new claim.
note_revoked() {
    reclaiming && return 0
    adopted || return 0
    local first now
    now="$(date +%s)"
    first="$(cat "${STATE}/revoked" 2>/dev/null || true)"
    case "${first}" in
        ''|*[!0-9]*)
            echo "${now}" > "${STATE}/revoked"
            log "parkeze.net no longer accepts claim $(claim_id); asking again before acting on it"
            return 0
            ;;
    esac
    [ "$((now - first))" -ge "${REVOKED_CONFIRM}" ] || return 0

    mint "${NEXT}"
    echo "${now}" > "${NEXT}/since"
    rm -f "${STATE}/revoked"
    log "claim $(claim_id) was revoked; claim $(id_in "${NEXT}") is waiting to be adopted"
    register_dir "${NEXT}" || true
}

# Seconds until the waiting claim is polled again: the first claim's backoff
# without its first two minutes at 5s, which are for an installer standing in
# front of a new gateway. Nobody is necessarily in front of this one, and the
# console's Check now polls at once for whoever is.
backoff() {
    local since now elapsed
    since="$(cat "${NEXT}/since" 2>/dev/null || true)"
    now="$(date +%s)"
    case "${since}" in ''|*[!0-9]*) since="${now}" ;; esac
    elapsed=$((now - since))
    if   [ "${elapsed}" -lt 900 ];  then echo 30
    elif [ "${elapsed}" -lt 3600 ]; then echo 300
    else echo 3600
    fi
}

apply_offline() {
    # The gateway never got internet, so the operator carried the bundle back
    # from parkeze.net by hand. It is signed with the fleet key, whose public
    # half is baked into the image — see docs/provisioning.md for why that is
    # both safe and necessary here.
    local blob="${1:?usage: parkeze-claim apply <bundle>}"
    [ -f "${blob}" ] || { echo "${blob}" > /tmp/.claim-bundle; blob=/tmp/.claim-bundle; }
    parkeze-adopt --from-bundle "${blob}" --verify-signature
    rm -f /tmp/.claim-bundle
    echo "adopted" > "${STATE}/state"
}

# ── reporting what this gateway is ──────────────────────────────────────────
#
# Everything on the console's Configuration page used to be typed by a person
# standing next to a device that already knew the answer: whether there is a
# modem, whether the wired path works, which port the console listens on. After
# adoption the gateway said nothing to parkeze.net ever again, so `backhaul` in
# particular was a human guess sitting beside the only thing that could know.
#
# What is sent is facts, not conclusions. The gateway does not say "I am an
# ethernet site" — it says what it can see, and parkeze.net decides. (A metered
# SIM never carries the management tunnel regardless: that is enforced by
# routing on the gateway, not by anything reported here.)
#
# Authentication is the same commitment proof `poll` uses. No new credential:
# the secret it already holds is what says this is that gateway, and it is
# checked against a hash parkeze.net stored at registration.

facts() {
    local modem wired board_id version modem_present modem_model modem_kind wired_usable tunnel iccid host_key tunnel_via ssh_ca wifi_uplink

    modem="$(parkeze-modem-detect --status 2>/dev/null || echo '{"present":false}')"
    wired="$(parkeze-wireguard-route status 2>/dev/null || echo '{"wiredUsable":false}')"

    modem_present="$(echo "${modem}" | jsonfilter -e '@.present' 2>/dev/null)" || true
    modem_model="$(echo "${modem}" | jsonfilter -e '@.model' 2>/dev/null)" || true
    iccid="$(echo "${modem}" | jsonfilter -e '@.iccid' 2>/dev/null)" || true
    # qmi, mbim or at through ModemManager; hilink or tether for a USB
    # Ethernet modem, which has no SIM this gateway can read, so simIccid is
    # empty for it and parkeze.net should not wait for one.
    modem_kind="$(echo "${modem}" | jsonfilter -e '@.kind' 2>/dev/null)" || true

    # This gateway's SSH host key, so gateway-link can pin it instead of
    # trusting whatever answers on the tunnel address. A shared known_hosts
    # file cannot work here: the addresses are allocated at enrolment, so a
    # newly adopted gateway is never in a file that shipped before it existed.
    # The key travels on this report, which is authenticated by the claim
    # secret — a better introduction than trust-on-first-use over the tunnel.
    host_key="$(parkeze-ssh-setup --host-key 2>/dev/null)" || true
    # Whether sshd accepts a Parkeze certificate naming this gateway. Asked of
    # the running sshd rather than of the files, because a config sshd did not
    # load is not a gateway gateway-link can reach with a certificate — and
    # one marked as trusting the CA is never tried with the fleet key.
    ssh_ca=false
    parkeze-ssh-setup --trusts-ca >/dev/null 2>&1 && ssh_ca=true
    wired_usable="$(echo "${wired}" | jsonfilter -e '@.wiredUsable' 2>/dev/null)" || true
    # Which path the tunnel's own packets are actually leaving on right now —
    # not inferred from a stale handshake, stated. This is the field that
    # changing backhaul is supposed to move promptly: see the immediate
    # report parkeze-wireguard-route fires on a transition.
    tunnel_via="$(echo "${wired}" | jsonfilter -e '@.via' 2>/dev/null)" || true
    tunnel="$(parkeze-backhaul-check --tunnel 2>/dev/null)" || true
    # Whether the WiFi uplink reaches the internet or is waiting at a portal
    # for somebody to sign the gateway in (parkeze-wifi-uplink), and "none"
    # without one. parkeze-wifi-uplink reports again when it changes.
    wifi_uplink=none
    if [ -n "$(uci -q get wireless.parkeze_sta.ssid)" ]; then
        wifi_uplink="$(parkeze-wifi-uplink status 2>/dev/null | jsonfilter -e '@.state' 2>/dev/null)" || true
    fi

    # jsonfilter prints nothing for a missing key, and an empty string is not
    # valid JSON in the value position. Default every field rather than emit a
    # body parkeze.net would reject whole.
    [ "${modem_present}" = "true" ] || modem_present="false"
    [ "${wired_usable}" = "true" ] || wired_usable="false"

    board_id="${BOARD_ID:-unknown}"
    version="${PARKEZE_VERSION:-0.0.0}"

    printf '{"board":"%s","osVersion":"%s","modemPresent":%s,"modemModel":"%s","modemKind":"%s","simIccid":"%s","sshHostKey":"%s","wiredUsable":%s,"tunnelVia":"%s","tunnelState":"%s","wifiUplink":"%s","consolePort":443,"consoleScheme":"https","tunnelConsolePort":8080,"sshPort":22,"sshCa":%s,"system":%s,"rakPower":%s,"setupAp":%s}' \
        "${board_id}" "${version}" "${modem_present}" "${modem_model:-}" "${modem_kind:-}" "${iccid:-}" \
        "${host_key:-}" "${wired_usable}" "${tunnel_via:-none}" "${tunnel:-none}" "${wifi_uplink:-unchecked}" "${ssh_ca}" "$(system_facts)" "$(rak_power_facts)" "$(setup_ap_facts)"
}

# The setup AP's name and passphrase, so the platform can give them to an admin
# of this gateway's organization who is standing at it. See parkeze-ap's report.
# Checked for the same reason as rak_power_facts: a configured SSID is anybody's
# text. The platform takes only the fields it names, so one that does not know
# this field drops it rather than keeping a secret somewhere it would show.
setup_ap_facts() {
    local out
    command -v parkeze-ap >/dev/null 2>&1 || { echo null; return; }
    out="$(parkeze-ap report 2>/dev/null)"
    if [ -n "${out}" ] && echo "${out}" | jsonfilter -e '@' >/dev/null 2>&1; then
        echo "${out}"
    else
        echo null
    fi
}

# The RAK power board's watchdog and battery pack, as parkeze-rak-power last
# recorded them, on a board that has one. parkeze-rak-power asks for this
# report itself when the watchdog stops answering or the battery changes band,
# so that reaches parkeze.net in minutes rather than at the next six-hourly one.
#
# Already JSON, written by lua-cjson; checked anyway, because one bad byte
# here would make parkeze.net reject the whole report.
rak_power_facts() {
    local out
    command -v parkeze-rak-power >/dev/null 2>&1 || { echo null; return; }
    out="$(parkeze-rak-power status 2>/dev/null)"
    if [ -n "${out}" ] && echo "${out}" | jsonfilter -e '@' >/dev/null 2>&1; then
        echo "${out}"
    else
        echo null
    fi
}

# The same key=value facts the MQTT forwarder attaches to LoRaWAN stats, as a
# JSON object. Sent here too because a gateway whose radio is missing or broken
# sends no stats — and that is the gateway somebody is trying to diagnose.
#
# Values are stripped to a safe character set before they go into JSON by
# hand: none of these legitimately contain a quote or a backslash, and one that
# did would otherwise break the whole report.
system_facts() {
    command -v parkeze-gateway-facts >/dev/null 2>&1 || { echo '{}'; return; }
    local out="" key value
    while IFS='=' read -r key value; do
        case "${key}" in ''|*[!a-z_]*) continue ;; esac
        value="$(printf '%s' "${value}" | tr -cd 'A-Za-z0-9._:/+,-')"
        out="${out}${out:+,}\"${key}\":\"${value}\""
    done <<EOF
$(parkeze-gateway-facts 2>/dev/null)
EOF
    printf '{%s}' "${out}"
}

# Exits 0 when accepted, 3 when parkeze.net says the claim is revoked, 1 for
# anything else, including no answer.
report() {
    ensure_identity
    adopted || {
        log "not adopted; nothing to report"
        return 0
    }

    # Always this gateway's own claim, even while another waits to replace
    # it: a report that is accepted again means the revocation was not one.
    local raw status response
    raw="$(call /api/v1/gateway-ops/report \
        "$(printf '{"claimId":"%s","secret":"%s","facts":%s}' \
              "$(claim_id)" "$(secret_in "${STATE}")" "$(facts)")")" || {
        log "report failed: ${raw}"
        return 1
    }
    status="$(echo "${raw}" | tail -n1)"
    response="$(echo "${raw}" | sed '$d')"

    if [ "${status}" = "200" ]; then
        rm -f "${STATE}/revoked"
        if reclaiming; then
            rm -rf "${NEXT}"
            log "claim $(claim_id) is accepted again; the claim waiting to replace it is dropped"
        fi
        log "reported: backhaul=$(echo "${response}" | jsonfilter -e '@.backhaul' 2>/dev/null || true)"
        return 0
    fi

    # 404 "No such gateway." is parkeze.net saying this claim no longer proves
    # this gateway. It does not unwind adoption — that is `parkeze-adopt
    # --check`, and only for somebody standing at the gateway — it starts a
    # claim for the new owner beside the old one. Nobody else can adopt that
    # claim: parkeze.net refuses an adoption into any organization but the one
    # that owns the gateway.
    if revoked_answer "${status}" "${response}" "No such gateway."; then
        note_revoked
        return 3
    fi

    log "report rejected (${status})"
    return 1
}

status() {
    ensure_identity
    local adoption online
    adoption="$(uci -q get parkeze.adoption.state || echo unadopted)"

    # Two different questions, and they only look like one.
    #
    # Adopted: "are we manageable" — whether the management tunnel has a
    # recent handshake, which is the path we would actually be managed over. parkeze-backhaul-check answers that.
    #
    # Unadopted: there is no tunnel to ask about yet, so the question is "did
    # we reach parkeze.net", which this script already knows from its own
    # polling. Asking backhaul-check here returned false for every gateway
    # that had not been adopted, which is the whole fleet at the exact moment
    # an installer is reading the indicator.
    #
    # Reclaiming: the same question as unadopted, because the claim screen is
    # what is asking, every three seconds, and polls of the waiting claim
    # already record the answer.
    #
    # "reclaiming" is adopted, with a claim to show: everything that shows the
    # first claim shows this one, and nothing that keys on "adopted" — the
    # tunnel, the broker, local sign-in — changes.
    local dir
    dir="$(shown)"
    reclaiming && adoption=reclaiming

    if [ "${adoption}" = "adopted" ]; then
        online="$(parkeze-backhaul-check >/dev/null 2>&1 && echo true || echo false)"
    else
        online="$(reached_recently && echo true || echo false)"
    fi

    printf '{"claimId":"%s","state":"%s","registered":%s,"url":"%s","online":%s}\n' \
        "$(id_in "${dir}")" \
        "${adoption}" \
        "$([ -f "${dir}/registered" ] && echo true || echo false)" \
        "$(payload)" \
        "${online}"
}

reset_claim() {
    rm -rf "${STATE}"
    mint
    echo "New claim code: $(claim_id)"
}

case "${1:-status}" in
    status)   status ;;
    qr)       qr "$2" ;;
    register) register ;;
    poll)     poll ;;
    report)   report ;;
    apply)    apply_offline "$2" ;;
    reset)    reset_claim ;;
    reclaiming)   reclaiming ;;
    backoff)      backoff ;;
    note-revoked) note_revoked ;;
    *)        die "usage: parkeze-claim {status|qr|register|poll|report|apply|reset|reclaiming|backoff|note-revoked}" ;;
esac
