#!/bin/sh
#
# Claim this gateway into a parkeze.net organisation.
#
#   parkeze-adopt <adoption-code>
#   parkeze-adopt --status
#   parkeze-adopt --release        (local only; parkeze.net keeps its record)
#
# WHAT ADOPTION CHANGES
#
#   * The gateway enrols its WireGuard key with parkeze.net and brings up the
#     management tunnel to the hub, over the wired path.
#   * It receives MQTT credentials for its own EUI.
#   * It installs the fleet recovery public key, which is what makes offline
#     recovery possible later. A gateway adopted without this can only be
#     recovered by reflashing it.
#   * Local password sign-in is DISABLED. From here on the way in is SSO while
#     online and signed challenge-response while offline. See
#     console/lib/auth.uc for the reasoning.
#
# The adoption code is short-lived and single-use, minted by parkeze.net when
# an operator starts onboarding. It is not a credential — it authorises exactly
# one gateway to claim exactly one pending record.

. /etc/parkeze/board.conf

NET_URL="${PARKEZE_NET_URL:-https://net.parkeze.com}"
STATE=/etc/parkeze

die() { echo "$*" >&2; exit 1; }

status() {
    printf '{"state":"%s","org":"%s","since":"%s","eui":"%s"}\n' \
        "$(uci -q get parkeze.adoption.state)" \
        "$(uci -q get parkeze.adoption.org)" \
        "$(uci -q get parkeze.adoption.since)" \
        "$(uci -q get parkeze.identity.gateway_eui)"
}

release() {
    # Local-side only. parkeze.net still holds the gateway record and the
    # tunnel peer; releasing here just returns this box to local management so
    # it can be re-adopted or repurposed. Deliberately does not call the API —
    # a gateway must not be able to remove itself from the fleet, or a
    # compromised one would.
    uci -q batch <<EOF
set parkeze.adoption.state='unadopted'
set parkeze.adoption.org=''
set parkeze.adoption.since=''
set parkeze.console.local_login='1'
EOF
    uci commit parkeze
    rm -f "${STATE}/recovery.pub" "${STATE}/wireguard/tunnel.json"
    # The claim goes too. Its secret is either revoked, which parkeze.net will
    # never register again, or adopted and collected, which it registers and
    # then refuses to hand a bundle for: kept, it left a released gateway
    # showing a code nobody could use. parkeze-claim mints a new one.
    rm -rf "${STATE}/claim"
    /etc/init.d/parkeze-wireguard stop >/dev/null 2>&1
    /etc/init.d/parkeze-mqtt-agent stop >/dev/null 2>&1
    /etc/init.d/parkeze-report stop >/dev/null 2>&1
    /etc/init.d/parkeze-claim restart >/dev/null 2>&1
    echo "Released. Local sign-in is enabled again."
}

# ── is this gateway still adopted? ──────────────────────────────────────────
#
# The recovery screen exists for an adopted gateway that cannot reach Parkeze.
# If the unit was decommissioned from the console, recovery is the wrong screen
# entirely: there is nobody left to sign the challenge, and the operator should
# be claiming it again instead. This is how it finds that out.
#
# ── WHAT MAY UNDO AN ADOPTION, AND WHAT MAY NOT ────────────────────────────
#
# Returning to adoption is the dangerous direction. An unadopted gateway shows
# a claim code and will join whichever organisation answers it, so anything
# that can convince a working gateway it is unadopted can steal it. The rules,
# and none of them are negotiable:
#
#   - Only parkeze.net's own answer counts. Not a button, not a local file, not
#     a UCI value, and not anything the console can set.
#   - The answer must arrive over TLS that verified. curl is run without -k and
#     a non-zero exit is treated as no answer at all.
#   - No answer is not an answer. A timeout, a DNS failure, a 5xx, a captive
#     portal, an unparseable body: every one of these leaves adoption alone.
#     This is the common case for a gateway on a broken network, which is
#     exactly the gateway looking at the recovery screen.
#   - It has to say so twice, a minute apart. A single 404 from a deploy that
#     was rolling, or a momentary database fault, would otherwise unadopt
#     whatever asked during that window. Two separated answers is cheap here —
#     nobody is timing this screen — and it turns a blip into a non-event.
#
# The request is authenticated with the claim secret, so a gateway can only ask
# about itself. Note that a 404 cannot distinguish "decommissioned" from "this
# secret is wrong": verifying the secret needs the claim row, and decommission
# deletes it. Unwinding on both is safe because `release` is local-only — it
# hands the box back to local management and destroys nothing at Parkeze.
#
# A transfer to another organization answers the same 404, because it revokes
# the claim too. Releasing then costs the tunnel until the new owner adopts the
# claim `release` mints; left alone, the report loop would have kept the tunnel
# and shown that claim anyway (see parkeze-claim). Somebody pressing this at
# the gateway is asking for the first.

probe_adoption() {
    # Prints the HTTP status, or nothing at all if there was no answer.
    local raw status
    raw="$(curl -sS --max-time 20 -w '\n%{http_code}' \
        -X POST "${NET_URL}/api/v1/gateway-ops/report" \
        -H 'Content-Type: application/json' \
        -d "$(printf '{"claimId":"%s","secret":"%s","facts":{}}' \
              "$(cat "${STATE}/claim/id" 2>/dev/null)" \
              "$(cat "${STATE}/claim/secret" 2>/dev/null)")" 2>/dev/null)" || return 1
    status="$(echo "${raw}" | tail -n1)"
    case "${status}" in
        [0-9][0-9][0-9]) echo "${status}" ;;
        *) return 1 ;;
    esac
}

# Where the console reads the answer from. The check takes a minute by design,
# which is far longer than an HTTP handler may block, so it runs detached and
# leaves its result here for the UI to poll.
CHECK_RESULT=/var/run/parkeze-adoption-check.json
CHECK_LOCK=/var/run/parkeze-adoption-check.lock

answer() {
    printf '%s\n' "$1" > "${CHECK_RESULT}"
    printf '%s\n' "$1"
}

check() {
    # One at a time. Without it, anything that can reach the console can start
    # an unbounded number of these, and on a metered SIM that is a bill.
    if ! mkdir "${CHECK_LOCK}" 2>/dev/null; then
        echo '{"checking":true}'
        return 0
    fi
    trap 'rmdir "${CHECK_LOCK}" 2>/dev/null' EXIT INT TERM

    if [ "$(uci -q get parkeze.adoption.state)" != "adopted" ]; then
        answer '{"adopted":false,"checked":false,"reason":"not adopted"}'
        return 0
    fi

    if [ ! -s "${STATE}/claim/id" ] || [ ! -s "${STATE}/claim/secret" ]; then
        # No credential to ask with. That says nothing about adoption, so it
        # must not be read as saying anything.
        answer '{"adopted":true,"checked":false,"reason":"no claim credential"}'
        return 0
    fi

    local first second
    first="$(probe_adoption)" || {
        answer '{"adopted":true,"checked":false,"reason":"unreachable"}'
        return 0
    }

    if [ "${first}" = "200" ]; then
        answer '{"adopted":true,"checked":true}'
        return 0
    fi

    if [ "${first}" != "404" ]; then
        logger -t adopt "adoption check inconclusive (${first})"
        answer "$(printf '{"adopted":true,"checked":false,"reason":"server error %s"}' "${first}")"
        return 0
    fi

    sleep 60
    second="$(probe_adoption)" || {
        answer '{"adopted":true,"checked":false,"reason":"unreachable"}'
        return 0
    }
    if [ "${second}" != "404" ]; then
        logger -t adopt "adoption check: 404 then ${second}; leaving adoption alone"
        answer '{"adopted":true,"checked":true}'
        return 0
    fi

    logger -t adopt "parkeze.net has no record of this gateway; returning to adoption"
    release >/dev/null
    answer '{"adopted":false,"checked":true,"released":true}'
}

# ── installing a bundle ─────────────────────────────────────────────────────

install_bundle() {
    local response="$1"
    local org recovery mqtt_user mqtt_pass mqtt_host mqtt_prefix

    org="$(echo "${response}" | jsonfilter -e '@.org')"
    recovery="$(echo "${response}" | jsonfilter -e '@.recoveryPublicKey')"
    mqtt_user="$(echo "${response}" | jsonfilter -e '@.mqtt.username')"
    mqtt_pass="$(echo "${response}" | jsonfilter -e '@.mqtt.password')"
    mqtt_host="$(echo "${response}" | jsonfilter -e '@.mqtt.host')"
    mqtt_prefix="$(echo "${response}" | jsonfilter -e '@.mqtt.topicPrefix')"

    # The recovery anchor is not optional. Without it this gateway can never be
    # recovered offline, and we would only find that out on the day it matters.
    #
    # An image built with the fleet public key baked in already has one, which
    # is the normal case now — this catches the older images that do not.
    if [ -z "${recovery}" ] && [ ! -s "${STATE}/recovery.pub" ]; then
        uci -q set parkeze.adoption.state='unadopted'; uci commit parkeze
        die "No recovery anchor available; refusing to adopt. Local sign-in is left enabled."
    fi

    if [ -n "${recovery}" ]; then
        echo "${recovery}" > "${STATE}/recovery.pub"
        chmod 0644 "${STATE}/recovery.pub"
    fi

    uci -q batch <<EOF
set parkeze.adoption.state='adopted'
set parkeze.adoption.org='${org}'
set parkeze.adoption.since='$(date -u +%Y-%m-%dT%H:%M:%SZ)'
set parkeze.console.local_login='0'
set parkeze.mqtt.host='${mqtt_host}'
set parkeze.mqtt.username='${mqtt_user}'
set parkeze.mqtt.password='${mqtt_pass}'
set parkeze.mqtt.topic_prefix='${mqtt_prefix}'
EOF
    uci commit parkeze

    # The cleartext first-boot password is meaningless now that local sign-in
    # is off, and leaving it on disk is a liability with no upside.
    rm -f "${STATE}/console/initial-password" "${STATE}/console/password-is-initial"

    # Enrols this gateway's WireGuard key and brings the management tunnel up.
    # Backgrounded inside: parkeze.net may not answer straight away.
    /etc/init.d/parkeze-wireguard restart >/dev/null 2>&1
    # Starts the MQTT forwarder alongside concentratord: it only runs once
    # adopted and holding broker credentials, which is this moment.
    /etc/init.d/parkeze-packet-forwarder restart >/dev/null 2>&1
    # The management agent is not running before this: it is only started once
    # there are broker credentials, and `uci commit` from a shell does not fire
    # the config trigger that would otherwise notice.
    /etc/init.d/parkeze-mqtt-agent restart >/dev/null 2>&1
    /etc/init.d/parkeze-claim stop >/dev/null 2>&1

    # The other half of the pair: claiming stops, reporting starts. Enabled as
    # well as started, so it survives the next boot — this is the only moment
    # a gateway crosses from one to the other.
    /etc/init.d/parkeze-report enable >/dev/null 2>&1
    /etc/init.d/parkeze-report start >/dev/null 2>&1

    logger -t adopt "adopted into ${org}"
    echo "Adopted into ${org}. Local sign-in is now disabled; manage this gateway from parkeze.net."
    status
}

# ── applying a bundle ───────────────────────────────────────────────────────

apply_bundle() {
    # The adoption bundle, however it arrived: pulled by parkeze-claim after
    # somebody scanned the QR, or carried back by hand for a gateway that has
    # never had internet.
    #
    # `--verify-signature` is for the hand-carried case. Online, the bundle
    # came over TLS from a host we resolved ourselves, so its provenance is the
    # transport. Offline it came through a human with a phone, so it has to
    # carry its own proof — an Ed25519 signature over the bundle body, checked
    # against the fleet public key baked into the image at build time.
    local file="${1:?bundle file}" verify=0
    [ "${2:-}" = "--verify-signature" ] && verify=1

    [ -s "${file}" ] || die "empty adoption bundle"

    if [ "${verify}" = 1 ]; then
        local body signature pubkey=/etc/parkeze/recovery.pub
        [ -f "${pubkey}" ] || die "This image carries no fleet key, so an \
offline bundle cannot be verified. Adopt this gateway while it has internet."

        body="$(jsonfilter -i "${file}" -e '@.bundle')"
        signature="$(jsonfilter -i "${file}" -e '@.signature')"
        [ -n "${body}" ] && [ -n "${signature}" ] \
            || die "That bundle is not signed."

        printf '%s' "${body}" > /tmp/.bundle-body
        # openssl, not base64: the image's BusyBox has no base64 applet, so the
        # previous `base64 -d` exited 127 and every offline bundle was refused
        # here as "Malformed signature" — offline adoption never worked. -A
        # because the signature is one unwrapped line.
        printf '%s' "${signature}" | openssl base64 -d -A > /tmp/.bundle-sig 2>/dev/null \
            || { rm -f /tmp/.bundle-body; die "Malformed signature."; }
        [ -s /tmp/.bundle-sig ] \
            || { rm -f /tmp/.bundle-body /tmp/.bundle-sig; die "Malformed signature."; }

        if ! openssl pkeyutl -verify -pubin -inkey "${pubkey}" -rawin \
                 -in /tmp/.bundle-body -sigfile /tmp/.bundle-sig >/dev/null 2>&1; then
            rm -f /tmp/.bundle-body /tmp/.bundle-sig
            die "That bundle's signature is not valid for this fleet."
        fi
        rm -f /tmp/.bundle-sig

        # The verified body is a base64 JSON document; from here it is read
        # exactly like the online one.
        printf '%s' "${body}" | openssl base64 -d -A > /tmp/.bundle.json 2>/dev/null \
            || die "Malformed bundle."
        [ -s /tmp/.bundle.json ] || die "Malformed bundle."
        rm -f /tmp/.bundle-body
        file=/tmp/.bundle.json
    fi

    local eui_in_bundle
    eui_in_bundle="$(jsonfilter -i "${file}" -e '@.eui')"
    if [ -n "${eui_in_bundle}" ] && \
       [ "${eui_in_bundle}" != "$(uci -q get parkeze.identity.gateway_eui)" ]; then
        rm -f /tmp/.bundle.json
        die "That bundle was issued for a different gateway (${eui_in_bundle})."
    fi

    install_bundle "$(cat "${file}")"
    rm -f /tmp/.bundle.json
}

case "${1:-}" in
    --status)       status; exit 0 ;;
    --release)      release; exit 0 ;;
    --check)        check; exit 0 ;;
    --check-result) cat /var/run/parkeze-adoption-check.json 2>/dev/null \
                        || echo '{"checking":true}'; exit 0 ;;
    --from-bundle)  apply_bundle "$2" "$3"; exit 0 ;;
    '')             die "usage: parkeze-adopt <adoption-code>" ;;
esac

CODE="$1"
EUI="$(uci -q get parkeze.identity.gateway_eui)"
SERIAL="$(uci -q get parkeze.identity.serial)"
[ -n "${EUI}" ] || die "This gateway has no EUI. Identity setup did not run."

[ "$(uci -q get parkeze.adoption.state)" = "adopted" ] \
    && die "Already adopted. Release it first if you mean to re-adopt."

uci -q set parkeze.adoption.state='adopting'; uci commit parkeze

# The request carries what parkeze.net needs to create the gateway record, and
# nothing that would let a bystander impersonate the gateway later. There is no
# device secret in this direction: the adoption code is the only bearer, which
# is why it is one-use and short-lived.
response="$(curl -fsS --max-time 45 \
    -X POST "${NET_URL}/api/v1/gateway-ops/adopt" \
    -H 'Content-Type: application/json' \
    -d "$(printf '{"code":"%s","eui":"%s","serial":"%s","board":"%s","version":"%s"}' \
          "${CODE}" "${EUI}" "${SERIAL}" "${BOARD_ID}" "${PARKEZE_VERSION}")" \
    2>&1)" || {
    uci -q set parkeze.adoption.state='unadopted'; uci commit parkeze
    die "Adoption failed: ${response}"
}

install_bundle "${response}"
