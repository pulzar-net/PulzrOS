#!/bin/sh
#
# The polling loop behind /etc/init.d/parkeze-claim. Split out so the backoff
# is readable and so it can be run by hand while debugging an install.

log() { logger -t claim -p daemon.info "$*"; }

# Seconds since boot, not the wall clock. A gateway with no RTC boots at its
# build date, and NTP then moves the clock forward by weeks: the backoff,
# counted from a start time on the old clock, jumped straight to hourly. An
# Opal adopted two minutes after power-on polled again an hour later.
uptime_s() { cut -d. -f1 /proc/uptime; }

started="$(uptime_s)"

# Whether the gateway has a way out that costs nothing per byte: the wired
# port or a WiFi uplink with an address. Read from netifd, so asking sends
# nothing.
unmetered() {
    local iface
    for iface in wan wwifi; do
        ubus call "network.interface.${iface}" status 2>/dev/null \
            | jsonfilter -e '@["ipv4-address"][0].address' >/dev/null 2>&1 && return 0
    done
    return 1
}

interval_for() {
    # Seconds since start -> how long to wait before the next poll.
    #
    # The backoff is for the SIM: a cellular-only gateway nobody adopts would
    # otherwise spend its data asking all day. On a wired or WiFi uplink there
    # is nothing to save, and backing off there made a gateway adopted an hour
    # after power-on wait up to another hour to notice: no tunnel, no report
    # and no SSH the whole time.
    local elapsed="$1"
    if   [ "${elapsed}" -lt 120 ];  then echo 5
    elif [ "${elapsed}" -lt 900 ] || unmetered; then echo 30
    elif [ "${elapsed}" -lt 3600 ]; then echo 300
    else echo 3600
    fi
}

log "waiting to be claimed — code $(parkeze-claim status | jsonfilter -e '@.claimId')"

while :; do
    if [ "$(uci -q get parkeze.adoption.state)" = "adopted" ]; then
        log "adopted; polling stops"
        # Take the service down rather than looping forever doing nothing.
        /etc/init.d/parkeze-claim stop >/dev/null 2>&1 &
        exit 0
    fi

    parkeze-claim poll >/dev/null 2>&1 || true

    elapsed=$(( $(uptime_s) - started ))
    sleep "$(interval_for "${elapsed}")"
done
