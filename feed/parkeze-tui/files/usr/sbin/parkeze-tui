#!/usr/bin/ucode -R
// The gateway console, in a terminal.
//
//   parkeze-tui                        here, as root; no sign-in
//   parkeze-tui --console [--tty DEV]  as a port's own program, behind the
//                                      web console's sign-in
//
// See /usr/share/parkeze/tui/app.uc for what it is and who it trusts.

let opts = { console: false, tty: null };
for (let i = 0; i < length(ARGV); i++) {
    if (ARGV[i] == '--console') opts.console = true;
    else if (ARGV[i] == '--tty') opts.tty = ARGV[++i];
    else {
        warn('usage: parkeze-tui [--console] [--tty DEVICE]\n');
        exit(2);
    }
}

let app = loadfile((getenv('PARKEZE_TUI_LIB') ?? '/usr/share/parkeze/tui') + '/app.uc', { raw_mode: true })();
exit(app.start(opts));
