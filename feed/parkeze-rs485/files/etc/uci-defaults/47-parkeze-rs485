#!/bin/sh
# The bus settings, seeded so they are visible in UCI rather than implied by
# their absence. 9600 8N1 is what the watchdog and the battery speak; on a
# board where they share the bus with the DC connector, changing it is how
# the watchdog stops being fed. Devices are `modbus` sections; see
# docs/rs485.md.

# OpenWrt runs uci-defaults during image assembly too; this is the device's.
[ -n "${IPKG_INSTROOT}" ] && exit 0

uci -q get parkeze.rs485 >/dev/null 2>&1 || uci -q batch <<UCI
set parkeze.rs485=rs485
set parkeze.rs485.baud='9600'
set parkeze.rs485.parity='none'
set parkeze.rs485.stopbits='1'
UCI
uci -q commit parkeze
exit 0
