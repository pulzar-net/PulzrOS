#!/bin/sh /etc/rc.common
#
# Device drivers (pulzr-drivers listen). Respawned, because a broker that goes
# away must not leave a device's commands unanswered until a reboot.
#
# START=97, after the management agent (96): the same broker login, and the
# agent's `drivers` op is how Pulzar says a driver changed.

START=97
STOP=10

USE_PROCD=1

start_service() {
	# Nothing to listen with until the gateway is adopted.
	[ "$(uci -q get pulzr.adoption.state)" = "adopted" ] || return 0
	[ -n "$(uci -q get pulzr.mqtt.host)" ] || return 0

	procd_open_instance
	procd_set_param command /usr/sbin/pulzr-drivers listen
	procd_set_param respawn 60 5 0
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	nft delete table inet pulzr_drivers 2>/dev/null
}

service_triggers() {
	procd_add_config_trigger "config.change" "pulzr" /etc/init.d/pulzr-drivers restart
}
