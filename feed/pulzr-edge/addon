# What makes this package an add-on (docs/addons.md). Read as KEY="value"
# shell by build-feed.sh, build-addons.sh and check-addons.sh.
#
# The shared runtime: no capability of its own, installed as the dependency of
# the add-ons that each bring one (pulzr-modbus, pulzr-zigbee, pulzr-zwave),
# so a deny on one never blocks another. scripts/check-addons.sh requires an
# ADDON_SHARED add-on to be depended on by at least one other.
ADDON_TITLE="Edge runtime"
ADDON_CAPS=""
ADDON_SHARED="1"
ADDON_FEATURE=""
ADDON_BOARDS="*"
