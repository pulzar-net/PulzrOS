# What makes this package an add-on rather than part of the image: it is built
# into a repository per release and architecture (scripts/build-addons.sh)
# and a gateway installs it on request. Read as KEY="value" shell by
# build-feed.sh, build-addons.sh and check-addons.sh.
ADDON_TITLE="Modbus"
ADDON_CAPS="modbus"
ADDON_FEATURE="modbus"
# Boards that may be offered it: "*" or board ids. Every board's OPENWRT_ARCH
# must be in this package's arches (scripts/check-addons.sh).
ADDON_BOARDS="*"
