#!/bin/sh /etc/rc.common
#
# The Modbus (and later Bluetooth and Zigbee) edge daemon. Respawned, because
# a broker that goes away must not leave the buses unread until a reboot; the
# daemon buffers to disk meanwhile.
#
# START=97, after the management agent (96): the daemon's broker certificate
# arrives over the platform, and nothing on a bus is urgent enough to beat it.

START=97
STOP=10

USE_PROCD=1

CONFIG=/etc/pulzr-edge/config.toml

start_service() {
    # Not started until a gateway has buses to read and a certificate to
    # publish with: the config names both. Starting anyway would only respawn
    # an exit every few seconds into the log, which is how pulzr-mqtt-agent's
    # unadopted gateways filled theirs.
    [ -s "${CONFIG}" ] || return 0

    procd_open_instance
    procd_set_param command /usr/sbin/pulzr-edge "${CONFIG}"
    procd_set_param respawn 60 5 0
    procd_set_param stderr 1
    procd_set_param file "${CONFIG}"
    procd_close_instance
}
