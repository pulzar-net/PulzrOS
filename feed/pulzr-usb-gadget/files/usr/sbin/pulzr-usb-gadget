#!/bin/sh
#
# The board's USB device port, as a network interface and a serial port.
#
#   pulzr-usb-gadget up       build the gadget and attach it
#   pulzr-usb-gadget down     detach and take it apart
#   pulzr-usb-gadget status   JSON, for the console
#
# ── WHAT A LAPTOP SEES ─────────────────────────────────────────────────────
#
# One composite device with two functions:
#
#   NCM   a network interface. Windows 11, macOS, Linux and ChromeOS all bind
#         it without a driver. It carries an MS OS descriptor naming WINNCM,
#         which is what lets Windows pick its own NCM driver by itself.
#   ACM   a serial port, with the terminal UI on it (ttyGS0 in /etc/inittab).
#         Every OS binds it without a driver too.
#
# Not RNDIS: macOS has no driver for it, and Microsoft's own advice is NCM.
# Not ECM: Windows has none. NCM is the one class all four bind. The cost is
# Windows 10, which has an NCM driver but does not reliably choose it; it is
# out of support, and the serial port works there regardless.
#
# Built through configfs rather than a legacy g_* module, because no legacy
# module offers NCM and ACM together.
#
# ── POWER ──────────────────────────────────────────────────────────────────
#
# On a Pi 4 and Pi 5 the device port IS the USB-C power input. A laptop
# plugged in there is also the power supply, and a laptop port supplies a
# fraction of what a Pi with a concentrator and a modem draws. A gateway on
# PoE, or powered through its header, is fine; one powered from its USB-C
# port needs a splitter that carries data from the laptop and power from the
# supply. See docs/access.md.

. /etc/pulzr/board.conf

G=/sys/kernel/config/usb_gadget/pulzr

# Bump when the functions change. Windows caches what it learnt about a
# device by vendor, product and this, and a cached answer for a different
# composition is how a working port stops working after an upgrade.
BCD_DEVICE=0x0100

udc() { ls /sys/class/udc 2>/dev/null | head -n1; }

# A stable, locally administered MAC for each end, derived from the gateway's
# serial: the same laptop sees the same interface on every boot, rather than a
# new "network 7" each time.
mac() {
    local h
    h="$(printf '%s-%s' "$(uci -q get pulzr.identity.serial || cat /proc/sys/kernel/hostname)" "$1" \
         | md5sum | cut -c1-10)"
    printf '02:%s:%s:%s:%s:%s\n' "$(echo "$h" | cut -c1-2)" "$(echo "$h" | cut -c3-4)" \
        "$(echo "$h" | cut -c5-6)" "$(echo "$h" | cut -c7-8)" "$(echo "$h" | cut -c9-10)"
}

up() {
    [ -d "${G}" ] && return 0
    grep -q ' /sys/kernel/config ' /proc/mounts || mount -t configfs none /sys/kernel/config || return 1

    # The overlay that hands the port to dwc2 is applied at boot by
    # pulzr-boot-config. On the first boot it is not there yet, and the
    # reboot first boot schedules is what brings the port up.
    local controller
    controller="$(udc)"
    if [ -z "${controller}" ]; then
        logger -t pulzr-usb-gadget "no USB device controller; the port comes up after a reboot"
        return 1
    fi

    mkdir -p "${G}" || return 1
    cd "${G}" || return 1

    # The Linux Foundation's multifunction composite gadget ID, which is what
    # it is for. A product with a USB-IF vendor ID of its own would use that.
    echo 0x1d6b > idVendor
    echo 0x0104 > idProduct
    echo "${BCD_DEVICE}" > bcdDevice
    echo 0x0200 > bcdUSB
    # Miscellaneous / IAD: a composite whose functions each describe
    # themselves, which is what Windows needs to bind them separately.
    echo 0xEF > bDeviceClass
    echo 0x02 > bDeviceSubClass
    echo 0x01 > bDeviceProtocol

    mkdir -p strings/0x409
    uci -q get pulzr.identity.serial > strings/0x409/serialnumber || echo pulzr > strings/0x409/serialnumber
    echo 'Pulzar' > strings/0x409/manufacturer
    echo "Pulzar ${BOARD_NAME:-gateway}" > strings/0x409/product

    mkdir -p configs/c.1/strings/0x409
    echo 'Network and serial console' > configs/c.1/strings/0x409/configuration
    # Bus-powered as far as the host is concerned, at the most USB 2 allows.
    # Honest about the cable, though not about the board; see POWER above.
    echo 0x80 > configs/c.1/bmAttributes
    echo 500 > configs/c.1/MaxPower

    mkdir -p functions/ncm.usb0
    mac host > functions/ncm.usb0/host_addr
    mac device > functions/ncm.usb0/dev_addr
    mkdir -p functions/acm.GS0

    # Windows chooses its NCM driver from this, and only from this.
    echo 1 > os_desc/use
    echo 0xcd > os_desc/b_vendor_code
    echo MSFT100 > os_desc/qw_sign
    echo WINNCM > functions/ncm.usb0/os_desc/interface.ncm/compatible_id
    # Absolute targets: configfs resolves a link's target from the link's own
    # directory, so a relative one names a path that is not there.
    ln -s "${G}/configs/c.1" "${G}/os_desc/"

    ln -s "${G}/functions/ncm.usb0" "${G}/configs/c.1/"
    ln -s "${G}/functions/acm.GS0" "${G}/configs/c.1/"

    echo "${controller}" > UDC
    logger -t pulzr-usb-gadget "up on ${controller}"
}

down() {
    [ -d "${G}" ] || return 0
    cd "${G}" || return 1
    echo '' > UDC 2>/dev/null
    rm -f os_desc/c.1 configs/c.1/ncm.usb0 configs/c.1/acm.GS0
    rmdir configs/c.1/strings/0x409 configs/c.1 2>/dev/null
    rmdir functions/ncm.usb0 functions/acm.GS0 strings/0x409 2>/dev/null
    cd / && rmdir "${G}" 2>/dev/null
    return 0
}

status() {
    local controller state address
    controller="$(cat "${G}/UDC" 2>/dev/null)"
    state="$(cat "/sys/class/udc/${controller}/state" 2>/dev/null)"
    address="$(uci -q get network.usb.ipaddr)"
    # `configured` is the host having enumerated the gadget and chosen its
    # configuration: a laptop is on the other end and has the interface.
    printf '{"present":%s,"connected":%s,"state":"%s","name":"pulzr.local","address":"%s"}\n' \
        "$([ -n "${controller}" ] && echo true || echo false)" \
        "$([ "${state}" = configured ] && echo true || echo false)" \
        "${state:-absent}" "${address}"
}

case "$1" in
    up) up ;;
    down) down ;;
    status) status ;;
    *) echo "usage: $0 up|down|status" >&2; exit 2 ;;
esac
