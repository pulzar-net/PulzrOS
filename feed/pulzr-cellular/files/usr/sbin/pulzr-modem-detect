#!/bin/sh
#
# Point the cellular interface at whatever modem ModemManager found.
#
#   pulzr-modem-detect            find it and write it into UCI
#   pulzr-modem-detect --status   report, change nothing
#   pulzr-modem-detect --set-slot N
#                                 use the SIM in slot N, on a modem with several
#   pulzr-modem-detect --sync-slot
#                                 put the modem on pulzr.cellular.sim_slot
#
# ── WHY THIS IS NEEDED ─────────────────────────────────────────────────────
#
# OpenWrt's modemmanager netifd proto identifies a modem by its *sysfs path* —
# something like /sys/devices/platform/soc/fe980000.usb/usb1/1-1/1-1.3 — and
# that path depends on which physical port the modem is plugged into. It cannot
# be known when the image is built, and it changes if somebody moves the modem
# to another port.
#
# So the interface ships without a device and this fills it in: on first boot,
# and again on any USB event that looks like a modem.
#
# The older uqmi-based config hardcoded /dev/cdc-wdm0 and did not have this
# problem. OpenWrt 24.10 shipped no uqmi, hence the trade.

MM_TIMEOUT="${PULZR_MM_TIMEOUT:-30}"

log() { logger -t modem -p daemon.info "$*"; }

command -v mmcli >/dev/null 2>&1 || {
    [ "$1" = "--status" ] && printf '{"present":false,"reason":"ModemManager is not installed."}\n'
    exit 1
}

case "$1" in
    --set-slot)
        case "$2" in [1-9]) ;; *) echo "a slot number" >&2; exit 2 ;; esac
        ;;
    --sync-slot|--status|'') ;;
    *) echo "usage: pulzr-modem-detect [--status|--set-slot N|--sync-slot]" >&2; exit 2 ;;
esac

# ModemManager enumerates asynchronously and a modem can take twenty seconds to
# appear after a cold boot, so this waits rather than concluding there is none.
modem_index=""
waited=0
while [ "${waited}" -lt "${MM_TIMEOUT}" ]; do
    modem_index="$(mmcli -L 2>/dev/null | sed -n 's|.*/Modem/\([0-9]*\).*|\1|p' | head -n1)"
    [ -n "${modem_index}" ] && break
    [ "$1" = "--status" ] && break      # do not block a console page load
    [ "$1" = "--set-slot" ] && break
    sleep 2
    waited=$((waited + 2))
done

if [ -z "${modem_index}" ]; then
    case "$1" in --set-slot|--sync-slot) echo "no modem" >&2; exit 1 ;; esac
    if [ "$1" = "--status" ]; then
        # A HiLink dongle or a tethered phone is a modem ModemManager never
        # sees: it is a USB Ethernet adapter, and pulzr-usb-cellular binds
        # it to usbwan. Reported here so the console, the claim report and the
        # MQTT agent, which all read this, learn of it without asking twice.
        [ -x /usr/sbin/pulzr-usb-cellular ] && /usr/sbin/pulzr-usb-cellular status --present && exit 0
        printf '{"present":false,"reason":"No modem. Normal on a wired-only gateway."}\n'
    else
        log "no modem found after ${waited}s"
        # Same reasoning as the commit at the end of this script: hotplug
        # runs this on every interface event, and a gateway with no modem
        # gets here every time.
        if [ "$(uci -q get pulzr.cellular.modem_present)" != "0" ]; then
            uci -q set pulzr.cellular=cellular
            uci -q set pulzr.cellular.modem_present='0'
            uci commit pulzr
        fi
    fi
    exit 1
fi

detail="$(mmcli -m "${modem_index}" 2>/dev/null)"
device_path="$(echo "${detail}" | sed -n 's/.*device: *//p' | head -n1 | tr -d ' ')"
manufacturer="$(echo "${detail}" | sed -n 's/.*manufacturer: *//p' | head -n1)"
model="$(echo "${detail}" | sed -n 's/.*model: *//p' | head -n1)"
imei="$(echo "${detail}" | sed -n 's/.*equipment id: *//p' | head -n1 | tr -d ' ')"

# How ModemManager talks to it, from the control ports it lists:
# "cdc-wdm0 (mbim)", "cdc-wdm0 (qmi)", or only "ttyUSB2 (at)", where the data
# goes over PPP and the interface's device is ppp-wwan. All three are wwan
# with proto modemmanager; the console shows which.
case "${detail}" in
    *'(mbim)'*) kind=mbim ;;
    *'(qmi)'*)  kind=qmi ;;
    *)          kind='at' ;;
esac

# The SIM the modem is actually holding. Pulzar links a gateway to its 1NCE
# SIM by ICCID, and until now somebody read it off the card and typed it into
# the fleet page — next to a device that could simply be asked.
sim_index="$(echo "${detail}" | sed -n 's|.*primary sim path: */org/freedesktop/ModemManager1/SIM/\([0-9]*\).*|\1|p' | head -n1)"
iccid_of() {
    mmcli -i "$1" --output-keyvalue 2>/dev/null | sed -n 's/^sim.properties.iccid *: *//p' | head -n1 | tr -cd '0-9'
}
iccid=""
[ -n "${sim_index}" ] && iccid="$(iccid_of "${sim_index}")"

# ── SIM SLOTS ──────────────────────────────────────────────────────────────
#
# A modem with two SIM holders (a dual-SIM Quectel, an EM7565) lists each in
# sim-slots and says which is primary; one with a single holder lists none,
# and then there is nothing to choose and nothing is reported. ModemManager
# switches with --set-primary-sim-slot and re-probes the modem, so its index
# changes and hotplug runs this script again.
#
# The slot in use is kept in pulzr.cellular.sim_slot, recorded the first time
# this sees a modem with several, so pulzr-apply's snapshot always holds the
# slot before a change: a switch to an empty or unprovisioned SIM that cuts
# the gateway off is undone when the window runs out, by its reload calling
# --sync-slot, like any other change to an uplink.
kv="$(mmcli -m "${modem_index}" --output-keyvalue 2>/dev/null)"
slot_count="$(echo "${kv}" | sed -n 's/^modem\.generic\.sim-slots\.length *: *//p' | head -n1 | tr -cd '0-9')"
primary_slot="$(echo "${kv}" | sed -n 's/^modem\.generic\.primary-sim-slot *: *//p' | head -n1 | tr -cd '0-9')"
slots_json=null
if [ "${slot_count:-0}" -gt 1 ] 2>/dev/null; then
    slots_json='['
    n=1
    while [ "${n}" -le "${slot_count}" ]; do
        path="$(echo "${kv}" | sed -n "s/^modem\.generic\.sim-slots\.value\[${n}\] *: *//p" | head -n1)"
        idx="$(echo "${path}" | sed -n 's|.*/SIM/\([0-9]*\)$|\1|p')"
        slot_iccid=""
        [ -n "${idx}" ] && slot_iccid="$(iccid_of "${idx}")"
        [ "${n}" -gt 1 ] && slots_json="${slots_json},"
        slots_json="${slots_json}$(printf '{"slot":%d,"present":%s,"iccid":"%s","active":%s}' \
            "${n}" "$([ -n "${idx}" ] && echo true || echo false)" "${slot_iccid}" \
            "$([ "${n}" = "${primary_slot}" ] && echo true || echo false)")"
        n=$((n + 1))
    done
    slots_json="${slots_json}]"
fi

# The modem onto pulzr.cellular.sim_slot. At most once a minute: hotplug runs
# this on every interface event, and a modem that refuses the switch would
# otherwise be asked again on each one.
sync_slot() {
    local want stamp=/var/run/pulzr-sim-slot
    want="$(uci -q get pulzr.cellular.sim_slot)"
    [ -n "${want}" ] && [ -n "${primary_slot}" ] && [ "${want}" != "${primary_slot}" ] || return 0
    [ "${want}" -le "${slot_count:-0}" ] 2>/dev/null || return 0
    if [ -f "${stamp}" ] && [ $(( $(date +%s) - $(cat "${stamp}" 2>/dev/null || echo 0) )) -lt 60 ]; then
        return 0
    fi
    date +%s > "${stamp}"
    if mmcli -m "${modem_index}" --set-primary-sim-slot="${want}" >/dev/null 2>&1; then
        log "SIM slot ${primary_slot} -> ${want}"
    else
        log "the modem refused SIM slot ${want}"
        return 1
    fi
}

case "$1" in
    --set-slot)
        [ "${slot_count:-0}" -gt 1 ] 2>/dev/null || { echo "this modem has one SIM slot" >&2; exit 2; }
        [ "$2" -le "${slot_count}" ] || { echo "this modem has ${slot_count} SIM slots" >&2; exit 2; }
        uci -q set pulzr.cellular=cellular
        uci -q set pulzr.cellular.sim_slot="$2"
        uci commit pulzr
        rm -f /var/run/pulzr-sim-slot
        sync_slot || { echo "the modem refused slot $2" >&2; exit 1; }
        printf '{"slot":%d}\n' "$2"
        exit 0
        ;;
    --sync-slot)
        rm -f /var/run/pulzr-sim-slot
        sync_slot
        exit $?
        ;;
esac

# Poll ModemManager's own location state for a fix and freeze it into
# pulzr.location.*, the same reference-coordinate mechanism a board with no
# receiver at all already reports through (see docs/src/content/docs/concentrators.md's GNSS
# section). Backgrounded and called once, right after the engine is enabled —
# a cold GPS fix can take minutes, and this must not hold up the rest of
# modem detection or a boot waiting on it.
#
# 30-second spacing matches the engine's own refresh rate (mmcli
# --location-status reports it), so a poll never lands between two fixes for
# nothing. Ten tries is five minutes, generous for a cold fix with reasonable
# sky view and short enough that a modem that never gets one does not poll
# forever.
sync_modem_location() {
    local index="$1" attempt=0 kv lat lon alt

    # Only when the modem may be the source. With a concentrator's receiver or
    # a separate one chosen on the GNSS page, the position is theirs to record.
    case "$(uci -q get pulzr.gps.source || echo auto)" in
        auto|modem) ;;
        *) return 0 ;;
    esac

    while [ "${attempt}" -lt 10 ]; do
        # Something else may have recorded a position while this was waiting
        # on a fix — a HAT's own receiver, synced by hand. Gateways do not
        # move, so whichever position landed first is the one that stands.
        [ -n "$(uci -q get pulzr.location.source)" ] && return 0

        kv="$(mmcli -m "${index}" --location-get --output-keyvalue 2>/dev/null)"
        lat="$(echo "${kv}" | sed -n 's/^modem\.location\.gps\.latitude *: *//p')"
        lon="$(echo "${kv}" | sed -n 's/^modem\.location\.gps\.longitude *: *//p')"
        alt="$(echo "${kv}" | sed -n 's/^modem\.location\.gps\.altitude *: *//p')"

        # "--" is mmcli's own placeholder for a field with no value yet, not a
        # real reading — the engine can be enabled and answering the query
        # for several polls before the sky view yields an actual fix.
        case "${lat}" in
            ''|--) ;;
            *)
                uci -q batch <<EOF
set pulzr.location=location
set pulzr.location.latitude='${lat}'
set pulzr.location.longitude='${lon}'
set pulzr.location.altitude='${alt:-0}'
set pulzr.location.source='modem'
set pulzr.location.fixed_at='$(date -u +%Y-%m-%dT%H:%M:%SZ)'
EOF
                uci commit pulzr
                log "recorded modem GPS position: ${lat}, ${lon}"
                return 0
                ;;
        esac

        attempt=$((attempt + 1))
        sleep 30
    done
    log "modem GPS enabled but never got a fix after $((attempt * 30))s"
}

# ── the modem's own GNSS ─────────────────────────────────────────────────────
#
# A modem with a GPS engine ships with it OFF. Unlike a discrete GNSS receiver
# on a HAT — which is a u-blox-style chip that starts emitting NMEA the moment
# it has power, no command required — a cellular module's GPS die stays
# powered down until something asks for a fix, to save the antenna current
# when nobody needs it. Nothing here ever asked, so pulzr-gps-detect's
# generic serial scan found an unpowered engine and correctly reported no
# receiver, on every gateway with a modem that has one.
#
# `--location-enable-gps-nmea` is ModemManager's own call for this — it sends
# whatever vendor AT command the modem actually wants (Quectel's is
# `AT+QGPS=1`; others differ) so this stays modem-agnostic rather than
# hardcoding one vendor's command set.
#
# Once enabled, whether pulzr-gps-detect's serial scan can see the result at
# all depends on how ModemManager is talking to this modem, and the two ways
# it does that disagree completely on where NMEA ends up:
#
#   the `option` driver     exposes a plain USB-serial AT port, and the modem
#                           streams NMEA on a real tty once asked — a genuine
#                           serial device, which is exactly what
#                           pulzr-gps-detect's scan is built to find.
#   qmi_wwan (this modem)   speaks QMI over a cdc-wdm control channel with no
#                           NMEA-emitting tty anywhere in the picture. The fix
#                           only ever exists inside ModemManager's own D-Bus
#                           state, read with `--location-get` — checked live
#                           on a Quectel EG25: `--location-get` returns a
#                           current, valid fix while there is no
#                           /dev/ttyUSB*/ttyACM* answering NMEA at all.
#                           pulzr-gps-detect's scan cannot see this under
#                           any timing or retry — there is nothing there to
#                           find, not a receiver that has not spoken up yet.
#
# So both are run: the scan, for a modem whose driver genuinely puts NMEA on a
# tty, and sync_modem_location below, for one that does not. Neither claims
# the other's ground — a QMI modem's fix is never claimed as pulzr.gps.*
# (that would tell concentratord it can open a device path for PPS timing that
# does not exist), so it goes into pulzr.location.* instead: the same
# reference-coordinate mechanism a receiver-less board already uses to give
# concentratord *a* position without pretending to give it GPS time too.
#
# Not conditioned on "is it enabled already" — mmcli's status output does not
# distinguish Capabilities from Enabled reliably enough to parse without a
# real modem to check the exact wording against, and asking again costs
# nothing: enabling an already-enabled source is a no-op on ModemManager's
# side, matching how the rest of this script is written to be safe to re-run
# on every boot and every hotplug event rather than only once.
#
# Never under --status. That mode is documented as changing nothing, and the
# console calls it on every Overview and Backhaul refresh: it was re-enabling
# the engine, logging that it had, starting a GNSS probe of every serial port
# and a five-minute position poll, every fifteen seconds for as long as a page
# was open — a tenth of the log, and a probe that retunes the receiver's port
# underneath the forwarder holding it.
gps_capable="false"
if mmcli -m "${modem_index}" --location-status 2>/dev/null | grep -q 'gps-nmea'; then
    gps_capable="true"
    if [ "$1" = "--status" ]; then
        :
    elif mmcli -m "${modem_index}" --location-enable-gps-nmea --location-enable-gps-raw >/dev/null 2>&1; then
        log "modem GPS engine enabled"
        # gps-detect writes pulzr.gps.* via `uci commit pulzr`, which the
        # packet forwarder already restarts on (its own config.change
        # trigger) — so calling it here is enough to get a tty-based GNSS into
        # concentratord without a second, bespoke restart path. First boot's
        # own gps-detect call, in 40-pulzr-concentrator, can run before the
        # modem has even enumerated; this is what catches it once the modem —
        # and now its GPS engine — actually exist.
        ( /usr/sbin/pulzr-gps-detect >/dev/null 2>&1 & )
        ( sync_modem_location "${modem_index}" & )
    else
        log "modem claims gps-nmea but would not enable it"
    fi
fi

if [ "$1" = "--status" ]; then
    printf '{"present":true,"kind":"%s","index":%s,"device":"%s","manufacturer":"%s","model":"%s","imei":"%s","iccid":"%s","gpsCapable":%s,"slots":%s}\n' \
        "${kind}" "${modem_index}" "${device_path}" "${manufacturer}" "${model}" "${imei}" "${iccid}" "${gps_capable}" "${slots_json}"
    exit 0
fi

[ -n "${device_path}" ] || { log "modem ${modem_index} reports no sysfs path"; exit 1; }

current="$(uci -q get network.wwan.device)"
if [ "${current}" != "${device_path}" ]; then
    uci -q set network.wwan.device="${device_path}"
    uci commit network
    log "cellular bound to ${device_path} (${manufacturer} ${model})"
    /sbin/ifup wwan >/dev/null 2>&1
fi

# Only if something differs. This script runs from hotplug.d/iface, so it
# re-runs on every interface event — and on a gateway whose wwan cannot bind
# ModemManager, netifd retries that interface continuously. Committing
# unconditionally turned each of those retries into a `config.change` on
# "pulzr", which restarts the packet forwarder, which is how a Pi4 ended up
# restarting its LoRa stack every ten seconds and never forwarding an uplink.
# These values — model, IMEI, ICCID — do not change between runs anyway.
changed=0
put() {
    [ "$(uci -q get "pulzr.$1")" = "$2" ] && return 0
    uci -q set "pulzr.$1=$2"
    changed=1
}

put cellular cellular
put cellular.modem_present 1
put cellular.model "${manufacturer} ${model}"
put cellular.imei "${imei}"
put cellular.iccid "${iccid}"
put cellular.gps_capable "$([ "${gps_capable}" = "true" ] && echo 1 || echo 0)"
# The slot in use, once, so a change has one to go back to (see SIM SLOTS).
if [ "${slot_count:-0}" -gt 1 ] 2>/dev/null && [ -z "$(uci -q get pulzr.cellular.sim_slot)" ] && [ -n "${primary_slot}" ]; then
    put cellular.sim_slot "${primary_slot}"
fi
[ "${changed}" = 1 ] && uci commit pulzr
sync_slot
exit 0
