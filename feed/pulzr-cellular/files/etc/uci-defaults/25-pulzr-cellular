#!/bin/sh
# The cellular interface, and binding it to the modem.
#
# Runs at first boot where pulzr-cellular is built into the image, and when
# pulzr-addon installs it everywhere else (it runs an add-on's uci-defaults as
# image assembly would).

# OpenWrt's prepare_rootfs runs every uci-defaults script during image
# assembly, with IPKG_INSTROOT set. There is no modem on a build runner, and
# probing for one there would only record the runner's hardware.
[ -n "${IPKG_INSTROOT}" ] && exit 0

. /etc/pulzr/board.conf

# Here rather than in 20-pulzr-network, which has the rest of the network's
# shape, because only a gateway with this package has ModemManager's netifd
# proto: a wwan interface without it is one netifd cannot bring up.
#
# A higher metric than wan: when both are up, wired wins and cellular costs
# nothing. When wired is down, cellular is the only default route and carries
# the control plane.
#
# proto modemmanager, not qmi: OpenWrt 24.10 shipped no uqmi, which is what
# provides the qmi proto. ModemManager wants the modem's *sysfs path* in
# `device`, which cannot be known at build time — pulzr-modem-detect fills it
# in on first boot and whenever the modem re-enumerates, and until it does the
# interface simply does not come up.
#
# signalrate: ModemManager reads RSSI and RSRP only when asked to poll them,
# and without it the report's cellular signal is always empty (a bench Pi on
# 0.4.0-rc3: refresh rate 0, every dBm "--"). Once a minute costs the modem
# nothing it is not already doing.
if [ "${PULZR_WAN_CELL_ENABLED}" = "1" ]; then
uci -q batch <<EOF
delete network.wwan
set network.wwan=interface
set network.wwan.proto='modemmanager'
set network.wwan.apn='${PULZR_CELL_APN:-iot.1nce.net}'
set network.wwan.auth='none'
set network.wwan.iptype='ipv4'
set network.wwan.metric='20'
set network.wwan.signalrate='60'
set network.wwan.disabled='0'
EOF
uci commit network
# Installed as an add-on, netifd is running and has not heard of wwan; at
# first boot it has not started yet, and reads it when it does.
pidof netifd >/dev/null && ubus call network reload >/dev/null 2>&1
fi

# Backgrounded: ModemManager can take twenty seconds to enumerate a cold modem,
# and first boot should not stall on it.
( /usr/sbin/pulzr-modem-detect >/dev/null 2>&1 ) &
exit 0
