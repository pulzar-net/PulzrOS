#!/bin/sh
#
# Whether this gateway's Matter controller is up, for pulzr-addon's report.
#
#   exit 0  ok: the controller runs on its organization's fabric
#   exit 2  idle: the gateway has not joined a fabric yet
#   exit 1  failing: the controller's module does not answer
#
# Reported, never acted on.
[ -e /etc/pulzr-edge/radios/matter.json ] || exit 2
state="$(pulzr-timeout 35 pulzr-radios call matter status < /dev/null 2>/dev/null | jsonfilter -e '@.state' 2>/dev/null)"
case "$state" in
    up) exit 0 ;;
    unjoined) exit 2 ;;
    *) exit 1 ;;
esac
