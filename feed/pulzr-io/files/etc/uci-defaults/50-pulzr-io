#!/bin/sh
# Hand the board's reset button to /usr/libexec/pulzr-reset-button.
#
# procd runs /etc/rc.button/<button> and only that, so the link goes there.
# Made here at first boot rather than shipped, because /etc/rc.button/reset
# belongs to base-files and two packages claiming one path is a file clash that
# fails the image build outright. In the overlay it sits over the stock file,
# and this runs again after every sysupgrade and factory reset.
#
# Before 0.3.6 this wrote a `button` section into /etc/config/system. Nothing
# reads those, so every gateway was on the stock handler. See
# pulzr-reset-button.
#
# The LEDs need no UCI: pulzr-io-daemon drives them directly through sysfs,
# because their states are derived from things (concentrator status, which
# backhaul is up) that no kernel trigger knows about.

# OpenWrt's prepare_rootfs runs every uci-defaults script during image
# assembly, with IPKG_INSTROOT set and absolute paths resolving to the build
# host. Everything below belongs to the device, so defer it to first boot.
[ -n "${IPKG_INSTROOT}" ] && exit 0

. /etc/pulzr/board.conf

# The section an earlier release left behind, so nobody reads it and believes it.
uci -q delete system.reset_button
uci -q commit system

[ -n "${PULZR_BUTTON_RESET}" ] \
    && ln -sf /usr/libexec/pulzr-reset-button "/etc/rc.button/${PULZR_BUTTON_RESET}"

exit 0
