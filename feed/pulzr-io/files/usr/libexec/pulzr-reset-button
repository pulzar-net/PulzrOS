#!/bin/sh
#
# The reset button.
#
#   one short press          report status on the LEDs, and nothing else
#   four short presses       setup mode: raise the setup AP, or refuse (below)
#   any other count          nothing
#   held 2s to hold-threshold  nothing: the release window, so a slip is harmless
#   held past threshold      factory reset
#
# A press is short under 2 seconds. Presses belong to one sequence while no
# more than GAP separates them, and the sequence is read only once the button
# has been left alone for SETTLE seconds.
#
# HOW THIS GETS CALLED
#
# procd runs /etc/rc.button/<button> for a button event, and nothing else:
# hotplug.json has no other route, /etc/hotplug.d/button is not called, and
# nothing in OpenWrt reads a `button` section of /etc/config/system. So this is
# what /etc/rc.button/reset points at, and 50-pulzr-io is what points it.
#
# Until 0.3.6 that script set `system.reset_button.handler` instead, which
# nothing reads, so this file never ran on any gateway. They ran base-files'
# stock handler: a press under a second rebooted, and five seconds factory
# reset without releasing the gateway first.
#
# It stays here rather than being shipped at /etc/rc.button/reset because that
# path is base-files', and two packages claiming one path fails the image build.
#
# OpenWrt calls this with ACTION=pressed, then ACTION=released, with SEEN the
# whole seconds between them. `exit N` from pressed asks for ACTION=timeout N
# seconds later, if the button has not been released by then.
#
# WHY FOUR SHORT PRESSES CANNOT BECOME A FACTORY RESET, OR THE OTHER WAY ROUND
#
# A factory reset is one continuous hold, and a press in a sequence is under 2
# seconds against a threshold of 10: no way of tapping adds up to a hold. Going
# the other way, a held button stops the sequence. Nothing is read while the
# button is down, and a hold of any length past a short press throws the count
# away, so tapping four times and then leaning on the button is a hold.
#
# WHY A SHORT PRESS DOES SOMETHING HARMLESS
#
# Because otherwise the only way to find out what the button does is to hold
# it, and the thing it does when held is destroy the gateway's configuration.
# A button whose safe behaviour is undiscoverable gets discovered unsafely.

. "${PULZR_BOARD_CONF:-/etc/pulzr/board.conf}"

HOLD="${PULZR_BUTTON_RESET_HOLD:-10}"

RUN="${PULZR_BUTTON_RUN:-/var/run/pulzr/button}"
UPTIME="${PULZR_UPTIME:-/proc/uptime}"
MOUNTS="${PULZR_MOUNTS:-/proc/mounts}"

SHORT=2             # a press under this many seconds counts
TAPS=4              # the setup gesture
GAP=250             # hundredths of a second between presses of one sequence
SETTLE="${PULZR_BUTTON_SETTLE:-3}"    # longer than GAP, so it cannot cut one off

LEDS="power status lora lora2 cloud cellular"

led() { /usr/sbin/pulzr-led "$@" 2>/dev/null; }

# Whole hundredths since boot. The wall clock jumps when NTP lands on a board
# with no RTC, and SEEN is in whole seconds, which is too coarse for a gap.
now_cs() {
    local up
    read -r up _ < "${UPTIME}"
    echo "$(( ${up%.*} * 100 + 1${up#*.} - 100 ))"
}

# pulzr-io-daemon rewrites these lights every few seconds. --hold keeps it
# off them while one of these signals is showing.
signal() {
    local state="$1" seconds="$2" name
    led --hold "$(( seconds + 2 ))"
    for name in ${LEDS}; do led "${name}" "${state}"; done
    sleep "${seconds}"
    # The daemon sets power once and flashes lora, so nothing else puts these
    # back. It rewrites the rest on its next pass.
    led power on
    led lora off
    led lora2 off
    led --hold 0
}

status_report() {
    # Three slow pulses if we are manageable, six if not. Readable without a
    # laptop. On the cloud LED where there is one, since that is what it means.
    local name=cloud pulses=6 _
    led --has cloud || name=status
    led --has "${name}" || name=lora
    /usr/sbin/pulzr-backhaul-check >/dev/null 2>&1 && pulses=3
    led --hold "$(( pulses * 2 + 2 ))"
    for _ in $(seq "${pulses}"); do
        led "${name}" on;  sleep 1
        led "${name}" off; sleep 1
    done
    led --hold 0
    logger -t button "status requested from reset button"
}

setup_mode() {
    local answer rc=3
    logger -t button "setup mode requested from reset button"
    if [ -x /usr/sbin/pulzr-ap ]; then
        answer="$(/usr/sbin/pulzr-ap button 2>/dev/null)"
        rc=$?
    fi
    # Raised: pulzr-io-daemon shows the setup code for as long as it is up.
    [ "${rc}" = 0 ] && return 0
    logger -t button "no setup AP: ${answer:-this board has no WiFi}"
    signal alert 6
}

# The sequence has gone quiet, or something later owns it.
settle() {
    local stamp="$1" count last
    sleep "${SETTLE}"
    # Still held, so this is not the end of anything. Its release decides.
    [ -e "${RUN}/down" ] && return 0
    [ -f "${RUN}/taps" ] || return 0
    read -r count last < "${RUN}/taps"
    [ "${last}" = "${stamp}" ] || return 0
    rm -f "${RUN}/taps"

    case "${count}" in
        1)       status_report ;;
        "${TAPS}") setup_mode ;;
        *)       logger -t button "${count} presses of the reset button: no action" ;;
    esac
}

tap() {
    local now count=0 last=0
    now="$(now_cs)"
    [ -f "${RUN}/taps" ] && read -r count last < "${RUN}/taps"
    [ "$(( now - ${last:-0} ))" -le "${GAP}" ] || count=0
    echo "$(( ${count:-0} + 1 )) ${now}" > "${RUN}/taps"

    # Backgrounded: procd runs button events one at a time, so waiting here
    # would hold up the next press until this one had settled.
    settle "${now}" </dev/null >/dev/null 2>&1 &
}

factory_reset() {
    logger -t button -p daemon.warn "factory reset requested from reset button (held ${SEEN}s)"

    # Without an overlay there is nothing to wipe. The release below would then
    # leave a gateway unadopted on its old configuration, for no reset at all.
    if ! grep -q ' /overlay ' "${MOUNTS}"; then
        logger -t button -p daemon.warn "no overlay: nothing to reset"
        return 0
    fi

    # Everything on at once, so it is unmistakable that something drastic
    # is happening and there is a moment to pull power if it was a mistake.
    led --hold 10
    for name in ${LEDS}; do led "${name}" on; done
    sleep 3

    # Release the gateway locally first: this tears down the management
    # tunnel, clears the recovery anchor and the adoption state, and re-enables local
    # sign-in. Doing it before the overlay wipe means a gateway whose
    # firstboot is interrupted still comes back locally reachable rather
    # than adopted-and-unreachable.
    /usr/sbin/pulzr-adopt --release >/dev/null 2>&1

    # factoryreset is 25.12's name for what 24.10 calls jffs2reset.
    if command -v factoryreset >/dev/null 2>&1; then
        factoryreset -y && reboot
    else
        jffs2reset -y && reboot
    fi
}

mkdir -p "${RUN}"

case "${ACTION}" in
pressed)
    : > "${RUN}/down"
    # Acknowledge immediately so the installer knows the button registered.
    led status blink 100 100
    exit "${HOLD}"
    ;;
timeout)
    # Held long enough: letting go now resets. Saying so here means nobody has
    # to count to ten with a paperclip.
    led --hold 15
    for name in ${LEDS}; do led "${name}" on; done
    ;;
released)
    rm -f "${RUN}/down"
    if [ "${SEEN}" -ge "${HOLD}" ]; then
        rm -f "${RUN}/taps"
        factory_reset
    elif [ "${SEEN}" -lt "${SHORT}" ]; then
        tap
    else
        # Released in the dead zone. Say nothing happened, clearly.
        rm -f "${RUN}/taps"
        logger -t button "reset button released after ${SEEN}s: no action (hold ${HOLD}s for factory reset)"
        led --hold 0
        led status heartbeat
    fi
    ;;
esac

exit 0
