#!/bin/sh
#
# Drive one logical LED.
#
#   parkeze-led <name> on|off|blink <ms-on> <ms-off>|flash|heartbeat
#   parkeze-led <name> path wired|cellular|none     which backhaul is carrying us
#   parkeze-led <name> breathe|solid <r|g|b|y|w>    RGB LEDs; plain ones just light
#   parkeze-led --has <name>           exit 0 if that logical LED is really there
#   parkeze-led --list                 what this board actually has
#   parkeze-led --test                 walk every LED, for bring-up
#
# Logical names — power, status, lora, cloud, cellular — are mapped to physical
# LEDs by the board (PARKEZE_LED_* in board.conf). Everything else in the system
# speaks logical names only, so a board with three LEDs and a board with five
# run the same code and a board that lacks one simply does nothing when it is
# asked for.
#
# That last property matters more than it looks: a Pi has two LEDs and a
# RAK7289CV2 has six. Without a mapping layer, every caller would need to know
# which board it is on, and the Pi case would be a pile of conditionals.

. /etc/parkeze/board.conf

LEDS=/sys/class/leds

# Resolve a logical name to a physical LED directory, or empty.
resolve() {
    local logical="$1" physical=""
    case "${logical}" in
        power)    physical="${PARKEZE_LED_POWER}" ;;
        status)   physical="${PARKEZE_LED_STATUS}" ;;
        lora)     physical="${PARKEZE_LED_LORA}" ;;
        lora2)    physical="${PARKEZE_LED_LORA2}" ;;
        cloud)    physical="${PARKEZE_LED_CLOUD}" ;;
        cellular) physical="${PARKEZE_LED_CELLULAR}" ;;
        *)        return 1 ;;
    esac
    [ -n "${physical}" ] || return 1
    case "${physical}" in
        aw2013:*)
            aw_present "$(echo "${physical}" | cut -d: -f2)" \
                       "$(echo "${physical}" | cut -d: -f3)" || return 1
            echo "${physical}"
            return 0 ;;
    esac
    [ -d "${LEDS}/${physical}" ] || return 1
    echo "${LEDS}/${physical}"
}

max_brightness() {
    cat "$1/max_brightness" 2>/dev/null || echo 1
}

# ── the breathing LED ───────────────────────────────────────────────────────
#
# The big light on top of a RAK7268 is not in /sys/class/leds. It is an AW2013
# three-channel driver on I2C, and the "breathing" is the chip's own hardware
# fade — it is told the rise, hold, fall and dark times once and then does it
# forever with no help from us. That is why this is a register write and not a
# userspace loop: a loop would be a wakeup every few dozen milliseconds on a
# board this small. The register map is the vendor's, from breathing_led in the
# stock firmware.
#
# A board maps a logical LED onto it as `aw2013:<i2c bus>:<address>`, e.g.
# PARKEZE_LED_CLOUD="aw2013:0:0x45".

AW_PWM="${PARKEZE_LED_AW2013_PWM:-0xff}"
# Rise/hold and fall/dark, one nibble each, in the chip's steps (0=0.13s,
# 1=0.26s, 2=0.52s, 3=1.04s, 4=2.08s). 0x40/0x41 is 2s up, 2s down and a short
# rest: a slow breath. This is the knob to turn if it reads too twitchy or too
# sleepy on a real unit.
AW_TIMING="${PARKEZE_LED_BREATHE_TIMING:-0x40 0x41}"
AW_CACHE=/var/run/parkeze/led-aw2013

# resolve() runs inside $(...), a subshell, so it cannot hand the bus and
# address back through variables; whoever holds the spec calls this.
aw_select() {
    AW_BUS="$(echo "$1" | cut -d: -f2)"
    AW_ADDR="$(echo "$1" | cut -d: -f3)"
}

aw_w() { i2cset -y "${AW_BUS}" "${AW_ADDR}" "$1" "$2" >/dev/null 2>&1; }

# Register 0x77 reads back 0x45 on this chip; the stock firmware uses the same
# check to decide the LED exists at all, so a board without it stays dark and
# silent instead of writing to whatever else answers at that address.
aw_present() {
    command -v i2cget >/dev/null 2>&1 &&
        [ "$(i2cget -y "$1" "$2" 0x77 2>/dev/null)" = 0x45 ]
}

# Colour is which of the three channels are enabled. y is red+green.
aw_mask() {
    case "$1" in
        r) echo 1 ;; g) echo 2 ;; b) echo 4 ;; y) echo 3 ;; w) echo 7 ;;
        off) echo 0 ;;
        *) return 1 ;;
    esac
}

# aw_show <steady|breathe> <colour|off>
aw_show() {
    local mode="$1" color="$2" mask cfg reg t1 t2 sig
    mask="$(aw_mask "${color}")" || return 1

    # The daemon re-asserts state every few seconds. Sending the same thing
    # again would restart the fade from the bottom each time, which reads as a
    # stutter; only touch the chip when what it should show has changed.
    sig="${mode}:${color}"
    [ "$(cat "${AW_CACHE}" 2>/dev/null)" = "${sig}" ] && return 0

    aw_w 0x01 0x01            # chip on
    aw_w 0x30 0x00            # all channels dark while reconfiguring, so the
                              # ones enabled below start their fade together
    if [ "${mask}" -ne 0 ]; then
        cfg=0x63; [ "${mode}" = breathe ] && cfg=0x73   # 15mA; 0x7_ is breathe
        for reg in 0x31 0x32 0x33; do aw_w "${reg}" "${cfg}"; done
        for reg in 0x34 0x35 0x36; do aw_w "${reg}" "${AW_PWM}"; done
        set -- ${AW_TIMING}; t1="$1"; t2="$2"
        for reg in 0x37 0x3a 0x3d; do aw_w "${reg}" "${t1}"; done
        for reg in 0x38 0x3b 0x3e; do aw_w "${reg}" "${t2}"; done
        for reg in 0x39 0x3c 0x3f; do aw_w "${reg}" 0x50; done
    fi
    aw_w 0x30 "${mask}"

    mkdir -p "$(dirname "${AW_CACHE}")" 2>/dev/null
    echo "${sig}" > "${AW_CACHE}" 2>/dev/null
    return 0
}

# What each generic state means on a light that can do colour.
aw_state() {
    case "$1" in
        path)
            # The same three answers a plain LED gives with on / blink / off,
            # said in colour: breathing is "alive", and which colour is which
            # path. Cellular is yellow because it works but is billed; solid
            # red is deliberately not breathing, so a light that has stopped
            # breathing is itself the signal.
            case "$2" in
                wired)    aw_show breathe b ;;
                cellular) aw_show breathe y ;;
                *)        aw_show steady r ;;
            esac ;;
        breathe) aw_show breathe "${2:-b}" ;;
        solid)   aw_show steady "${2:-w}" ;;
        on)      aw_show steady w ;;
        off)     aw_show steady off ;;
        blink|flash|heartbeat) aw_show breathe w ;;
        *) echo "unknown LED state '$1'" >&2; return 2 ;;
    esac
}

# The braces matter: `echo x > f 2>/dev/null` opens f first, so a failed open
# is reported by the shell before the 2>/dev/null takes effect and the error
# lands in the log anyway. Silencing has to wrap the whole command.
put()     { { echo "$1" > "$2"; } 2>/dev/null; }

case "${1:-}" in
    --has)
        # For the console, which cannot see I2C the way it can list a directory.
        resolve "${2:?usage: parkeze-led --has <name>}" >/dev/null 2>&1
        exit $?
        ;;
    --list)
        printf '%-10s %-24s %s\n' LOGICAL PHYSICAL PRESENT
        for logical in power status lora lora2 cloud cellular; do
            path="$(resolve "${logical}" 2>/dev/null)" && state=yes || state=no
            eval "physical=\${PARKEZE_LED_$(echo "${logical}" | tr '[:lower:]' '[:upper:]')}"
            printf '%-10s %-24s %s\n' "${logical}" "${physical:--}" "${state}"
        done
        echo
        echo "Physical LEDs this kernel exposes:"
        ls -1 "${LEDS}" 2>/dev/null | sed 's/^/  /' || echo "  (none)"
        exit 0
        ;;
    --test)
        # Bring-up aid. The LED map is the single most likely thing in a new
        # board file to be wrong, and this is how you find out in ten seconds
        # rather than by wondering why the cloud light never comes on.
        for logical in power status lora lora2 cloud cellular; do
            path="$(resolve "${logical}" 2>/dev/null)" || continue
            echo "${logical} -> ${path}"
            case "${path}" in
                aw2013:*)
                    aw_select "${path}"
                    for c in r g b; do aw_state solid "${c}"; sleep 1; done
                    aw_state breathe b; sleep 5
                    aw_state off
                    continue ;;
            esac
            put none "${path}/trigger"
            put "$(max_brightness "${path}")" "${path}/brightness"
            sleep 1
            put 0 "${path}/brightness"
        done
        exit 0
        ;;
esac

NAME="${1:?usage: parkeze-led <name> <state>}"
STATE="${2:?usage: parkeze-led <name> <state>}"

path="$(resolve "${NAME}")" || exit 0   # absent LED: not an error, just nothing

case "${path}" in
    aw2013:*)
        aw_select "${path}"
        aw_state "${STATE}" "${3:-}"
        exit $?
        ;;
esac

trigger() { put "$1" "${path}/trigger"; }
bright()  { put "$1" "${path}/brightness"; }

case "${STATE}" in
    on)
        trigger none
        bright "$(max_brightness "${path}")"
        ;;
    off)
        trigger none
        bright 0
        ;;
    blink)
        # Kernel-side timer, so the blink keeps going without a process
        # babysitting it. A userspace blink loop on a gateway is a wakeup every
        # few hundred milliseconds forever, which is a real cost on a board
        # this small.
        trigger timer
        put "${3:-500}" "${path}/delay_on"
        put "${4:-500}" "${path}/delay_off"
        ;;
    flash)
        # A single visible pulse — one uplink, one blink.
        trigger oneshot
        put 1 "${path}/invert"
        put 60 "${path}/delay_on"
        put 60 "${path}/delay_off"
        put 1 "${path}/shot"
        ;;
    heartbeat)
        trigger heartbeat
        ;;
    path)
        # Which backhaul is carrying us, on a light that can only be on, off or
        # blinking. The RGB LED says the same thing in colour (see aw_state).
        case "${3:-}" in
            wired)    trigger none; bright "$(max_brightness "${path}")" ;;
            cellular) trigger timer; put 1000 "${path}/delay_on"; put 1000 "${path}/delay_off" ;;
            *)        trigger none; bright 0 ;;
        esac
        ;;
    breathe|solid)
        # Colour and fading are the RGB LED's; a plain one can only be lit.
        trigger none
        bright "$(max_brightness "${path}")"
        ;;
    *)
        echo "unknown LED state '${STATE}'" >&2
        exit 2
        ;;
esac

exit 0
