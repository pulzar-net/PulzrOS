#!/bin/sh /etc/rc.common
#
# The RAK7289CV2 power board's one owner. Early and respawned, because on the
# newer revision this is what keeps the power on: its watchdog cuts the
# supply ten minutes after the last feed, and the unit in
# chirpstack-gateway-os#155 stayed off until somebody power-cycled it.
# Neither adoption, the network nor the broker gates it.
#
# START=15: right after pulzr-bootprov (14). Nothing here needs the network;
# the daemon waits for the USB bridge itself, which appears when the CH340
# driver loads a few seconds later.

START=15
STOP=90

USE_PROCD=1

start_service() {
    . /etc/pulzr/board.conf
    [ -n "${PULZR_RAK_POWER_USB}" ] || return 0

    procd_open_instance
    procd_set_param command /usr/sbin/pulzr-rak-power run
    # Five seconds and no limit. A daemon that will not stay up is the watchdog
    # going unfed; giving up on it after a few tries is what the power cut does.
    procd_set_param respawn 3600 5 0
    procd_set_param stderr 1
    procd_close_instance
}
