#!/bin/sh /etc/rc.common
#
# Install an SSH key dropped on the boot partition.
#
# WHY THIS EXISTS
#
# A gateway whose web console does not start is reachable only over SSH, and
# SSH needs the per-unit password — which is printed on the label, shown in the
# console, and on the serial MOTD. If the console is the thing that is broken
# and the unit has no serial header populated, there is no way in at all and
# the only remedy is a reflash, which destroys the evidence for whatever went
# wrong.
#
# The FAT boot partition is the way out. Every laptop can read and write it
# with nothing but a card reader; no ext4 driver, no serial adapter, no Linux
# box. Drop a public key on it, boot, and you are in.
#
# WHY IT IS NOT A NEW WAY IN FOR SOMEBODY ELSE
#
# Whoever holds the card already holds the device: the rootfs is on the same
# card, and anything that can mount ext4 can edit /etc/shadow directly. This
# grants no access that physical possession did not already grant — it only
# saves us needing a Linux box to use it.
#
# The one case where it does lower the bar is an attacker who can write the FAT
# partition but not read ext4 — a Windows or macOS laptop. So it is refused on
# an adopted gateway, which is the same rule the setup AP follows in
# docs/access.md: as open as the unit has something to lose. A bench or
# field-prep unit takes the key; a gateway standing in a car park does not, and
# recovers through the signed parkeze.net path instead.

START=14

BOOT_KEYFILE="parkeze-authorized-keys"
MNT="/tmp/.bootpart"

start() {
	. /etc/parkeze/board.conf 2>/dev/null

	[ "${PARKEZE_BOOTPART_KEYS:-1}" = "1" ] || return 0

	# Refused once the gateway has something to lose.
	if [ "$(uci -q get parkeze.adoption.state)" = "adopted" ]; then
		return 0
	fi

	mkdir -p "${MNT}"

	# Mounting IS the filesystem test — no blkid or block-mount needed, and a
	# partition that is not FAT simply fails and we move on. Read-only, so a
	# half-written card cannot be made worse by us touching it.
	local dev found=""
	for dev in /dev/mmcblk0p1 /dev/mmcblk1p1 /dev/sda1 /dev/sdb1; do
		[ -b "${dev}" ] || continue
		if mount -t vfat -o ro,noatime "${dev}" "${MNT}" 2>/dev/null; then
			found="${dev}"
			break
		fi
	done
	[ -n "${found}" ] || { rmdir "${MNT}" 2>/dev/null; return 0; }

	if [ -s "${MNT}/${BOOT_KEYFILE}" ]; then
		# Sanity-check before installing: a truncated or wrong file written
		# into authorized_keys would not fail, it would silently leave the
		# gateway with no working key and look like the feature is broken.
		if grep -qE '^(ssh-(rsa|ed25519)|ecdsa-sha2-)' "${MNT}/${BOOT_KEYFILE}"; then
			mkdir -p /etc/dropbear
			cat "${MNT}/${BOOT_KEYFILE}" > /etc/dropbear/authorized_keys
			chmod 0600 /etc/dropbear/authorized_keys
			# Loudly. A key installed from removable media is exactly the kind
			# of thing that should be visible in the log afterwards.
			logger -t parkeze -p daemon.warn \
				"installed SSH key(s) from ${found}:/${BOOT_KEYFILE}"
		else
			logger -t parkeze -p daemon.err \
				"${BOOT_KEYFILE} on ${found} holds no recognisable public key; ignored"
		fi
	fi

	umount "${MNT}" 2>/dev/null
	rmdir "${MNT}" 2>/dev/null
}
