#!/bin/sh
# Silence the stock OpenWrt banner, and OpenWrt 25.12's opkg-to-apk table.
#
# /etc/profile cats /etc/banner before it sources profile.d, so leaving it in
# place means every login shows OpenWrt's wordmark and then ours. Emptied
# rather than deleted: some tooling expects the file to exist, and an empty
# file is a clearer statement of intent than a missing one.

# OpenWrt's prepare_rootfs runs every uci-defaults script during image
# assembly, with IPKG_INSTROOT set and absolute paths resolving to the build
# host — so unguarded, this truncates the *runner's* /etc/banner, fails on
# permissions, and takes the image build down with it. That was exit code 2.
[ -n "${IPKG_INSTROOT}" ] && exit 0

: > /etc/banner

# Fourteen lines on every login about a package manager nobody at a gateway
# runs: nothing here is installed by hand, and firmware is the only update.
: > /etc/profile.d/apk-cheatsheet.sh
exit 0
