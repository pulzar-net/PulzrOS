#!/bin/sh
#
# Network defaults.
#
# THE SHAPE OF A PARKEZE GATEWAY'S NETWORKING
#
#   lan       the port you plug a laptop into to reach the console. Static,
#             on an unusual /24 so it does not collide with the site.
#   wan       ethernet uplink. CONFIGURED BUT DISABLED, and hidden in the
#             console — see below.
#   wwan      cellular. The default backhaul, enabled out of the box.
#
# WHY ETHERNET WAN EXISTS BUT IS OFF AND HIDDEN
#
# Every gateway we deploy is either cellular-backhauled or is a wired unit that
# parkeze.net configures during adoption. Neither case wants a site technician
# enabling a DHCP client on the WAN port and putting the gateway on a network
# nobody has assessed. So the interface is fully defined — the config is here
# and correct — and simply not brought up, with the console offering no control
# for it. `PARKEZE_WAN_ETH_ENABLED=1` in a board's config is how a wired board
# turns it on at build time, and adoption can turn it on remotely.
#
# It is defined rather than absent because a *disabled* interface can be
# enabled by one UCI set from the management plane, while a missing one needs
# a whole interface definition pushed to a device we may only reach over a
# metered SIM.

# OpenWrt's prepare_rootfs runs every uci-defaults script during image
# assembly, with IPKG_INSTROOT set and absolute paths resolving to the build
# host. Everything below belongs to the device, so defer it to first boot.
[ -n "${IPKG_INSTROOT}" ] && exit 0

. /etc/parkeze/board.conf

# ── The single ethernet port ────────────────────────────────────────────────
#
# Defined as BOTH lan and wan, with exactly one enabled at a time.
# parkeze-port-role decides which when the cable is plugged in, and flips the
# `disabled` flags.
#
# Deliberately NOT a bridge. The stock config puts eth0 in br-lan, and leaving
# it there while also naming eth0 as the wan device means the bridge wins and
# the wan interface never comes up — which is exactly what happened: the
# gateway sat on its static console address and never took a DHCP lease.
#
# A single-port gateway has nothing to bridge anyway.
uci -q batch <<EOF
delete network.device_lan_bridge
delete network.lan
set network.lan=interface
set network.lan.device='${PARKEZE_PORT_IFACE:-eth0}'
set network.lan.proto='static'
set network.lan.ipaddr='${PARKEZE_LAN_IPADDR}'
set network.lan.netmask='${PARKEZE_LAN_NETMASK}'

delete network.wan
set network.wan=interface
set network.wan.device='${PARKEZE_PORT_IFACE:-eth0}'
set network.wan.proto='dhcp'
set network.wan.metric='10'

delete network.wan6
EOF

# Start as wan and disabled-lan. Failing closed matters here: until the probe
# has run we do not know whose network this is, and the expensive mistake is
# answering DHCP on somebody else's.
uci -q batch <<EOF
set network.lan.disabled='1'
set network.wan.disabled='0'
EOF

# ── Always reachable, whichever role it takes ───────────────────────────────
#
# An IPv4 link-local alias plus mDNS, on both roles. A laptop plugged straight
# in self-assigns 169.254.x.x whether or not anything hands out addresses, so
# the console answers at
#
#     https://<hostname>.local
#
# even when the port has decided it is a WAN and is not serving DHCP.
#
# This is what makes it safe for the role probe to be conservative: guessing
# wrong costs a convenience rather than access to the gateway.
uci -q batch <<EOF
delete network.linklocal
set network.linklocal=interface
set network.linklocal.proto='static'
set network.linklocal.device='${PARKEZE_PORT_IFACE:-eth0}'
set network.linklocal.ipaddr='169.254.61.1'
set network.linklocal.netmask='255.255.0.0'
EOF

# ── Cellular ────────────────────────────────────────────────────────────────
# Defined here rather than in parkeze-cellular so that the whole network shape
# is in one file and readable at a glance. parkeze-cellular owns the modem
# lifecycle; this owns what the interface *is*.
#
# A higher metric than wan: when both are up, wired wins and cellular costs
# nothing. When wired is down, cellular is the only default route and carries
# the control plane.
if [ "${PARKEZE_WAN_CELL_ENABLED}" = "1" ]; then
# proto modemmanager, not qmi: OpenWrt 24.10 ships no uqmi, which is what
# provided the qmi proto. ModemManager wants the modem's *sysfs path* in
# `device`, which cannot be known at build time — parkeze-modem-detect fills it
# in on first boot and whenever the modem re-enumerates, and until it does the
# interface simply does not come up.
uci -q batch <<EOF
delete network.wwan
set network.wwan=interface
set network.wwan.proto='modemmanager'
set network.wwan.apn='${PARKEZE_CELL_APN:-iot.1nce.net}'
set network.wwan.auth='none'
set network.wwan.iptype='ipv4'
set network.wwan.metric='20'
set network.wwan.disabled='0'
EOF
fi

# ── Firewall ────────────────────────────────────────────────────────────────
#
# Both uplinks share one wan zone, and NOTHING is accepted from it.
#
# This is the rule that makes a wired backhaul safe. The gateway sits on a
# customer network that we do not control and cannot assess, often with a
# public address behind it. Its console, its SSH and its API must not be
# reachable from there — not on a non-standard port, not "just on the LAN
# side of their router".
#
# Management arrives the other way round: the gateway *originates* a Tailscale
# connection outbound, and gateway-link reaches it back down that tunnel. An
# inbound port on the uplink is never needed and is never opened.
#
# DROP rather than REJECT. REJECT answers with an ICMP error, which confirms
# something is listening; DROP says nothing. On a device whose whole security
# posture is "you cannot reach the management plane from the internet", not
# advertising its presence to a scan is worth the slightly worse debuggability.
uci -q batch <<EOF
set firewall.@zone[0].name='lan'
set firewall.@zone[0].input='ACCEPT'
set firewall.@zone[0].output='ACCEPT'
set firewall.@zone[0].forward='ACCEPT'
set firewall.@zone[0].network='lan'

set firewall.@zone[1].name='wan'
set firewall.@zone[1].input='DROP'
set firewall.@zone[1].output='ACCEPT'
set firewall.@zone[1].forward='DROP'
set firewall.@zone[1].masq='1'
set firewall.@zone[1].mtu_fix='1'
set firewall.@zone[1].network='wan wwan'
EOF

uci commit network
uci commit firewall

exit 0
