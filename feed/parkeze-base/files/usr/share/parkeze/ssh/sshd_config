# sshd's configuration, as the image ships it. parkeze-ssh-setup copies this
# to /etc/ssh/sshd_config at every boot: that file is a package conffile, and
# sysupgrade keeps conffiles, so a change made here would otherwise never reach
# a gateway that had been upgraded once. Edits to /etc/ssh/sshd_config do not
# survive a reboot.

# First, because sshd takes the first value it reads for each keyword: the
# certificate authority and the principals file, written by parkeze-ssh-setup
# only when the image carries a CA and the gateway knows its EUI.
Include /etc/ssh/sshd_config.d/*.conf

Port 22

# The two dropbear made. parkeze-ssh-setup converts dropbear's own on the first
# boot after the switch, so the key parkeze.net pinned is the key presented.
# No ECDSA key is offered, so nothing presents a key nobody pinned.
HostKey /etc/ssh/ssh_host_ed25519_key
HostKey /etc/ssh/ssh_host_rsa_key

# Root by key or certificate, never by password: root has none
# (parkeze-root-keys-only), and a root shell on ParkezeOS is a copy of it, so
# root is Parkeze's fleet key and the certificates parkeze.net signs for staff.
# A technician signs in as `parkeze`, at the end of this file.
PermitRootLogin prohibit-password
PubkeyAuthentication yes
PasswordAuthentication no
PermitEmptyPasswords no
KbdInteractiveAuthentication no
AuthorizedKeysFile .ssh/authorized_keys

# Every unauthenticated connection is an sshd-session process of a megabyte or
# two, on a gateway with 128MB. Bounded so a scan of the site network cannot
# spend the RAM the forwarder needs.
MaxStartups 4:50:10
LoginGraceTime 30
MaxAuthTries 4

# A session over a cellular link that dropped is otherwise a process held
# until TCP gives up, which can be hours.
ClientAliveInterval 60
ClientAliveCountMax 3

# The login banner and the claim QR come from /etc/profile.d, as they did
# under dropbear. sshd printing its own would be the banner twice.
PrintMotd no

# OpenSSH 9 scp speaks SFTP, so this is also what `scp` to a gateway uses.
Subsystem sftp /usr/lib/sftp-server

# `ssh parkeze@<gateway>`: the gateway console, behind the same sign-in the
# web console and the TUI on a port ask for. It is how a technician gets the
# claim code or changes a setting over the site network, where the label's
# password used to open a root shell.
#
# The account has no password of its own and uid 0, because the console runs
# as root on every port and has to (parkeze-ssh-setup makes the account). What
# keeps that safe is that this block runs the TUI and nothing else: whatever
# the client asks for — a command, sftp, a forward — gets the console, and the
# console's `!` needs a Parkeze staff sign-in. PermitRootLogin is here because
# sshd judges uid 0, not the name. Last in the file: everything after a Match
# belongs to it.
Match User parkeze
    PermitRootLogin yes
    PasswordAuthentication yes
    PermitEmptyPasswords yes
    PubkeyAuthentication no
    ForceCommand /usr/sbin/parkeze-tui --console
    PermitTTY yes
    PermitUserRC no
    AllowTcpForwarding no
    AllowStreamLocalForwarding no
    AllowAgentForwarding no
    X11Forwarding no
    PermitTunnel no
