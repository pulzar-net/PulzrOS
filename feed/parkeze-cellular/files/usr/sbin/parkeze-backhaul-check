#!/bin/sh
#
# Is parkeze.net reachable, and by which path?
#
#   parkeze-backhaul-check          exit 0 if manageable, 1 if not
#   parkeze-backhaul-check --json   report both paths
#
# BUDGET
#
# This runs periodically and one of the two paths it tests is billed by the
# megabyte. So the cellular test only asks whether a TCP connection to
# parkeze.net completes: no TLS, no certificate chain. An HTTPS GET to a health
# endpoint is closer to 6KB once the chain is counted, for an answer no better.
#
# It costs about 700 bytes, not the 200 a bare handshake would. The image has
# no tool that can stop at the handshake: BusyBox nc here is the minimal build
# with no -z or -w (so the `nc -w 5 -z` this used to run failed for every host,
# and the cellular path could never test as up), and there is no ucode socket
# module. curl is already a dependency, so it connects in plain HTTP to the
# HTTPS port — ~83 bytes out, a ~400-byte "wrong protocol" reply back — and the
# decision is whether the connection was made, not what came back. Adding
# ucode-mod-socket would get this to the handshake alone, if that difference
# ever matters on a real bill.
#
# The wired path is free, so it gets the fuller check.

. /etc/parkeze/board.conf

JSON=0
[ "$1" = "--json" ] && JSON=1

# Derived from PARKEZE_NET_URL rather than spelled out again. The default here
# used to be a literal `parkeze.net`, which stopped existing when the platform
# moved to net.parkeze.com — it is NXDOMAIN now, so the handshake below could
# never connect and the cellular path tested as down on every gateway whose
# wired path was down. That is precisely the case this check exists for: it is
# what the fallback AP watchdog and the reset-button LED read.
#
# board.conf already calls PARKEZE_NET_URL the one place a host is named. This
# makes that true of the probe as well, so the next move is still one line.
_net_host="${PARKEZE_NET_URL#*://}"
CHECK_HOST="${PARKEZE_HEALTH_HOST:-${_net_host%%/*}}"
CHECK_HOST="${CHECK_HOST:-net.parkeze.com}"
CHECK_PORT="${PARKEZE_HEALTH_PORT:-443}"

# ── wired ───────────────────────────────────────────────────────────────────
# Tailscale's own view is the honest answer for this path: it is the thing we
# actually manage over, so "can tailscaled reach its coordination server" is
# the question, not "does the internet exist".
wired_up=false
ts_state="$(tailscale --socket=/var/run/tailscale/tailscaled.sock status --json 2>/dev/null \
            | jsonfilter -e '@.BackendState' 2>/dev/null)"
[ "${ts_state}" = "Running" ] && wired_up=true

# ── cellular ────────────────────────────────────────────────────────────────
# Only tested if the wired path is down. When Tailscale is up we already know
# we are manageable, and spending cellular bytes to confirm a second path we
# are not using is precisely the waste this whole design avoids.
cell_up=false
if [ "${wired_up}" != "true" ]; then
    if ip link show "$(uci -q get network.wwan.device >/dev/null; echo wwan0)" >/dev/null 2>&1 \
       || ip route show table main | grep -q wwan; then
        # time_connect is 0 unless the TCP handshake completed, whatever curl
        # does afterwards — the far end answering plain HTTP on an HTTPS port
        # with an error is the expected outcome, not a failure. Timeouts cap
        # how long a dead network can hold the link open.
        connected="$(curl -s --connect-timeout 5 --max-time 6 -o /dev/null \
                          -w '%{time_connect}' \
                          "http://${CHECK_HOST}:${CHECK_PORT}/" </dev/null 2>/dev/null)"
        case "${connected}" in
            ''|0|0.0|0.00000|0.000000) ;;
            *) cell_up=true ;;
        esac
    fi
fi

if [ "${JSON}" = 1 ]; then
    printf '{"wired":%s,"cellular":%s,"tailscaleState":"%s","manageable":%s}\n' \
        "${wired_up}" "${cell_up}" "${ts_state:-Unknown}" \
        "$([ "${wired_up}" = true ] || [ "${cell_up}" = true ] && echo true || echo false)"
fi

[ "${wired_up}" = true ] || [ "${cell_up}" = true ]
