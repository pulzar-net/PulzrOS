#!/bin/sh
#
# Point the cellular interface at whatever modem ModemManager found.
#
#   parkeze-modem-detect            find it and write it into UCI
#   parkeze-modem-detect --status   report, change nothing
#
# ── WHY THIS IS NEEDED ─────────────────────────────────────────────────────
#
# OpenWrt's modemmanager netifd proto identifies a modem by its *sysfs path* —
# something like /sys/devices/platform/soc/fe980000.usb/usb1/1-1/1-1.3 — and
# that path depends on which physical port the modem is plugged into. It cannot
# be known when the image is built, and it changes if somebody moves the modem
# to another port.
#
# So the interface ships without a device and this fills it in: on first boot,
# and again on any USB event that looks like a modem.
#
# The older uqmi-based config hardcoded /dev/cdc-wdm0 and did not have this
# problem. 24.10 ships no uqmi, hence the trade.

MM_TIMEOUT="${PARKEZE_MM_TIMEOUT:-30}"

log() { logger -t modem -p daemon.info "$*"; }

command -v mmcli >/dev/null 2>&1 || {
    [ "$1" = "--status" ] && printf '{"present":false,"reason":"ModemManager is not installed."}\n'
    exit 1
}

# ModemManager enumerates asynchronously and a modem can take twenty seconds to
# appear after a cold boot, so this waits rather than concluding there is none.
modem_index=""
waited=0
while [ "${waited}" -lt "${MM_TIMEOUT}" ]; do
    modem_index="$(mmcli -L 2>/dev/null | sed -n 's|.*/Modem/\([0-9]*\).*|\1|p' | head -n1)"
    [ -n "${modem_index}" ] && break
    [ "$1" = "--status" ] && break      # do not block a console page load
    sleep 2
    waited=$((waited + 2))
done

if [ -z "${modem_index}" ]; then
    if [ "$1" = "--status" ]; then
        printf '{"present":false,"reason":"No modem. Normal on a wired-only gateway."}\n'
    else
        log "no modem found after ${waited}s"
        uci -q set parkeze.cellular=cellular
        uci -q set parkeze.cellular.modem_present='0'
        uci commit parkeze
    fi
    exit 1
fi

detail="$(mmcli -m "${modem_index}" 2>/dev/null)"
device_path="$(echo "${detail}" | sed -n 's/.*device: *//p' | head -n1 | tr -d ' ')"
manufacturer="$(echo "${detail}" | sed -n 's/.*manufacturer: *//p' | head -n1)"
model="$(echo "${detail}" | sed -n 's/.*model: *//p' | head -n1)"
imei="$(echo "${detail}" | sed -n 's/.*equipment id: *//p' | head -n1 | tr -d ' ')"

if [ "$1" = "--status" ]; then
    printf '{"present":true,"index":%s,"device":"%s","manufacturer":"%s","model":"%s","imei":"%s"}\n' \
        "${modem_index}" "${device_path}" "${manufacturer}" "${model}" "${imei}"
    exit 0
fi

[ -n "${device_path}" ] || { log "modem ${modem_index} reports no sysfs path"; exit 1; }

current="$(uci -q get network.wwan.device)"
if [ "${current}" != "${device_path}" ]; then
    uci -q set network.wwan.device="${device_path}"
    uci commit network
    log "cellular bound to ${device_path} (${manufacturer} ${model})"
    /sbin/ifup wwan >/dev/null 2>&1
fi

uci -q batch <<EOF
set parkeze.cellular=cellular
set parkeze.cellular.modem_present='1'
set parkeze.cellular.model='${manufacturer} ${model}'
set parkeze.cellular.imei='${imei}'
EOF
uci commit parkeze
exit 0
