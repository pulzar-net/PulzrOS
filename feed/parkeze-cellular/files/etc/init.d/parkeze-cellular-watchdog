#!/bin/sh /etc/rc.common
#
# The cellular watchdog. Late for the same reason as the AP watchdog: its
# first look should not be at a network that has not finished coming up.

START=99
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /usr/sbin/parkeze-cellular-watchdog
    procd_set_param respawn 60 10 0
    procd_close_instance
}
