# Mark everything tailscaled originates, so parkeze-tailscale-route can send it
# to a table that only ever contains the wired default route.
#
# fw4 includes every .nft file in this directory into its own ruleset, so this
# survives a firewall reload — a plain `nft add rule` would not, and the leak
# it would open (marked packets falling through to the main table and out over
# cellular) is silent and expensive.
#
# The mark is applied in the `mangle` output hook at a priority ahead of
# routing, because the routing decision is what we are trying to influence; a
# mark set after routing changes nothing.
#
# skuid matches the *originating socket's* owner, which is what confines the
# encrypted outer traffic to peers and DERP. See parkeze-tailscale-route for
# why matching on the tailscale0 interface instead would confine the wrong
# direction.

chain parkeze_ts_mark {
    type route hook output priority mangle; policy accept;
    meta skuid "tailscale" meta mark set meta mark and 0xffff00ff or 0x9700
}
