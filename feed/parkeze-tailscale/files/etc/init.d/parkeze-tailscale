#!/bin/sh /etc/rc.common
#
# tailscaled, confined to the wired WAN.
#
# Ordered after the network so that the routing table this depends on can
# actually be built, and after parkeze-adopt so that an auth key issued during
# adoption is on disk before we try to use it.

START=96
STOP=10
USE_PROCD=1

PROG=/usr/sbin/tailscaled
STATE_DIR=/etc/parkeze/tailscale
STATE_FILE="${STATE_DIR}/tailscaled.state"
SOCKET=/var/run/tailscale/tailscaled.sock

. /etc/parkeze/board.conf

boot() {
    # On boot the wired WAN is usually not up yet. Start anyway: the hotplug
    # handler applies the route the moment it comes up, and a tailscaled that
    # is already running joins in seconds rather than waiting for the next
    # service poll.
    start
}

NFT_SNIPPET=/etc/nftables.d/20-parkeze-tailscale.nft

write_mark_snippet() {
	# Match tailscaled's sockets by CGROUP, not by uid.
	#
	# The uid version could never have worked. It named a `tailscale` user that
	# no package has ever created, so procd's `user` parameter silently did
	# nothing, tailscaled ran as root, and the rule matched no packets at all —
	# while also being unresolvable at firewall-render time, which took fw4
	# down with it and left the gateway with no firewall whatsoever.
	#
	# Matching uid 0 instead is not an option: that is every packet the system
	# sends. And running tailscaled as a real user means CAP_NET_ADMIN plus
	# opening /dev/net/tun (root-only, 0600) to a non-root group — three moving
	# parts, each a way to break the tunnel, to identify a process procd
	# already isolates for us.
	#
	# procd puts every service in its own cgroup: tailscaled lives in
	# services/parkeze-tailscale/instance1. Level 2 names the parent, so this keeps
	# matching whatever procd calls the instance. Verified on a Pi 3 — the rule
	# counted tailscaled's outbound packets, which the uid version never did.
	#
	# Needs kmod-nft-socket, which is in the board package list for this reason.
	cat > "${NFT_SNIPPET}" <<EOF
# Generated by /etc/init.d/parkeze-tailscale — do not edit.
#
# Mark everything tailscaled originates so parkeze-tailscale-route can send it
# to a table that only ever holds the wired default route.
#
# The mark is applied in the route output hook, ahead of the routing decision,
# because influencing that decision is the whole point; a mark set afterwards
# changes nothing.
#
# Matching the socket's cgroup is what confines the encrypted OUTER traffic to
# peers and DERP. That traffic never traverses tailscale0, so a rule written
# against the interface confines the wrong direction and looks correct right up
# until the SIM bill arrives.
chain parkeze_ts_mark {
	type route hook output priority mangle; policy accept;
	socket cgroupv2 level 2 "services/parkeze-tailscale" meta mark set meta mark and 0xffff00ff or ${PARKEZE_TAILSCALE_MARK:-0x9700}
}
EOF

	# Two things have to be true before nft will even parse the rule, and
	# neither is true on a first boot.
	#
	# The module: nftables pulls nft_socket in when a rule using it is
	# inserted, but `nft -c` only parses, so nothing triggers the autoload.
	modprobe nft_socket 2>/dev/null || true

	# The cgroup: nft resolves the path at PARSE time and fails with
	# "cgroupv2 path fails: No such file or directory" if the directory is not
	# there. This function runs before procd_open_instance, so on a cold boot
	# the service's own cgroup does not exist yet — the check failed, the
	# snippet was discarded, and the gateway came up unconfined. Every manual
	# restart then worked, because the cgroup survived from the previous run.
	#
	# That is the real cause of the boot-only failure adde830 blamed on the
	# module. The modprobe above is still needed; it was just not the reason.
	#
	# Creating it is safe: cgroup2 directories are made with mkdir, and procd
	# puts its instance underneath one that already exists just as happily as
	# one it made itself.
	mkdir -p /sys/fs/cgroup/services/parkeze-tailscale 2>/dev/null || true

	# fw4 loads every snippet atomically, so a rule it cannot parse takes the
	# whole ruleset with it. Check before installing rather than finding out by
	# losing the firewall, which is exactly how this went wrong last time.
	if ! nft -c -f /dev/stdin >/dev/null 2>&1 <<EOF
table inet parkeze_ts_check {
	chain c {
		type route hook output priority mangle; policy accept;
		socket cgroupv2 level 2 "services/parkeze-tailscale" meta mark set 0x9700
	}
}
EOF
	then
		rm -f "${NFT_SNIPPET}"
		logger -t parkeze-tailscale -p daemon.err \
			"kernel will not accept the cgroup match (kmod-nft-socket missing?); tailnet egress is NOT confined and will be stopped when the wired uplink drops"
	fi

	/etc/init.d/firewall restart >/dev/null 2>&1
}

start_service() {
    # The tailscale package ships its OWN init script, and it wins.
    #
    # /etc/init.d/tailscale starts at S80, ours at S96, so on a Pi 3 the stock
    # daemon was the one actually running — `--port 41641 --state
    # /etc/tailscale/tailscaled.state`, no --netfilter-mode=off, its own socket
    # — and every start of ours died on the socket it already held. Which means
    # none of the confinement in this file has ever been in force: not the
    # egress pinning, not the state path, not the netfilter mode. The crash
    # loop that flooded the log ring was this, not a stale socket.
    #
    # Stopped and disabled on every start rather than once in uci-defaults, so
    # reinstalling the tailscale package cannot quietly hand it back.
    if [ -x /etc/init.d/tailscale ]; then
        /etc/init.d/tailscale disable >/dev/null 2>&1 || true
        if /etc/init.d/tailscale running >/dev/null 2>&1; then
            logger -t parkeze-tailscale -p daemon.warn \
                "stopping the stock tailscale service; this gateway is managed by parkeze-tailscale"
            /etc/init.d/tailscale stop >/dev/null 2>&1 || true
            # Give it a moment to release the control socket before we bind it.
            sleep 1
        fi
    fi

    [ "${PARKEZE_TAILSCALE_ENABLED}" = "1" ] || {
        logger -t tailscale "disabled in board configuration"
        return 0
    }

    # What parkeze.net concluded from the facts this gateway reported. A
    # cellular-only unit has no wired path for a tunnel to ride, so running
    # tailscaled on one achieves nothing and spends metered bytes trying.
    #
    # Absent means "nobody has said", which starts: a gateway that has not
    # reported yet — or one that cannot reach parkeze.net at all — must still
    # come up manageable. Only an explicit 0 stops it, and the confinement
    # below is what makes being wrong here harmless either way.
    [ "$(uci -q get parkeze.backhaul.tailscale)" != "0" ] || {
        logger -t tailscale "cellular-only backhaul; tailnet not started"
        return 0
    }

    # Refuse to run if the confinement is not in place. A tailscaled that comes
    # up unconfined on a cellular-only gateway is the one failure mode this
    # whole package exists to prevent, so it fails closed.
    if [ "${PARKEZE_TAILSCALE_ALLOW_CELLULAR}" != "1" ]; then
        parkeze-tailscale-route apply || {
            logger -t tailscale -p daemon.err \
              "could not pin tailnet egress to the wired WAN; refusing to start"
            return 1
        }
    fi

    mkdir -p "${STATE_DIR}" /var/run/tailscale
    # No chown: tailscaled runs as root (it needs the TUN device), and the
    # previous `chown tailscale` named a user nothing creates, so every boot
    # logged "chown: unknown user tailscale" and changed nothing.
    chmod 0700 "${STATE_DIR}"

    # Remove a stale control socket before starting.
    #
    # tailscaled binds this as a unix socket and does not always get to unlink
    # it — a kill -9, a power cut, or a crash leaves the file behind, and the
    # next start dies with 'safesocket.Listen: address already in use'. Under
    # procd respawn that is not a single failure, it is a loop: the daemon
    # exits within a second, procd restarts it five seconds later, forever.
    #
    # Observed on a Pi 3, where it also flooded the log ring fast enough to
    # evict the entire boot sequence — so the failure destroyed the evidence
    # for every other problem on the device.
    #
    # Safe because procd guarantees only one instance: if we are here, no
    # tailscaled of ours is running, so nothing is legitimately bound to it.
    [ -S "${SOCKET}" ] && rm -f "${SOCKET}"

    # The uid-mark snippet is written HERE, at start, and only when the user it
    # names actually exists.
    #
    # It used to ship as a static /etc/nftables.d/20-parkeze-tailscale.nft
    # matching `meta skuid "tailscale"` — a user no package has ever created.
    # fw4 renders every snippet into one ruleset and loads it atomically, so
    # that one unresolvable name meant fw4 loaded NOTHING and the gateway stood
    # on a customer LAN with no firewall at all. A file that can only be
    # correct some of the time does not belong in a directory where being wrong
    # disables everything.
    #
    # Written by numeric uid rather than by name, so rendering never depends on
    # a passwd lookup, and removed outright when the user is absent.
    write_mark_snippet

    procd_open_instance tailscaled
    procd_set_param command "${PROG}" \
        --state="${STATE_FILE}" \
        --socket="${SOCKET}" \
        --no-logs-no-support

    # --netfilter-mode belongs on `tailscale up`, NOT here: tailscaled has no
    # such flag and exits printing its usage when given one. It was added to
    # this command line in 00b9074 to stop the daemon shelling out to iptables,
    # and it has been killing every start of this service ever since — which
    # went unnoticed only because the stock tailscale init was the one actually
    # running. See parkeze-tailscale-up, where the flag now lives.

    # A real kernel TUN, NOT --tun=userspace-networking.
    #
    # Userspace mode was chosen to stop the gateway ever acting as a subnet
    # router or exit node, which is a real concern — a site's parking hardware
    # is not ours to expose. But userspace mode cannot accept *inbound*
    # connections either, and inbound is the entire point: gateway-link reaches
    # the gateway back down the tunnel it opened. With it set, the wired
    # management path did not work at all.
    #
    # The routing concern is handled where it belongs: we never pass
    # --advertise-routes or --advertise-exit-node, so the node offers no route
    # to anything behind it, and the tailnet ACL grants tag:gateway nothing
    # outbound. kmod-tun is already a dependency of the tailscale package.

    # Runs as root, deliberately. tailscaled needs CAP_NET_ADMIN for the TUN
    # device and the routing table, and /dev/net/tun is root-only. Confinement
    # of its egress is the cgroup mark above, not the account it runs under.
    procd_set_param stdout 1
    procd_set_param stderr 1
    # Bounded, not infinite. The third field was 0 — retry forever — so a
    # daemon that could not start at all respawned every five seconds until the
    # device was rebooted, which is how the log ring got flushed. Five attempts
    # in an hour is enough to ride out a transient failure; past that the
    # problem is not transient and the gateway is better off with a quiet log
    # and a stopped service that says so.
    procd_set_param respawn 3600 5 5
    procd_close_instance

    # Bring the node up once the daemon is listening. Done here rather than in
    # a separate service because `tailscale up` is idempotent and cheap, and a
    # second unit that can be started without this one is a way to get a node
    # that is running but never authenticated.
    ( sleep 3; /usr/sbin/parkeze-tailscale-up ) &
}

stop_service() {
    parkeze-tailscale-route flush
}

reload_service() {
    stop
    start
}

service_triggers() {
    procd_add_reload_interface_trigger "${PARKEZE_WAN_ETH_IFACE:-wan}"
    procd_add_config_trigger "config.change" "parkeze" /etc/init.d/parkeze-tailscale reload
}
