#!/bin/sh /etc/rc.common
#
# tailscaled, confined to the wired WAN.
#
# Ordered after the network so that the routing table this depends on can
# actually be built, and after parkeze-adopt so that an auth key issued during
# adoption is on disk before we try to use it.

START=96
STOP=10
USE_PROCD=1

PROG=/usr/sbin/tailscaled
STATE_DIR=/etc/parkeze/tailscale
STATE_FILE="${STATE_DIR}/tailscaled.state"
SOCKET=/var/run/tailscale/tailscaled.sock

. /etc/parkeze/board.conf

boot() {
    # On boot the wired WAN is usually not up yet. Start anyway: the hotplug
    # handler applies the route the moment it comes up, and a tailscaled that
    # is already running joins in seconds rather than waiting for the next
    # service poll.
    start
}

NFT_SNIPPET=/etc/nftables.d/20-parkeze-tailscale.nft

write_mark_snippet() {
	local user uid
	user="${PARKEZE_TAILSCALE_USER:-tailscale}"
	uid="$(awk -F: -v u="${user}" '$1 == u { print $3 }' /etc/passwd 2>/dev/null)"

	if [ -z "${uid}" ]; then
		# No such user, so tailscaled is running as root and a uid match would
		# either never fire or — matching uid 0 — mark every packet the system
		# sends. Both are wrong, so mark nothing and say so: the wired-only
		# guarantee comes from stop-on-loss-of-wired below, not from this.
		if [ -f "${NFT_SNIPPET}" ]; then
			rm -f "${NFT_SNIPPET}"
			/etc/init.d/firewall restart >/dev/null 2>&1
		fi
		logger -t parkeze-tailscale -p daemon.warn \
			"user '${user}' does not exist; tailscaled runs as root and its egress cannot be uid-marked"
		return 0
	fi

	cat > "${NFT_SNIPPET}" <<EOF
# Generated by /etc/init.d/parkeze-tailscale — do not edit.
#
# Mark everything tailscaled originates so parkeze-tailscale-route can send it
# to a table that only ever holds the wired default route.
#
# The mark is applied in the route output hook, ahead of the routing decision,
# because influencing that decision is the whole point; a mark set afterwards
# changes nothing.
#
# skuid matches the originating socket's owner, which is what confines the
# encrypted OUTER traffic to peers and DERP. That traffic never traverses
# tailscale0, so a rule written against the interface confines the wrong
# direction and looks correct right up until the SIM bill arrives.
chain parkeze_ts_mark {
	type route hook output priority mangle; policy accept;
	meta skuid ${uid} meta mark set meta mark and 0xffff00ff or ${PARKEZE_TAILSCALE_MARK:-0x9700}
}
EOF
	/etc/init.d/firewall restart >/dev/null 2>&1
}

start_service() {
    [ "${PARKEZE_TAILSCALE_ENABLED}" = "1" ] || {
        logger -t tailscale "disabled in board configuration"
        return 0
    }

    # Refuse to run if the confinement is not in place. A tailscaled that comes
    # up unconfined on a cellular-only gateway is the one failure mode this
    # whole package exists to prevent, so it fails closed.
    if [ "${PARKEZE_TAILSCALE_ALLOW_CELLULAR}" != "1" ]; then
        parkeze-tailscale-route apply || {
            logger -t tailscale -p daemon.err \
              "could not pin tailnet egress to the wired WAN; refusing to start"
            return 1
        }
    fi

    mkdir -p "${STATE_DIR}" /var/run/tailscale
    chown "${PARKEZE_TAILSCALE_USER:-tailscale}" "${STATE_DIR}" /var/run/tailscale
    chmod 0700 "${STATE_DIR}"

    # Remove a stale control socket before starting.
    #
    # tailscaled binds this as a unix socket and does not always get to unlink
    # it — a kill -9, a power cut, or a crash leaves the file behind, and the
    # next start dies with 'safesocket.Listen: address already in use'. Under
    # procd respawn that is not a single failure, it is a loop: the daemon
    # exits within a second, procd restarts it five seconds later, forever.
    #
    # Observed on a Pi 3, where it also flooded the log ring fast enough to
    # evict the entire boot sequence — so the failure destroyed the evidence
    # for every other problem on the device.
    #
    # Safe because procd guarantees only one instance: if we are here, no
    # tailscaled of ours is running, so nothing is legitimately bound to it.
    [ -S "${SOCKET}" ] && rm -f "${SOCKET}"

    # The uid-mark snippet is written HERE, at start, and only when the user it
    # names actually exists.
    #
    # It used to ship as a static /etc/nftables.d/20-parkeze-tailscale.nft
    # matching `meta skuid "tailscale"` — a user no package has ever created.
    # fw4 renders every snippet into one ruleset and loads it atomically, so
    # that one unresolvable name meant fw4 loaded NOTHING and the gateway stood
    # on a customer LAN with no firewall at all. A file that can only be
    # correct some of the time does not belong in a directory where being wrong
    # disables everything.
    #
    # Written by numeric uid rather than by name, so rendering never depends on
    # a passwd lookup, and removed outright when the user is absent.
    write_mark_snippet

    procd_open_instance tailscaled
    procd_set_param command "${PROG}" \
        --state="${STATE_FILE}" \
        --socket="${SOCKET}" \
        --netfilter-mode=off \
        --no-logs-no-support

    # --netfilter-mode=off: tailscaled otherwise shells out to iptables and
    # ip6tables, which do not exist on this image — OpenWrt 24.10 is fw4 and
    # nftables, and we do not install the legacy binaries. It logged
    # 'executable file not found in $PATH' on every start.
    #
    # Turning it off is correct here rather than merely quiet: the rules
    # tailscaled wants to install are for subnet routing and exit-node
    # forwarding, and this node does neither — it advertises no routes and is
    # not an exit node. The firewall for the tailnet interface is ours, in
    # parkeze-base's 20-parkeze-network.

    # A real kernel TUN, NOT --tun=userspace-networking.
    #
    # Userspace mode was chosen to stop the gateway ever acting as a subnet
    # router or exit node, which is a real concern — a site's parking hardware
    # is not ours to expose. But userspace mode cannot accept *inbound*
    # connections either, and inbound is the entire point: gateway-link reaches
    # the gateway back down the tunnel it opened. With it set, the wired
    # management path did not work at all.
    #
    # The routing concern is handled where it belongs: we never pass
    # --advertise-routes or --advertise-exit-node, so the node offers no route
    # to anything behind it, and the tailnet ACL grants tag:gateway nothing
    # outbound. kmod-tun is already a dependency of the tailscale package.

    procd_set_param user "${PARKEZE_TAILSCALE_USER:-tailscale}"
    procd_set_param stdout 1
    procd_set_param stderr 1
    # Bounded, not infinite. The third field was 0 — retry forever — so a
    # daemon that could not start at all respawned every five seconds until the
    # device was rebooted, which is how the log ring got flushed. Five attempts
    # in an hour is enough to ride out a transient failure; past that the
    # problem is not transient and the gateway is better off with a quiet log
    # and a stopped service that says so.
    procd_set_param respawn 3600 5 5
    procd_close_instance

    # Bring the node up once the daemon is listening. Done here rather than in
    # a separate service because `tailscale up` is idempotent and cheap, and a
    # second unit that can be started without this one is a way to get a node
    # that is running but never authenticated.
    ( sleep 3; /usr/sbin/parkeze-tailscale-up ) &
}

stop_service() {
    parkeze-tailscale-route flush
}

reload_service() {
    stop
    start
}

service_triggers() {
    procd_add_reload_interface_trigger "${PARKEZE_WAN_ETH_IFACE:-wan}"
    procd_add_config_trigger "config.change" "parkeze" /etc/init.d/parkeze-tailscale reload
}
