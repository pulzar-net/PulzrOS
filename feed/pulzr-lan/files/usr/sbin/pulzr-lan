#!/usr/bin/ucode
// The devlan zone: the devices this gateway serves on its LAN ports.
//
//   pulzr-lan apply                          counting and forwarding table,
//                                              and each client's policy rules
//   pulzr-lan status                         JSON: clients, traffic, forwards
//   pulzr-lan policy <mac> parkeze|internet
//   pulzr-lan reserve <mac> <ip> [<name>]    the same address every time
//   pulzr-lan unreserve <mac>
//   pulzr-lan forward <ip> <port> <seconds> [<request id>]
//   pulzr-lan unforward <tunnel port> [<request id>]
//   pulzr-lan expose tcp|udp <port> <ip> [<client port>]
//   pulzr-lan unexpose tcp|udp <port>
//   pulzr-lan cellular <mac> allow|block [tcp:<port>[-<port>] udp:...]
//   pulzr-lan links                          which devices are which uplink
//   pulzr-lan seen <mac> <ip>                from a DHCP event
//   pulzr-lan isolate                        port isolation on every member
//
// ── THE TUNNEL FORWARD ─────────────────────────────────────────────────────
//
// From the management tunnel to one client's TCP port, for a bounded time.
// That is how somebody at Pulzar Cloud opens a PLC's own interface without the
// PLC holding a second connection or the site opening anything.
//
// It lives in a table of our own, inet pulzr_lan, not in fw4's. fw4 rebuilds
// its table on every reload, which would close a forward somebody is using
// and zero every client's counters whenever a WiFi network is joined. The
// expiry is the kernel's: each forward is an element with a timeout, so it
// closes on time with nothing on the gateway having to remember to close it,
// and a reboot closes them all. The guard chain drops a forwarded connection
// the moment its port leaves the open set, so a session already running does
// not outlive its window either.
//
// fw4's mgmt zone forwards nothing, so one rule is added to it
// (/usr/share/pulzr/lan/mgmt-forward.nft): accept what this table marked.
// The mark is set only by the DNAT here, and the DNAT only matches an open
// port.
//
// Every open and close is journalled to /etc/pulzr/lan/forwards.log, as a
// setup AP raise is, and `status` carries the recent entries to Pulzar Cloud.
//
// ── EXPOSED PORTS ──────────────────────────────────────────────────────────
//
// A port on the uplink's own address, forwarded to one client for good: a
// camera or a PLC a customer serves to the internet themselves, through their
// own router's forward to this gateway and their own DNS name (pulzr-dns's
// ddns). Kept in UCI (pulzr.expose_*), loaded into this table by apply.
//
// Only the wired uplinks and the WiFi uplink. Matched on device AND address
// (uplink_in), not on fw4's wan zone, because that zone also holds usbwan, a
// cellular dongle, and the console's addresses on the same port. The tunnel
// never reaches an exposed port, and a connection through one is dropped
// rather than leave on cellular. That is the line: a customer's traffic
// never rides our tunnel or our SIM.
//
// The client must hold a reservation, and keeps it while it is exposed: an
// exposed port to a dynamic address lands on whatever device leases it next.
// Ports the gateway itself answers on its uplink (RESERVED) are refused.
//
// ponytail: replies follow the main routing table. An exposed port answers on
// whichever wired or WiFi uplink carries the default route; arriving on
// another, the reply leaves the wrong way and the connection fails. Mark the
// connection with its uplink and route the reply by mark if a site ever
// needs more than one at once.
//
// fw4's wan zone forwards nothing, so one rule is added to it
// (/usr/share/pulzr/lan/wan-forward.nft), as for the tunnel's.
//
// ── CELLULAR ───────────────────────────────────────────────────────────────
//
// Per client: allowed onto cellular, blocked from it, or allowed except some
// ports. A camera on the internet policy otherwise fails over onto the SIM
// with everything else and spends its data in a day. Matched on the cellular
// devices (wwan, usbwan) by MAC, before fw4 sees the packet, so it holds
// whatever the policy allows. REJECT, as the zone does: a client refused
// fails at once rather than retrying into a link it may not use.
//
// ── COUNTING ───────────────────────────────────────────────────────────────
//
// Per client and per uplink, by nftables: a dynamic set keyed on the client's
// address and the uplink device, with a counter on each element. Counted after
// fw4 has filtered, so a blocked attempt is not traffic. nlbwmon counts per
// client but not per uplink, and per uplink is the question: which client
// spent the SIM's data. Since boot, because the counters live in the kernel.

let fs = require('fs');
let uci = require('uci');

const TABLE = 'pulzr_lan';
const MARK = 0x504b;
const EXPOSE_MARK = 0x5045;
// What the gateway answers on its own uplink address: DHCP renewals, and the
// console, its WiFi sign-in proxy and SSH, which a site may reach it on.
const RESERVED = { tcp: [22, 80, 443, 8443], udp: [67, 68] };
const MAX_EXPOSED = 32;
const MAX_BLOCKS = 16;
// Which netifd interfaces are which, as /usr/share/pulzr/wired.sh and
// cellular.sh have them: wan and wan_<device> are wired (pulzr-ports),
// wwifi the WiFi uplink, wwan the modem and usbwan a dongle or a phone.
const CELLULAR_UPLINKS = ['wwan', 'usbwan'];
let exposeUplink = (name) => name == 'wwifi' || name == 'wan' || index(name, 'wan_') == 0;
// The tunnel-side ports a forward is reached on. Sixteen at once is far more
// than anybody opens; a full range is refused rather than grown.
const FIRST_PORT = 40000;
const LAST_PORT = 40015;
const MAX_SECONDS = 86400;
const STATE = '/etc/pulzr/lan';
const JOURNAL = STATE + '/forwards.log';
const SEEN = STATE + '/seen.json';
const JOURNAL_KEEP = 200;
const JOURNAL_REPORT = 20;
const LEASES = '/tmp/dhcp.leases';

let cursor = uci.cursor();

let die = (msg, code) => {
    warn(msg, '\n');
    exit(code ?? 1);
};

let log = (msg) => system(['logger', '-t', 'lan', '-p', 'daemon.notice', msg]);

// Output of a fixed command, never a shell: every argument is its own argv
// entry, so nothing a caller passed can become part of a command.
let capture = (argv) => {
    let quoted = join(' ', map(argv, (a) => "'" + replace(a, "'", "'\\''") + "'"));
    let proc = fs.popen(quoted + ' 2>/dev/null', 'r');
    if (!proc) return null;
    let out = proc.read('all');
    proc.close();
    return out;
};

let captureJson = (argv) => {
    let out = capture(argv);
    if (!out) return null;
    try { return json(out); } catch (e) { return null; }
};

let nftScript = (text) => {
    let path = sprintf('/tmp/pulzr-lan.%d.nft', time());
    fs.writefile(path, text);
    let rc = system(['nft', '-f', path]);
    fs.unlink(path);
    return rc == 0;
};

// ── addresses ─────────────────────────────────────────────────────────────

let ipToInt = (ip) => {
    let m = match(ip ?? '', /^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$/);
    if (!m) return null;
    let n = 0;
    for (let i = 1; i <= 4; i++) {
        let b = int(m[i]);
        if (b > 255) return null;
        n = n * 256 + b;
    }
    return n;
};

let normalMac = (mac) => {
    mac = lc(mac ?? '');
    return match(mac, /^[0-9a-f]{2}(:[0-9a-f]{2}){5}$/) ? mac : null;
};

let macId = (mac) => replace(mac, /:/g, '');

let lanNet = () => {
    let addr = ipToInt(cursor.get('network', 'devlan', 'ipaddr'));
    let mask = ipToInt(cursor.get('network', 'devlan', 'netmask') ?? '255.255.255.0');
    if (addr == null || mask == null) return null;
    return { addr, mask, net: addr & mask, bcast: (addr & mask) | (~mask & 0xffffffff) };
};

// A client address: inside the LAN, and neither the gateway, the network
// nor the broadcast address.
let clientIp = (ip) => {
    let n = ipToInt(ip), lan = lanNet();
    if (n == null || !lan) return false;
    return (n & lan.mask) == lan.net && n != lan.addr && n != lan.net && n != lan.bcast;
};

let bridge = () => cursor.get('network', 'devlan_dev', 'name') ?? 'br-devlan';

// ── the table ─────────────────────────────────────────────────────────────

let table = () => sprintf(`
table inet ${TABLE} {
	set usage_up { type ipv4_addr . ifname; flags dynamic; counter; }
	set usage_down { type ipv4_addr . ifname; flags dynamic; counter; }
	set forward_open { type inet_service; flags timeout; }
	map forward_to { type inet_service : ipv4_addr . inet_service; flags timeout; }
	set uplink_in { type ifname . ipv4_addr; }
	set cellular_if { type ifname; }
	set expose_open { type inet_proto . inet_service; }
	map expose_to { type inet_proto . inet_service : ipv4_addr . inet_service; }
	set cell_deny { type ether_addr; }
	set cell_block { type ether_addr . inet_proto . inet_service; flags interval; }

	chain dstnat {
		type nat hook prerouting priority dstnat - 5; policy accept;
		iifname "wg0" tcp dport @forward_open ct mark set 0x%x dnat ip to tcp dport map @forward_to
		iifname . ip daddr @uplink_in meta l4proto . th dport @expose_open ct mark set 0x%x dnat ip to meta l4proto . th dport map @expose_to
	}
	chain srcnat {
		type nat hook postrouting priority srcnat - 5; policy accept;
		ct mark 0x%x oifname "%s" masquerade
	}
	chain guard {
		type filter hook forward priority filter - 5; policy accept;
		ct mark 0x%x ct original proto-dst != @forward_open drop
		ct mark 0x%x meta l4proto . ct original proto-dst != @expose_open drop
		ct mark 0x%x oifname @cellular_if drop
		iifname "%s" oifname @cellular_if ether saddr @cell_deny reject
		iifname "%s" oifname @cellular_if ether saddr . meta l4proto . th dport @cell_block reject
	}
	chain account {
		type filter hook forward priority filter + 10; policy accept;
		iifname "%s" update @usage_up { ip saddr . oifname }
		oifname "%s" update @usage_down { ip daddr . iifname }
	}
}
`, MARK, EXPOSE_MARK, MARK, bridge(), MARK, EXPOSE_MARK, EXPOSE_MARK,
   bridge(), bridge(), bridge(), bridge());

// A table from before exposed ports has none of their sets. A gateway gets a
// new one at the reboot an upgrade brings; this is for a package swapped in
// by hand, and it closes any tunnel forward open at the time.
let ensureTable = () => {
    if (length(capture(['nft', 'list', 'set', 'inet', TABLE, 'uplink_in']))) return true;
    if (length(capture(['nft', 'list', 'table', 'inet', TABLE])))
        system(['nft', 'delete', 'table', 'inet', TABLE]);
    return nftScript(table());
};

// ── policy ────────────────────────────────────────────────────────────────
//
// pulzr is the default and has no rules of its own: the zone's rules let
// every client reach Pulzar, NTP and DNS. internet is two rules per client,
// one per uplink zone, matched on its MAC so a new lease does not lose it.

let UPLINK_ZONES = ['wan', 'cellular'];

let applyPolicy = () => {
    let want = {};
    cursor.foreach('pulzr', 'lan_client', (s) => {
        let mac = normalMac(s.mac);
        if (!mac || s.policy != 'internet') return;
        for (let zone in UPLINK_ZONES)
            want[sprintf('lan_inet_%s_%s', macId(mac), zone)] = { mac, zone };
    });

    let have = {};
    cursor.foreach('firewall', 'rule', (s) => {
        if (index(s['.name'], 'lan_inet_') == 0)
            have[s['.name']] = { mac: s.src_mac, zone: s.dest };
    });

    let changed = false;
    for (let name in keys(have)) {
        if (want[name]?.mac == have[name].mac && want[name]?.zone == have[name].zone) continue;
        cursor.delete('firewall', name);
        changed = true;
    }
    for (let name in keys(want)) {
        if (have[name]?.mac == want[name].mac && have[name]?.zone == want[name].zone) continue;
        cursor.set('firewall', name, 'rule');
        cursor.set('firewall', name, 'name', 'LAN-internet-' + macId(want[name].mac));
        cursor.set('firewall', name, 'src', 'devlan');
        cursor.set('firewall', name, 'dest', want[name].zone);
        cursor.set('firewall', name, 'src_mac', want[name].mac);
        cursor.set('firewall', name, 'target', 'ACCEPT');
        changed = true;
    }
    if (changed) {
        cursor.commit('firewall');
        system('/etc/init.d/firewall reload >/dev/null 2>&1', 30000);
    }
    return changed;
};

// A client's section holds its policy and its cellular rules; it goes when
// neither differs from the default.
let saveClient = (mac, set) => {
    let name = 'lan_' + macId(mac);
    let s = cursor.get_all('pulzr', name) ?? {};
    set(s);
    if (s.policy != 'internet' && s.cellular != 'block' && !length(s.cellular_block ?? [])) {
        cursor.delete('pulzr', name);
    } else {
        cursor.set('pulzr', name, 'lan_client');
        cursor.set('pulzr', name, 'mac', mac);
        for (let opt in ['policy', 'cellular', 'cellular_block']) {
            if (s[opt] == null || (type(s[opt]) == 'array' && !length(s[opt])))
                cursor.delete('pulzr', name, opt);
            else
                cursor.set('pulzr', name, opt, s[opt]);
        }
    }
    cursor.commit('pulzr');
};

// "tcp:554" or "udp:5000-5010" as nft writes it, or null.
let blockEntry = (text) => {
    let m = match(text ?? '', /^(tcp|udp):([0-9]{1,5})(-([0-9]{1,5}))?$/);
    if (!m) return null;
    let lo = int(m[2]), hi = m[4] ? int(m[4]) : lo;
    if (lo < 1 || hi > 65535 || hi < lo) return null;
    return { proto: m[1], ports: lo == hi ? sprintf('%d', lo) : sprintf('%d-%d', lo, hi) };
};

let exposed = () => {
    let out = [];
    cursor.foreach('pulzr', 'lan_expose', (s) =>
        push(out, { proto: s.proto, port: int(s.port), ip: s.ip, dport: int(s.dport) }));
    return sort(out, (a, b) => a.port - b.port || (a.proto < b.proto ? -1 : 1));
};

// The uplinks by role, from netifd: the wired and WiFi uplinks' devices and
// addresses, which exposed ports answer on, and the cellular devices.
let links = () => {
    let out = { expose: [], cellular: [] };
    let dump = captureJson(['ubus', 'call', 'network.interface', 'dump']);
    for (let ifc in dump?.interface ?? []) {
        let dev = ifc.l3_device;
        if (!ifc.up || !dev) continue;
        if (exposeUplink(ifc.interface))
            for (let a in ifc['ipv4-address'] ?? [])
                push(out.expose, { uplink: ifc.interface, device: dev, address: a.address });
        if (ifc.interface in CELLULAR_UPLINKS)
            push(out.cellular, dev);
    }
    return out;
};

// Every set this table loads from state, in one transaction: a flush and its
// refill are atomic, so nothing is ever briefly open or briefly unguarded.
let loadSets = () => {
    let l = links(), lines = [];
    let fill = (set, elems) => {
        push(lines, sprintf('flush set inet %s %s', TABLE, set));
        if (length(elems)) push(lines, sprintf('add element inet %s %s { %s }', TABLE, set, join(', ', elems)));
    };
    fill('uplink_in', map(l.expose, (e) => sprintf('"%s" . %s', e.device, e.address)));
    fill('cellular_if', map(uniq(l.cellular), (d) => sprintf('"%s"', d)));

    let open = [], to = [];
    for (let e in exposed()) {
        push(open, sprintf('%s . %d', e.proto, e.port));
        push(to, sprintf('%s . %d : %s . %d', e.proto, e.port, e.ip, e.dport));
    }
    fill('expose_open', open);
    push(lines, sprintf('flush map inet %s expose_to', TABLE));
    if (length(to)) push(lines, sprintf('add element inet %s expose_to { %s }', TABLE, join(', ', to)));

    let deny = [], block = [];
    cursor.foreach('pulzr', 'lan_client', (s) => {
        let mac = normalMac(s.mac);
        if (!mac) return;
        if (s.cellular == 'block') push(deny, mac);
        else for (let text in s.cellular_block ?? []) {
            let b = blockEntry(text);
            if (b) push(block, sprintf('%s . %s . %s', mac, b.proto, b.ports));
        }
    });
    fill('cell_deny', deny);
    fill('cell_block', block);
    return nftScript(join('\n', lines) + '\n');
};

// ── what a client is ──────────────────────────────────────────────────────

let readSeen = () => {
    try { return json(fs.readfile(SEEN) ?? '{}') ?? {}; } catch (e) { return {}; }
};

let writeSeen = (seen) => {
    fs.mkdir(STATE);
    fs.writefile(SEEN + '.tmp', sprintf('%J', seen));
    fs.rename(SEEN + '.tmp', SEEN);
};

let leases = () => {
    let out = [];
    for (let line in split(fs.readfile(LEASES) ?? '', '\n')) {
        let f = split(trim(line), /\s+/);
        if (length(f) < 4 || !clientIp(f[2])) continue;
        push(out, { expires: int(f[0]), mac: normalMac(f[1]), ip: f[2], hostname: f[3] == '*' ? null : f[3] });
    }
    return out;
};

// Who is answering right now: a complete ARP entry on the bridge.
let online = () => {
    let out = {}, dev = bridge();
    for (let line in split(fs.readfile('/proc/net/arp') ?? '', '\n')) {
        let f = split(trim(line), /\s+/);
        if (length(f) >= 6 && f[5] == dev && f[2] == '0x2')
            out[normalMac(f[3])] = f[0];
    }
    return out;
};

// The port each client is behind, from the bridge's own forwarding table.
//
// Not `bridge fdb show`: that also dumps every DSA port's hardware table, and
// on the GL-SFT1200 the mxl-gsw1xx switch answers over MDIO at about six
// seconds a port, holding RTNL the whole time. The console's LAN page took
// twelve seconds, and every request that touched the network behind it (wg,
// ubus network) waited too. The bridge learns the same client addresses in
// software from the frames that reach the CPU, which is every client that has
// asked for a lease, and brforward hands that table over without touching the
// switch: 16 bytes an entry, the MAC, then the port number, then is_local.
let ports = () => {
    let out = {}, dev = bridge(), byNumber = {};
    let dir = sprintf('/sys/class/net/%s/brif', dev);
    for (let name in fs.lsdir(dir) ?? [])
        byNumber[int(trim(fs.readfile(sprintf('%s/%s/port_no', dir, name)) ?? ''), 16)] = name;
    let table = fs.readfile(sprintf('/sys/class/net/%s/brforward', dev)) ?? '';
    for (let at = 0; at + 16 <= length(table); at += 16) {
        if (ord(table, at + 7)) continue;
        let number = ord(table, at + 6) | (ord(table, at + 12) << 8);
        let mac = join(':', map([0, 1, 2, 3, 4, 5], (i) => sprintf('%02x', ord(table, at + i))));
        if (byNumber[number]) out[mac] ??= byNumber[number];
    }
    return out;
};

// Device to the logical uplink it carries, so traffic reads "wan", "wwan"
// and "wwifi" rather than eth0 and phy0-sta0. The uplink port also carries
// the console and link-local interfaces, so the one with a default route
// names it.
let uplinkNames = () => {
    let out = {};
    let dump = captureJson(['ubus', 'call', 'network.interface', 'dump']);
    let routes = (ifc) => length(filter(ifc.route ?? [], (r) => r.target == '0.0.0.0' && r.mask == 0));
    for (let ifc in sort(dump?.interface ?? [], (a, b) => routes(b) - routes(a)))
        if (ifc.l3_device && ifc.interface != 'devlan' && ifc.interface != 'loopback')
            out[ifc.l3_device] ??= ifc.interface;
    // A forward's replies, which netifd does not know as an interface.
    out.wg0 = 'tunnel';
    return out;
};

let counters = (set, names) => {
    let out = {};
    let doc = captureJson(['nft', '-j', 'list', 'set', 'inet', TABLE, set]);
    for (let item in doc?.nftables ?? []) {
        for (let e in item.set?.elem ?? []) {
            let key = e.elem?.val?.concat, c = e.elem?.counter;
            if (!key || !c) continue;
            let uplink = names[key[1]] ?? key[1];
            out[key[0]] ??= {};
            out[key[0]][uplink] ??= { bytes: 0, packets: 0 };
            out[key[0]][uplink].bytes += c.bytes;
            out[key[0]][uplink].packets += c.packets;
        }
    }
    return out;
};

let forwards = () => {
    let out = [];
    let doc = captureJson(['nft', '-j', 'list', 'map', 'inet', TABLE, 'forward_to']);
    for (let item in doc?.nftables ?? []) {
        for (let e in item.map?.elem ?? []) {
            let key = e[0]?.elem, to = e[1]?.concat;
            if (!key || !to) continue;
            push(out, { port: key.val, ip: to[0], dport: to[1], expiresIn: key.expires });
        }
    }
    return out;
};

let journalTail = () => {
    let lines = filter(split(fs.readfile(JOURNAL) ?? '', '\n'), (l) => length(l));
    let out = [];
    for (let line in slice(lines, -JOURNAL_REPORT)) {
        try { push(out, json(line)); } catch (e) { }
    }
    return out;
};

let journal = (entry) => {
    fs.mkdir(STATE);
    let lines = filter(split(fs.readfile(JOURNAL) ?? '', '\n'), (l) => length(l));
    push(lines, sprintf('%J', entry));
    fs.writefile(JOURNAL + '.tmp', join('\n', slice(lines, -JOURNAL_KEEP)) + '\n');
    fs.rename(JOURNAL + '.tmp', JOURNAL);
};

let status = () => {
    let lan = lanNet();
    if (!lan) return { configured: false };

    let clients = {};
    let client = (mac) => (clients[mac] ??= { mac, ip: null, hostname: null, reserved: null,
                                              policy: 'parkeze', cellular: 'allow', cellularBlock: [],
                                              online: false,
                                              firstSeen: null, lastSeen: null, traffic: {} });

    for (let l in leases()) {
        if (!l.mac) continue;
        let c = client(l.mac);
        c.ip = l.ip;
        c.hostname = l.hostname;
        c.leaseExpires = l.expires;
    }
    cursor.foreach('dhcp', 'host', (s) => {
        let mac = normalMac(type(s.mac) == 'array' ? s.mac[0] : s.mac);
        if (!mac || index(s['.name'], 'lan_') != 0) return;
        let c = client(mac);
        c.reserved = s.ip;
        c.hostname ??= s.name;
        c.ip ??= s.ip;
    });
    cursor.foreach('pulzr', 'lan_client', (s) => {
        let mac = normalMac(s.mac);
        if (!mac) return;
        let c = client(mac);
        if (s.policy == 'internet') c.policy = 'internet';
        if (s.cellular == 'block') c.cellular = 'block';
        c.cellularBlock = filter(s.cellular_block ?? [], (t) => blockEntry(t));
    });
    let seen = readSeen(), now = online();
    for (let mac in keys(seen)) {
        let c = client(mac);
        c.firstSeen = seen[mac].first;
        c.lastSeen = seen[mac].last;
    }
    for (let mac in keys(now)) {
        let c = client(mac);
        c.online = true;
        c.ip ??= now[mac];
        c.lastSeen = time();
    }

    let behind = ports();
    for (let mac in keys(clients))
        clients[mac].port = behind[mac] ?? null;

    let names = uplinkNames();
    let up = counters('usage_up', names), down = counters('usage_down', names);
    for (let mac in keys(clients)) {
        let c = clients[mac];
        if (!c.ip) continue;
        for (let uplink in uniq([...keys(up[c.ip] ?? {}), ...keys(down[c.ip] ?? {})]))
            c.traffic[uplink] = { txBytes: up[c.ip]?.[uplink]?.bytes ?? 0,
                                  rxBytes: down[c.ip]?.[uplink]?.bytes ?? 0 };
    }

    return {
        configured: true,
        address: cursor.get('network', 'devlan', 'ipaddr'),
        ports: cursor.get('network', 'devlan_dev', 'ports') ?? [],
        clients: sort(values(clients), (a, b) => (a.ip ?? '') < (b.ip ?? '') ? -1 : 1),
        forwards: forwards(),
        exposed: exposed(),
        // Where exposed ports answer now: the wired and WiFi uplinks'
        // addresses. A private one is behind a site router, which has to
        // forward to it as well.
        exposedOn: map(links().expose, (e) => ({ uplink: e.uplink, address: e.address })),
        journal: journalTail(),
    };
};

// Port isolation in the bridge, so clients on different ports reach each other
// only through the gateway, which forwards nothing between them. netifd has no
// option for it, so it is the kernel's flag, set on every ifup and every time
// a port comes back.
let isolate = () => {
    for (let port in cursor.get('network', 'devlan_dev', 'ports') ?? []) {
        let flag = sprintf('/sys/class/net/%s/brport/isolated', port);
        if (fs.access(flag)) fs.writefile(flag, '1');
    }
};

// A reservation an exposed port points at stays where it is: moved or
// released, the port would follow whatever leases the address next.
let keepExposed = (was, now) => {
    if (!was || was == now) return;
    for (let e in exposed())
        if (e.ip == was) die(sprintf('%s has exposed ports; remove them first', was), 3);
};

// ── commands ──────────────────────────────────────────────────────────────

let commands = {
    apply: () => {
        if (!lanNet()) die('no LAN on this gateway');
        ensureTable() || die('could not load the nftables table');
        loadSets() || die('could not load the exposed ports and cellular rules');
        applyPolicy();
        isolate();
    },

    isolate: () => isolate(),

    // An uplink came up, went down or changed address (hotplug).
    links: () => {
        if (!lanNet()) exit(0);
        (ensureTable() && loadSets()) || die('could not load the uplinks');
    },

    status: () => printf('%J\n', status()),

    policy: (mac, policy) => {
        mac = normalMac(mac) ?? die('a MAC address, like 00:11:22:33:44:55', 2);
        (policy == 'parkeze' || policy == 'internet') || die('policy is parkeze or internet', 2);
        saveClient(mac, (s) => s.policy = policy == 'internet' ? policy : null);
        applyPolicy();
        log(sprintf('%s policy %s', mac, policy));
        printf('%J\n', { mac, policy });
    },

    cellular: (mac, mode, ...blocks) => {
        mac = normalMac(mac) ?? die('a MAC address, like 00:11:22:33:44:55', 2);
        (mode == 'allow' || mode == 'block') || die('cellular is allow or block', 2);
        (length(blocks) <= MAX_BLOCKS) || die(sprintf('at most %d blocked ports', MAX_BLOCKS), 2);
        for (let b in blocks)
            blockEntry(b) || die(sprintf('%s is not tcp:<port> or udp:<port>-<port>', b), 2);
        blocks = mode == 'allow' ? uniq(blocks) : [];
        saveClient(mac, (s) => {
            s.cellular = mode == 'block' ? 'block' : null;
            s.cellular_block = blocks;
        });
        ensureTable() && loadSets() || die('could not load the cellular rules');
        log(sprintf('%s cellular %s%s', mac, mode, length(blocks) ? ' except ' + join(' ', blocks) : ''));
        printf('%J\n', { mac, cellular: mode, cellularBlock: blocks });
    },

    expose: (proto, port, ip, dport) => {
        (proto == 'tcp' || proto == 'udp') || die('tcp or udp', 2);
        port = match(port ?? '', /^[0-9]{1,5}$/) ? int(port) : 0;
        (port >= 1 && port <= 65535) || die('a port from 1 to 65535', 2);
        (port in RESERVED[proto]) && die(sprintf('%s %d is the gateway\'s own', proto, port), 3);
        clientIp(ip) || die('an address on the LAN, other than the gateway', 2);
        dport = dport == null ? port : (match(dport, /^[0-9]{1,5}$/) ? int(dport) : 0);
        (dport >= 1 && dport <= 65535) || die('a client port from 1 to 65535', 2);
        let reserved = false;
        cursor.foreach('dhcp', 'host', (s) => {
            if (s.ip == ip && index(s['.name'], 'lan_') == 0) reserved = true;
        });
        reserved || die(sprintf('reserve %s first', ip), 3);
        let name = sprintf('expose_%s_%d', proto, port);
        (cursor.get('pulzr', name) || length(exposed()) < MAX_EXPOSED)
            || die(sprintf('at most %d exposed ports', MAX_EXPOSED), 3);
        cursor.set('pulzr', name, 'lan_expose');
        cursor.set('pulzr', name, 'proto', proto);
        cursor.set('pulzr', name, 'port', sprintf('%d', port));
        cursor.set('pulzr', name, 'ip', ip);
        cursor.set('pulzr', name, 'dport', sprintf('%d', dport));
        cursor.commit('pulzr');
        ensureTable() && loadSets() || die('could not load the exposed ports');
        journal({ at: time(), op: 'expose', proto, port, ip, dport });
        log(sprintf('exposed %s %d -> %s:%d', proto, port, ip, dport));
        printf('%J\n', { proto, port, ip, dport });
    },

    unexpose: (proto, port) => {
        let name = sprintf('expose_%s_%d', proto ?? '', int(port ?? 0));
        let found = cursor.get_all('pulzr', name) ?? die('nothing exposed on that port', 3);
        cursor.delete('pulzr', name);
        cursor.commit('pulzr');
        ensureTable() && loadSets() || die('could not load the exposed ports');
        journal({ at: time(), op: 'unexpose', proto, port: int(port), ip: found.ip, dport: int(found.dport) });
        log(sprintf('unexposed %s %d', proto, int(port)));
        printf('%J\n', { proto, port: int(port), closed: true });
    },

    reserve: (mac, ip, name) => {
        mac = normalMac(mac) ?? die('a MAC address, like 00:11:22:33:44:55', 2);
        clientIp(ip) || die('an address on the LAN, other than the gateway', 2);
        (name == null || match(name, /^[A-Za-z0-9-]{1,63}$/)) || die('a name is letters, digits and hyphens', 2);
        let section = 'lan_' + macId(mac);
        keepExposed(cursor.get('dhcp', section, 'ip'), ip);
        let taken = null;
        cursor.foreach('dhcp', 'host', (s) => {
            if (s.ip == ip && s['.name'] != section) taken = s['.name'];
        });
        taken && die(sprintf('%s is already reserved', ip), 3);
        cursor.set('dhcp', section, 'host');
        cursor.set('dhcp', section, 'mac', mac);
        cursor.set('dhcp', section, 'ip', ip);
        if (name) {
            cursor.set('dhcp', section, 'name', name);
            cursor.set('dhcp', section, 'dns', '1');
        } else {
            cursor.delete('dhcp', section, 'name');
            cursor.delete('dhcp', section, 'dns');
        }
        cursor.commit('dhcp');
        system('/etc/init.d/dnsmasq reload >/dev/null 2>&1', 30000);
        log(sprintf('%s reserved %s', mac, ip));
        printf('%J\n', { mac, ip, name });
    },

    unreserve: (mac) => {
        mac = normalMac(mac) ?? die('a MAC address, like 00:11:22:33:44:55', 2);
        keepExposed(cursor.get('dhcp', 'lan_' + macId(mac), 'ip'), null);
        cursor.delete('dhcp', 'lan_' + macId(mac));
        cursor.commit('dhcp');
        system('/etc/init.d/dnsmasq reload >/dev/null 2>&1', 30000);
        log(sprintf('%s reservation released', mac));
        printf('%J\n', { mac, ip: null });
    },

    forward: (ip, port, seconds, id) => {
        clientIp(ip) || die('an address on the LAN, other than the gateway', 2);
        port = match(port ?? '', /^[0-9]{1,5}$/) ? int(port) : 0;
        (port >= 1 && port <= 65535) || die('a port from 1 to 65535', 2);
        seconds = match(seconds ?? '', /^[0-9]{1,6}$/) ? int(seconds) : 0;
        (seconds >= 60 && seconds <= MAX_SECONDS) || die(sprintf('from 60 to %d seconds', MAX_SECONDS), 2);
        ensureTable() || die('could not load the nftables table');

        let open = {};
        for (let f in forwards()) open[f.port] = f;
        let tunnel = null;
        for (let p = FIRST_PORT; p <= LAST_PORT && tunnel == null; p++)
            if (!open[p]) tunnel = p;
        tunnel ?? die('every forward is in use', 3);

        // One transaction, so a port is never open without a target.
        nftScript(sprintf('add element inet %s forward_to { %d timeout %ds : %s . %d }\n' +
                          'add element inet %s forward_open { %d timeout %ds }\n',
                          TABLE, tunnel, seconds, ip, port, TABLE, tunnel, seconds))
            || die('could not open the forward');

        let at = time();
        journal({ at, op: 'open', port: tunnel, ip, dport: port, seconds, id });
        log(sprintf('forward %d -> %s:%d open for %ds', tunnel, ip, port, seconds));
        printf('%J\n', { port: tunnel, ip, dport: port, expires: at + seconds });
    },

    unforward: (port, id) => {
        port = match(port ?? '', /^[0-9]{1,5}$/) ? int(port) : 0;
        let found = null;
        for (let f in forwards()) if (f.port == port) found = f;
        found ?? die('no forward on that port', 3);
        nftScript(sprintf('delete element inet %s forward_open { %d }\n' +
                          'delete element inet %s forward_to { %d }\n',
                          TABLE, port, TABLE, port))
            || die('could not close the forward');
        journal({ at: time(), op: 'close', port, ip: found.ip, dport: found.dport, id });
        log(sprintf('forward %d -> %s:%d closed', port, found.ip, found.dport));
        printf('%J\n', { port, closed: true });
    },

    // First and last DHCP contact, kept across reboots and upgrades: a lease
    // file says only when a lease ends, and nothing says when a device first
    // appeared. dnsmasq reports every interface it serves, the setup AP and
    // the USB port among them, so only a LAN address counts.
    seen: (mac, ip) => {
        mac = normalMac(mac) ?? exit(0);
        clientIp(ip) || exit(0);
        let seen = readSeen(), at = time();
        seen[mac] ??= { first: at };
        seen[mac].last = at;
        writeSeen(seen);
    },
};

let cmd = commands[ARGV[0] ?? 'status'];
cmd ?? die('usage: pulzr-lan {apply|status|policy|cellular|reserve|unreserve|forward|unforward|expose|unexpose|links|seen|isolate}', 2);
call(cmd, null, null, ...slice(ARGV, 1));
