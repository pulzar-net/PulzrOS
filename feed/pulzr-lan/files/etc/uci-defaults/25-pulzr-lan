#!/bin/sh
#
# The devlan zone: the LAN ports, and the devices on them.
#
# ── WHY THESE PORTS SERVE DHCP WHEN THE UPLINK PORT NEVER DOES ─────────────
#
# The uplink port does not serve DHCP because nothing on the gateway can tell
# a laptop from a customer's network, and guessing wrong is somebody else's
# outage (20-pulzr-network). A board's LAN ports have no such question: the
# board names them, and what is cabled to one is a device this gateway serves.
#
# ── WHAT A CLIENT CAN REACH ────────────────────────────────────────────────
#
# Modelled on the setup network (60-pulzr-ap, docs/src/content/docs/access.md): its own zone,
# REJECT by default, and nothing that is not named below.
#
#   the gateway    DHCP, DNS and the console's sign-in. Not SSH.
#   each other     nothing: the bridge isolates its ports (pulzr-lan
#                  isolate), and the zone forwards nothing back into itself.
#   the tunnel     nothing. There is no devlan-to-mgmt forwarding, and a
#                  forward the other way exists only while pulzr-lan holds
#                  one open.
#   out            Pulzar, NTP and DNS by default; everything, for a client
#                  whose policy is internet. Over whichever uplink the route
#                  metrics pick, masqueraded.
#
# Pulzar is a set of addresses dnsmasq fills as it answers for Pulzar's
# names, so it follows a move with no rule to change. The names come from
# board.conf's two endpoints, as every other Pulzar host does. A client that
# brings its own resolver bypasses that and reaches nothing.
#
# The console is here so that a laptop on a LAN port can reach it: somebody who
# has moved a gateway has a cable and a port, and on a board with LAN ports the
# uplink port is the one going to the wall. What it reaches is the sign-in page,
# the same one the uplink port offers a cable. Authentication is the boundary
# there and it is here (docs/src/content/docs/access.md), and a device on this port is on a
# network this gateway serves, not a stranger's. 8443 is the WiFi sign-in proxy,
# which goes where the console goes. SSH stays off: a PLC has no business with
# it, and everything a laptop here needs is in the console.
#
# REJECT rather than the uplink's DROP: this is our network, nobody scans it
# from outside, and a PLC told "refused" fails in a second where one dropped
# retries for a minute.

# OpenWrt's prepare_rootfs runs every uci-defaults script during image
# assembly, with IPKG_INSTROOT set and absolute paths resolving to the build
# host. Everything below belongs to the device, so defer it to first boot.
[ -n "${IPKG_INSTROOT}" ] && exit 0

. /etc/pulzr/board.conf

[ -n "${PULZR_LAN_PORTS}" ] || exit 0

# The registrable domain of each Pulzar endpoint, and dnsmasq matches a domain's
# subdomains too. The image's own endpoints and the broker the gateway was
# actually given: an upgraded gateway keeps the host adoption handed it, which
# may be an older name (net.parkeze.com, mqtt.parkeze.com) than the image's.
domains=""
for host in "${PULZR_NET_URL}" "${PULZR_MQTT_HOST}" "$(uci -q get pulzr.mqtt.host)"; do
	[ -n "${host}" ] || continue
	host="${host#*://}"; host="${host%%/*}"; host="${host%%:*}"
	domain="$(echo "${host}" | awk -F. 'NF >= 2 { print $(NF-1) "." $NF }')"
	case " ${domains} " in *" ${domain} "*) ;; *) domains="${domains} ${domain}" ;; esac
done

# Any stock bridge holding these ports goes. A router's default config puts
# its LAN ports in br-lan, and 20-pulzr-network has already removed the lan
# interface that used it.
for dev in $(uci -q show network | sed -n 's/^network\.\([^.=]*\)=device$/\1/p'); do
	[ "$(uci -q get "network.${dev}.name")" = "br-lan" ] && uci -q delete "network.${dev}"
done

uci -q batch <<EOF
delete network.devlan_dev
set network.devlan_dev=device
set network.devlan_dev.name='br-devlan'
set network.devlan_dev.type='bridge'
$(for port in ${PULZR_LAN_PORTS}; do echo "add_list network.devlan_dev.ports='${port}'"; done)

delete network.devlan
set network.devlan=interface
set network.devlan.device='br-devlan'
set network.devlan.proto='static'
set network.devlan.ipaddr='${PULZR_DEVLAN_IPADDR}'
set network.devlan.netmask='255.255.255.0'

delete dhcp.devlan
set dhcp.devlan=dhcp
set dhcp.devlan.interface='devlan'
set dhcp.devlan.start='100'
set dhcp.devlan.limit='100'
set dhcp.devlan.leasetime='12h'
set dhcp.devlan.dhcpv6='disabled'
set dhcp.devlan.ra='disabled'

delete dhcp.pulzr_dst
set dhcp.pulzr_dst=ipset
add_list dhcp.pulzr_dst.name='pulzr_dst'
set dhcp.pulzr_dst.family='4'
$(for domain in ${domains}; do echo "add_list dhcp.pulzr_dst.domain='${domain}'"; done)

delete firewall.pulzr_dst
set firewall.pulzr_dst=ipset
set firewall.pulzr_dst.name='pulzr_dst'
set firewall.pulzr_dst.family='ipv4'
add_list firewall.pulzr_dst.match='dest_ip'

delete firewall.devlan
set firewall.devlan=zone
set firewall.devlan.name='devlan'
set firewall.devlan.network='devlan'
set firewall.devlan.input='REJECT'
set firewall.devlan.output='ACCEPT'
set firewall.devlan.forward='REJECT'

delete firewall.devlan_dhcp
set firewall.devlan_dhcp=rule
set firewall.devlan_dhcp.name='Allow-LAN-DHCP'
set firewall.devlan_dhcp.src='devlan'
set firewall.devlan_dhcp.proto='udp'
set firewall.devlan_dhcp.dest_port='67'
set firewall.devlan_dhcp.target='ACCEPT'

delete firewall.devlan_console
set firewall.devlan_console=rule
set firewall.devlan_console.name='Allow-LAN-console'
set firewall.devlan_console.src='devlan'
set firewall.devlan_console.proto='tcp'
set firewall.devlan_console.dest_port='80 443 8443'
set firewall.devlan_console.target='ACCEPT'

delete firewall.devlan_mdns
set firewall.devlan_mdns=rule
set firewall.devlan_mdns.name='Allow-LAN-mDNS'
set firewall.devlan_mdns.src='devlan'
set firewall.devlan_mdns.proto='udp'
set firewall.devlan_mdns.dest_port='5353'
set firewall.devlan_mdns.target='ACCEPT'

delete firewall.devlan_dns
set firewall.devlan_dns=rule
set firewall.devlan_dns.name='Allow-LAN-DNS'
set firewall.devlan_dns.src='devlan'
set firewall.devlan_dns.proto='tcp udp'
set firewall.devlan_dns.dest_port='53'
set firewall.devlan_dns.target='ACCEPT'

set firewall.cellular.masq='1'

delete firewall.lan_forward
set firewall.lan_forward=include
set firewall.lan_forward.type='nftables'
set firewall.lan_forward.path='/usr/share/pulzr/lan/mgmt-forward.nft'
set firewall.lan_forward.position='chain-pre'
set firewall.lan_forward.chain='forward_mgmt'

delete firewall.lan_expose
set firewall.lan_expose=include
set firewall.lan_expose.type='nftables'
set firewall.lan_expose.path='/usr/share/pulzr/lan/wan-forward.nft'
set firewall.lan_expose.position='chain-pre'
set firewall.lan_expose.chain='forward_wan'
EOF

# The default policy, per uplink zone: Pulzar over HTTPS and MQTT, and NTP.
for zone in wan cellular; do
	uci -q batch <<EOF
delete firewall.devlan_pulzr_${zone}
set firewall.devlan_pulzr_${zone}=rule
set firewall.devlan_pulzr_${zone}.name='Allow-LAN-Pulzar-${zone}'
set firewall.devlan_pulzr_${zone}.src='devlan'
set firewall.devlan_pulzr_${zone}.dest='${zone}'
set firewall.devlan_pulzr_${zone}.proto='tcp'
set firewall.devlan_pulzr_${zone}.dest_port='443 8883'
set firewall.devlan_pulzr_${zone}.ipset='pulzr_dst'
set firewall.devlan_pulzr_${zone}.target='ACCEPT'

delete firewall.devlan_ntp_${zone}
set firewall.devlan_ntp_${zone}=rule
set firewall.devlan_ntp_${zone}.name='Allow-LAN-NTP-${zone}'
set firewall.devlan_ntp_${zone}.src='devlan'
set firewall.devlan_ntp_${zone}.dest='${zone}'
set firewall.devlan_ntp_${zone}.proto='udp'
set firewall.devlan_ntp_${zone}.dest_port='123'
set firewall.devlan_ntp_${zone}.target='ACCEPT'
EOF
done

# dnsmasq is bound to loopback by pulzr-base; the LAN bridge is one more
# interface it serves.
uci -q del_list dhcp.@dnsmasq[0].interface='br-devlan'
uci -q add_list dhcp.@dnsmasq[0].interface='br-devlan'

uci commit network
uci commit dhcp
uci commit firewall

/etc/init.d/pulzr-lan enable
exit 0
