#!/bin/sh /etc/rc.common
#
# Which management ports the LAN's clients answer on, every fifteen minutes
# and soon after a new lease: see `pulzr-lan scan`.

START=97
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /usr/sbin/pulzr-lan scan-service
    procd_set_param respawn 3600 5 0
    procd_close_instance
}
