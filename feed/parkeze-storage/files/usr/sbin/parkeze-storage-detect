#!/bin/sh
#
# Find removable storage, mount it, and record it in UCI.
#
#   parkeze-storage-detect            find it, mount it, write UCI
#   parkeze-storage-detect --dry-run  say what it would do, change nothing
#   parkeze-storage-detect --umount   unmount it and record it as gone
#
# ── WHY THIS EXISTS ────────────────────────────────────────────────────────
#
# A WisGate ships with an SD card in a slot on the side and nothing in this
# image has ever looked at it. That is ~30GB sitting unused on the board whose
# 32MB of soldered flash is the reason half the decisions in this repo are
# what they are — and it is the only place on a RAK large enough to hold a
# copy of the firmware we are about to overwrite, which is the thing that
# makes an automatic rollback possible there at all. See docs/firmware.md.
#
# ── THE RULE THAT MATTERS MORE THAN ANY OTHER HERE ─────────────────────────
#
# Never touch the disk the system is running from.
#
# On a RAK that is not a risk: root is squashfs on MTD and the card is the
# only block device in the machine. On a Pi it very much is — a Pi boots from
# mmcblk0 and keeps its overlay there too, so "mount the SD card" on a Pi
# means "mount the disk we are running from", and anything this script might
# later be extended to do to a card it owns (format it, fsck it, fill it) is
# then being done to the rootfs of every Pi in the fleet.
#
# So a candidate is not chosen by device name, by the kernel's `removable`
# flag, or by which board we think we are. It is chosen by elimination:
# whatever disk is backing /, /rom, /overlay or /boot is struck off, and only
# what remains is eligible. That rule needs no per-board knowledge, and it
# cannot be wrong about a board nobody has tried yet.
#
# ── AND IT CAN BE PULLED OUT ───────────────────────────────────────────────
#
# It is a card in a slot, so it is absent, yanked mid-write, worn out, or
# read-only as often as it is fine. Nothing on it is ever load-bearing: this
# writes what it found and returns non-zero when there is nothing, every
# caller treats storage as an optimisation, and the gateway that has none
# behaves exactly like the gateway that does, only without the extras.

. /lib/functions.sh

MOUNT_POINT=/mnt/storage

DRY_RUN=0
[ "$1" = "--dry-run" ] && DRY_RUN=1

log() { logger -t storage -p daemon.info "$*"; [ "${DRY_RUN}" = 1 ] && echo "$*" >&2; }

# The whole disk a partition belongs to. mmcblk0p1 -> mmcblk0, sda1 -> sda.
#
# Two rules because the kernel has two naming conventions: anything whose name
# ends in a digit takes a `p` before the partition number (mmcblk, nvme, loop),
# and the SCSI-style names do not.
parent_disk() {
    case "$1" in
        mmcblk*p[0-9]*|nvme*p[0-9]*|loop*p[0-9]*) echo "${1%p[0-9]*}" ;;
        sd[a-z]*[0-9]*|vd[a-z]*[0-9]*|hd[a-z]*[0-9]*) echo "${1%%[0-9]*}" ;;
        *) echo "$1" ;;
    esac
}

# Every disk the running system depends on, as whole-disk names.
#
# Read from /proc/mounts rather than assumed from the board, so a board that
# boots some way nobody here anticipated still protects itself. /rom and
# /overlay are named explicitly because on OpenWrt they are the squashfs and
# the writable layer that / is assembled from — / itself is an overlayfs whose
# own device field says nothing useful.
system_disks() {
    local device mount rest name
    while read -r device mount rest; do
        case "${mount}" in
            /|/rom|/overlay|/boot) ;;
            *) continue ;;
        esac
        case "${device}" in
            /dev/*) ;;
            *) continue ;;      # overlayfs, tmpfs, ubi — not a block disk
        esac
        # Resolved, because / is very often /dev/root, which is a symlink to
        # the real partition. Left unresolved it contributes the useless name
        # "root" and the disk it actually stands for goes unprotected. On a
        # standard OpenWrt squashfs board /rom and /overlay name the real
        # devices anyway, so this only matters on a plain-rootfs layout — but
        # that is exactly the layout where it is the only thing protecting it.
        name="$(readlink -f "${device}" 2>/dev/null || echo "${device}")"
        parent_disk "${name#/dev/}"
    done < /proc/mounts
}

in_use() {
    local candidate="$1" used
    for used in $(system_disks); do
        [ "${candidate}" = "${used}" ] && return 0
    done
    return 1
}

# What we could mount, best candidate first.
#
# A partition is preferred over the whole disk: a card that has been through
# any normal formatting tool has one, and mounting the raw disk when it has a
# partition table mounts nothing useful. The bare disk is still offered as a
# fallback because a card written with `mkfs` straight onto the device is a
# thing people do and it is perfectly mountable.
candidates() {
    local disk part
    for disk in /sys/block/*; do
        disk="$(basename "${disk}")"
        case "${disk}" in
            mmcblk*|sd[a-z]|nvme*) ;;
            *) continue ;;      # mtdblock, loop, ram
        esac
        in_use "${disk}" && continue

        for part in /sys/block/"${disk}"/"${disk}"*; do
            [ -d "${part}" ] || continue
            echo "/dev/$(basename "${part}")"
        done
        echo "/dev/${disk}"
    done
}

# ── mounting ────────────────────────────────────────────────────────────────

# umask on vfat because it has no permissions of its own: without it every
# file we put on the card is world-readable, and some of what goes there —
# config backups above all — has no business being.
mount_one() {
    local device="$1"
    mkdir -p "${MOUNT_POINT}"

    mount -t ext4 -o rw,noatime "${device}" "${MOUNT_POINT}" 2>/dev/null && return 0
    mount -t vfat -o rw,noatime,umask=0077 "${device}" "${MOUNT_POINT}" 2>/dev/null && return 0
    # Last resort: let the kernel pick. Anything it mounts that the two above
    # did not is something we did not plan for, which is worth having rather
    # than refusing, but is reported as whatever it turned out to be.
    mount -o rw,noatime "${device}" "${MOUNT_POINT}" 2>/dev/null
}

fstype_of() {
    awk -v m="${MOUNT_POINT}" '$2 == m { print $3; exit }' /proc/mounts
}

mounted_device() {
    awk -v m="${MOUNT_POINT}" '$2 == m { print $1; exit }' /proc/mounts
}

# A card that has worn out stops accepting writes and says nothing about it —
# it just goes read-only, and every later write fails at the moment it is
# needed. Cheaper to find out now, with one file, than when a rollback is
# trying to save the gateway.
writable() {
    local probe="${MOUNT_POINT}/.parkeze-write-test"
    echo parkeze > "${probe}" 2>/dev/null || return 1
    [ "$(cat "${probe}" 2>/dev/null)" = "parkeze" ] || { rm -f "${probe}"; return 1; }
    rm -f "${probe}" 2>/dev/null
    return 0
}

blocks_mb() {
    # df -k, second/fourth columns, in MB. Busybox df has no -BM.
    df -k "${MOUNT_POINT}" 2>/dev/null | awk 'NR == 2 { printf "%d %d\n", $2 / 1024, $4 / 1024 }'
}

# Committing rewrites the package file even when no value differs, and procd's
# config.change trigger on "parkeze" watches it — which restarts the LoRa stack.
# This script runs from hotplug, so a card that re-enumerates a few times on a
# bad contact would otherwise restart the forwarder once per event. See
# parkeze-gps-detect for the version of this that ate itself in a loop.
changed=0
put() {
    [ "$(uci -q get "parkeze.$1")" = "$2" ] && return 0
    uci -q set "parkeze.$1=$2"
    changed=1
}

record_absent() {
    [ "${DRY_RUN}" = 1 ] && { echo "no removable storage"; return 0; }
    put storage storage
    put storage.present 0
    put storage.device ''
    put storage.mount ''
    put storage.fstype ''
    put storage.writable 0
    [ "${changed}" = 1 ] && uci commit parkeze
    return 0
}

# ── unmount ─────────────────────────────────────────────────────────────────

if [ "$1" = "--umount" ]; then
    # Lazy, because the card may already be physically gone: a plain umount
    # of a mount whose device has vanished blocks on IO that will never
    # complete, and this runs from a hotplug event that must not hang.
    umount -l "${MOUNT_POINT}" 2>/dev/null
    log "storage unmounted"
    record_absent
    exit 0
fi

# ── detect ──────────────────────────────────────────────────────────────────

# Already mounted from an earlier run or a hotplug event: re-record rather
# than remount, so this is safe to call as often as anything likes.
existing="$(mounted_device)"

# Unless what it is mounted from has gone. A card pulled out of the slot does
# not always produce a clean remove event — and when it does not, the mount
# stays behind pointing at a device that no longer exists. Every read on it
# blocks and every write fails, while this would otherwise go on reporting
# present=1 and a rollback would go on believing it had somewhere to write.
# Checking the device node still exists is the cheapest way to tell the
# difference between a card that is there and the memory of one that was.
if [ -n "${existing}" ] && [ ! -b "${existing}" ]; then
    log "${existing} is mounted but gone — the card was pulled"
    umount -l "${MOUNT_POINT}" 2>/dev/null
    existing=""
fi

if [ -z "${existing}" ]; then
    for device in $(candidates); do
        [ -b "${device}" ] || continue
        if [ "${DRY_RUN}" = 1 ]; then
            echo "would mount ${device} at ${MOUNT_POINT}"
            exit 0
        fi
        if mount_one "${device}"; then
            log "mounted ${device} at ${MOUNT_POINT} ($(fstype_of))"
            existing="${device}"
            break
        fi
        log "${device} would not mount"
    done
fi

if [ -z "${existing}" ]; then
    log "no removable storage found"
    record_absent
    exit 1
fi

[ "${DRY_RUN}" = 1 ] && { echo "${existing} at ${MOUNT_POINT} ($(fstype_of))"; exit 0; }

# Ours, kept in one place so everything else that writes here agrees where
# things go and a person reading the card can tell what put them there.
mkdir -p "${MOUNT_POINT}/parkeze/firmware" "${MOUNT_POINT}/parkeze/backups" 2>/dev/null

if writable; then
    is_writable=1
else
    is_writable=0
    log "WARNING: ${existing} mounted read-only or failed a write test — a worn card does this"
fi

set -- $(blocks_mb)
put storage storage
put storage.present 1
put storage.device "${existing}"
put storage.mount "${MOUNT_POINT}"
put storage.fstype "$(fstype_of)"
put storage.writable "${is_writable}"
put storage.size_mb "${1:-0}"
put storage.free_mb "${2:-0}"
[ "${changed}" = 1 ] && uci commit parkeze

exit 0
