#!/bin/sh
#
# Work out what is in each concentrator slot, and record it in UCI.
#
#   pulzr-concentrator-detect            probe and write UCI
#   pulzr-concentrator-detect --dry-run  probe and print, change nothing
#
# SLOTS
#
# A gateway has one or more slots; a slot is one SX130x and the eight channels
# it carries. An 8-channel gateway has one, a RAK7289CV2 has two. The board
# declares them in PULZR_CONCENTRATOR_SLOTS — see boards/common/board.conf.
#
# A slot is either fixed ("spi:/dev/spidev0.0:17") or "auto". Fixed slots are
# not probed at all: on a product the hardware cannot change, and asking a
# question we already know the answer to only adds a way to get it wrong. Auto
# slots are what a Pi has, where somebody can swap a HAT for a USB stick
# between boots.
#
# NO BUS IS PREFERRED. SPI, USB and UART are all normal on a Pi. The probe
# order is cheapest-first — it is about how long detection takes, not about
# which hardware we expect to find — and an operator override always wins over
# whatever the probe concluded.
#
# A board can also declare more than one auto slot ("auto auto") for a kit
# that genuinely may carry two concentrators at once on different buses — a
# USB RAK5146 alongside an SPI Waveshare HAT, say. Each auto slot is probed in
# turn, and a bus an earlier slot already found hardware on is skipped by the
# ones after it: an SX130x answers on the one bus it is wired to, not two, so
# there is nothing left there for a later slot to find, and trying anyway is
# how the same USB stick would end up recorded in both slots while the SPI HAT
# next to it was never even probed.

. /lib/functions.sh
. /etc/pulzr/board.conf

DRY_RUN=0
[ "$1" = "--dry-run" ] && DRY_RUN=1

# Stderr under --dry-run, not stdout: every probe function is called through
# $(...) to capture its one-line result, and a log line written to stdout from
# inside one of them lands in that capture instead of the terminal — the
# result garbled with its own diagnostic, on a failed probe specifically,
# which is the one case somebody running --dry-run is trying to read.
log() { logger -t concentrator -p daemon.info "$*"; [ "${DRY_RUN}" = 1 ] && echo "$*" >&2; }

PROFILE_DIR=/usr/share/pulzr/concentrator

# ── Probes ──────────────────────────────────────────────────────────────────
#
# Each probe echoes a model id and returns 0, or returns 1. Model ids are the
# keys under ${PROFILE_DIR} — a probe that invents an id with no matching
# profile produces a gateway that detects hardware and then cannot configure
# it, so keep the two in step.

# The radios pulzr-probe found (pulzr-probe in every image, see
# pulzr-radios). Scanned first, so a stick plugged in a second ago is in it;
# with this add-on installed the scan names a concentrator and never asks it
# anything (--claimed lorawan), so it is cheap and harmless to repeat.
PROBE_REPORT="${PULZR_PROBE_REPORT:-/var/run/pulzr-probe/radios.json}"

probe_usb() {
    # A concentrator on USB is one pulzr-probe names: Semtech's USB reference
    # design, as a RAK5146 USB enumerates (radios.json in pulzr-edge). Never a
    # bare CP210x or CH9102: those are in Zigbee sticks and RS-485 adapters as
    # well, and this used to take an unlabelled CP210x for a concentrator.
    # Echoes the model id and the device node, which pulzr-lora-config hands
    # concentratord: the node pulzr-probe saw, never the first ttyACM going,
    # which on a gateway with a Zigbee stick as well could be the stick.
    pulzr-radios scan --quiet >/dev/null 2>&1
    local path
    path="$(jsonfilter -i "${PROBE_REPORT}" \
        -e '@.detected[@.protocol="lorawan" && @.bus="usb"].path' 2>/dev/null | head -n1)"
    [ -n "${path}" ] && [ -c "${path}" ] || return 1
    echo "sx1302_usb ${path}"
}

probe_spi() {
    # An SX130x on SPI cannot be enumerated: SPI has no discovery. pulzr-probe
    # resets the part with the pins one specific profile claims and reads its
    # version register (pulzr-probe sx130x), holding the lines only for the
    # read, so concentratord finds them free.
    #
    # One profile's pins, not a sweep of plausible ones. That used to mean
    # trying GPIO 4-27 in turn to find whichever line the fitted HAT actually
    # resets on, which worked — and also reset whatever else on the board used
    # one of those lines for something else. Measured on a Waveshare HAT,
    # where the sweep put its own GNSS into standby, because the same pins
    # this scheme was guessing through are the HAT's GNSS control lines. A
    # profile carries exactly the pins its part uses and nothing it does not.
    local spidev="$1" reset="$2" power="$3" sx1261="$4" ad5338r="$5" chip
    [ -c "${spidev}" ] || { log "no ${spidev}"; return 1; }
    chip="$(pulzr-probe sx130x --gpiochip "/dev/${PULZR_GPIOCHIP:-gpiochip0}" \
        --spi "${spidev}:${reset:--}:${power:--}${sx1261:+:${sx1261}}${ad5338r:+:${ad5338r}}" 2>/dev/null \
        | jsonfilter -e '@.chip' 2>/dev/null)"
    case "${chip}" in
        SX1302) echo "sx1302_spi" ;;
        SX1303) echo "sx1303_spi" ;;
        SX1301) echo "sx1301_spi" ;;
        *) log "nothing answered on ${spidev} with reset GPIO${reset:-none}"; return 1 ;;
    esac
}

probe_uart() {
    # The UART parts speak the register protocol wrapped in a framing layer
    # nothing here implements, so this cannot confirm one is there.
    #
    # It is NOT skipped for that reason though — a UART concentrator is a
    # perfectly normal thing to have on a Pi, and the honest handling is to
    # report that we cannot tell rather than to guess either way. Selecting it
    # explicitly in the console is how a UART part comes up, and the console
    # labels it as such rather than letting somebody pick it and wonder why
    # detection disagrees.
    local port="$1"
    [ -c "${port}" ] || return 1
    return 1
}

# ── One slot ────────────────────────────────────────────────────────────────

# detect_slot <index> <spec>
#   spec: "auto" | "<bus>:<device>:<reset>[:<power>]"
detect_slot() {
    local index="$1" spec="$2"
    local bus device reset power found detected=""

    if [ "${spec}" = "auto" ]; then
        # A kit. Probe every bus in the configured order.
        device=""

        # Which SPI profile's pins to probe with. An operator's earlier choice
        # outranks the board default: a HAT that has already been identified
        # is confirmed with its own pins, not re-guessed with the board's —
        # and it is what makes a second run after picking a HAT in the
        # console actually find it, rather than trying the same default pins
        # again and reporting the same silence.
        #
        # The default is the board's most common fitment, not a guess across
        # every HAT this catalogue knows: probing with pins a HAT does not use
        # is how a Waveshare SX1302 HAT's GNSS ended up in standby earlier —
        # see probe_spi. A HAT that is not the default is found by picking it
        # in the console, not by the detector trying harder on its own.
        local spi_profile=""
        [ "${PULZR_CONCENTRATOR_CONFIGURABLE}" = "1" ] \
            && spi_profile="$(uci -q get "pulzr.slot${index}.override")"
        [ -n "${spi_profile}" ] || spi_profile="${PULZR_CONCENTRATOR_DEFAULT_PROFILE:-sx1302_spi}"

        local spi_pf="${PROFILE_DIR}/${spi_profile}.json"
        # Falls back to board.conf's own pins when the chosen profile has none
        # of its own — a USB or UART profile picked by mistake, or an older
        # profile nobody has updated — rather than probing SPI with nothing.
        reset="$(jsonfilter -i "${spi_pf}" -e '@.resetGpio' 2>/dev/null)"
        power="$(jsonfilter -i "${spi_pf}" -e '@.powerGpio' 2>/dev/null)"
        sx1261="$(jsonfilter -i "${spi_pf}" -e '@.sx1261ResetGpio' 2>/dev/null)"
        ad5338r="$(jsonfilter -i "${spi_pf}" -e '@.ad5338rResetGpio' 2>/dev/null)"
        [ -n "${reset}" ] || reset="${PULZR_SX130X_RESET_GPIO}"
        [ -n "${power}" ] || power="${PULZR_SX130X_POWER_EN_GPIO}"

        # An operator's own typed reset line outranks even a picked profile —
        # it is the escape hatch for a HAT this catalogue has no profile for
        # at all, or for correcting one whose pins are simply wrong.
        if [ "${PULZR_CONCENTRATOR_CONFIGURABLE}" = "1" ]; then
            local manual_reset
            manual_reset="$(uci -q get "pulzr.slot${index}.reset_gpio_override")"
            [ -n "${manual_reset}" ] && reset="${manual_reset}"
        fi

        for try in ${PULZR_CONCENTRATOR_PROBE_ORDER:-usb spi uart}; do
            # A bus an earlier auto slot already found hardware on is not
            # tried again. Without this, a Pi with a USB RAK5146 *and* an SPI
            # Waveshare HAT — "auto auto" in PULZR_CONCENTRATOR_SLOTS —
            # would have slot 1 walk the same probe order as slot 0, find the
            # same USB bridge first, and report it a second time in its own
            # slot while never reaching the SPI probe that would have found
            # the HAT. One SX130x does not answer on two buses at once, so a
            # bus already claimed has nothing left on it for another slot to
            # find.
            case " ${CLAIMED_BUSES} " in
                *" ${try} "*) log "slot ${index}: skipping ${try}, already claimed by an earlier slot"; continue ;;
            esac
            log "slot ${index}: probing ${try}"
            case "${try}" in
                usb)  found="$(probe_usb)" && bus=usb && detected="${found%% *}" && device="${found#* }" ;;
                spi)  detected="$(probe_spi "${PULZR_SPI_DEV:-/dev/spidev0.0}" \
                                            "${reset}" "${power}" "${sx1261}" "${ad5338r}")" \
                          && bus=spi && device="${PULZR_SPI_DEV:-/dev/spidev0.0}" ;;
                uart) detected="$(probe_uart "${PULZR_UART_DEV:-/dev/ttyAMA0}")" \
                          && bus=uart && device="${PULZR_UART_DEV:-/dev/ttyAMA0}" ;;
            esac
            [ -n "${detected}" ] && break
        done
        [ -n "${detected}" ] && CLAIMED_BUSES="${CLAIMED_BUSES} ${bus}"
    else
        # A product. Trust the board.
        bus="${spec%%:*}"
        local rest="${spec#*:}"
        device="${rest%%:*}"
        rest="${rest#*:}"
        reset="${rest%%:*}"
        case "${rest}" in *:*) power="${rest#*:}" ;; *) power="" ;; esac
        [ "${reset}" = "-" ] && reset=""

        # A product declares what is fitted, and that is what gets recorded.
        #
        # It used to read the chip version here as well, so a dead part would
        # show as broken rather than present-and-silent. That read is
        # a full-duplex spi-pipe transfer, which the MT7628's
        # half-duplex SPI controller rejects outright, so on a RAK every
        # working concentrator was recorded as absent and nothing started. A
        # dead part now shows up where it actually fails: concentratord does
        # not start, and the console shows the forwarder not running.
        case "${bus}" in
            spi)  detected="${PULZR_CONCENTRATOR_PART:-sx1302_spi}" ;;
            usb)
                # A product names the exact ttyACM/ttyUSB each concentrator is
                # on. Key presence to that specific node existing, not to
                # probe_usb's "is any concentrator on USB at all" — on the
                # two-slot RAK7289CV2 the generic probe answers yes for both
                # slots off one module, reporting 16 channels when only 8
                # answered. Keyed to the node, a missing second module reads
                # absent and the gateway lands in the loud `partial` state.
                # A kit's USB slot is "auto" and never reaches this branch.
                #
                # A card that is fitted but has not enumerated gets one reset
                # through its slot's line, where the board has one, and the
                # time a RAK5146 takes to come back (about two seconds on the
                # bench) and then some. The line is a name the device tree
                # exports, never a number: on USB the number would be handed
                # to concentratord as the SX1302's own reset, and that hung it.
                if [ ! -c "${device}" ] && [ -n "${reset}" ] && pulzr-hwline "${reset}"; then
                    log "slot ${index}: ${device} missing; resetting it through ${reset}"
                    pulzr-hwline "${reset}" pulse 1
                    local waited=0
                    while [ ! -c "${device}" ] && [ "${waited}" -lt 10 ]; do
                        sleep 1; waited=$((waited + 1))
                    done
                fi
                if [ -c "${device}" ]; then
                    detected="${PULZR_CONCENTRATOR_PART:-sx1302_usb}"
                fi
                ;;
            uart) detected="sx1302_uart" ;;   # cannot be probed; the board says so
        esac
        if [ -z "${detected}" ]; then
            log "slot ${index}: board declares ${bus} ${device} but it did not answer"
        fi
    fi

    # ── record ──────────────────────────────────────────────────────────────
    local section="slot${index}"
    [ "${DRY_RUN}" = 1 ] && { echo "slot ${index}: ${detected:-nothing} on ${bus:-?} ${device:-?}"; return 0; }

    put "${section}" slot
    put "${section}.index" "${index}"
    put "${section}.bus" "${bus}"
    put "${section}.device" "${device}"
    put "${section}.reset_gpio" "${reset}"
    put "${section}.power_gpio" "${power}"
    put "${section}.detected" "${detected}"

    if [ -z "${detected}" ]; then
        put "${section}.status" absent
        put "${section}.active" ''
        return 1
    fi

    if [ ! -f "${PROFILE_DIR}/${detected}.json" ]; then
        log "slot ${index}: detected ${detected} but no profile ships for it"
        put "${section}.status" unsupported
        put "${section}.active" ''
        return 1
    fi

    # An operator override is a decision, and a decision outranks a probe. We
    # still record what the probe saw, so the console can show "you selected X,
    # the hardware looks like Y" rather than silently disagreeing with itself.
    #
    # Only honoured on a configurable board: on a product the hardware cannot
    # change, so a stale override from a support session must not survive.
    local override=""
    [ "${PULZR_CONCENTRATOR_CONFIGURABLE}" = "1" ] \
        && override="$(uci -q get "pulzr.${section}.override")"

    put "${section}.status" present
    if [ -n "${override}" ] && [ "${override}" != "${detected}" ]; then
        log "slot ${index}: operator override ${override} kept over detected ${detected}"
        put "${section}.active" "${override}"
    else
        put "${section}.active" "${detected}"
    fi
    return 0
}

# ── Every slot ──────────────────────────────────────────────────────────────
#
# `uci commit` rewrites the package file whether or not any value differs.
# Detection is overwhelmingly stable, the same board finding the same part on
# every boot, so comparing first means the common case writes nothing to
# flash. An unchanged commit does not fire procd's config.change on its own;
# see the note in pulzr-gps-detect for what does.
changed=0
put() {
    [ "$(uci -q get "pulzr.$1")" = "$2" ] && return 0
    uci -q set "pulzr.$1=$2"
    changed=1
}
drop() {
    uci -q get "pulzr.$1" >/dev/null 2>&1 || return 0
    uci -q delete "pulzr.$1"
    changed=1
}

index=0
present=0
total=0
channels=0
# Buses an auto slot has already found hardware on, across this whole run —
# see the skip in detect_slot's probe loop above.
CLAIMED_BUSES=""

# How many cards the unit left the factory with, where it says (RAK's hardware
# descriptor; see pulzr-hwdesc). A RAK7289CV2 has two slots and is sold with
# one card or two; a one-card unit's empty slot is how it was built, not a
# card that died, and must not put the gateway in `partial`. A slot past that
# count still counts when a card answers in it, since cards get added later.
fitted="$(pulzr-hwdesc get 'LORA.concentrator[*].intf_type' 2>/dev/null | grep -c .)"

for spec in ${PULZR_CONCENTRATOR_SLOTS:-auto}; do
    total=$((total + 1))
    if detect_slot "${index}" "${spec}"; then
        present=$((present + 1))
        active="$(uci -q get "pulzr.slot${index}.active")"
        slot_ch="$(jsonfilter -i "${PROFILE_DIR}/${active}.json" -e '@.channels' 2>/dev/null)"
        channels=$((channels + ${slot_ch:-8}))
    elif [ "${fitted}" -gt 0 ] && [ "${index}" -ge "${fitted}" ] && [ "${DRY_RUN}" != 1 ]; then
        log "slot ${index}: empty, as the unit was built (${fitted} card(s) fitted)"
        put "slot${index}.status" unfitted
        total=$((total - 1))
    fi
    index=$((index + 1))
done

[ "${DRY_RUN}" = 1 ] && exit 0

# Clear any slot sections left over from a board that used to have more of
# them. Without this, reflashing a 16-channel unit's config onto an 8-channel
# one leaves a phantom slot the console renders and the forwarder cannot start.
stale="${index}"
while uci -q get "pulzr.slot${stale}" >/dev/null 2>&1; do
    drop "slot${stale}"
    stale=$((stale + 1))
done

put concentrator concentrator
put concentrator.slots "${total}"
put concentrator.present "${present}"
put concentrator.channels "${channels}"
put concentrator.configurable "${PULZR_CONCENTRATOR_CONFIGURABLE:-1}"

# A partial detection on a multi-slot board is its own state, and a loud one:
# the gateway works, at half its channel count, and nothing about the uplink
# counts makes that obvious.
if [ "${present}" = 0 ]; then
    put concentrator.status absent
elif [ "${present}" -lt "${total}" ]; then
    put concentrator.status partial
    log "WARNING: only ${present} of ${total} concentrators responded — this gateway is running at ${channels} channels"
else
    put concentrator.status present
fi

[ "${changed}" = 1 ] && uci commit pulzr

log "detection complete: ${present}/${total} slots, ${channels} channels"

[ "${present}" -gt 0 ]
