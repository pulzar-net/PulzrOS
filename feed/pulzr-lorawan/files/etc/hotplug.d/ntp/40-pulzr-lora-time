#!/bin/sh
#
# Turn on the gateway's own uplink timestamps once NTP has set the clock. Why
# they wait for this is in pulzr-lora-config, at time_fallback.
#
# Once per boot: the flag is on tmpfs, and every render after it exists already
# has the right answer, so later sync events have nothing to do.

case "${ACTION}" in step|stratum|periodic) ;; *) exit 0 ;; esac
# Stratum 16 is busybox ntpd's "not synchronised".
[ -n "${stratum}" ] && [ "${stratum}" -lt 16 ] 2>/dev/null || exit 0

FLAG=/var/run/pulzr/clock-synced
[ -f "${FLAG}" ] && exit 0
mkdir -p /var/run/pulzr && touch "${FLAG}"
logger -t lora -p daemon.info "clock set by NTP (stratum ${stratum}); uplinks now carry the gateway's receive time"

# Concentratord alone, not the service. A reload re-runs hardware detection
# against a concentrator that is running, and could restart the buffer broker,
# whose queue may only be in RAM — this can fire the moment the network comes
# back, which is exactly when that queue is full.
#
# It reads its config only at start, so this is ~10s deaf, once per boot.
# The same re-render picks up the LoRa profile: on a gateway with a SIM alone
# the first sync comes over the SIM, so this one restart is also the one that
# moves its stats to five minutes (pulzr-lora-profile).
exec /usr/sbin/pulzr-lora-profile apply
