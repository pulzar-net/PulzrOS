#!/bin/sh
#
# A USB concentrator plugged in after boot should just work.
#
# Narrowed to the USB identities our concentrators use, because this fires
# for every USB event on the box — including the cellular modem re-attaching,
# and restarting the packet forwarder every time the SIM bounces would be both
# pointless and disruptive.

case "${ACTION}" in add|remove) ;; *) exit 0 ;; esac

case "${PRODUCT}" in
    # CP210x, FT2232H, and the RAK5146 USB module's own STM32 CDC-ACM —
    # see probe_usb() in pulzr-concentrator-detect for what each one is.
    10c4/ea60/*|403/6010/*|483/5740/*) ;;
    *) exit 0 ;;
esac

logger -t concentrator "USB concentrator ${ACTION}; re-detecting"
/usr/sbin/pulzr-concentrator-detect >/dev/null 2>&1
/etc/init.d/pulzr-packet-forwarder restart >/dev/null 2>&1 &
