#!/bin/sh
#
# A USB concentrator plugged in after boot should just work.
#
# Narrowed to the USB identity of the one USB concentrator pulzr-probe names,
# Semtech's reference design (a RAK5146 USB's STM32), because this fires for
# every USB event on the box — including the cellular modem re-attaching,
# and restarting the packet forwarder every time the SIM bounces would be both
# pointless and disruptive. Detection then asks pulzr-probe's report which
# tty it is.

case "${ACTION}" in add|remove) ;; *) exit 0 ;; esac

case "${PRODUCT}" in
    483/5740/*) ;;
    *) exit 0 ;;
esac

logger -t concentrator "USB concentrator ${ACTION}; re-detecting"
/usr/sbin/pulzr-concentrator-detect >/dev/null 2>&1
/etc/init.d/pulzr-packet-forwarder restart >/dev/null 2>&1 &
