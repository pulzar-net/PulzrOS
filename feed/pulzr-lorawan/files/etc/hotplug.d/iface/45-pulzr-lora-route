#!/bin/sh
#
# Re-decide where uplinks may go whenever a backhaul comes or goes.
#
# Both directions and both interfaces, same as the tunnel's own handler: a
# wired ifdown is what makes the confinement start dropping uplinks, and a
# wired ifup is what lets them flow again. Waiting for a periodic sweep would
# mean uplinks either sitting undelivered after ethernet returned, or going
# out over the SIM in the window after it left.

[ "${ACTION}" = "ifup" ] || [ "${ACTION}" = "ifdown" ] || exit 0

case "${INTERFACE}" in
    wan|wan_*|wwifi|wwifi2|wwan|usbwan) ;;
    *) exit 0 ;;
esac

/usr/sbin/pulzr-lora-route apply >/dev/null 2>&1

# And whether the stats interval should follow: not now, but once the uplink
# has stayed what it is for ten minutes, so a short failover restarts nothing
# (pulzr-lora-profile). In the background: hotplug waits for its scripts.
( /usr/sbin/pulzr-lora-profile settle </dev/null >/dev/null 2>&1 & )
