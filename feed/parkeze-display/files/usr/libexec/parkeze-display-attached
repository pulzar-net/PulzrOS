#!/bin/sh
#
# Exit 0 if a display is attached, 1 if not.
#
# On the Pi's firmware framebuffer — which is what OpenWrt runs; it loads no
# KMS driver — the firmware decides at boot. It asks the HDMI ports what is
# plugged in, and with nothing there it reports no displays and the kernel's
# bcm2708_fb creates no /dev/fb0 at all. So the framebuffer existing *is*
# the answer, and it costs nothing to ask.
#
# Two things make it less simple than that:
#
#   * A Pi 3 drives composite TV-out when it finds no HDMI, and composite is a
#     framebuffer too. enable_tvout=0 (PARKEZE_DISPLAY_BOOT, applied by
#     parkeze-boot-config) turns that off, so a headless Pi 3 has no fb0 either
#     — and does not power a video encoder for a cable nobody plugged in.
#
#   * The firmware only looks at boot. A screen plugged into a gateway that is
#     already running stays dark until the next boot, because nothing tells
#     the firmware framebuffer about it. Hotplug would mean the vc4 KMS driver:
#     about a megabyte of DRM modules on every Pi, and a contiguous-memory
#     reservation, for the minute a technician spends finding the reset
#     button. Rebooting with the screen attached is the cheaper answer.
fb=/sys/class/graphics/fb0
[ -e "${fb}" ] || exit 1
size="$(cat "${fb}/virtual_size" 2>/dev/null)"
case "${size}" in ''|0,0) exit 1 ;; esac
exit 0
