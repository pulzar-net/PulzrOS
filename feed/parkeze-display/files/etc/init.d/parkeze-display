#!/bin/sh /etc/rc.common
#
# The terminal UI on the HDMI console — if, and only if, there is a screen.
#
# With none attached this does nothing at all: no process waits on tty1, and
# the firmware has already left HDMI unpowered (see parkeze-display-attached).
# With one, the TUI owns tty1 behind the web console's sign-in, and the
# kernel blanks the screen after ten minutes without a key.

START=99
USE_PROCD=1

start_service() {
    if ! /usr/libexec/parkeze-display-attached; then
        logger -t parkeze-display "no display attached; console not started"
        return 0
    fi

    # The stock tty1 login is removed by 55-parkeze-display, which runs on
    # first boot after procd has already read /etc/inittab. On that one boot
    # it is still there, and two programs reading one keyboard is worse than
    # a screen that waits for the reboot first boot does anyway.
    if grep -q '^tty1::' /etc/inittab; then
        logger -t parkeze-display "tty1 still has the stock login; console starts after the reboot"
        return 0
    fi

    procd_open_instance console
    procd_set_param command /usr/libexec/parkeze-tui-console /dev/tty1 linux
    procd_set_param respawn 3600 5 0
    procd_set_param stderr 1
    procd_close_instance
}
