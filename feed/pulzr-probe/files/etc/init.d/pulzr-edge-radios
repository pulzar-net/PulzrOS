#!/bin/sh /etc/rc.common
#
# The radio modules: one `pulzr-edge radio serve` per radio in
# /etc/pulzr-edge/radios/, each a Zigbee or Z-Wave coordinator
# (docs/src/content/docs/radio-modules.md). A file appears when a person sets up a network from
# Pulzr Net (`pulzr-radios use`, through the console API) and goes with
# `pulzr-radios release`; both reload this.
#
# One process per radio, so one stack failing never takes another network
# down. Respawned like the buses: a module that exits because this build has
# no stack for its protocol (exit 3) stops being respawned after five tries,
# and the console says why.
#
# No procd file trigger on a radio's file: the module writes it itself (its
# network, its keys), and a trigger would restart it on every save.

START=97
STOP=10

USE_PROCD=1

RADIOS=/etc/pulzr-edge/radios
CONFIG=/var/run/pulzr-edge/radios.toml

. /usr/libexec/pulzr/edge-config

start_service() {
    local id bin top runnable
    ls "${RADIOS}"/*.json >/dev/null 2>&1 || return 0
    # Not started until the gateway holds a broker login (edge_common says why).
    top="$(edge_common)" || return 0
    mkdir -p /var/run/pulzr-edge
    ( umask 077; { printf '%s\n' "${top}"; edge_firmware; } > "${CONFIG}" )
    # Each radio with its protocol's own binary, and only where that
    # protocol's add-on put it (pulzr-radios runnable), so a gateway locked
    # off a capability never runs it.
    # Read from a here-document, not a pipe: a piped loop runs in a subshell,
    # and procd's instances would be built and lost there.
    runnable="$(pulzr-radios runnable)"
    while read -r id bin; do
        [ -n "${id}" ] || continue
        procd_open_instance "${id}"
        procd_set_param command "${bin}" radio serve "${id}" "${CONFIG}"
        procd_set_param respawn 60 5 5
        procd_set_param stderr 1
        procd_close_instance
    done <<EOF
${runnable}
EOF
}

service_triggers() {
    # Credentials can change after adoption, and a re-adoption replaces them.
    procd_add_config_trigger "config.change" "pulzr" /etc/init.d/pulzr-edge-radios restart
}
