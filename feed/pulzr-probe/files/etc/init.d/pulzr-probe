#!/bin/sh /etc/rc.common
#
# Once at boot, for what was plugged in before the gateway powered on: hotplug
# fires for those before this package's hooks can be useful to anyone. Quiet,
# because nothing is listening yet; the claim report's first run carries it.

START=95

boot() {
    ( /usr/sbin/pulzr-radios scan --quiet --boot >/dev/null 2>&1 & )
}

start() {
    /usr/sbin/pulzr-radios scan --quiet >/dev/null 2>&1
}
