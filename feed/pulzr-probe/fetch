#!/usr/bin/env bash
#
# Put the pulzr-probe binary for one architecture into a package root.
#
#   fetch <package-arch> <dest-root> <cache-dir>
#
# Built from pulzr-edge's source with the OpenWrt SDK (sdk/packages/pulzr-edge,
# where the one version is pinned) into .build/sdk/<arch>/pulzr-probe, as
# feed/pulzr-edge's fetch takes pulzr-edge from there.

set -euo pipefail

ARCH="${1:?arch}" DEST="${2:?dest}"
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
SDK_OUT="${PULZR_SDK_OUT:-${ROOT}/.build/sdk}"

# The GL-SFT1200's mipsel_24kc_24kf takes the soft-float mipsel_24kc build, as
# pulzr-edge does: no LoRa board shares its SDK target.
case "${ARCH}" in
  mipsel_24kc_24kf) from=mipsel_24kc ;;
  *) from="${ARCH}" ;;
esac

bin="${SDK_OUT}/${from}/pulzr-probe"
[ -f "${bin}" ] || { echo "no pulzr-probe for ${ARCH} in ${SDK_OUT}/${from}; build it with sdk/build.sh" >&2; exit 1; }
mkdir -p "${DEST}/usr/sbin"
install -m 0755 "${bin}" "${DEST}/usr/sbin/pulzr-probe"
