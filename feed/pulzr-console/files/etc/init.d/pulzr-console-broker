#!/bin/sh /etc/rc.common
#
# The root half of the terminal console on SSH: pulzr-tui runs as the
# unprivileged `pulzr` account there and asks this for everything it reads or
# changes. See /usr/sbin/pulzr-console-broker.

START=60
STOP=10
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /usr/sbin/pulzr-console-broker
    procd_set_param respawn 3600 5 0
    procd_set_param stderr 1
    procd_close_instance
}
