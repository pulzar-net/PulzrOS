#!/bin/sh /etc/rc.common
#
# Moves the WiFi uplink to another remembered network in range when the
# current one has been gone a while. See roam() in lib/access.uc.

START=99
STOP=10
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /usr/sbin/pulzr-wifi-roam
    procd_set_param respawn 3600 5 0
    procd_close_instance
}
