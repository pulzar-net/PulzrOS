#!/bin/sh
#
# Resource history for the console's System page.
#
#   pulzr-stats collect           sample every 20s into the ring, forever
#   pulzr-stats history SECONDS   JSON for the last SECONDS, at most 360 points
#
# ── WHY ITS OWN COLLECTOR ──────────────────────────────────────────────────
#
# The console can only show what is happening now; a graph needs what happened
# before the page was opened. collectd and luci-statistics would do it, at the
# cost of rrdtool, a plugin per source and a few megabytes of flash a 16MB
# board does not have. This is one awk process reading /proc.
#
# Kept in /var/run, so a day at most and gone on reboot. That is the right
# horizon for "is this gateway struggling", and it never writes to flash.
#
# ── ONE LINE PER SAMPLE ────────────────────────────────────────────────────
#
#   <epoch> <cpu ‰> <mem used> <mem total> <load1> <iface>=<rx/s>/<tx/s>;...
#
# CPU and network are rates over the interval just ended, worked out here from
# /proc's counters, so a reader never needs two lines to make sense of one.

DIR=/var/run/pulzr/stats
HISTORY="${DIR}/history"
INTERVAL=20
# A day at 20s.
KEEP=4320

collect() {
    mkdir -p "${DIR}"
    # One awk for the life of the service. It sleeps through system() and
    # re-reads /proc with getline, so a sample costs no fork beyond the sleep
    # and the clock.
    exec awk -v interval="${INTERVAL}" -v keep="${KEEP}" -v out="${HISTORY}" '
    function now(   t) { "date +%s" | getline t; close("date +%s"); return t + 0 }
    BEGIN {
        n = 0
        while (1) {
            ts = now()
            while ((getline line < "/proc/stat") > 0) {
                # By the count split returns: awk arrays keep entries from a
                # longer earlier line, and summing those would count jiffies
                # from a different CPU line into this one.
                fields = split(line, f, " ")
                if (f[1] == "cpu") {
                    total = 0
                    for (i = 2; i <= fields; i++) total += f[i]
                    idle = f[5] + f[6]
                    break
                }
            }
            close("/proc/stat")

            memtotal = 0; memavail = 0
            while ((getline line < "/proc/meminfo") > 0) {
                split(line, f, " ")
                if (f[1] == "MemTotal:") memtotal = f[2] * 1024
                if (f[1] == "MemAvailable:") memavail = f[2] * 1024
            }
            close("/proc/meminfo")

            getline line < "/proc/loadavg"; close("/proc/loadavg")
            split(line, f, " "); load = f[1]

            nets = ""
            skip = 2
            while ((getline line < "/proc/net/dev") > 0) {
                if (skip-- > 0) continue
                gsub(":", " ", line)
                split(line, f, " ")
                name = f[1]
                if (name == "lo") continue
                rx = f[2]; tx = f[10]
                if (name in lastrx && ts > lastts) {
                    drx = rx - lastrx[name]; dtx = tx - lasttx[name]
                    # A counter that went backwards is an interface that came
                    # back up, not negative traffic.
                    if (drx < 0) drx = 0
                    if (dtx < 0) dtx = 0
                    nets = nets sprintf("%s%s=%d/%d", nets == "" ? "" : ";", name,
                                        drx / (ts - lastts), dtx / (ts - lastts))
                }
                lastrx[name] = rx; lasttx[name] = tx
            }
            close("/proc/net/dev")

            if (lasttotal != "" && total > lasttotal) {
                cpu = int(1000 * ((total - lasttotal) - (idle - lastidle)) / (total - lasttotal))
                printf "%d %d %d %d %s %s\n", ts, cpu, memtotal - memavail, memtotal, load, nets >> out
                close(out)
                # Trimmed every so often rather than every sample: a tail of
                # a few thousand short lines is cheap, but not free on MIPS.
                if (++n % 90 == 0)
                    system("tail -n " keep " " out " > " out ".tmp && mv " out ".tmp " out)
            }
            lasttotal = total; lastidle = idle; lastts = ts
            system("sleep " interval)
        }
    }'
}

# Averaged into at most 360 buckets, so a day and an hour cost the browser
# the same and a line chart never has more points than it has pixels.
history() {
    local span="$1"
    case "${span}" in ''|*[!0-9]*) span=3600 ;; esac
    [ -s "${HISTORY}" ] || { echo '{"interval":'"${INTERVAL}"',"points":[]}'; return; }
    awk -v since="$(( $(date +%s) - span ))" -v span="${span}" -v interval="${INTERVAL}" '
    $1 >= since {
        width = span / 360; if (width < interval) width = interval
        b = int(($1 - since) / width)
        if (!(b in count)) order[++buckets] = b
        count[b]++
        ts[b] = $1
        cpu[b] += $2; mem[b] += $3; total[b] = $4; load[b] += $5
        split($6, ifs, ";")
        for (i in ifs) {
            split(ifs[i], kv, "=")
            if (kv[1] == "") continue
            split(kv[2], rt, "/")
            rx[b, kv[1]] += rt[1]; tx[b, kv[1]] += rt[2]
            names[kv[1]] = 1
        }
    }
    END {
        printf "{\"interval\":%d,\"points\":[", interval
        for (k = 1; k <= buckets; k++) {
            b = order[k]; c = count[b]
            # Parenthesised: a bare > among the printf arguments is awk for
            # "write to the file named 1".
            printf "%s{\"t\":%d,\"cpu\":%.1f,\"mem\":%d,\"memTotal\":%d,\"load\":%.2f,\"net\":{", \
                (k > 1 ? "," : ""), ts[b], cpu[b] / c / 10, mem[b] / c, total[b], load[b] / c
            first = 1
            for (name in names) {
                printf "%s\"%s\":[%d,%d]", first ? "" : ",", name, rx[b, name] / c, tx[b, name] / c
                first = 0
            }
            printf "}}"
        }
        printf "]}\n"
    }' "${HISTORY}"
}

case "$1" in
    collect) collect ;;
    history) history "$2" ;;
    *) echo "usage: $0 collect | history SECONDS" >&2; exit 1 ;;
esac
