#!/bin/sh
#
# Decide what the ethernet port is, and configure it accordingly.
#
#   parkeze-port-role            decide and apply
#   parkeze-port-role --check    decide and print, change nothing
#   parkeze-port-role --status   report the current role, probe nothing
#
# ── THE TWO SITUATIONS ─────────────────────────────────────────────────────
#
#   plugged into a site network   it is the WAN. Take a DHCP lease, carry the
#                                 backhaul, accept nothing inbound.
#   a laptop plugged straight in  it is the LAN. Hand out an address so the
#                                 console is reachable without configuring
#                                 anything.
#
# A Pi has one ethernet port, so it cannot be both. This decides which.
#
# ── WHY "NO DHCP SERVER" IS NOT ENOUGH TO CONCLUDE "LAPTOP" ────────────────
#
# It is the obvious test and it is wrong in a way that costs somebody else an
# outage. A site network that uses static addressing — industrial kit, a
# controls VLAN — has no DHCP server either. Concluding "laptop" there means we
# start answering DHCP on a network we do not own, handing out addresses on the
# wrong subnet, and exposing this gateway's console on it.
#
# The two mistakes are not equally expensive:
#
#   said WAN, was a laptop    the laptop gets no address. Annoying, and the
#                             mDNS name below still reaches the console.
#   said LAN, was a network   rogue DHCP on a customer's LAN, plus our console
#                             published to it. An incident, and a hard one for
#                             them to trace back to a LoRaWAN gateway.
#
# So LAN requires *positive* evidence that the segment is unpopulated, and
# anything ambiguous resolves to WAN.
#
# ── WHY A WRONG GUESS IS SURVIVABLE ────────────────────────────────────────
#
# Both roles keep an IPv4 link-local address and answer mDNS, so the console is
# reachable at
#
#     https://<hostname>.local
#
# from a directly-connected laptop no matter which role was chosen — a laptop
# with no DHCP self-assigns 169.254.x.x and can talk to us there. That is what
# makes it safe to be conservative about serving DHCP: being wrong costs a
# convenience, not access.

set -u

. /etc/parkeze/board.conf

IFACE="${PARKEZE_PORT_IFACE:-eth0}"
STATE=/var/run/parkeze/port-role.json

log() { logger -t port-role -p daemon.notice "$*"; }

carrier() { [ "$(cat "/sys/class/net/${IFACE}/carrier" 2>/dev/null)" = "1" ]; }

configured_role() { uci -q get parkeze.port.role || echo auto; }

# ── evidence ────────────────────────────────────────────────────────────────

# Does a DHCP server answer? The one unambiguous signal that this is somebody
# else's network. `-s /bin/true` means the lease is never applied — we only
# care that an offer came back.
#
# Three tries over about nine seconds: a single discover gets dropped often
# enough on a busy LAN that one-shot probing would decide "empty segment" on a
# live corporate network, which is the expensive direction to be wrong in.
dhcp_offered() {
    udhcpc -i "${IFACE}" -n -q -t 3 -T 3 -s /bin/true >/dev/null 2>&1
}

# How much traffic arrives while we sit silent.
#
# A populated network is never quiet: ARP, spanning tree, IPv6 router
# advertisements, mDNS, broadcast from everything on it. A single directly
# connected laptop produces a trickle by comparison.
#
# This is a weak signal on its own — it is deliberately only ever used to
# *refuse* the LAN role, never to grant it.
link_chatter() {
    local before after
    before="$(cat "/sys/class/net/${IFACE}/statistics/rx_packets" 2>/dev/null || echo 0)"
    sleep 8
    after="$(cat "/sys/class/net/${IFACE}/statistics/rx_packets" 2>/dev/null || echo 0)"
    echo $(( after - before ))
}

# Above this many packets in eight seconds, assume something more than one
# quiet host is out there. A laptop idling emits mDNS and IPv6 multicast, so
# the floor cannot be zero; a real LAN is an order of magnitude busier.
CHATTER_LIMIT="${PARKEZE_PORT_CHATTER_LIMIT:-40}"

# ── the decision ────────────────────────────────────────────────────────────

decide() {
    local role; role="$(configured_role)"
    case "${role}" in
        lan) echo "lan:set by configuration"; return ;;
        wan) echo "wan:set by configuration"; return ;;
    esac

    if ! carrier; then
        # Nothing plugged in. LAN is the useful default: the first laptop
        # connected gets an address immediately instead of waiting out a probe,
        # and there is no one to collide with.
        echo "lan:nothing connected"; return
    fi

    if dhcp_offered; then
        echo "wan:a DHCP server answered"; return
    fi

    local packets; packets="$(link_chatter)"
    if [ "${packets}" -gt "${CHATTER_LIMIT}" ]; then
        # Populated, but nothing is handing out addresses. Most likely a
        # statically addressed network. Refuse to serve DHCP onto it.
        echo "wan:no DHCP server, but the segment is busy (${packets} packets in 8s)"
        return
    fi

    echo "lan:no DHCP server and the segment is quiet (${packets} packets in 8s)"
}

# ── applying it ─────────────────────────────────────────────────────────────

apply_lan() {
    uci -q batch <<EOF
set network.lan.device='${IFACE}'
set network.lan.disabled='0'
set network.wan.disabled='1'
set dhcp.lan.ignore='0'
EOF
}

apply_wan() {
    uci -q batch <<EOF
set network.wan.device='${IFACE}'
set network.wan.disabled='0'
set network.lan.disabled='1'
set dhcp.lan.ignore='1'
EOF
}

record() {
    mkdir -p /var/run/parkeze
    printf '{"role":"%s","reason":"%s","configured":"%s","carrier":%s,"at":%s}\n' \
        "$1" "$2" "$(configured_role)" \
        "$(carrier && echo true || echo false)" "$(date +%s)" > "${STATE}"
}

case "${1:-}" in
--status)
    [ -s "${STATE}" ] && cat "${STATE}" \
        || printf '{"role":"unknown","reason":"not probed yet"}\n'
    exit 0 ;;
--check)
    verdict="$(decide)"
    printf '{"role":"%s","reason":"%s"}\n' "${verdict%%:*}" "${verdict#*:}"
    exit 0 ;;
esac

verdict="$(decide)"
role="${verdict%%:*}"
reason="${verdict#*:}"

previous="$(uci -q get parkeze.port.actual || echo '')"

if [ "${role}" = "${previous}" ]; then
    record "${role}" "${reason}"
    exit 0
fi

log "ethernet is ${role} — ${reason}"

case "${role}" in
    lan) apply_lan ;;
    wan) apply_wan ;;
esac

uci -q set parkeze.port=port
uci -q set parkeze.port.actual="${role}"
uci commit network
uci commit dhcp
uci commit parkeze

# Reload rather than restart: restarting the network takes the link down, and
# on the LAN role that is the connection somebody is using to watch this.
/sbin/reload_config >/dev/null 2>&1 || /etc/init.d/network reload >/dev/null 2>&1
/etc/init.d/firewall reload >/dev/null 2>&1
/etc/init.d/dnsmasq reload >/dev/null 2>&1

record "${role}" "${reason}"
exit 0
