#!/bin/sh
#
# Decide whether this gateway should serve DHCP on its LAN port.
#
#   parkeze-lan-guard            probe and apply
#   parkeze-lan-guard --check    probe and print, change nothing
#
# ── THE PROBLEM ────────────────────────────────────────────────────────────
#
# A gateway's LAN port serves two completely different situations:
#
#   a laptop plugged straight in       needs an address from us, or the
#                                      installer has to configure a static one
#                                      by hand in a car park.
#
#   the port patched into a site LAN   must NOT get an address from us. A
#                                      second DHCP server on somebody's network
#                                      hands out addresses on the wrong subnet,
#                                      points clients at a gateway that routes
#                                      nowhere, and takes down whatever it
#                                      reaches. It is an outage we caused, on
#                                      equipment that is not ours, and it is
#                                      genuinely hard for the site to diagnose
#                                      because the culprit is a LoRaWAN gateway
#                                      nobody was thinking about.
#
# Getting this wrong in the second direction is far worse than in the first, so
# the probe FAILS CLOSED: anything ambiguous means we do not serve DHCP.
#
# ── HOW ────────────────────────────────────────────────────────────────────
#
# Ask the segment whether it already has a DHCP server, by being a client for a
# moment. `-s /bin/true` means the lease is never applied — we only care
# whether an offer comes back, not what is in it.
#
# The static console address stays regardless. 192.168.61.1 is documented, it
# is on the MOTD and it is what the label says, so it must answer whether or
# not the port is also on somebody's network.

. /etc/parkeze/board.conf

IFACE="${PARKEZE_LAN_IFACE:-br-lan}"
MODE="$(uci -q get parkeze.lan.dhcp_mode || echo auto)"

CHECK_ONLY=0
[ "$1" = "--check" ] && CHECK_ONLY=1

log() { logger -t lan-guard -p daemon.info "$*"; }

# Is there already a DHCP server on this segment?
#
# Three tries over about nine seconds. One try is not enough — a switch that is
# still learning, or a server under load, drops the first discover often enough
# that a single-shot probe would decide "no server here" on a live corporate
# LAN. That is the expensive direction to be wrong in.
foreign_dhcp() {
    [ -d "/sys/class/net/${IFACE}" ] || return 1

    # No carrier means nothing is plugged in, so there is no foreign network to
    # collide with — and also nobody to serve. Handled by the caller.
    [ "$(cat "/sys/class/net/${IFACE}/carrier" 2>/dev/null)" = "1" ] || return 1

    udhcpc -i "${IFACE}" -n -q -t 3 -T 3 -s /bin/true >/dev/null 2>&1
}

carrier() {
    [ "$(cat "/sys/class/net/${IFACE}/carrier" 2>/dev/null)" = "1" ]
}

decide() {
    case "${MODE}" in
        never)
            echo "never:configured off"; return ;;
        always)
            # An explicit choice by somebody who knows what is on the other end
            # of the cable. Deliberately possible, deliberately not the default.
            echo "serve:configured on"; return ;;
    esac

    if ! carrier; then
        # Nothing plugged in. Serving costs nothing and means the very first
        # laptop to be connected gets an address without waiting for a re-probe.
        echo "serve:nothing connected"; return
    fi

    if foreign_dhcp; then
        echo "off:another DHCP server answered"; return
    fi

    echo "serve:no other DHCP server on this segment"
}

verdict="$(decide)"
action="${verdict%%:*}"
reason="${verdict#*:}"

if [ "${CHECK_ONLY}" = 1 ]; then
    printf '{"serving":%s,"reason":"%s","mode":"%s","carrier":%s}\n' \
        "$([ "${action}" = serve ] && echo true || echo false)" \
        "${reason}" "${MODE}" \
        "$(carrier && echo true || echo false)"
    exit 0
fi

current="$(uci -q get dhcp.lan.ignore || echo 0)"
want="$([ "${action}" = serve ] && echo 0 || echo 1)"

if [ "${current}" != "${want}" ]; then
    uci -q set dhcp.lan.ignore="${want}"
    uci commit dhcp
    /etc/init.d/dnsmasq reload >/dev/null 2>&1
    if [ "${want}" = 0 ]; then
        log "serving DHCP on ${IFACE} — ${reason}"
    else
        log "NOT serving DHCP on ${IFACE} — ${reason}"
    fi
fi

# Recorded either way so the console can explain itself without re-probing,
# which takes nine seconds and would make a page load feel broken.
mkdir -p /var/run/parkeze
printf '{"serving":%s,"reason":"%s","mode":"%s","checkedAt":%s}\n' \
    "$([ "${want}" = 0 ] && echo true || echo false)" \
    "${reason}" "${MODE}" "$(date +%s)" > /var/run/parkeze/lan-guard.json

exit 0
