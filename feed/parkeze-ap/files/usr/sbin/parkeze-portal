#!/bin/sh
#
# The captive portal that sits behind the setup AP.
#
#   parkeze-portal on|off|status
#
# ── WHAT A CAPTIVE PORTAL IS HERE ──────────────────────────────────────────
#
# Two pieces, and nothing more:
#
#   1. DNS on the setup network answers every name with the gateway's own
#      address, so whatever the phone probes to detect a portal resolves here.
#   2. A firewall redirect sends any HTTP request arriving on the setup
#      interface to the console.
#
# The console then decides what to show, based on adoption state — see
# lib/portal.uc. This script does not know or care what the portal contains.
#
# ── WHAT IT DELIBERATELY DOES NOT DO ───────────────────────────────────────
#
# It does not route. The setup network has no path to the WAN, the LAN, or the
# management tunnel, and the firewall zone below says so explicitly. Somebody associated
# to the setup AP can reach exactly one thing: this gateway's console.
#
# That matters most in the unadopted case, where the AP is open. An open AP
# that also forwarded traffic would be a free, anonymous, untraceable internet
# connection attached to a customer's site — which is somebody else's incident
# to explain, and ours to have caused.

set -e

SETUP_NET=setup
SETUP_ADDR="$(uci -q get network.setup.ipaddr || echo 192.168.62.1)"

log() { logger -t portal -p daemon.info "$*"; }

on() {
    # DNS hijack, scoped to the setup interface only. `address=/#/` is
    # dnsmasq's catch-all; confining it with `interface=` means the LAN's own
    # DNS keeps working normally while this is up.
    cat > /var/etc/dnsmasq-portal.conf <<EOF
# Generated by parkeze-portal. Removed when the portal goes down.
interface=br-setup
no-dhcp-interface=
address=/#/${SETUP_ADDR}
EOF
    /etc/init.d/dnsmasq reload >/dev/null 2>&1

    uci -q batch <<EOF
set firewall.portal_redirect=redirect
set firewall.portal_redirect.name='Parkeze setup portal'
set firewall.portal_redirect.src='setup'
set firewall.portal_redirect.src_dport='80'
set firewall.portal_redirect.dest_port='443'
set firewall.portal_redirect.dest_ip='${SETUP_ADDR}'
set firewall.portal_redirect.proto='tcp'
set firewall.portal_redirect.target='DNAT'
EOF
    uci commit firewall
    /etc/init.d/firewall reload >/dev/null 2>&1

    log "captive portal up on ${SETUP_ADDR}"
}

off() {
    rm -f /var/etc/dnsmasq-portal.conf
    /etc/init.d/dnsmasq reload >/dev/null 2>&1

    uci -q delete firewall.portal_redirect
    uci commit firewall
    /etc/init.d/firewall reload >/dev/null 2>&1

    log "captive portal down"
}

case "${1:-status}" in
    on)  on ;;
    off) off ;;
    status)
        if [ -f /var/etc/dnsmasq-portal.conf ]; then
            printf '{"up":true,"address":"%s"}\n' "${SETUP_ADDR}"
        else
            printf '{"up":false}\n'
        fi
        ;;
    *) echo "usage: parkeze-portal {on|off|status}" >&2; exit 2 ;;
esac
