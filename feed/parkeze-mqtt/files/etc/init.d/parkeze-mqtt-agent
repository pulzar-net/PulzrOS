#!/bin/sh /etc/rc.common
#
# The management channel. Respawned, because a broker that goes away must not
# take the gateway's manageability with it permanently — and on a cellular
# gateway this is often the cheapest way in.
#
# START=96, after parkeze-claim (95), which is what obtains the credentials
# this needs. A gateway that has just been adopted should not have to wait for
# a reboot before it can be managed.

START=96
STOP=10

USE_PROCD=1

start_service() {
    # There is nothing to listen on until the gateway is adopted and has
    # broker credentials, and the agent exits saying so. procd's respawn is
    # what makes that self-correcting: the credentials arrive when adoption
    # completes, not when this first ran.
    procd_open_instance
    procd_set_param command /usr/sbin/parkeze-mqtt-agent
    procd_set_param respawn 30 5 0
    procd_set_param stderr 1
    procd_close_instance
}
