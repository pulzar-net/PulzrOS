#!/bin/sh
#
# Decide whether LoRaWAN uplinks are allowed onto the metered link.
#
#   parkeze-lora-route apply    enforce the current setting
#   parkeze-lora-route flush    remove the rule and table
#   parkeze-lora-route status   report the setting and where uplinks go
#
# ── WHY THIS IS A SEPARATE DECISION ────────────────────────────────────────
#
# Management traffic and LoRaWAN traffic have different answers to "is
# cellular acceptable".
#
# Management has to reach a gateway whatever happens — an unreachable gateway
# cannot be fixed remotely, so it is worth the data every time, and cellular
# is its failover unconditionally.
#
# Uplinks are the opposite shape. A busy site can produce them continuously,
# the volume is set by how many devices are in range rather than by anything
# we control, and a wired outage nobody notices for a week is a bill nobody
# budgeted for. Whether that is acceptable depends on the site, so it is a
# setting rather than a policy: `parkeze.lorawan.allow_cellular`.
#
# ── WHAT "NOT ALLOWED" COSTS TODAY ─────────────────────────────────────────
#
# Uplinks are dropped while wired is down, not held. The forwarder publishes
# at QoS 0 to a broker it cannot reach, and nothing on the gateway stores
# them. Local buffering — a broker here that queues and replays when the link
# returns — is the next piece of this and is what makes "not allowed" a
# trade rather than a loss. Until then the default is deliberately 1: every
# gateway keeps behaving exactly as it does now unless somebody chooses
# otherwise.
#
# ── HOW ────────────────────────────────────────────────────────────────────
#
# The same shape as parkeze-wireguard-route, for the same reasons: mark the
# traffic, send the mark to a table of our own, and put an unreachable rule
# under it so a marked packet is dropped rather than falling through to the
# main table when ours is empty. A gap between wired going down and cellular
# registering must not leak uplinks onto the SIM.
#
# Marked by destination port rather than by process. The forwarder runs as
# root, so there is no uid to match that would not also match everything else
# the gateway does — but 8883 is the broker and nothing else on this box
# speaks it. Reports and claims go to 443 and are untouched.

. /lib/functions.sh
. /lib/functions/network.sh
. /etc/parkeze/board.conf

MARK="${PARKEZE_LORA_MARK:-0x9800}"
MASK="0xff00"
TABLE="${PARKEZE_LORA_TABLE:-98}"
WIRED_IFACE="${PARKEZE_WAN_ETH_IFACE:-wan}"

log() { logger -t lora-route -p daemon.info "$*"; }

# The port the forwarder actually talks to, read from the config that was
# rendered for it rather than assumed. A deployment that moves its broker
# should not have to remember this file exists.
broker_port() {
    local conf port
    for conf in /tmp/run/parkeze/lora/slot*/mqtt-forwarder.toml; do
        [ -f "${conf}" ] || continue
        port="$(sed -n 's/^server=".*:\([0-9]\+\)"/\1/p' "${conf}" | head -n1)"
        [ -n "${port}" ] && { echo "${port}"; return; }
    done
    echo 8883
}

# 1 unless somebody has said otherwise. Per gateway, because whether a metered
# uplink is acceptable is a property of the site rather than of the board.
allow_cellular() {
    local set; set="$(uci -q get parkeze.lorawan.allow_cellular)"
    [ -n "${set}" ] || set="${PARKEZE_LORA_ALLOW_CELLULAR:-1}"
    [ "${set}" = "1" ]
}

iface_gateway() {
    local gw dev
    network_get_gateway gw "$1" || return 1
    network_get_device dev "$1" || return 1
    [ -n "${gw}" ] && [ -n "${dev}" ] || return 1
    echo "${gw} ${dev}"
}

flush() {
    while ip rule del fwmark "${MARK}/${MASK}" table "${TABLE}" 2>/dev/null; do :; done
    while ip rule del fwmark "${MARK}/${MASK}" unreachable 2>/dev/null; do :; done
    ip route flush table "${TABLE}" 2>/dev/null
    nft delete table inet parkeze-lora 2>/dev/null
}

case "${1:-status}" in

apply)
    if allow_cellular; then
        # Nothing to confine. Uplinks take whatever route the gateway has,
        # which is the behaviour every gateway has had until now.
        flush
        log "uplinks may use any backhaul"
        exit 0
    fi

    port="$(broker_port)"

    # Mark first, so that even if the routing below cannot be built the
    # packets are marked and the unreachable rule catches them. Built fresh
    # rather than added to: a stale rule from an earlier port would otherwise
    # keep marking traffic nobody meant to confine.
    nft delete table inet parkeze-lora 2>/dev/null
    if ! nft -f - <<EOF 2>/dev/null
table inet parkeze-lora {
    chain output {
        type route hook output priority mangle; policy accept;
        tcp dport ${port} meta mark set ${MARK}
    }
}
EOF
    then
        log "ERROR: could not mark uplink traffic; leaving it unconfined"
        exit 1
    fi

    # The unreachable rule goes in first and at a higher priority number, so
    # it sits *below* the table lookup. Order matters: installed the other way
    # round it would swallow everything.
    ip rule del fwmark "${MARK}/${MASK}" unreachable 2>/dev/null
    ip rule add fwmark "${MARK}/${MASK}" unreachable priority 32101 2>/dev/null
    ip rule del fwmark "${MARK}/${MASK}" table "${TABLE}" 2>/dev/null
    ip rule add fwmark "${MARK}/${MASK}" table "${TABLE}" priority 32100 2>/dev/null

    ip route flush table "${TABLE}" 2>/dev/null
    if set -- $(iface_gateway "${WIRED_IFACE}"); [ -n "${1:-}" ]; then
        ip route replace default via "$1" dev "$2" table "${TABLE}"
        log "uplinks confined to wired (${2}), port ${port}"
    else
        # Wired is down. The table stays empty and the unreachable rule below
        # it drops uplinks, which is the whole point of the setting: they wait
        # for ethernet rather than being billed to the SIM.
        log "uplinks confined to wired, which is down — they will not be sent"
    fi
    ;;

flush)
    flush
    log "confinement removed"
    ;;

status)
    allowed=false; allow_cellular && allowed=true
    wired=false
    iface_gateway "${WIRED_IFACE}" >/dev/null 2>&1 && wired=true
    # Sending right now means: allowed anywhere, or confined with wired up.
    sending=false
    if [ "${allowed}" = "true" ] || [ "${wired}" = "true" ]; then sending=true; fi
    printf '{"allowCellular":%s,"wiredUp":%s,"sending":%s,"brokerPort":%s}\n' \
        "${allowed}" "${wired}" "${sending}" "$(broker_port)"
    ;;

*)
    echo "usage: parkeze-lora-route {apply|flush|status}" >&2
    exit 2
    ;;
esac

exit 0
