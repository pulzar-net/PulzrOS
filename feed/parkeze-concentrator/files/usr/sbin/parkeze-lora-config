#!/bin/sh
#
# Render the LoRa configuration for one slot.
#
#   parkeze-lora-config <slot-index> <output-dir>
#
# Writes into <output-dir>:
#
#   concentratord.toml   ChirpStack Concentratord: which part, which bus, which
#   region.toml          reset line, and the channel plan it listens on.
#   channels.toml
#   mqtt-forwarder.toml  ChirpStack MQTT Forwarder: where the frames go.
#
# The gateway runs only the gateway half of ChirpStack. Concentratord drives
# the SX130x; the forwarder carries its frames to the cloud network server over
# MQTT, authenticated with the credentials adoption issued. Nothing on the
# gateway is a network server.
#
# Three inputs are combined, and keeping them separate is the whole reason a
# Pi with a WM1302 and a RAK7289CV2 share this file:
#
#   the part      /usr/share/parkeze/concentrator/<model>.json — which
#                 concentratord build, its default model, whether it does LBT.
#   the region    /usr/share/parkeze/region/<REGION>/ — channel plan and the
#                 topic prefix the server-side region listens on.
#   the board     /etc/parkeze/board.conf and UCI — bus, device node, reset
#                 line, this gateway's EUI and MQTT credentials.
#
# The output is written under /var/run, not /etc: it is derived, and a copy on
# flash would be one more thing that can disagree with what it was derived from.

set -e

SLOT="${1:?slot index}"
OUT="${2:?output dir}"

. /etc/parkeze/board.conf

PROFILE_DIR=/usr/share/parkeze/concentrator
REGION_DIR=/usr/share/parkeze/region
STATE_DIR=/var/run/parkeze/lora

die() { echo "slot ${SLOT}: $*" >&2; exit 1; }

# An unset option is normal here — no power-enable line, no GNSS, not adopted
# yet — and `uci get` exits non-zero for one, which under `set -e` ends the
# script silently in the middle of an assignment. Every read goes through this.
get() { uci -q get "$1" || true; }

section="slot${SLOT}"
active="$(get "parkeze.${section}.active")"
bus="$(get "parkeze.${section}.bus")"
device="$(get "parkeze.${section}.device")"
reset="$(get "parkeze.${section}.reset_gpio")"
power="$(get "parkeze.${section}.power_gpio")"
region="$(get parkeze.lorawan.region)"; region="${region:-US915}"
eui="$(get parkeze.identity.gateway_eui)"

[ -n "${active}" ] || die "no active concentrator"

profile="${PROFILE_DIR}/${active}.json"
plan="${REGION_DIR}/${region}"
[ -f "${profile}" ] || die "no profile ${profile}"
[ -f "${plan}/region.conf" ] || die "no region plan ${plan}"
. "${plan}/region.conf"

chipset="$(jsonfilter -i "${profile}" -e '@.concentratord')"
[ -n "${chipset}" ] || die "${active} cannot be driven by concentratord"

# Model: the operator's choice, then the board's, then the part's default. It
# selects the TX gain table, so a board that knows its module says so.
model="$(get "parkeze.${section}.model")"
[ -n "${model}" ] || model="${PARKEZE_CONCENTRATOR_MODEL}"
[ -n "${model}" ] || model="$(jsonfilter -i "${profile}" -e '@.model')"

# A region that mandates listen-before-talk on a part that cannot do it is a
# configuration error, not something to paper over — transmitting without LBT
# where it is required is a regulatory problem, not a performance one.
if [ "${LBT_REQUIRED}" = "1" ] && [ "$(jsonfilter -i "${profile}" -e '@.lbt')" != "true" ]; then
    die "region ${region} requires listen-before-talk but ${active} does not support it"
fi

mkdir -p "${OUT}"
cp "${plan}/region.toml" "${OUT}/region.toml"
cp "${plan}/channels.toml" "${OUT}/channels.toml"

# Concentratord and its forwarder find each other on these sockets, one pair
# per slot.
events="ipc:///tmp/parkeze_${section}_event"
commands="ipc:///tmp/parkeze_${section}_command"

# ── concentratord.toml ──────────────────────────────────────────────────────

flags=""
case "${bus}" in
    spi) ;;
    usb) flags="\"USB\","
         device="$(ls /dev/ttyACM* 2>/dev/null | head -n1)" ;;
    *)   die "bus '${bus}' is not supported by concentratord" ;;
esac

# Only slot 0 has the receiver: one gateway, one position, and two processes
# opening the same tty is a fault that looks like intermittent GPS.
gps_device="$(get parkeze.gps.device)"
gps=""
if [ "${SLOT}" = "0" ] && [ "$(get parkeze.gps.status)" = "present" ] && [ -c "${gps_device}" ]; then
    flags="${flags}\"GNSS\","
    gps="gnss_dev_path=\"${gps_device}\""
fi

# The EUI is the gateway's, from UCI, on slot 0. A second slot takes its
# chip's own EUI: ChirpStack sees it as a second gateway, which is honest about
# what it is until multi-slot aggregation exists.
gateway_id=""
[ "${SLOT}" = "0" ] && [ -n "${eui}" ] && gateway_id="gateway_id=\"${eui}\""

chip="/dev/${PARKEZE_GPIOCHIP:-gpiochip0}"

{
    cat <<EOF
[concentratord]
log_level="INFO"
log_to_syslog=true
stats_interval="30s"
disable_crc_filter=false

[concentratord.api]
event_bind="${events}"
command_bind="${commands}"

[gateway]
lorawan_public=true
model="${model}"
region="${CONCENTRATORD_REGION}"
model_flags=[${flags}]
antenna_gain=0
${gateway_id}
com_dev_path="${device}"
${gps}
EOF
    [ -n "${reset}" ] && printf '%s_reset_chip="%s"\n%s_reset_pin=%s\n' "${chipset}" "${chip}" "${chipset}" "${reset}"
    [ -n "${power}" ] && printf '%s_power_en_chip="%s"\n%s_power_en_pin=%s\n' "${chipset}" "${chip}" "${chipset}" "${power}"
    [ -n "${PARKEZE_CONCENTRATOR_I2C}" ] && printf 'i2c_dev_path="%s"\n' "${PARKEZE_CONCENTRATOR_I2C}"

    # With no receiver the network server still needs to know where the
    # gateway is: the reference coordinates recorded at install.
    if [ -z "${gps}" ]; then
        latitude="$(get parkeze.location.latitude)"
        longitude="$(get parkeze.location.longitude)"
        altitude="$(get parkeze.location.altitude)"
        cat <<EOF

[gateway.location]
latitude=${latitude:-0}
longitude=${longitude:-0}
altitude=${altitude:-0}
EOF
    fi
} > "${OUT}/concentratord.toml"

# ── mqtt-forwarder.toml ─────────────────────────────────────────────────────
#
# TLS with the system CA bundle. The forwarder only turns TLS on when a CA path
# is set, so leaving ca_cert empty against an ssl:// server fails to connect
# rather than falling back to anything.
#
# Connection state goes to a file through the forwarder's callbacks, so the
# console can say "connected" without scraping the log for a message whose
# wording belongs to somebody else.

host="$(get parkeze.mqtt.host)"
port="$(get parkeze.mqtt.port)"; port="${port:-${PARKEZE_MQTT_PORT:-8883}}"
[ -n "${host}" ] || host="${PARKEZE_MQTT_HOST}"

mkdir -p "${STATE_DIR}"
state="${STATE_DIR}/${section}.mqtt"

cat > "${OUT}/mqtt-forwarder.toml" <<EOF
[logging]
level="info"
log_to_syslog=true

[mqtt]
topic_prefix="${TOPIC_PREFIX}"
json=false
server="ssl://${host}:${port}"
username="$(get parkeze.mqtt.username)"
password="$(get parkeze.mqtt.password)"
qos=0
clean_session=true
client_id="${eui}-${section}"
ca_cert="/etc/ssl/certs/ca-certificates.crt"
# A broker that is down or refusing us should not be retried every second: it
# fills the log, and on cellular it spends the data plan.
reconnect_interval="30s"

[backend]
enabled="concentratord"

[backend.concentratord]
event_url="${events}"
command_url="${commands}"

[callbacks]
on_mqtt_connected=["/bin/sh", "-c", "echo connected > ${state}"]
on_mqtt_connection_error=["/bin/sh", "-c", "echo error > ${state}"]
EOF
chmod 0600 "${OUT}/mqtt-forwarder.toml"

exit 0
