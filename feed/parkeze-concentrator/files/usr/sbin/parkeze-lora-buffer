#!/bin/sh
#
# Hold uplinks locally when they cannot be sent, and replay them when they can.
#
#   parkeze-lora-buffer render   write the broker's config, if enabled
#   parkeze-lora-buffer status   JSON: enabled, running, how much is queued
#
# It does not start anything. procd does, from parkeze-packet-forwarder, so
# the broker is supervised and respawned like everything else in the LoRa
# stack — and so there is exactly one thing that can start it. Two mechanisms
# able to launch a broker is two brokers on one port, eventually.
#
# ── WHAT THIS IS FOR ───────────────────────────────────────────────────────
#
# Without it, "do not send uplinks over cellular" means dropping them: the
# forwarder publishes to a broker it cannot reach and nothing on the gateway
# keeps what it could not send. That makes the setting a loss rather than a
# trade, which is not much of a choice to offer anybody.
#
# With it, the forwarder publishes to a broker on loopback that is always
# there, and a bridge carries those messages out when there is a path. A wired
# outage becomes a delay instead of a hole in the data.
#
# ── WHY A WHOLE BROKER ─────────────────────────────────────────────────────
#
# Because the forwarder has nowhere to put a message it cannot send —
# chirpstack-mqtt-forwarder is a thin bridge between concentratord and MQTT,
# with no store of its own, and no amount of configuration gives it one.
#
# A stock WisGateOS unit does run `mosquitto -c /tmp/mosquitto.generated.conf`
# beside its packet forwarder, which is where this idea came from — but that
# is not a RAK design decision. It is the OpenWrt mosquitto package's own init
# script, which generates exactly that path and is enabled on install. RAK
# built a Lua data-broker and SQLite on top of it for their integrations; the
# broker underneath is stock. Worth stating plainly, because "the vendor does
# this too" was doing more work as an argument than it had earned.
#
# ── THE DETAIL THAT DECIDES WHETHER IT WORKS ───────────────────────────────
#
# A mosquitto bridge does not queue QoS 0 messages. Not a flag we are leaving
# off — a bridge only stores what it is obliged to deliver, and QoS 0 obliges
# it to nothing. The forwarder publishes at QoS 0 by default, so pointing it
# at a local broker and stopping there would buffer precisely nothing while
# looking like it worked.
#
# So parkeze-lora-config publishes at QoS 1 when buffering is on. Over
# loopback that costs an acknowledgement to a process on the same machine,
# which is nothing, and it is what makes the queue exist.
#
# ── WHERE THE QUEUE LIVES ──────────────────────────────────────────────────
#
# In memory, and on the SD card if there is one. Not on flash: a queue is
# written continuously by definition, and a RAK's 32MB of soldered NOR is not
# somewhere to do that. A gateway with no card keeps its queue in RAM and
# loses it on reboot, which is still far better than dropping every message
# the moment the link goes.

. /etc/parkeze/board.conf

CONF=/var/run/parkeze/lora/mosquitto.conf

# Not 1883. The mosquitto package ships its own /etc/init.d/mosquitto at
# START=80, enabled, which binds 1883 before this service starts at 97 — so
# our broker could not bind and the forwarder, pointed at 1883, connected to
# the stock one instead. That broker has no bridge, so it accepted every
# uplink and dropped it, while every status this gateway reports looked fine.
#
# A port nobody else uses removes the whole class of collision: if our broker
# is not running, the forwarder fails to connect loudly instead of handing its
# uplinks to a stranger. 35-parkeze-mosquitto disables the stock service too,
# but that is defence in depth, not the fix — a port is the fix.
PORT="${PARKEZE_LORA_BUFFER_PORT:-18831}"

log() { logger -t lora-buffer -p daemon.info "$*"; }

get() { uci -q get "$1" || true; }

enabled() {
    local set; set="$(get parkeze.lorawan.buffer)"
    [ -n "${set}" ] || set="${PARKEZE_LORA_BUFFER:-0}"
    [ "${set}" = "1" ]
}

# The card, if there is one and it is writable. Checked rather than assumed:
# parkeze-storage records both, and a card that has worn read-only is exactly
# the case where writing a queue to it would fail continuously.
persistence_dir() {
    [ "$(get parkeze.storage.present)" = "1" ] || return 1
    [ "$(get parkeze.storage.writable)" = "1" ] || return 1
    local mount; mount="$(get parkeze.storage.mount)"
    [ -d "${mount}" ] || return 1
    echo "${mount}/parkeze/queue"
}

render() {
    local host port user pass prefix eui queue persist region plan
    host="$(get parkeze.mqtt.host)"; [ -n "${host}" ] || host="${PARKEZE_MQTT_HOST}"
    port="$(get parkeze.mqtt.port)"; port="${port:-${PARKEZE_MQTT_PORT:-8883}}"
    user="$(get parkeze.mqtt.username)"
    pass="$(get parkeze.mqtt.password)"
    eui="$(get parkeze.identity.gateway_eui)"

    # The topic prefix has to be the one the forwarder actually publishes
    # under, and that is not always in UCI: parkeze-lora-config falls back to
    # the region plan's TOPIC_PREFIX, so this has to fall back the same way.
    #
    # Getting this wrong would not fail, which is why it is worth closing:
    # the bridge would connect, authenticate, and sit there mapping topics
    # nothing publishes to. Defensive rather than diagnosed — adoption does
    # normally write this key, so on an adopted gateway the fallback should
    # never be reached.
    prefix="$(get parkeze.mqtt.topic_prefix)"
    if [ -z "${prefix}" ]; then
        region="$(get parkeze.lorawan.region)"; region="${region:-US915}"
        plan="/usr/share/parkeze/region/${region}/region.conf"
        # shellcheck disable=SC1090
        [ -f "${plan}" ] && . "${plan}"
        prefix="${TOPIC_PREFIX}"
    fi
    [ -n "${prefix}" ] || { log "no topic prefix for region ${region:-?}; refusing to bridge nothing"; return 1; }

    [ -n "${host}" ] && [ -n "${eui}" ] || { log "not adopted; nothing to bridge to"; return 1; }

    # Bounded, because an unbounded queue on a 128MB gateway is a way to run
    # the box out of memory during exactly the outage it was meant to survive.
    # ~10k uplinks is hours of a busy site and a few megabytes.
    queue="$(get parkeze.lorawan.queue_messages)"; queue="${queue:-10000}"

    mkdir -p "$(dirname "${CONF}")"
    {
        cat <<EOF
# Generated by parkeze-lora-buffer. Edits here are lost on the next render.

# Loopback only. This broker exists for one process on this machine; exposing
# it on any other address would be an unauthenticated MQTT broker on whatever
# network the gateway is plugged into.
listener ${PORT} 127.0.0.1
allow_anonymous true

autosave_interval 30

# To syslog, so the gateway log has it. Without this mosquitto writes to
# stderr, procd is not capturing stderr for this instance, and the broker is
# the one process in the LoRa stack that cannot say what is wrong with it —
# which is precisely the position this was debugged from.
#
# The bridge subtypes are the point. A bridge that connects and then forwards
# nothing looks identical from outside to one that is working, and these lines
# are the only place the difference shows up.
log_dest syslog
log_type error
log_type warning
log_type notice
log_type information
connection_messages true
EOF

        if persist="$(persistence_dir)"; then
            mkdir -p "${persist}" 2>/dev/null
            cat <<EOF
persistence true
persistence_location ${persist}/
EOF
        else
            echo "persistence false"
        fi

        cat <<EOF

connection parkeze
address ${host}:${port}
remote_username ${user}
remote_password ${pass}
bridge_cafile /etc/ssl/certs/ca-certificates.crt
bridge_insecure false

# false, so the remote session survives a disconnect and the broker knows it
# still owes those messages. With a clean session every reconnect would start
# empty, which is the queue quietly not existing.
cleansession false

# Exactly the topics the gateway's own credentials are allowed to use, in the
# directions they are allowed to use them — see mqtt-authorizer. A wildcard
# bridge would try to carry traffic the ACL denies and spend the outage
# retrying things that will never be accepted.
topic ${prefix}/gateway/${eui}/event/# out 1
topic ${prefix}/gateway/${eui}/state/# out 1
topic ${prefix}/gateway/${eui}/command/# in 1

max_queued_messages ${queue}

# Off: they are published to the local broker, which nothing reads, and on a
# metered link the bridge would also carry them out.
notifications false
EOF
    } > "${CONF}"
    chmod 0600 "${CONF}"
}

case "${1:-status}" in

render)
    # Removed on every path that is not a successful render, because the file
    # is what everything else reads to decide whether buffering is really on:
    # parkeze-lora-config points the forwarder at loopback by it, and
    # parkeze-lora-route confines the bridge's port by it. /var/run is tmpfs,
    # so a reboot clears it — but turning buffering off from the console is a
    # restart, not a reboot, and last run's file would outlive the setting.
    if ! enabled; then rm -f "${CONF}"; exit 1; fi
    command -v mosquitto >/dev/null 2>&1 || {
        log "mosquitto is not installed; uplinks will not be buffered"
        rm -f "${CONF}"; exit 1
    }
    render || { rm -f "${CONF}"; exit 1; }
    ;;

status)
    on=false; enabled && on=true
    running=false
    pgrep -f "mosquitto -c ${CONF}" >/dev/null 2>&1 && running=true
    # What is actually waiting. mosquitto keeps this in its persistence file,
    # and its size is the only honest answer available without an admin
    # interface the package does not build.
    queued_bytes=0
    if persist="$(persistence_dir)" && [ -f "${persist}/mosquitto.db" ]; then
        queued_bytes="$(wc -c < "${persist}/mosquitto.db" 2>/dev/null || echo 0)"
    fi
    printf '{"enabled":%s,"running":%s,"persistent":%s,"port":%s,"queuedBytes":%s}\n' \
        "${on}" "${running}" \
        "$(persistence_dir >/dev/null 2>&1 && echo true || echo false)" \
        "${PORT}" "${queued_bytes}"
    ;;

*)
    echo "usage: parkeze-lora-buffer {render|status}" >&2
    exit 2
    ;;
esac

exit 0
