#!/bin/sh
#
# What this gateway is, as key=value lines.
#
# Run by the MQTT forwarder on every stats interval ([metadata.commands]), which
# attaches the output to the stats message it already sends to the LNS. The LNS
# stores it on the gateway record, and parkeze.net reads that record — so the
# gateway page learns the firmware version and addresses over the connection
# and credentials the gateway already uses for LoRaWAN, with no extra topic and
# no broker change.
#
# Also used by `parkeze-claim report`, so a gateway with no working radio —
# which sends no stats — still says what it is.
#
# Small on purpose: this rides every stats message, and on a SIM those are
# billed. Keys are short and nothing here is slow.

. /etc/parkeze/board.conf

addr() {
    # First IPv4 address on a logical interface, or nothing.
    ubus call "network.interface.$1" status 2>/dev/null \
        | jsonfilter -e '@["ipv4-address"][0].address' 2>/dev/null
}

echo "parkeze_version=${PARKEZE_VERSION}"
echo "parkeze_build=${PARKEZE_BUILD}"
echo "openwrt=${OPENWRT_VERSION}"
echo "board=${BOARD_ID}"
echo "uptime=$(cut -d. -f1 /proc/uptime)"

wan="$(addr wan)";   [ -n "${wan}" ]   && echo "wan_ip=${wan}"
wwan="$(addr wwan)"; [ -n "${wwan}" ]  && echo "cellular_ip=${wwan}"

tunnel="$(jsonfilter -i /etc/parkeze/wireguard/tunnel.json -e '@.address' 2>/dev/null)"
[ -n "${tunnel}" ] && echo "tunnel_ip=${tunnel%/*}"

echo "concentrator=$(uci -q get parkeze.concentrator.status || echo unknown)"

# The unit as its maker recorded it, where it did (parkeze-hwdesc): which of
# a model's builds this is, the serial on its label, and its capabilities.
if hw="$(parkeze-hwdesc get DEV_NAME 2>/dev/null)" && [ -n "${hw}" ]; then
    echo "hw=${hw}"
    echo "hw_sn=$(parkeze-hwdesc get DEV_SERIAL_NUMBER)"
    echo "hw_caps=$(parkeze-hwdesc caps)"
fi

# on, off or absent; parkeze.net lists a gateway with Bluetooth as carrying
# both radios, and shows the switch for it.
[ -x /usr/sbin/parkeze-ble ] && echo "bluetooth=$(/usr/sbin/parkeze-ble state)"
exit 0
