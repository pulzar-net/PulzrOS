#!/bin/sh
#
# Find the GNSS receiver, if there is one, and record it in UCI.
#
#   parkeze-gps-detect            probe and write UCI
#   parkeze-gps-detect --dry-run  probe and print
#
# WHERE GPS LIVES ON THESE GATEWAYS
#
#   SPI HAT (RAK2287/5146 SPI, WM1302)   the GNSS module on the HAT is wired to
#                                        the Pi's own UART. This is the common
#                                        case and the reason UART is probed
#                                        first.
#   USB concentrator (RAK5146 USB)       the stick presents a second tty
#                                        alongside the concentrator's own.
#   RAK WisGate                          fixed, declared by the board.
#
# THE CONFLICT WORTH KNOWING ABOUT
#
# A UART *concentrator* and a UART *GNSS* cannot both have the Pi's serial
# port. If the board is configured for a UART concentrator, this refuses to
# claim the same device rather than producing two subsystems that each work
# until the other one starts. Put the GPS on USB in that configuration.

. /lib/functions.sh
. /etc/parkeze/board.conf

DRY_RUN=0
[ "$1" = "--dry-run" ] && DRY_RUN=1

log() { logger -t gps -p daemon.info "$*"; [ "${DRY_RUN}" = 1 ] && echo "$*"; }

# Ports already claimed by a concentrator, which must not be probed for GPS.
concentrator_ports() {
    local index=0 slots
    slots="$(uci -q get parkeze.concentrator.slots || echo 0)"
    while [ "${index}" -lt "${slots}" ]; do
        uci -q get "parkeze.slot${index}.device"
        index=$((index + 1))
    done
}

is_claimed() {
    local candidate="$1" taken
    for taken in $(concentrator_ports); do
        [ "${candidate}" = "${taken}" ] && return 0
    done
    return 1
}

# Which serial ports the kernel is using as a console.
#
# Probing one of these is destructive: the probe reconfigures the port to
# 9600 raw, and on a Pi the console is ttyAMA0 at 115200, so a GPS probe
# silently kills the serial console — the exact thing you reach for when a
# gateway will not boot.
console_ports() {
    local arg port
    for arg in $(cat /proc/cmdline 2>/dev/null); do
        case "${arg}" in
            console=*)
                port="${arg#console=}"
                port="${port%%,*}"
                case "${port}" in tty[0-9]*) continue ;; esac   # tty1 etc, not serial
                echo "/dev/${port}"
                # serial0 and serial1 are symlinks on a Pi; resolve them too.
                [ -L "/dev/${port}" ] && echo "/dev/$(readlink "/dev/${port}")"
                ;;
        esac
    done
}

is_console() {
    local candidate="$1" used
    for used in $(console_ports); do
        [ "${candidate}" = "${used}" ] && return 0
    done
    return 1
}

# Read at most `size` bytes from a port, giving up after `seconds`.
#
# `timeout` is not available: it is not a busybox applet in this build and
# there is no coreutils. Without it the original probe expanded to
# "timeout: not found", read nothing, and reported no GNSS on every board —
# quietly, because a failed probe is a normal outcome.
bounded_read() {
    local port="$1" seconds="$2" size="$3" out="$4"

    # Job-control notices from the kill below would otherwise land in the boot
    # log as a bare "Terminated", which reads like a fault rather than a probe
    # finishing normally.
    head -c "${size}" "${port}" > "${out}" 2>/dev/null &
    local pid=$!
    local waited=0
    while kill -0 "${pid}" 2>/dev/null; do
        if [ "${waited}" -ge "${seconds}" ]; then
            kill -TERM "${pid}" 2>/dev/null
            # A read blocked in the kernel on a silent tty ignores TERM.
            sleep 1
            kill -KILL "${pid}" 2>/dev/null
            break
        fi
        sleep 1
        waited=$((waited + 1))
    done
    wait "${pid}" 2>/dev/null
    return 0
} 2>/dev/null

# Does this tty emit NMEA?
#
# The only honest test is to listen. A GNSS receiver with no sky view still
# emits sentences — it just reports no fix — so this detects the *receiver*,
# not the fix, which is the right thing: a gateway in a rack being configured
# before it goes on a roof should still show its GPS as present.
probe_nmea() {
    local port="$1" baud="${2:-9600}"
    [ -c "${port}" ] || return 1

    # Never touch the console. On a Pi with an SPI concentrator HAT the HAT's
    # GNSS *is* wired to the console UART, so this is a real hardware conflict
    # rather than a corner case: you can have the serial console or UART GNSS,
    # not both. The console wins unless the board says otherwise, because
    # losing it is how a gateway becomes undiagnosable.
    if is_console "${port}"; then
        if [ "${PARKEZE_GPS_ALLOW_CONSOLE_UART:-0}" != "1" ]; then
            log "skipping ${port} — it is the kernel console"
            log "  (set PARKEZE_GPS_ALLOW_CONSOLE_UART=1 to give it up for GNSS)"
            return 1
        fi
        log "claiming the console port ${port} for GNSS, as configured"
    fi

    # Saved and restored: a probe that leaves a port at the wrong baud breaks
    # whatever owns it next.
    local saved
    saved="$(stty -F "${port}" -g 2>/dev/null)"
    stty -F "${port}" "${baud}" raw -echo 2>/dev/null || return 1

    # Two seconds is four or five sentence bursts at the usual 1Hz — enough to
    # see one, short enough that probing several ports at two baud rates does
    # not add half a minute to every boot.
    local tmp=/tmp/.gps-probe
    bounded_read "${port}" 2 512 "${tmp}"

    [ -n "${saved}" ] && stty -F "${port}" "${saved}" 2>/dev/null

    # $GPxxx, $GNxxx, $GLxxx, $GAxxx — the talker ID varies by constellation
    # and by receiver, so match the shape rather than a specific prefix.
    if grep -qE '\$G[PNLABQ][A-Z]{3},' "${tmp}" 2>/dev/null; then
        rm -f "${tmp}"
        return 0
    fi
    rm -f "${tmp}"
    return 1
}

# ── candidates ──────────────────────────────────────────────────────────────

# Is this tty a concentrator rather than something that might be a GNSS?
#
# A USB concentrator enumerates as a serial device, so it lands in the same
# glob as a USB GNSS puck. Probing it is not harmless: probe_nmea opens the
# port and changes its baud rate, and that leaves the SX1302 link wedged.
#
# What it cost, on a Pi 4 with a RAK5146 USB. At boot the order in
# parkeze-packet-forwarder is detect, then gps-detect, then start the slots —
# so this probed /dev/ttyACM0, and concentratord then sat on "Starting the
# concentrator" forever. Every register write succeeded; lgw_start never
# returned. That gateway had a concentrator detected, eight channels
# configured, a forwarder running, and had never carried one uplink.
#
# The thing that made it hard to see: restarting the LoRa stack fixed it every
# time. On a restart the previous concentratord still holds the port, so this
# probe cannot open it and the link survives. Only a cold boot, where nothing
# holds it yet, actually breaks. So the failure looked like "works when you
# poke it", which sent me looking at ModemManager instead.
#
# Matched on the USB ids probe_usb() recognises in parkeze-concentrator-detect,
# the same list as the ModemManager hotplug override in boards/common/files.
# Three places now, and they have to agree: a concentrator one of them does not
# know about is a concentrator something else will open.
is_concentrator_tty() {
    local port="$1" node ids
    case "${port}" in
        /dev/ttyACM*|/dev/ttyUSB*) ;;
        *) return 1 ;;
    esac

    node="/sys/class/tty/${port#/dev/}/device"
    [ -e "${node}" ] || return 1
    node="$(readlink -f "${node}" 2>/dev/null)" || return 1

    while [ -n "${node}" ] && [ "${node}" != "/sys" ] && [ "${node}" != "/" ]; do
        if [ -f "${node}/idVendor" ] && [ -f "${node}/idProduct" ]; then
            ids="$(cat "${node}/idVendor" 2>/dev/null):$(cat "${node}/idProduct" 2>/dev/null)"
            case "${ids}" in
                # CP2102N, FT2232H, STM32 CDC-ACM — see probe_usb().
                10c4:ea60|0403:6010|0483:5740) return 0 ;;
            esac
            return 1
        fi
        node="$(dirname "${node}")"
    done
    return 1
}

candidates() {
    if [ -n "${PARKEZE_GPS_DEV}" ]; then
        echo "${PARKEZE_GPS_DEV}"
        return
    fi
    # UART first: on a Pi with an SPI HAT that is where the GNSS is, and it is
    # the configuration most of the fleet runs.
    echo "${PARKEZE_UART_DEV:-/dev/ttyAMA0}"
    echo /dev/ttyS0
    for tty in /dev/ttyUSB* /dev/ttyACM*; do
        [ -c "${tty}" ] || continue
        if is_concentrator_tty "${tty}"; then
            log "skipping ${tty} — it is the concentrator, not a receiver"
            continue
        fi
        echo "${tty}"
    done
}

# ── decide ──────────────────────────────────────────────────────────────────

found=""
found_baud=""

if [ "$(uci -q get parkeze.gps.source)" = "device" ]; then
    # A receiver somebody chose on the GNSS page. Checked, never searched for:
    # probing other ports would replace their choice with whatever answered
    # first, which on a board with its own receiver is that one.
    found="$(uci -q get parkeze.gps.source_device)"
    found_baud="$(uci -q get parkeze.gps.source_baud)"
    found_baud="${found_baud:-9600}"
    if [ -z "${found}" ] || is_claimed "${found}"; then
        log "chosen GNSS device '${found}' is unset or belongs to a concentrator"
        found=""
    elif ! probe_nmea "${found}" "${found_baud}"; then
        log "chosen GNSS device ${found} emitted no NMEA at ${found_baud}"
        found=""
    fi
elif [ "${PARKEZE_GPS}" = "none" ]; then
    log "GPS disabled for this board"
elif [ -n "${PARKEZE_GPS}" ] && [ "${PARKEZE_GPS}" != "auto" ]; then
    # Fixed hardware. Trust the board, but still confirm the receiver answers —
    # knowing what is fitted is not the same as knowing it works.
    found="${PARKEZE_GPS_DEV}"
    found_baud="${PARKEZE_GPS_BAUD:-9600}"
    probe_nmea "${found}" "${found_baud}" || {
        log "board declares GPS on ${found} but it emitted no NMEA"
        found=""
    }
else
    for port in $(candidates); do
        if is_claimed "${port}"; then
            log "skipping ${port} — a concentrator has it"
            continue
        fi
        # 9600 is the near-universal default; 115200 is what the faster u-blox
        # modules ship at and what several RAK HATs are configured to.
        for baud in 9600 115200; do
            if probe_nmea "${port}" "${baud}"; then
                found="${port}"; found_baud="${baud}"
                log "GNSS found on ${port} at ${baud}"
                break
            fi
        done
        [ -n "${found}" ] && break
    done
fi

[ "${DRY_RUN}" = 1 ] && { echo "${found:-none} ${found_baud}"; exit 0; }

# ── record, but only if it differs ──────────────────────────────────────────
#
# `uci commit` rewrites the package file whether or not any value actually
# changed, and procd's config.change trigger on "parkeze" watches that file.
# This script runs from parkeze-packet-forwarder's start_service, so an
# unconditional commit restarts the service that just called it — which calls
# it again. It is a loop with nothing to stop it.
#
# Found on a Pi4 that had never forwarded a single uplink: the cycle ran every
# ten seconds and chirpstack-mqtt-forwarder never stayed alive long enough to
# finish connecting to the broker. Nothing in the log said "restarting", so it
# read as a broken forwarder rather than as a config trigger eating itself.
#
# Comparing before setting is what breaks it: on the boots where detection
# finds what it found last time — which is nearly all of them — there is
# nothing to commit and the trigger never fires.
changed=0
put() {
    [ "$(uci -q get "parkeze.$1")" = "$2" ] && return 0
    uci -q set "parkeze.$1=$2"
    changed=1
}

put gps gps
if [ -z "${found}" ]; then
    put gps.status absent
    put gps.device ''
    [ "${changed}" = 1 ] && uci commit parkeze
    log "no GNSS receiver found"
    exit 1
fi

put gps.status present
put gps.device "${found}"
put gps.baud "${found_baud}"
[ "${changed}" = 1 ] && uci commit parkeze
exit 0
