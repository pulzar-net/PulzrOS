#!/bin/sh /etc/rc.common
#
# The one reboot 35-parkeze-spi asks for, after it switches SPI on in
# config.txt. Last in the boot order so the gateway finishes coming up — and a
# first-boot claim code has already been minted — before it goes down. See that
# script for why it cannot loop.

START=99

boot() {
    [ -f /etc/parkeze/spi-reboot-pending ] || return 0
    rm -f /etc/parkeze/spi-reboot-pending
    sync
    logger -t concentrator "rebooting to load the SPI device tree"
    ( sleep 5; reboot ) >/dev/null 2>&1 &
}
