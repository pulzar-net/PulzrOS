#!/bin/sh /etc/rc.common
#
# The LoRa gateway: ChirpStack Concentratord and MQTT Forwarder, per slot.
#
# The gateway runs the gateway half of ChirpStack and nothing more. Per
# concentrator slot:
#
#   concentratord    drives the SX130x and publishes frames on a local socket
#   mqtt-forwarder   carries them to the cloud network server over MQTT/TLS,
#                    with the credentials adoption issued
#
# WHY PER SLOT
#
# Concentratord drives exactly one SX130x per process. So a 16-channel gateway
# (a RAK7289CV2: two SX1302s) runs two pairs, and an 8-channel gateway runs one.
# Treating the single-concentrator case as the general case would have made the
# 16-channel board a fork of this file; instead the loop below runs once on most
# boards and twice on that one. See docs/concentrators.md for how the second
# slot appears in ChirpStack.
#
# The name stays parkeze-packet-forwarder: the console, adoption and hotplug all
# restart the LoRa stack by it, and what it starts is an implementation detail.

START=97
STOP=15
USE_PROCD=1

CONF_DIR=/var/run/parkeze/lora

start_service() {
    local slots present

    # Re-run detection first. A concentrator can be hot-plugged on a Pi, and
    # starting against a stale UCI value is how you get a forwarder running
    # happily against hardware that is no longer there.
    /usr/sbin/parkeze-concentrator-detect >/dev/null 2>&1

    # GNSS too, for the same reason: a receiver can be plugged in between
    # boots, and slot 0's config depends on whether one is there.
    /usr/sbin/parkeze-gps-detect >/dev/null 2>&1

    # The local broker that holds uplinks when they cannot be sent, if this
    # gateway is buffering. Rendered here and run as a procd instance below,
    # so it is supervised like the rest of the stack rather than daemonising
    # itself somewhere nothing is watching.
    BUFFER=0
    /usr/sbin/parkeze-lora-buffer render >/dev/null 2>&1 && BUFFER=1

    # Whether these uplinks may go out over the SIM. After the render, because
    # what gets confined is the port the *bridge* dials out on, and that is
    # read from the config the render just wrote.
    /usr/sbin/parkeze-lora-route apply >/dev/null 2>&1

    # First, so the forwarder has somewhere to publish to by the time it
    # starts. Started after, its first connection fails against a port nothing
    # is listening on and it waits out a whole reconnect interval before
    # trying again.
    if [ "${BUFFER}" = 1 ]; then
        procd_open_instance "buffer"
        # No -d: procd supervises it in the foreground.
        procd_set_param command /usr/sbin/mosquitto -c /var/run/parkeze/lora/mosquitto.conf
        procd_set_param respawn 60 10 0
        procd_close_instance

        # Writes the queue to the card during an outage, and only then. Only
        # when the render actually gave the broker a card to write to.
        if grep -q '^persistence true' /var/run/parkeze/lora/mosquitto.conf; then
            procd_open_instance "buffer-save"
            procd_set_param command /usr/sbin/parkeze-lora-buffer watch
            procd_set_param respawn 60 10 0
            procd_close_instance
        fi
    fi

    slots="$(uci -q get parkeze.concentrator.slots || echo 0)"
    present="$(uci -q get parkeze.concentrator.present || echo 0)"

    if [ "${present}" = 0 ]; then
        logger -t lora -p daemon.warn "no concentrator responded; not starting"
        return 0
    fi

    if [ "${present}" -lt "${slots}" ]; then
        # Start anyway — half a gateway beats none — but say so loudly, because
        # nothing downstream makes a missing concentrator obvious.
        logger -t lora -p daemon.err \
          "only ${present} of ${slots} concentrators responded; running at reduced channel count"
    fi

    # Without credentials the forwarder can only be refused by the broker, so
    # it is not started. An unadopted gateway still runs its radio, so the
    # console can show it hearing traffic; adoption restarts this service.
    FORWARD=1
    [ "$(uci -q get parkeze.adoption.state)" = "adopted" ] \
        && [ -n "$(uci -q get parkeze.mqtt.username)" ] \
        && [ -n "$(uci -q get parkeze.mqtt.password)" ] || {
        FORWARD=0
        logger -t lora -p daemon.warn "not adopted: no MQTT credentials, so the radio runs and uplinks are not forwarded"
    }

    local index=0
    while [ "${index}" -lt "${slots}" ]; do
        start_slot "${index}"
        index=$((index + 1))
    done
    return 0
}

start_slot() {
    local index="$1"
    local section="slot${index}"
    local active status chipset dir

    status="$(uci -q get "parkeze.${section}.status")"
    active="$(uci -q get "parkeze.${section}.active")"
    [ "${status}" = "present" ] && [ -n "${active}" ] || {
        logger -t lora "slot ${index}: ${status:-unknown}; skipping"
        return 0
    }

    chipset="$(jsonfilter -i "/usr/share/parkeze/concentrator/${active}.json" -e '@.concentratord')"
    [ -x "/usr/bin/chirpstack-concentratord-${chipset}" ] || {
        logger -t lora -p daemon.err "slot ${index}: chirpstack-concentratord-${chipset} is not installed"
        return 1
    }

    # Emptied first: the check below is that files exist, and last run's must
    # not pass for this run's.
    dir="${CONF_DIR}/${section}"
    rm -rf "${dir}"; mkdir -p "${dir}"
    rm -f "${CONF_DIR}/${section}.mqtt"
    /usr/sbin/parkeze-lora-config "${index}" "${dir}" 2>&1 | logger -t lora -p daemon.err
    [ -s "${dir}/concentratord.toml" ] && [ -s "${dir}/mqtt-forwarder.toml" ] || {
        logger -t lora -p daemon.err "slot ${index}: could not render config"
        return 1
    }

    # Concentratord pulses the reset line itself, from the pin in its config,
    # every time it starts — so a restart after a crash always opens a part
    # that has just been reset.
    #
    # A concentrator that will not initialise usually will not initialise on
    # the next try either. Back off rather than spinning: a tight respawn loop
    # on a cellular gateway fills the log partition.
    # Concentratord claims the reset and power-enable lines itself. Detection
    # releases them, but a reset run by hand from the console would not, and
    # the failure is a crash loop on "Resource busy" rather than anything that
    # names a pin. Cheap to be certain here.
    parkeze-sx130x-reset --release 2>/dev/null

    procd_open_instance "concentratord${index}"
    procd_set_param command "/usr/bin/chirpstack-concentratord-${chipset}" \
        -c "${dir}/concentratord.toml" -c "${dir}/region.toml" -c "${dir}/channels.toml"
    procd_set_param respawn 60 10 0
    procd_close_instance

    [ "${FORWARD}" = 1 ] || return 0
    procd_open_instance "forwarder${index}"
    procd_set_param command /usr/bin/chirpstack-mqtt-forwarder -c "${dir}/mqtt-forwarder.toml"
    procd_set_param respawn 60 10 0
    procd_close_instance

    logger -t lora "slot ${index}: ${active} via concentratord-${chipset}, forwarding"
}

service_triggers() {
    procd_add_config_trigger "config.change" "parkeze" \
        /etc/init.d/parkeze-packet-forwarder restart
}
