#!/bin/sh
# Seed the concentrator section and run the first detection.
. /etc/parkeze/board.conf

uci -q batch <<EOF
set parkeze.concentrator=concentrator
set parkeze.concentrator.status='unknown'
set parkeze.lorawan=lorawan
set parkeze.lorawan.region='${PARKEZE_LORA_REGION:-US915}'
EOF
uci commit parkeze

# Detection at image-build time would record the *builder's* hardware, so this
# only ever runs on the device, on first boot.
/usr/sbin/parkeze-concentrator-detect >/dev/null 2>&1 || true

# GNSS after the concentrator, not before: the probe skips any serial port a
# concentrator has claimed, and it can only know which those are once the
# concentrator slots are in UCI.
/usr/sbin/parkeze-gps-detect >/dev/null 2>&1 || true
exit 0
