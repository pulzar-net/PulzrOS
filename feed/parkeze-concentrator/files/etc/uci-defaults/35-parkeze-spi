#!/bin/sh
#
# Turn the Pi's SPI controller on, for concentrator HATs.
#
# The image has always shipped the SPI drivers (kmod-spi-bcm2835, kmod-spi-dev)
# and pointed detection at /dev/spidev0.0, but nothing set `dtparam=spi=on` in
# the Pi's config.txt. Without it the controller is `disabled` in the device
# tree, the device node never appears, and an SPI concentrator is invisible —
# on every Pi this project has built. That read as "no radio fitted".
#
# config.txt is read by the Pi firmware before Linux starts, so the change only
# takes effect on the next boot. parkeze-spi-reboot does that reboot once, at
# the end of this boot, and only if this script had to change the file. It
# cannot loop: on the next boot the line is already there and nothing is
# scheduled.

# OpenWrt's prepare_rootfs runs every uci-defaults script during image
# assembly, on the build host. Guarded before anything else: unguarded, this
# would source the host's board.conf and could edit the host's own
# /boot/config.txt.
[ -n "${IPKG_INSTROOT}" ] && exit 0

. /etc/parkeze/board.conf

# Only boards that expect an SPI concentrator, and only a Pi boot partition.
# A RAK has no config.txt and describes its SPI in its own device tree.
[ -n "${PARKEZE_SPI_DEV}" ] || exit 0

CONFIG=/boot/config.txt
[ -f "${CONFIG}" ] || exit 0

grep -q '^dtparam=spi=on' "${CONFIG}" && exit 0

printf '\n# Parkeze: SPI concentrator HATs\ndtparam=spi=on\n' >> "${CONFIG}" || exit 0
sync
logger -t concentrator "enabled SPI in ${CONFIG}; rebooting once at the end of boot"
touch /etc/parkeze/spi-reboot-pending
exit 0
