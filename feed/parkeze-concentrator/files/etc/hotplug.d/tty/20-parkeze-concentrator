#!/bin/sh
#
# Keep ModemManager off the concentrator's serial port.
#
# A USB concentrator enumerates as a serial device. ModemManager treats every
# tty as a modem candidate and probes it with AT commands: OpenWrt's
# 25-modemmanager-tty reports the port with `mmcli --report-kernel-event`, and
# MM opens it. Two processes then own one port and the concentrator's binary
# protocol is interleaved with AT strings.
#
# What that looks like, on a Pi 4 with a RAK5146 USB and a Quectel EG25:
#
#   ModemManager[1503]: hotplug: add serial interface ttyACM0: event processed
#   ... 15 seconds later ...
#   concentratord: Setting board configuration, com_type: Usb, com_path: /dev/ttyACM0
#   concentratord: Configuring radio, radio: 0 ...      <- these all succeed
#   concentratord: Configuring multi-SF LoRa channel ...
#   concentratord: Starting the concentrator            <- and then nothing, ever
#
# The single register writes get through; lgw_start needs a sustained
# bidirectional exchange and never completes. The gateway had a concentrator
# detected, 8 channels configured, a forwarder running, and had never carried
# a single uplink. An SPI gateway never shows this, because nothing else on
# the system wants an SPI bus.
#
# This runs at 20, before 25-modemmanager-tty. Hotplug scripts are sourced
# into one shell by hotplug-call, so exiting here ends the chain for this
# event and the port is never reported to anything. That is the intent, not a
# side effect: nothing on this gateway should be opening the concentrator's
# port except concentratord.
#
# Matched on the USB ids probe_usb() already recognises in
# parkeze-concentrator-detect. Keep the two lists together — a concentrator
# this file does not know about is one ModemManager will happily take.

[ -n "${DEVNAME}" ] || return 0

case "${DEVNAME}" in
    ttyACM*|ttyUSB*) ;;
    *) return 0 ;;
esac

# Walk up from the tty to the USB device that owns it, which is where the
# vendor and product ids live. DEVPATH is the kernel path for this tty.
node="/sys${DEVPATH}"
while [ -n "${node}" ] && [ "${node}" != "/sys" ] && [ "${node}" != "/" ]; do
    if [ -f "${node}/idVendor" ] && [ -f "${node}/idProduct" ]; then
        ids="$(cat "${node}/idVendor" 2>/dev/null):$(cat "${node}/idProduct" 2>/dev/null)"
        case "${ids}" in
            # CP2102N (RAK5146/RAK2287 USB), FT2232H (WM1302 USB),
            # STM32 CDC-ACM (the RAK5146 module's own MCU).
            10c4:ea60|0403:6010|0483:5740)
                logger -t concentrator -p daemon.info \
                    "${DEVNAME} is a concentrator (${ids}); not offering it to ModemManager"
                exit 0
                ;;
        esac
        break
    fi
    node="$(dirname "${node}")"
done

return 0
