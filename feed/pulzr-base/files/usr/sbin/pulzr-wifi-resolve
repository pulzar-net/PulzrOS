#!/usr/bin/ucode
// A name's IPv4 address as the WiFi network answers it.
//
//   pulzr-wifi-resolve <name> [iface]   prints the first address, or exits non-zero
//
// iface is the WiFi uplink to ask through: wwifi (the default) or wwifi2, a
// second radio's, which pulzr-wifi-uplink proves before it carries anything.
//
// On failure one line goes to stderr, which pulzr-wifi-uplink keeps as the
// reason the WiFi is offline:
//
//   exit 1  down          the WiFi is not up
//   exit 3  nodns         the lease named no IPv4 DNS server
//   exit 4  noanswer <s>  none of the servers <s> answered
//   exit 5  noaddress <s> they answered, with no address (rcode or no A)
//
// ── WHY NOT THE GATEWAY'S OWN RESOLVER ─────────────────────────────────────
//
// pulzr-wifi-uplink and the sign-in proxy both need to ask the WiFi
// network, not the internet: a portal often answers every name with its own
// address, and that is the answer that leads to its page. Asking dnsmasq
// asks whichever upstream it likes, cellular's among them. Asking the WiFi's
// own servers with nslookup was no better: while the WiFi is held back at
// metric 30, the route to them is the SIM's, so on a campus guest network the
// question about OpenDNS went out over cellular and came back with the real
// address.
//
// Nor a host route to the WiFi's servers. That moves every lookup the
// gateway makes to them onto the WiFi, and while it is captive those come
// back as the portal: MQTT and reports over cellular would start dialling
// the portal by name.
//
// So one question, on a socket bound to the WiFi device (SO_BINDTODEVICE),
// to the servers the WiFi's lease named, and nothing else uses it.
//
// ── WHY TWICE, AND WHY TCP ─────────────────────────────────────────────────
//
// One lost UDP datagram used to be "offline": a single question, one try per
// server. Each server is asked again on a second pass with a longer wait,
// because a radio that has just associated loses the odd frame. And an answer
// with the truncated bit and no address is asked again over TCP, as a stub
// resolver would; a server that only answers in full over TCP is still
// answering.

let fs = require('fs');
let socket = require('socket');

let name = ARGV[0];
let wifi = ARGV[1] ?? 'wwifi';
if (!name || !match(name, /^[A-Za-z0-9.-]{1,253}$/) || !(wifi in ['wwifi', 'wwifi2'])) {
    warn('usage: pulzr-wifi-resolve <name> [wwifi|wwifi2]\n');
    exit(2);
}

let fail = (code, line) => {
    warn(line, '\n');
    exit(code);
};

let status = null;
let proc = fs.popen(sprintf('ubus call network.interface.%s status 2>/dev/null', wifi), 'r');
if (proc) {
    try { status = json(proc.read('all')); } catch (e) { status = null; }
    proc.close();
}
let dev = status?.l3_device;
if (!status?.up || !dev) fail(1, 'down');

let servers = filter(status['dns-server'] ?? [], (s) => match(s, /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/));
if (!length(servers)) fail(3, 'nodns');

let be16 = (n) => chr((n >> 8) & 255, n & 255);
let u16 = (buf, at) => (ord(buf, at) << 8) | ord(buf, at + 1);

// A standard query for one A record, recursion desired.
let id = hex(substr(fs.readfile('/proc/sys/kernel/random/uuid') ?? '1234', 0, 4)) || 0x1234;
let query = be16(id) + be16(0x0100) + be16(1) + be16(0) + be16(0) + be16(0);
for (let label in split(name, '.')) {
    if (!length(label)) continue;
    query += chr(length(label)) + label;
}
query += chr(0) + be16(1) + be16(1);

// Past a name in the message: labels, or a two-byte pointer that ends it.
let skipName = (buf, at) => {
    while (at < length(buf)) {
        let len = ord(buf, at);
        if (len == 0) return at + 1;
        if ((len & 0xc0) == 0xc0) return at + 2;
        at += len + 1;
    }
    return length(buf);
};

// { ip } for an address, { truncated } for a TC answer without one,
// { none } for an answer without one, null for no answer to this query.
let answer = (buf) => {
    if (length(buf) < 12 || u16(buf, 0) != id || !(ord(buf, 2) & 0x80)) return null;
    if ((ord(buf, 3) & 0x0f) != 0) return { none: true };
    let count = u16(buf, 6);
    let at = skipName(buf, 12) + 4;
    for (let i = 0; i < count && at + 10 <= length(buf); i++) {
        at = skipName(buf, at);
        let type = u16(buf, at), size = u16(buf, at + 8);
        at += 10;
        if (type == 1 && size == 4 && at + 4 <= length(buf))
            return { ip: sprintf('%d.%d.%d.%d', ord(buf, at), ord(buf, at + 1), ord(buf, at + 2), ord(buf, at + 3)) };
        at += size;
    }
    return (ord(buf, 2) & 0x02) ? { truncated: true } : { none: true };
};

let open = (kind, wait) => {
    let sock = socket.create(socket.AF_INET, kind);
    if (!sock) return null;
    if (sock.setopt(socket.SOL_SOCKET, socket.SO_BINDTODEVICE, dev)
        && sock.setopt(socket.SOL_SOCKET, socket.SO_RCVTIMEO, { sec: wait, usec: 0 })
        && sock.setopt(socket.SOL_SOCKET, socket.SO_SNDTIMEO, { sec: wait, usec: 0 }))
        return sock;
    sock.close();
    return null;
};

let overUdp = (server, wait) => {
    let sock = open(socket.SOCK_DGRAM, wait), got = null;
    if (sock && sock.connect(server, 53) && sock.send(query))
        got = answer(sock.recv(1500) ?? '');
    if (sock) sock.close();
    return got;
};

let overTcp = (server, wait) => {
    let sock = open(socket.SOCK_STREAM, wait), got = null;
    if (sock && sock.connect(server, 53) && sock.send(be16(length(query)) + query)) {
        let buf = '';
        while (length(buf) < 2 || length(buf) < 2 + u16(buf, 0)) {
            let chunk = sock.recv(4096);
            if (chunk == null || !length(chunk)) break;
            buf += chunk;
        }
        if (length(buf) > 2) got = answer(substr(buf, 2));
    }
    if (sock) sock.close();
    return got;
};

let answered = false;
for (let wait in [2, 3]) {
    for (let server in servers) {
        let got = overUdp(server, wait);
        if (got?.truncated) got = overTcp(server, wait) ?? got;
        if (got?.ip) {
            print(got.ip, '\n');
            exit(0);
        }
        if (got) answered = true;
    }
    // An answer without an address is an answer: asking again changes nothing.
    if (answered) break;
}
fail(answered ? 5 : 4, (answered ? 'noaddress ' : 'noanswer ') + join(' ', servers));
