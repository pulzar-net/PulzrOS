#!/bin/sh
#
# The Pi firmware settings a concentrator HAT needs: SPI, and who owns the UART;
# while Bluetooth is on, the wiring that gives the chip a UART of its own; and
# what the display and the USB device port need, on a board with either.
#
# config.txt and cmdline.txt are read by the Pi firmware before Linux starts, so
# nothing here takes effect until the next boot. It reports whether it changed
# anything; the caller decides what to do about that. On first boot that is
# 35-pulzr-boot-config, which schedules one reboot.
#
# ── WHO OWNS THE UART ──────────────────────────────────────────────────────
#
# One port, two claims, and the right answer depends on a HAT that cannot be
# detected: a Waveshare SX1302 HAT wires its GNSS to the same pins the kernel
# console uses, and a Pi with no HAT, or a RAK module, wants the console.
#
# So it is a setting, not a guess. The board supplies the default and a unit
# can override it, because which HAT is bolted on is a fact about the unit and
# not about the image it was flashed from.
#
#   console   the kernel console keeps the port. GNSS on that port is not
#             detected — see pulzr-gps-detect, which never probes a console.
#   gps       the console is taken off the port and the GNSS gets it.
#
# Losing the serial console is a real cost: it is the one tool that works on a
# gateway that will not boot. That is why `console` stays the default and the
# trade is made per unit, deliberately.

. /etc/pulzr/board.conf

CONFIG=/boot/config.txt
CMDLINE=/boot/cmdline.txt
changed=0

# --dry-run reports the role and whether this board has anything to apply,
# without touching a boot file. The console reads state far more often than it
# changes it, and a status call must never rewrite firmware settings.
DRY=0
[ "$1" = "--dry-run" ] && DRY=1

role="$(uci -q get pulzr.hardware.uart_role || true)"
[ -n "${role}" ] || role="${PULZR_UART_ROLE:-console}"

# Nothing to do on a board with no Pi boot partition; a RAK describes its own
# hardware in its device tree.
[ -f "${CONFIG}" ] || { printf '{"changed":false,"role":"%s","applies":false}\n' "${role}"; exit 0; }

add_line() {
    grep -q "^$1\$" "${CONFIG}" && return 0
    changed=1
    [ "${DRY}" = 1 ] && return 0
    printf '\n# Pulzar\n%s\n' "$1" >> "${CONFIG}"
}

# The reverse of add_line: the line, the "# Pulzar" above it and the blank
# line above that, so turning something off leaves the file as it was.
remove_line() {
    grep -q "^$1\$" "${CONFIG}" || return 0
    changed=1
    [ "${DRY}" = 1 ] && return 0
    awk -v l="$1" '{ a[NR] = $0 }
        END {
            for (i = 1; i <= NR; i++) {
                if (a[i] == l) continue
                if (a[i] == "# Pulzar" && a[i + 1] == l) continue
                if (a[i] == "" && a[i + 1] == "# Pulzar" && a[i + 2] == l) continue
                print a[i]
            }
        }' "${CONFIG}" > "${CONFIG}.new" && mv "${CONFIG}.new" "${CONFIG}"
}

# Bluetooth wants its wiring only while it is on. The board says what that
# wiring is; a board with none has nothing to apply either way.
bt=0
[ -n "${PULZR_BT_BOOT}" ] && [ "$(uci -q get pulzr.ble.enabled)" = 1 ] && bt=1

# SPI, for a concentrator on the header. Without it the controller is disabled
# in the device tree and /dev/spidev0.0 never appears.
[ -n "${PULZR_SPI_DEV}" ] && add_line 'dtparam=spi=on'

# I2C, for the AD5338R that sets transmit power on a CoreCell-style module.
# Only where the board describes that part, since it is the only thing on this
# bus and a board without one has no reason to expose it.
[ -n "${PULZR_AD5338R_RESET_GPIO}" ] && add_line 'dtparam=i2c_arm=on'

if [ "${role}" = "gps" ]; then
    # PL011 on the header pins, not the Bluetooth-shared mini UART: a GNSS at
    # 9600 on the mini UART drifts with the core clock.
    add_line 'enable_uart=1'
    # disable-bt also switches the mini UART off, so with Bluetooth on it must
    # not follow miniuart-bt -- and is not needed: miniuart-bt puts the PL011
    # on the header pins itself, which is all the GNSS wants from this line.
    # OpenWrt's distroconfig.txt applies it before either, which is harmless.
    if [ "${bt}" = 1 ]; then
        remove_line 'dtoverlay=disable-bt'
    else
        add_line 'dtoverlay=disable-bt'
    fi

    # Take the console off the port. This is the half that actually frees it:
    # with a console on it, pulzr-gps-detect refuses to probe and a getty
    # would eat the NMEA anyway.
    if grep -q 'console=serial0\|console=ttyAMA0' "${CMDLINE}" 2>/dev/null; then
        changed=1
        [ "${DRY}" = 1 ] || sed -i 's/console=serial0,[0-9]*[[:space:]]*//g; s/console=ttyAMA0,[0-9]*[[:space:]]*//g' "${CMDLINE}"
    fi
elif ! grep -q 'console=serial0\|console=ttyAMA0' "${CMDLINE}" 2>/dev/null; then
    # Back to the console: put it where the stock image has it.
    changed=1
    [ "${DRY}" = 1 ] || sed -i 's/$/ console=serial0,115200/' "${CMDLINE}"
fi

for line in ${PULZR_BT_BOOT}; do
    if [ "${bt}" = 1 ]; then
        add_line "${line}"
    # Still wanted by the GNSS role, whose setting it also is.
    elif [ "${role}" = "gps" ] && [ "${line}" = 'enable_uart=1' ]; then
        continue
    else
        remove_line "${line}"
    fi
done

# The terminal-UI features: composite TV-out off for the display, and the
# device port handed to dwc2 for the USB gadget. Each applies while its package
# is installed, which is what having the feature means; see the Display and USB
# device port sections of boards/common/board.conf.
for line in ${PULZR_DISPLAY_BOOT}; do
    if [ -x /etc/init.d/pulzr-display ]; then add_line "${line}"; else remove_line "${line}"; fi
done
for line in ${PULZR_USB_GADGET_BOOT}; do
    if [ -x /usr/sbin/pulzr-usb-gadget ]; then add_line "${line}"; else remove_line "${line}"; fi
done

[ "${changed}" = 1 ] && [ "${DRY}" = 0 ] && sync
printf '{"changed":%s,"role":"%s","applies":true,"bluetooth":%s}\n' \
    "$([ "${changed}" = 1 ] && echo true || echo false)" "${role}" \
    "$([ "${bt}" = 1 ] && echo true || echo false)"
exit 0
