#!/bin/sh
#
# Compose root's authorized_keys from the image and the site.
#
# ── WHY THIS EXISTS ────────────────────────────────────────────────────────
#
# /etc/dropbear/authorized_keys shipped in the image, which made it a package
# conffile — and sysupgrade keeps conffiles. So the fleet key a gateway was
# flashed with was the fleet key it kept forever: an upgrade carrying a new
# one installed everything except the file that decides who can log in. The
# platform rotated its key, every gateway went on accepting only the old one,
# and the failure looked like an authentication bug on a gateway that was
# otherwise perfectly reachable.
#
# So authorized_keys is no longer shipped. It is composed at every boot from
# two inputs that cannot be confused for each other:
#
#   /usr/share/pulzr/fleet-keys   Pulzar's own key(s), from the image. On
#                                   /usr, which sysupgrade replaces whole, so
#                                   a rotated key arrives with the firmware.
#   /etc/pulzr/site-keys          keys a technician provisioned on this unit
#                                   (see pulzr-bootprov). Development builds
#                                   only: anywhere else this file is deleted.
#
# Site keys used to work on every build, refused only once a gateway was
# adopted — and a key planted before adoption stayed afterwards. Root on
# PulzarOS is a copy of PulzarOS, so on a production build root is Pulzar's
# alone; a technician reaches the console as `pulzr` (pulzr-ssh-setup).
#
# A key in neither file is not in authorized_keys after a reboot. That is the
# point: revoking fleet access has to be possible, and "it is still in a file
# somebody edited once" is not a revocation.

set -eu

FLEET=/usr/share/pulzr/fleet-keys
SITE=/etc/pulzr/site-keys
OUT=/etc/dropbear/authorized_keys
# sshd reads $HOME/.ssh. OpenWrt's dropbear, which images before the switch to
# OpenSSH ran, reads /etc/dropbear/authorized_keys; still written, so a
# rollback to one of those images keeps the same keys.
HOME_OUT=/root/.ssh/authorized_keys

valid() { grep -hE '^(ssh-(rsa|ed25519)|ecdsa-sha2-)' "$1" 2>/dev/null || true; }

PULZR_DEV=0
BOARD_CONF="${PULZR_BOARD_CONF:-/etc/pulzr/board.conf}"
# Tested first: `.` of a missing file ends a POSIX shell, `|| true` or not.
if [ -f "${BOARD_CONF}" ]; then . "${BOARD_CONF}"; fi
if [ "${PULZR_DEV:-0}" != 1 ] && [ -e "${SITE}" ]; then
    rm -f "${SITE}"
    logger -t pulzr -p daemon.notice "site SSH keys removed: production builds take Pulzar's only"
fi

composed="$( { [ -f "${FLEET}" ] && valid "${FLEET}"
               [ -f "${SITE}" ] && valid "${SITE}"; } | sort -u)"

if [ -z "${composed}" ]; then
    # No keys at all is a legitimate build (PULZR_OPS_KEYS=0) and a
    # legitimate state. Leave nothing behind rather than an empty file that
    # reads like the composition failed.
    rm -f "${OUT}" "${HOME_OUT}"
    exit 0
fi

mkdir -p /etc/dropbear /root/.ssh
chmod 0700 /etc/dropbear /root/.ssh

# Written only when it differs, so a read-mostly boot does not rewrite flash.
if [ "$(cat "${OUT}" 2>/dev/null || true)" != "${composed}" ]; then
    printf '%s\n' "${composed}" > "${OUT}"
    chmod 0600 "${OUT}"
    logger -t pulzr -p daemon.info \
        "authorized_keys composed from the image and site keys"
fi
cp "${OUT}" "${HOME_OUT}"
chmod 0600 "${HOME_OUT}"
