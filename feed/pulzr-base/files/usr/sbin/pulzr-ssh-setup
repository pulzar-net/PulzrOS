#!/bin/sh
#
# What sshd trusts, composed at boot from the image and this gateway.
#
#   pulzr-ssh-setup              write /etc/ssh: config, host keys, CA, principal
#   pulzr-ssh-setup --host-key   the host key to report, "ssh-ed25519 AAAA..."
#   pulzr-ssh-setup --trusts-ca  exit 0 if the running sshd accepts a Pulzar
#                                  certificate naming this gateway
#
# ── WHY OPENSSH, AND ONLY OPENSSH ─────────────────────────────────────────
#
# Pulzar Cloud reaches a gateway's shell with an SSH certificate made for that
# one gateway, good for five minutes, rather than with one fleet key that opens
# every gateway. dropbear cannot check a certificate, so sshd replaces it.
#
# Replaces, rather than runs beside it on the management addresses. Those are
# the tunnel's, allocated at enrolment and up only while it handshakes, and the
# SIM's; the ethernet port alone holds a lease, the console address and a
# link-local address at once. Two daemons on 22 split by address would be a
# binding to keep right on every one of those changes, a second host key for
# Pulzar Cloud to pin, and two daemons' RAM on a 128MB gateway instead of one.
#
# ── HOST KEYS ──────────────────────────────────────────────────────────────
#
# Pulzar Cloud pins the host key a gateway reports. dropbear's keys are
# converted once, on the first boot without dropbear, so sshd presents the key
# already pinned. dropbear's files are left where they are: a rollback to a
# dropbear image presents the same key again. keep.d carries both sets.
#
# ── THE CERTIFICATE AUTHORITY AND THE PRINCIPAL ───────────────────────────
#
# The CA's public line ships on /usr, which sysupgrade replaces whole, so a
# rotated CA arrives with the firmware; it is copied to the path Pulzar Cloud's
# docs name. A certificate is accepted for root only if it names this
# gateway's EUI — 16 lowercase hex, one line — so a certificate leaked from one
# session opens one gateway for five minutes. An image built without a CA, or
# a gateway that does not know its EUI, gets no CA configuration at all, and
# the fleet key in authorized_keys is the way in, as before.
#
# ── THE CONSOLE ACCOUNT ───────────────────────────────────────────────────
#
# `pulzr` (and `parkeze`, its ParkezeOS name), no password: sshd_config runs
# the TUI's sign-in as its only command, so `ssh pulzr@<gateway>` is the
# console and nothing else. Not root (it was, until 0.4): anybody on the
# site's network reaches it before signing in, so it runs as uid 1000 and asks
# pulzr-console-broker, which is root, for everything it reads or changes.
# Made here, every boot, because /etc/passwd and /etc/shadow are conffiles a
# gateway keeps from whatever image it was first flashed with, and a gateway
# upgraded from 0.3 has the account as uid 0 there: rewritten, not added to.
#
# Everything is written only when it differs, so a boot that changes nothing
# writes nothing to flash.

SSH="${PULZR_SSH_DIR:-/etc/ssh}"
SHARE="${PULZR_SSH_SHARE:-/usr/share/pulzr/ssh}"
DROPBEAR="${PULZR_DROPBEAR_DIR:-/etc/dropbear}"

PASSWD="${PULZR_PASSWD:-/etc/passwd}"
SHADOW="${PULZR_SHADOW:-/etc/shadow}"
GROUP="${PULZR_GROUP:-/etc/group}"
CONSOLE_PASSWD='pulzr:x:1000:1000:Pulzar console:/:/bin/ash'
CONSOLE_SHADOW='pulzr::0:0:99999:7:::'
CONSOLE_GROUP='pulzr:x:1000:'
# ParkezeOS's name for the same account. Technicians and the platform's tools
# still run `ssh parkeze@<gateway>`; it is the same console under another name.
LEGACY_PASSWD='parkeze:x:1000:1000:Pulzar console:/:/bin/ash'
LEGACY_SHADOW='parkeze::0:0:99999:7:::'

CA="${SSH}/pulzr_user_ca.pub"
PRINCIPALS="${SSH}/auth_principals"
CA_CONF="${SSH}/sshd_config.d/pulzr-ca.conf"

log() { logger -t pulzr-ssh -p daemon.info "$*"; }
err() { logger -t pulzr-ssh -p daemon.err "$*"; }

changed=""

# put <path> <mode> <content>
put() {
    if [ ! -f "$1" ] || [ "$(cat "$1")" != "$3" ]; then
        printf '%s\n' "$3" > "$1.tmp" && chmod "$2" "$1.tmp" && mv "$1.tmp" "$1" \
            || { rm -f "$1.tmp"; err "could not write $1"; return 1; }
        changed=1
    fi
    chmod "$2" "$1"
}

drop() {
    [ -e "$1" ] || return 0
    rm -f "$1"
    changed=1
}

# The certificate principal: this gateway's EUI, exactly as Pulzar Cloud names
# it, or nothing.
principal() {
    local eui
    eui="$(uci -q get pulzr.identity.gateway_eui 2>/dev/null | tr 'A-F' 'a-f')"
    printf '%s' "${eui}" | grep -qE '^[0-9a-f]{16}$' || return 1
    echo "${eui}"
}

# The CA line, if the image carries a usable one.
ca_line() {
    local line
    [ -s "${SHARE}/pulzr_user_ca.pub" ] || return 1
    [ "$(grep -c . "${SHARE}/pulzr_user_ca.pub")" = 1 ] || return 1
    line="$(grep . "${SHARE}/pulzr_user_ca.pub")"
    printf '%s' "${line}" | grep -qE '^ssh-ed25519 [A-Za-z0-9+/]+=* ?' || return 1
    echo "${line}"
}

# dropbear_<type>_host_key -> ssh_host_<type>_key, once.
convert() {
    local type="$1"
    local from="${DROPBEAR}/dropbear_${type}_host_key" to="${SSH}/ssh_host_${type}_key"
    [ -s "${to}" ] && return 0
    [ -s "${from}" ] || return 0
    command -v dropbearconvert >/dev/null 2>&1 || {
        err "no dropbearconvert; sshd will present a new ${type} host key"
        return 1
    }
    rm -f "${to}.tmp"
    if ( umask 077; dropbearconvert dropbear openssh "${from}" "${to}.tmp" ) >/dev/null 2>&1 \
       && ssh-keygen -y -f "${to}.tmp" > "${to}.pub.tmp" 2>/dev/null \
       && [ -s "${to}.pub.tmp" ]; then
        chmod 0600 "${to}.tmp"
        chmod 0644 "${to}.pub.tmp"
        mv "${to}.tmp" "${to}"
        mv "${to}.pub.tmp" "${to}.pub"
        log "sshd presents dropbear's ${type} host key"
        changed=1
        return 0
    fi
    rm -f "${to}.tmp" "${to}.pub.tmp"
    err "could not convert dropbear's ${type} host key; sshd will present a new one"
    return 1
}

# account <file> <line> <mode>: <file> with exactly one line for the user
# <line> names, <line>, after everything else in it.
account() {
    local file="$1" line="$2" mode="$3" user rest
    user="${line%%:*}"
    [ -f "${file}" ] || { err "no ${file}; no console account"; return 1; }
    [ "$(grep "^${user}:" "${file}")" = "${line}" ] && return 0
    rest="$(grep -v "^${user}:" "${file}")"
    put "${file}" "${mode}" "${rest}
${line}" && log "console account ${user} written to ${file}"
}

setup() {
    account "${PASSWD}" "${LEGACY_PASSWD}" 0644
    account "${PASSWD}" "${CONSOLE_PASSWD}" 0644
    account "${SHADOW}" "${LEGACY_SHADOW}" 0600
    account "${SHADOW}" "${CONSOLE_SHADOW}" 0600
    account "${GROUP}" "${CONSOLE_GROUP}" 0644
    # Somebody else's uid 1000 would share the console's ubus rights.
    awk -F: '$3 == 1000 && $1 != "pulzr" && $1 != "parkeze" { found = 1 } END { exit !found }' \
        "${PASSWD}" && err "uid 1000 belongs to another account as well as the console"

    mkdir -p "${SSH}/sshd_config.d"
    chmod 0755 "${SSH}" "${SSH}/sshd_config.d"

    # ParkezeOS wrote the same CA under parkeze_user_ca.pub and parkeze-ca.conf.
    # The key is unchanged and is written again below under the new names; a
    # leftover config pointing at the old file would be a second, stale copy.
    rm -f "${SSH}/parkeze_user_ca.pub" "${SSH}/sshd_config.d/parkeze-ca.conf"

    [ -s "${SHARE}/sshd_config" ] && put "${SSH}/sshd_config" 0644 "$(cat "${SHARE}/sshd_config")"

    convert ed25519
    convert rsa
    # A gateway flashed with this image never had dropbear. Made here, before
    # sshd starts, so the first report has a key to send whatever sshd's own
    # init goes on to make; sshd_config offers only ed25519 and RSA.
    if [ ! -s "${SSH}/ssh_host_ed25519_key" ] && [ ! -s "${SSH}/ssh_host_rsa_key" ]; then
        ssh-keygen -q -t ed25519 -N '' -f "${SSH}/ssh_host_ed25519_key" >/dev/null 2>&1 \
            && log "made an ed25519 host key" && changed=1
    fi

    local line eui
    line="$(ca_line)" || line=""
    eui="$(principal)" || eui=""
    if [ -n "${line}" ] && [ -n "${eui}" ]; then
        put "${CA}" 0644 "${line}"
        mkdir -p "${PRINCIPALS}"
        chmod 0755 "${PRINCIPALS}"
        put "${PRINCIPALS}/root" 0644 "${eui}"
        put "${CA_CONF}" 0644 "TrustedUserCAKeys ${CA}
AuthorizedPrincipalsFile ${PRINCIPALS}/%u"
    else
        [ -n "${line}" ] || log "this image carries no SSH CA; certificates are not accepted"
        [ -n "${eui}" ] || err "no valid gateway EUI; certificates are not accepted"
        drop "${CA_CONF}"
        drop "${PRINCIPALS}/root"
        drop "${CA}"
    fi

    # At boot this runs before sshd starts; anything later that changes what
    # sshd trusts has to restart it for the change to count.
    if [ -n "${changed}" ] && pidof sshd >/dev/null 2>&1; then
        /etc/init.d/sshd restart >/dev/null 2>&1
    fi
    return 0
}

# The key reported to Pulzar Cloud for pinning. ed25519 first, as dropbear's
# was read before, so a converted gateway reports the key it reported then.
host_key() {
    local type f key
    for type in ed25519 rsa; do
        f="${SSH}/ssh_host_${type}_key"
        [ -s "${f}" ] || continue
        if [ -s "${f}.pub" ]; then
            key="$(cat "${f}.pub")"
        else
            key="$(ssh-keygen -y -f "${f}" 2>/dev/null)"
        fi
        key="$(printf '%s\n' "${key}" | awk '/^ssh-/ { print $1" "$2; exit }')"
        [ -n "${key}" ] && { echo "${key}"; return 0; }
    done
    return 1
}

trusts_ca() {
    local eui conf
    eui="$(principal)" || return 1
    [ -s "${CA}" ] || return 1
    [ "$(cat "${PRINCIPALS}/root" 2>/dev/null)" = "${eui}" ] || return 1
    pidof sshd >/dev/null 2>&1 || return 1
    conf="$(sshd -T -f "${SSH}/sshd_config" 2>/dev/null)" || return 1
    # Without regard to case: OpenSSH 9 prints `sshd -T` keywords in lower
    # case and OpenSSH 10 in their documented case, and an exact match made
    # every gateway on OpenWrt 25.12 report that it trusts no CA, so the front
    # door refused them all.
    printf '%s\n' "${conf}" | grep -qix "trustedusercakeys ${CA}" || return 1
    printf '%s\n' "${conf}" | grep -qix "authorizedprincipalsfile ${PRINCIPALS}/%u"
}

case "${1:-}" in
    '')          setup ;;
    --host-key)  host_key ;;
    --trusts-ca) trusts_ca ;;
    *)           echo "usage: pulzr-ssh-setup [--host-key | --trusts-ca]" >&2; exit 2 ;;
esac
