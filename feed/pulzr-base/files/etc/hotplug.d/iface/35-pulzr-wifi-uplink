#!/bin/sh
#
# Ask whether a WiFi uplink that just came up reaches the internet.
#
# Until it has answered, the WiFi is not usable for the tunnel or for LoRa
# uplinks — see pulzr-wifi-uplink — so the question is asked here rather
# than left to the once-a-minute sweep. Backgrounded, and a couple of seconds
# late, so the lease's DNS servers are in place first and this handler does
# not hold up the ones after it.
#
# Asked again at 10 and 30 seconds while the answer is not "open". The first
# ask can land before the network passes traffic — on a campus eduroam it said
# "offline" seconds after a good join — and the sweep would have left the
# gateway off its WiFi for up to a minute on the strength of it.

[ "${INTERFACE}" = "wwifi" ] && [ "${ACTION}" = "ifup" ] || exit 0

(
    for wait in 2 8 20; do
        sleep "${wait}"
        /usr/sbin/pulzr-wifi-uplink check
        /usr/sbin/pulzr-wifi-uplink usable && break
    done
) >/dev/null 2>&1 &
