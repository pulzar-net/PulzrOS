#!/bin/sh /etc/rc.common
#
# Undo a change that was never confirmed, before the network starts.
#
# pulzr-apply arm (a port layout, a cellular or Wi-Fi change, an uplink order)
# keeps the configuration it replaced on flash until the change is confirmed.
# A reboot inside that window, a power cut or somebody pulling the plug
# because the change cut them off, would otherwise boot straight into the
# configuration nobody confirmed. Named for the first change that needed it;
# renaming an enabled init script is a migration. After uci-defaults (10),
# before network (20).

START=11

boot() {
	/usr/sbin/pulzr-apply boot
}

start() {
	:
}
