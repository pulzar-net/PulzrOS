#!/bin/sh
#
# Give this gateway a stable identity on first boot.
#
# Runs once (uci-defaults scripts delete themselves on success). Everything
# here is derived from hardware, so a reflash produces the same identity and a
# gateway that comes back from an RMA is still recognisably itself.

# ── Do not run during image assembly ────────────────────────────────────────
#
# OpenWrt's prepare_rootfs executes every /etc/uci-defaults script while the
# image is being built, with IPKG_INSTROOT pointing at the staging rootfs. Any
# absolute path in here therefore hits the *build host*, not the gateway.
#
# For this package that is not merely wrong, it is dangerous: identity comes
# from /proc/cpuinfo, and the console's first-boot credentials and TLS key are
# generated here. Run at build time, every gateway flashed from one image would
# share one password and one private key, and would believe it was the CI
# runner.
#
# So: defer to first boot, which is the only place any of this makes sense.
[ -n "${IPKG_INSTROOT}" ] && exit 0

. /etc/pulzr/board.conf

# ── Serial ──────────────────────────────────────────────────────────────────
# Preference order matters. The Pi's CPU serial is stable across reflashes and
# unique per unit; a MAC address is stable but can be spoofed or, on some
# boards, is assigned from a pool at boot. Fall back to a random value only if
# both are missing, and record that we did — a randomly-identified gateway
# loses its identity on reflash and support needs to know that.
serial="$(sed -n 's/^Serial\s*:\s*0*//p' /proc/cpuinfo | head -n1)"
serial_source="cpuinfo"

if [ -z "${serial}" ]; then
    serial="$(cat /sys/class/net/eth0/address 2>/dev/null | tr -d ':')"
    serial_source="eth0"
fi
if [ -z "${serial}" ]; then
    serial="$(head -c8 /dev/urandom | hexdump -ve '1/1 "%02x"')"
    serial_source="random"
fi

short="$(echo "${serial}" | tail -c9)"
hostname="${PULZR_HOSTNAME_PREFIX:-pulzr}-${short}"

# ── LoRaWAN Gateway EUI ─────────────────────────────────────────────────────
# Sixteen hex characters, which is what ChirpStack and Pulzar Cloud key a
# gateway on. Derived from the ethernet MAC in the conventional EUI-64 way
# (insert FFFE in the middle) so that the EUI printed on a label, the EUI the
# packet forwarder announces, and the EUI in our database are the same string.
mac="$(cat /sys/class/net/eth0/address 2>/dev/null | tr -d ':' | tr 'a-f' 'A-F')"
if [ -n "${mac}" ] && [ ${#mac} -eq 12 ]; then
    eui="$(echo "${mac}" | cut -c1-6)FFFE$(echo "${mac}" | cut -c7-12)"
else
    # No usable MAC. Derive from the serial instead of shipping the vendor
    # placeholder AA555A0000000000, which collides across every unit that
    # never got this right and is genuinely painful to untangle in ChirpStack.
    eui="$(echo "${serial}" | md5sum | cut -c1-16 | tr 'a-f' 'A-F')"
fi

uci -q batch <<EOF
set system.@system[0].hostname='${hostname}'
set system.@system[0].timezone='EST5EDT,M3.2.0,M11.1.0'
set system.@system[0].zonename='America/New_York'
set system.@system[0].log_size='64'

set pulzr.identity=identity
set pulzr.identity.serial='${serial}'
set pulzr.identity.serial_source='${serial_source}'
set pulzr.identity.hostname='${hostname}'
set pulzr.identity.gateway_eui='$(echo "${eui}" | tr 'A-F' 'a-f')'
set pulzr.identity.board='${BOARD_ID}'
set pulzr.identity.board_name='${BOARD_NAME}'
EOF

uci commit system
uci commit pulzr

echo "${hostname}" > /proc/sys/kernel/hostname

exit 0
