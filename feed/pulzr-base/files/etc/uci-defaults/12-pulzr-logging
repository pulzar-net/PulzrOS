#!/bin/sh
#
# Size the system log from board.conf. Runs before the log service starts at
# boot, and again after every upgrade, so a new size applies from the next
# boot either way.

[ -n "${IPKG_INSTROOT}" ] && exit 0

. /etc/pulzr/board.conf

case "${PULZR_LOG_SIZE:-}" in
    ''|*[!0-9]*) exit 0 ;;
esac
uci -q set system.@system[0].log_size="${PULZR_LOG_SIZE}"
uci commit system
exit 0
