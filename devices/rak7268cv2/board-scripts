PART_NAME=firmware
REQUIRE_IMAGE_METADATA=1

RAMFS_COPY_BIN='fw_printenv fw_setenv'
RAMFS_COPY_DATA='/etc/fw_env.config /var/lock/fw_printenv.lock'

[ -f /lib/upgrade/rak_img_check.sh ] && . /lib/upgrade/rak_img_check.sh

platform_check_image() {
	local board=$(board_name)
	local magic="$(get_magic_long "$1")"
	# Checking fixed magic value for bin file
	if [ "$magic" == "27051956" ]; then
		return 0
	elif [ "$magic" == "$RAKIMG_MGWORD" ]; then
		check_rak_image $1
		rtn_code=$?
		if [ $rtn_code = 0 ] ; then
			return 0
		else
			v "Invalid image"
			echo $rtn_code > /tmp/upgrade_failure
			return 1
		fi
	else
		v "Invalid image magic number $magic"
		echo $RAKIMGCHK_MGFAIL > /tmp/upgrade_failure
		return 1
	fi
	return 0
}

platform_do_upgrade() {
	local board=$(board_name)
	local magic="$(get_magic_long "$1")"
	case "$board" in
	alfa-network,awusfree1)
		[ "$(fw_printenv -n dual_image 2>/dev/null)" = "1" ] &&\
		[ -n "$(find_mtd_part backup)" ] && {
			PART_NAME=backup
			if [ "$(fw_printenv -n bootactive 2>/dev/null)" = "1" ]; then
				fw_setenv bootactive 2 || exit 1
			else
				fw_setenv bootactive 1 || exit 1
			fi
		}
		default_do_upgrade "$1"
		;;
	tplink,archer-c20-v5|\
	tplink,archer-c50-v4)
		MTD_ARGS="-t romfile"
		default_do_upgrade "$1"
		;;
	rakwireless,rak634|\
	rakwireless,rak636)
		if [ "$magic" == "$RAKIMG_MGWORD" ]; then
		    v "Start upgrading RAK image"
			do_rak_upgrade "$1"
		else
		    v "Start upgrading standard image "
			default_do_upgrade "$1"
		fi
		;;
	*)
		default_do_upgrade "$1"
		;;
	esac
}
