#!/usr/bin/env bash
# The OpenWrt targets the LoRa packages are built for: every target a board
# with the lorawan feature is on, one <target>/<subtarget> per line. CI builds
# one SDK job per line, so a board on a new target needs nothing here.
set -euo pipefail
BOARDS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../boards" && pwd)"
export BOARDS_DIR
for conf in "${BOARDS_DIR}"/*/board.conf; do
  [ "${conf}" = "${BOARDS_DIR}/common/board.conf" ] && continue
  # shellcheck disable=SC1090
  ( . "${conf}"; ! has_feature lorawan || echo "${OPENWRT_TARGET}/${OPENWRT_SUBTARGET}" )
done | sort -u
