#!/usr/bin/env bash
# The cache key for one target's packages: the target, and only what decides
# what they are. A cold build is hours, so an edit that cannot change a
# package must not change the key: the key once hashed every file in sdk/,
# and removing a lookup helper from it (sdk/targets, 23 Nov 2026) sent all
# five targets cold.
#
#   sdk/key <target>/<subtarget>
#
# What does decide them: the OpenWrt release; sdk/build.sh, which configures
# and builds; the feeds it pins, the list it collects (built) and the recipes
# under packages/; and scripts/busybox-quiet-config.sh, which sets the
# busybox it builds. Their comment lines (a shell or Makefile
# line starting with #) and blank lines are left out, so neither is a rebuild.
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "${HERE}/.." && pwd)"
target="${1:?usage: sdk/key <target>/<subtarget>}"

inputs() {
  ( cd "${ROOT}" && {
      echo sdk/build.sh; echo sdk/feeds; echo sdk/built
      echo scripts/busybox-quiet-config.sh
      find sdk/packages -type f
    } | LC_ALL=C sort )
}

sum="$( {
  grep '^OPENWRT_VERSION=' "${ROOT}/boards/common/board.conf"
  for f in $(inputs); do
    printf '%s %s\n' "${f}" "$(grep -v -E '^[[:space:]]*(#|$)' "${ROOT}/${f}" | sha256sum | cut -c1-64)"
  done
} | sha256sum | cut -c1-16)"
echo "lora-${target//\//-}-${sum}"
