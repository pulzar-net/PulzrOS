{
  "name": "pulzr-gateway-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The on-device console for a Pulzr gateway. Built to static files and served by uhttpd; there is no Node on the gateway.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@pulzr/ui": "git+https://github.com/pulzar-net/pulzr-ui.git#v0.1.3",
    "@tanstack/react-query": "^5.62.0",
    "@tanstack/react-table": "^8.21.3",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.8.3",
    "vite": "^6.0.3"
  }
}
